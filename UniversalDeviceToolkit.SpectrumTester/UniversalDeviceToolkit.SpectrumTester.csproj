<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
	<TargetFramework>$(UDTTargetFramework)</TargetFramework>
	<RootNamespace>UniversalDeviceToolkit.SpectrumTester</RootNamespace>
	<OutputType>Exe</OutputType>
	<AssemblyName>SpectrumTester</AssemblyName>
	<SelfContained>false</SelfContained>
	<PublishSingleFile>false</PublishSingleFile>
	<PublishReadyToRun>false</PublishReadyToRun>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
</PropertyGroup>

<ItemGroup>
	<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
		<_Parameter1>UniversalDeviceToolkit.Tests</_Parameter1>
	</AssemblyAttribute>
	<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
		<_Parameter1>UniversalDeviceToolkit.Tests.Contracts</_Parameter1>
	</AssemblyAttribute>
	<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
		<_Parameter1>UniversalDeviceToolkit.Tests.Stateful</_Parameter1>
	</AssemblyAttribute>
</ItemGroup>

<ItemGroup>
	<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
</ItemGroup>

<ItemGroup>
	<ProjectReference Include="..\UniversalDeviceToolkit.Lib\UniversalDeviceToolkit.Lib.csproj" />
</ItemGroup>

</Project>
