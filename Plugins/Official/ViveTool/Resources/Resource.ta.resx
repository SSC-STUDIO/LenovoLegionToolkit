<root><resheader name="resmimetype"><value>text/microsoft-resx</value></resheader><resheader name="version"><value>2.0</value></resheader><resheader name="reader"><value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value></resheader><resheader name="writer"><value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value></resheader><data name="ViveTool_PageTitle"><value>ViVeTool</value></data><data name="ViveTool_PageDescription"><value>விவேட்டூலைப் பயன்படுத்தி விண்டோஸ் அம்சக் கொடிகளைக் கட்டுப்படுத்தவும். பரிசோதனை விண்டோஸ் அம்சங்களை இயக்கவும் அல்லது முடக்கவும்.</value></data><data name="ViveTool_WarningTitle"><value>எச்சரிக்கை</value></data><data name="ViveTool_WarningMessage"><value>அதிக ஆபத்து: விண்டோஸ் அம்சக் கொடிகளை மாற்றுவது விண்டோஸ் புதுப்பிப்புகள், பயன்பாடுகள், இயக்கிகளை மற்றும் சிஸ்டம் ஸ்திரத்தன்மையை பாதிக்கலாம். முதலில் ஒரு மீட்டெடுப்புப் புள்ளியை உருவாக்கவும். ஆவணப்படுத்தப்பட்ட அம்ச ஐடிகளை மட்டும் பயன்படுத்தவும். சில மாற்றங்களுக்கு மறுதொடக்கம் தேவைப்படலாம், மேலும் காப்புப்பிரதி இல்லாமல் அவற்றை மீட்டெடுக்க முடியாது.</value></data><data name="ViveTool_ViveToolStatus"><value>விவேட்டூல் நிலை</value></data><data name="ViveTool_ViveToolFound"><value>விவேட்டூல் இங்கே உள்ளது: {0}</value></data><data name="ViveTool_ViveToolNotFound"><value>விவேட்டூல் காணப்படவில்லை. நம்பகமான விவேட்டூல் இயங்குதளத்தை பதிவிறக்கவும் அல்லது கட்டமைக்கவும்.</value></data><data name="ViveTool_ViveToolError"><value>விவேட்டூல் நிலையை சரிபார்க்கும்</value></data><data name="ViveTool_DownloadProgress"><value>பதிவிறக்கம்: {0} / {1} ({2}%)</value></data><data name="ViveTool_DownloadComplete"><value>பதிவிறக்கம் முடிந்தது</value></data><data name="ViveTool_DownloadCompleteMessage"><value>விவேட்டூல் {0} இல் பதிவிறக்கம் செய்யப்பட்டது</value></data><data name="ViveTool_DownloadFailed"><value>பதிவிறக்கம் தோல்வியடைந்தது</value></data><data name="ViveTool_Refresh"><value>புதுப்பிக்கவும்</value></data><data name="ViveTool_SearchFeatures"><value>அம்சங்களைத் தேடு</value></data><data name="ViveTool_SearchPlaceholder"><value>தேடலுக்கு அம்ச ஐடி அல்லது பெயரை உள்ளிடவும்...</value></data><data name="ViveTool_Search"><value>தேடு</value></data><data name="ViveTool_FeatureFlags"><value>அம்சக் கொடிகள்</value></data><data name="ViveTool_RefreshList"><value>பட்டியலை புதுப்பிக்கவும்</value></data><data name="ViveTool_Loading"><value>ஏற்றுதல்...</value></data><data name="ViveTool_FeatureId"><value>ஐடி</value></data><data name="ViveTool_FeatureName"><value>பெயர்</value></data><data name="ViveTool_Status"><value>நிலை</value></data><data name="ViveTool_Actions"><value>செயல்கள்</value></data><data name="ViveTool_Enable"><value>இயக்க</value></data><data name="ViveTool_Disable"><value>முடக்கு</value></data><data name="ViveTool_NoFeaturesFound"><value>எந்த அம்சமும் இல்லை</value></data><data name="ViveTool_FeatureEnabled"><value>அம்சம் இயக்கப்பட்டது</value></data><data name="ViveTool_FeatureEnabledMessage"><value>அம்சம் {0} வெற்றிகரமாக இயக்கப்பட்டது</value></data><data name="ViveTool_FeatureDisabled"><value>அம்சம் முடக்கப்பட்டது</value></data><data name="ViveTool_FeatureDisabledMessage"><value>அம்சம் {0} வெற்றிகரமாக முடக்கப்பட்டது</value></data><data name="ViveTool_Error"><value>பிழை</value></data><data name="ViveTool_EnableFeatureFailed"><value>அம்சம் {0} இயக்க முடியவில்லை. தயவுசெய்து நிர்வாக அனுமதிகளை சரிபார்க்கவும்.</value></data><data name="ViveTool_DisableFeatureFailed"><value>அம்சம் {0} முடக்க முடியவில்லை. தயவுசெய்து நிர்வாக அனுமதிகளை சரிபார்க்கவும்.</value></data><data name="ViveTool_Import"><value>இறக்குமதி</value></data><data name="ViveTool_Export"><value>ஏற்றுமதி</value></data><data name="ViveTool_ExportFileDialogFilter"><value>JSON கோப்புகள் (*.json)|*.json|எல்லா கோப்புகளும் (*.*)|*.*</value></data><data name="ViveTool_ExportSuccess"><value>வெற்றிகரமாக ஏற்றுமதி செய்யப்பட்டது</value></data><data name="ViveTool_ExportSuccessMessage"><value>வெற்றிகரமாக {0} அம்சக் கொடி(களை) {1} க்கு ஏற்றுமதி செய்யப்பட்டது</value></data><data name="ViveTool_ExportFailed"><value>அம்சங்களின் பட்டியலை ஏற்றுமதி செய்ய முடியவில்லை.</value></data><data name="ViveTool_ExportFailedWithMessage"><value>அம்சங்களின் பட்டியலை ஏற்றுமதி செய்ய முடியவில்லை: {0}</value></data><data name="ViveTool_ExportNoFeatures"><value>எந்த அம்சங்களும் ஏற்றுமதி செய்யப்படவில்லை.</value></data><data name="ViveTool_ImportFromFile"><value>கோப்பிலிருந்து இறக்குமதி செய்க</value></data><data name="ViveTool_ImportFileDialogFilter"><value>அனைத்து கோப்புகளும் (*.*)|*.*|JSON கோப்புகள் (*.json)|*.json|உரை கோப்புகள் (*.txt)|*.txt|CSV கோப்புகள் (*.csv)|*.csv</value></data><data name="ViveTool_ImportFromUrl"><value>URL இலிருந்து இறக்குமதி செய்க</value></data><data name="ViveTool_ImportDescription"><value>ஒரு கோப்பிலோ அல்லது URL-லிலோ அம்சக் கொடிகளை இறக்குமதி செய்க. ஆதரிக்கப்படும் வடிவங்கள்: JSON, CSV, அல்லது எளிய உரை (ஒவ்வொரு வரியிலும் ஒரு ID)</value></data><data name="ViveTool_ImportUrlDescription"><value>எந்த URL இலிருந்து அம்சக் கொடிகளை இறக்குமதி செய்ய வேண்டும் என்பதை உள்ளிடவும்:</value></data><data name="ViveTool_ImportSuccess"><value>வெற்றிகரமாக இறக்குமதி செய்யப்பட்டது</value></data><data name="ViveTool_ImportSuccessMessage"><value>{0} அம்சக் கொடியை வெற்றிகரமாக இறக்குமதி செய்யப்பட்டது</value></data><data name="ViveTool_ImportFailed"><value>அம்சங்களை இறக்குமதி செய்ய முடியவில்லை: {0}</value></data><data name="ViveTool_InvalidUrl"><value>செல்லாத URL. சரியான URL ஐ உள்ளிடவும்.</value></data><data name="ViveTool_Cancel"><value>ரத்து செய்</value></data><data name="ViveTool_Browse"><value>தேடு</value></data><data name="ViveTool_SelectViveTool"><value>vivetool.exe ஐத் தேர்ந்தெடுக்கவும்</value></data><data name="ViveTool_ExecutableDialogFilter"><value>இயங்கக்கூடிய கோப்புகள் (*.exe)|*.exe|அனைத்து கோப்புகளும் (*.*)|*.*</value></data><data name="ViveTool_InvalidViveToolFile"><value>தயவுசெய்து vivetool.exe கோப்பைத் தேர்ந்தெடுக்கவும்</value></data><data name="ViveTool_PathSet"><value>பாதை அமைக்கப்பட்டது</value></data><data name="ViveTool_PathSetMessage"><value>ViVeTool பாதை பின்வருமாறு அமைக்கப்பட்டுள்ளது: {0}</value></data><data name="ViveTool_SetPathFailed"><value>ViVeTool பாதையை அமைப்பதில் தோல்வி: {0}</value></data><data name="ViveTool_Download"><value>பதிவிறக்கவும்</value></data><data name="ViveTool_PathPlaceholder"><value>ViVeTool.exe பாதை</value></data><data name="ViveTool_PathDescription"><value>இந்த பிளகின் இயல்பாக ஒரு தொகுக்கப்பட்ட ViVeTool இயக்க நேரத்துடன் வருகிறது. இருப்பினும், நீங்கள் ஒரு தனிப்பயன் ViVeTool.exe பாதையைத் தேர்ந்தெடுக்கலாம்; தனிப்பயன் பாதை காலியாக இருந்தால், தொகுக்கப்பட்ட அல்லது சரிபார்க்கப்பட்ட உள்ளமைக்கப்பட்ட இயக்க நேரம் மட்டுமே பயன்படுத்தப்படும்.</value></data><data name="ViveTool_BrowseError"><value>கோப்புகளை அணுகுவதில் பிழை: {0}</value></data><data name="ViveTool_Downloading"><value>ViVeTool பதிவிறக்கம்...</value></data><data name="ViveTool_StatusEnabled"><value>செயல்படுத்தப்பட்டது</value></data><data name="ViveTool_StatusDisabled"><value>முடக்கப்பட்டது</value></data><data name="ViveTool_StatusDefault"><value>இயல்புநிலை</value></data><data name="ViveTool_StatusUnknown"><value>தெரியவில்லை</value></data><data name="ViveTool_StatusFilterAll"><value>அனைத்து நிலைகளும்</value></data><data name="ViveTool_MissingToolMessage"><value>ViVeTool கண்டுபிடிக்கப்படவில்லை. தயவுசெய்து அமைப்புகளில் உள்ளமைக்கவும்.</value></data><data name="ViveTool_GoToSettings"><value>அமைப்புகளுக்குச் செல்லவும்</value></data><data name="ViveTool_ImportConfig"><value>உள்ளமைவை இறக்குமதி செய்யவும்</value></data><data name="ViveTool_ImportConfigTitle"><value>உள்ளமைவை இறக்குமதி செய்யவும்</value></data><data name="ViveTool_ImportConfigDialogFilter"><value>JSON கோப்புகள் (*.json)|*.json|CSV கோப்புகள் (*.csv)|*.csv|உரை கோப்புகள் (*.txt)|*.txt|எல்லா கோப்புகளும் (*.*)|*.*</value></data><data name="ViveTool_ImportConfigDescription"><value>உள்ளூர் கோப்பிலிருந்து ViVeTool உள்ளமைவை இறக்குமதி செய்யவும். இது அம்சம் கொடிகள் மற்றும் அவற்றின் அமைப்புகளை ஏற்றும்.</value></data><data name="ViveTool_ConfigImportSuccess"><value>உள்ளமைவு இறக்குமதி செய்யப்பட்டது</value></data><data name="ViveTool_ConfigImportSuccessMessage"><value>{0} அம்ச உள்ளமைவுகளை {1} இலிருந்து வெற்றிகரமாக இறக்குமதி செய்யப்பட்டது</value></data><data name="ViveTool_ConfigImportFailed"><value>உள்ளமைவை இறக்குமதி செய்ய முடியவில்லை</value></data><data name="ViveTool_ConfigImportFailedMessage"><value>உள்ளமைவை இறக்குமதி செய்ய முடியவில்லை: {0}</value></data><data name="ViveTool_GitHub"><value>GitHub</value></data><data name="ViveTool_BinaryPathTitle"><value>ViVeTool பைனரி பாதை</value></data></root>