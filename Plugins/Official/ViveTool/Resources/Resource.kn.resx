><data name="ViveTool_ExportSuccessMessage"><value>ಯಶಸ್ವಿಯಾಗಿ {0} ವೈಶಿಷ್ಟ್ಯ ಫ్లాగ్‌ಗಳನ್ನು {1} ಗೆ ರಫ್ತು ಮಾಡಲಾಗಿದೆ</value></data><data name="ViveTool_ExportFailed"><value>ವೈಶಿಷ್ಟ್ಯ ಪಟ್ಟಿ ರಫ್ತು ಮಾಡಲು విಫలವಾಗಿದೆ.</value></data><data name="ViveTool_ExportFailedWithMessage"><value>ವೈಶಿಷ್ಟ್ಯ ಪಟ್ಟಿ ರಫ್ತು ಮಾಡಲು విಫలವಾಗಿದೆ: {0}</value></data><data name="ViveTool_ExportNoFeatures"><value>ಯಾವುದೇ ವಿಶೇಷಣಗಳನ್ನು ರಫ್ತು ಮಾಡಲು ಲಭ್ಯವಿಲ್ಲ.</value></data><data name="ViveTool_ImportFromFile"><value>ಫೈಲ್ నుండి ಆಯೋಜಿಸಿ</value></data><data name="ViveTool_ImportFileDialogFilter"><value>ಎಲ್ಲಾ ಫೈಲ್‌ಗಳು (*.*)|*.*|JSON ಫೈಲ್‌ಗಳು (*.json)|*.json|टेक्स्ट ಫೈಲ್‌ಗಳು (*.txt)|*.txt|CSV ಫೈಲ್‌ಗಳು (*.csv)|*.csv</value></data><data name="ViveTool_ImportFromUrl"><value>URL నుండి ಆಯೋಜಿಸಿ</value></data><data name="ViveTool_ImportDescription"><value>ಫೈಲ್ ಅಥವಾ URL నుండి ವೈಶಿಷ್ಟ್ಯ ಟಾಗ್‌ಗಳನ್ನು ಆಯೋಜಿಸಿ. ಬೆಂಬಲಿತ ಸ್ವರೂપો: JSON, CSV, ಅಥವಾ ಸರಳ ಪಠ্য (ಒಂದು ID ಪ್ರತಿ ಸಾಲಿನಲ್ಲಿ).</value></data><data name="ViveTool_ImportUrlDescription"><value>ವೈಶಿಷ್ಟ್ಯ ಟಾಗ್‌ಗಳನ್ನು ಆಯೋಜಿಸಲು URL ಅನ್ನು ನಮೂದಿಸಿ:</value></data><data name="ViveTool_ImportSuccess"><value>ಆಯೋಜನೆ ಯಶಸ್ವಿಯಾಯಿತು</value></data><data name="ViveTool_ImportSuccessMessage"><value>{0} ವೈಶಿಷ್ಟ್ಯ ಟಾಗ್‌ಗಳನ್ನು ಯಶಸ್ವಿಯಾಗಿ ಆಯೋಜಿಸಲಾಗಿದೆ</value></data><data name="ViveTool_ImportFailed"><value>ವೈಶಿಷ್ಟ್ಯಗಳನ್ನು ಆಯೋಜಿಸಲು ವಿಫಲ: {0}</value></data><data name="ViveTool_InvalidUrl"><value>ನಕಲಿ URL. ದಯವಿಟ್ಟು, ನಕಲಿ URL ಅನ್ನು ನಮೂದಿಸಿ.</value></data><data name="ViveTool_Cancel"><value>ರದ್ದುಮಾಡಿ</value></data><data name="ViveTool_Browse"><value>ಆಯ್ಕೆಮಾಡಿ</value></data><data name="ViveTool_SelectViveTool"><value>vivetool.exe ಅನ್ನು ಆಯ್ಕೆಮಾಡಿ</value></data><data name="ViveTool_ExecutableDialogFilter"><value>ಕಾರ್ಯನಿರ್ವಾಹಕ ಫೈಲ್‌ಗಳು (*.exe)|*.exe| ಎಲ್ಲಾ ಫೈಲ್‌ಗಳು (*.*)|*.*</value></data><data name="ViveTool_InvalidViveToolFile"><value>ದಯವಿಟ್ಟು vivetool.exe ಫೈಲ್ ಅನ್ನು ಆಯ್ಕೆಮಾಡಿ</value></data><data name="ViveTool_PathSet"><value>ಮಾರ್ಗ ಹೊಂದಿಸಲಾಗಿದೆ</value></data><data name="ViveTool_PathSetMessage"><value>ViVeTool ಮಾರ್ಗವನ್ನು {0} ಎಂದು ಹೊಂದಿಸಲಾಗಿದೆ</value></data><data name="ViveTool_SetPathFailed"><value>ViVeTool ಮಾರ್ಗವನ್ನು ಹೊಂದಿಸಲು ವಿಫಲ: {0}</value></data><data name="ViveTool_Download"><value>ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ</value></data><data name="ViveTool_PathPlaceholder"><value>ViVeTool.exe ಮಾರ್ಗ</value></data><data name="ViveTool_PathDescription"><value>ಈ ಪ್ಲಗಿನ್ ಅನ್ನು ಡೈಫಾಲ್ಟ್ ಆಗಿ ViVeTool ರನ್টাইಮ್‌ನೊಂದಿಗೆ ಒಳಗೊಂಡಿದೆ. ಆದಾಗ್ಯೂ, ನೀವು ವೈಯಕ್ತಿಕ ViVeTool.exe ಮಾರ್ಗವನ್ನು ಆಯ್ಕೆ ಮಾಡಬಹುದು; ವೈಯಕ್ತಿಕ ಮಾರ್ಗ ಖಾಲಿ ಆಗಿದ್ದರೆ, ಒಳಗೊಂಡ ಅಥವಾ ధృవీಕಿತ ಅಂತರ್ಗತ ರನ್টাইಮ್ ಅನ್ನು ಮಾತ್ರ ಬಳಸಲಾಗುತ್ತದೆ.</value></data><data name="ViveTool_BrowseError"><value>ಫೈಲ್‌ಗಳನ್ನು ಪ್ರೊಸೆಸ್ ಮಾಡಲು ದೋಷ: {0}</value></data><data name="ViveTool_Downloading"><value>ViVeTool ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲಾಗುತ್ತಿದೆ...</value></data><data name="ViveTool_StatusEnabled"><value>ಸಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ</value></data><data name="ViveTool_StatusDisabled"><value>ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ</value></data><data name="ViveTool_StatusDefault"><value>ಡೈಫಾಲ್ಟ್</value></data><data name="ViveTool_StatusUnknown"><value>ಅರಿವಿಲ್ಲ</value></data><data name="ViveTool_StatusFilterAll"><value>ಎಲ್ಲಾ ಸ್ಥಿತಿಗಳು</value></data><data name="ViveTool_MissingToolMessage"><value>ViVeTool ಅನ್ನು ಕಂಡುಹಿಡಿಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ದಯವಿಟ್ಟು ಅದನ್ನು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಕಾನ್ಫಿಗರ್ ಮಾಡಿ.</value></data><data name="ViveTool_GoToSettings"><value>ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಗೆ ಹೋಗಿ</value></data><data name="ViveTool_ImportConfig"><value>ಕಾನ್ಫಿಗರ್ ಅನ್ನು ಆಮದು ಮಾಡಿ</value></data><data name="ViveTool_ImportConfigTitle"><value>ಕಾನ್ಫಿಗರೇಶನ್ ಅನ್ನು ಆಮದು ಮಾಡಿ</value></data><data name="ViveTool_ImportConfigDialogFilter"><value>JSON ಫೈಲ್‌ಗಳು (*.json)|*.json|CSV ಫೈಲ್‌ಗಳು (*.csv)|*.csv|ಟೆಕ್ಸ್ಟ್ ಫೈಲ್‌ಗಳು (*.txt)|*.txt|ಎಲ್ಲಾ ಫೈಲ್‌ಗಳು (*.*)|*.*</value></data><data name="ViveTool_ImportConfigDescription"><value>ಸ್ಥಳೀಯ ಫೈಲ್‌ನಿಂದ ViVeTool ಕಾನ್ಫಿಗರೇಶನ್ ಅನ್ನು ಆಮದು ಮಾಡಿ. ಇದು ವೈಶಿಷ್ಟ್ಯ ಫ್ಲ್ಯಾಗ್‌ಗಳು ಮತ್ತು ಅವುಗಳ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಲೋಡ್ ಮಾಡುತ್ತದೆ.</value></data><data name="ViveTool_ConfigImportSuccess"><value>ಕಾನ್ಫಿಗರೇಶನ್ ಆಮದು ಮಾಡಲಾಗಿದೆ</value></data><data name="ViveTool_ConfigImportSuccessMessage"><value>{0} ವೈಶಿಷ್ಟ್ಯ ಕಾನ್ಫಿಗರೇಶನ್‌ಗಳನ್ನು {1} ಯಶಸ್ವಿಯಾಗಿ ಆಮದು ಮಾಡಲಾಗಿದೆ</value></data><data name="ViveTool_ConfigImportFailed"><value>ಆಮದು ಮಾಡಲು ವಿಫಲ</value></data><data name="ViveTool_ConfigImportFailedMessage"><value>ಕಾನ್ಫಿಗರೇಶನ್ ಅನ್ನು ಆಮದು ಮಾಡಲು ವಿಫಲ: {0}</value></data><data name="ViveTool_GitHub"><value>ಗಿಟ್‌ಹಬ್</value></data><data name="ViveTool_BinaryPathTitle"><value>ViVeTool ಬಿನಾರಿ ಮಾರ್ಗ</value></data></root>