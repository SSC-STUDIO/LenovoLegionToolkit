<UserControl x:Class="UniversalDeviceToolkit.Plugins.CustomMouse.CustomMouseSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="clr-namespace:UniversalDeviceToolkit.Plugins.CustomMouse"
             xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="720"
             AutomationProperties.AutomationId="CustomMouseSettingsRoot">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UniversalDeviceToolkit.Plugins.Shared;component/DesignTokens.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UniversalDeviceToolkit.Plugins.Shared;component/PluginUiStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Compact single-column layout: matches host Settings cards (flat, minimal nesting). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,12">

            <!-- Kept for code-behind status glyph updates (compact: no hero banner). -->
            <wpfui:SymbolIcon x:Name="_statusIcon"
                              Symbol="CheckmarkCircle24"
                              Width="0"
                              Height="0"
                              Visibility="Collapsed" />

            <TextBlock Text="{x:Static text:CustomMouseText.SettingsOverviewTitle}"
                       FontSize="{StaticResource PluginFontSizeSection}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Margin="0,4,0,12"
                       Text="{x:Static text:CustomMouseText.WindowsSettingsDescription}"
                       FontSize="{StaticResource PluginFontSizeCaption}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{x:Static text:CustomMouseText.PointerPreviewLabel}"
                               FontSize="{StaticResource PluginFontSizeSmall}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="_pointerPreviewValueTextBlock"
                               AutomationProperties.AutomationId="CustomMousePointerPreviewText"
                               Margin="0,2,0,0"
                               FontSize="{StaticResource PluginFontSizeLabel}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{x:Static text:CustomMouseText.ButtonLayoutLabel}"
                               FontSize="{StaticResource PluginFontSizeSmall}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="_buttonLayoutValueTextBlock"
                               AutomationProperties.AutomationId="CustomMouseButtonLayoutText"
                               Margin="0,2,0,0"
                               FontSize="{StaticResource PluginFontSizeLabel}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="{x:Static text:CustomMouseText.CursorThemeStatusLabel}"
                               FontSize="{StaticResource PluginFontSizeSmall}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="_cursorThemeValueTextBlock"
                               AutomationProperties.AutomationId="CustomMouseCursorThemeText"
                               Margin="0,2,0,0"
                               FontSize="{StaticResource PluginFontSizeLabel}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Grid>

            <Separator Margin="0,0,0,12" />

            <TextBlock Text="{x:Static text:CustomMouseText.WindowsSettingsTitle}"
                       FontSize="{StaticResource PluginFontSizeLabel}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static text:CustomMouseText.PointerSpeedLabel}"
                           FontSize="{StaticResource PluginFontSizeCaption}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="_pointerSpeedValueLabel"
                           Grid.Column="1"
                           MinWidth="40"
                           TextAlignment="Right"
                           FontSize="{StaticResource PluginFontSizeLabel}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Grid>
            <Slider x:Name="_pointerSpeedSlider"
                    AutomationProperties.AutomationId="PointerSpeedSlider"
                    Margin="0,6,0,8"
                    Minimum="1"
                    Maximum="20"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    ValueChanged="SettingsInputChanged" />
            <CheckBox x:Name="_swapButtonsCheckBox"
                      AutomationProperties.AutomationId="SwapButtonsCheckBox"
                      Margin="0,0,0,14"
                      Content="{x:Static text:CustomMouseText.SwapButtonsLabel}"
                      Checked="SettingsInputChanged"
                      Unchecked="SettingsInputChanged" />

            <TextBlock Text="{x:Static text:CustomMouseText.CursorThemeModeLabel}"
                       FontSize="{StaticResource PluginFontSizeLabel}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Margin="0,4,0,8"
                       Text="{x:Static text:CustomMouseText.CursorHint}"
                       FontSize="{StaticResource PluginFontSizeCaption}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ComboBox x:Name="_cursorThemeModeComboBox"
                      AutomationProperties.AutomationId="CursorThemeModeComboBox"
                      Margin="0,0,0,10"
                      MinHeight="32"
                      MinWidth="180"
                      SelectionChanged="CursorThemeModeComboBox_SelectionChanged">
                <ComboBoxItem Content="{x:Static text:CustomMouseText.CursorThemeModeAuto}" Tag="Auto" />
                <ComboBoxItem Content="{x:Static text:CustomMouseText.CursorThemeModeLight}" Tag="Light" />
                <ComboBoxItem Content="{x:Static text:CustomMouseText.CursorThemeModeDark}" Tag="Dark" />
                <ComboBoxItem Content="{x:Static text:CustomMouseText.CursorThemeModeWindowsDefault}" Tag="WindowsDefault" />
            </ComboBox>
            <WrapPanel Margin="0,0,0,14">
                <wpfui:Button Content="{x:Static text:CustomMouseText.ApplyCursorThemeNowButton}"
                              AutomationProperties.AutomationId="ApplyCursorThemeNowButton"
                              Margin="0,0,8,8"
                              Icon="PaintBrush24"
                              Padding="10,6"
                              Click="ApplyCursorThemeNowButton_Click" />
                <wpfui:Button Content="{x:Static text:CustomMouseText.RestoreWindowsDefaultButton}"
                              AutomationProperties.AutomationId="RestoreWindowsDefaultButton"
                              Margin="0,0,8,8"
                              Icon="ArrowUndo24"
                              Padding="10,6"
                              Click="RestoreWindowsDefaultButton_Click" />
            </WrapPanel>

            <Separator Margin="0,0,0,10" />

            <StackPanel Margin="0,0,0,10"
                        Orientation="Horizontal">
                <wpfui:ProgressRing x:Name="_applyProgressRing"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    IsIndeterminate="True"
                                    Visibility="Collapsed" />
                <TextBlock x:Name="_statusTextBlock"
                           AutomationProperties.AutomationId="CustomMouse_StatusText"
                           FontSize="{StaticResource PluginFontSizeCaption}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <WrapPanel>
                <wpfui:Button Content="{x:Static text:CustomMouseText.SyncFromWindowsButton}"
                              AutomationProperties.AutomationId="SyncFromWindowsButton"
                              Icon="ArrowSync24"
                              Margin="0,0,8,8"
                              Padding="10,6"
                              Click="SyncFromWindowsButton_Click" />
                <wpfui:Button Content="{x:Static text:CustomMouseText.ReloadButton}"
                              AutomationProperties.AutomationId="ReloadButton"
                              Icon="ArrowClockwise24"
                              Margin="0,0,8,8"
                              Padding="10,6"
                              Click="ReloadButton_Click" />
                <wpfui:Button Content="{x:Static text:CustomMouseText.ApplyToWindowsButton}"
                              AutomationProperties.AutomationId="ApplyToWindowsButton"
                              Appearance="Primary"
                              Icon="Checkmark24"
                              Margin="0,0,8,8"
                              Padding="12,6"
                              Click="ApplyButton_Click" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
