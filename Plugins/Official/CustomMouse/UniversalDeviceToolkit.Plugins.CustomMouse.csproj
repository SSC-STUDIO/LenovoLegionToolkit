<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.0.18</Version>
    <FileVersion>1.0.18</FileVersion>
    <AssemblyVersion>1.0.18</AssemblyVersion>
    <AssemblyName>UniversalDeviceToolkit.Plugins.CustomMouse</AssemblyName>
  </PropertyGroup>

  <!-- Windows WPF flavor (default): net10.0-windows + UseWPF + win-x64. -->
  <PropertyGroup Condition="'$(UdtPluginAvaloniaOnly)' != 'true'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <!-- Portable Avalonia-only flavor: -p:UdtPluginAvaloniaOnly=true
       Produces a net10.0 (AnyCPU, no UseWPF / WPF-UI / Lib) build for the
       cross-platform Avalonia host. Output goes to a distinct folder so the
       two flavors never collide in the plugin load directory. -->
  <PropertyGroup Condition="'$(UdtPluginAvaloniaOnly)' == 'true'">
    <TargetFramework>net10.0</TargetFramework>
    <UseWPF>false</UseWPF>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(UdtPluginAvaloniaOnly)' != 'true'">
    <OutputPath>..\..\.build\plugins\UniversalDeviceToolkit.Plugins.CustomMouse\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' AND '$(UdtPluginAvaloniaOnly)' != 'true'">
    <OutputPath>..\..\.build\plugins\UniversalDeviceToolkit.Plugins.CustomMouse\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UdtPluginAvaloniaOnly)' == 'true'">
    <OutputPath>..\..\.build\plugins-avalonia\UniversalDeviceToolkit.Plugins.CustomMouse\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <!-- The portable flavor gets the portable Abstractions assembly (net10.0)
       instead of the host Lib that carries the same types for the WPF host.
       Registry types are part of the net10.0 shared framework; only
       Microsoft.Win32.SystemEvents needs the NuGet package. -->
  <ItemGroup Condition="'$(UdtPluginAvaloniaOnly)' == 'true'">
    <ProjectReference Include="..\..\SDK\Abstractions\UniversalDeviceToolkit.Plugins.Abstractions.csproj" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SDK\Runtime\UniversalDeviceToolkit.Plugins.SDK.csproj" />
    <ProjectReference Include="..\..\Shared.Core\UniversalDeviceToolkit.Plugins.Shared.Core.csproj" />
  </ItemGroup>

  <!-- The WPF shared library is only referenced by the WPF flavor; the
       portable flavor references Shared.Core exclusively. -->
  <ItemGroup Condition="'$(UdtPluginAvaloniaOnly)' != 'true'">
    <ProjectReference Include="..\..\Shared\UniversalDeviceToolkit.Plugins.Shared.csproj" />
  </ItemGroup>

  <!-- WPF UI surface is compiled out of the portable flavor. -->
  <PropertyGroup Condition="'$(UdtPluginAvaloniaOnly)' == 'true'">
    <DefaultItemExcludes>$(DefaultItemExcludes);CustomMouseSettingsControl.xaml;CustomMouseSettingsControl.xaml.cs</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\**\*" Exclude="Resources\*.resx;Resources\*.Designer.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Resource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resource.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Resource.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>UniversalDeviceToolkit.Plugins.CustomMouse.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
