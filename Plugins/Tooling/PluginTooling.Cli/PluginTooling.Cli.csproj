<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPluginToolProject>true</IsPluginToolProject>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PluginTooling.Core\PluginTooling.Core.csproj" />
  </ItemGroup>

  <Target Name="WriteRuntimeConfigFallback" AfterTargets="Build">
    <WriteLinesToFile
      File="$(OutputPath)$(AssemblyName).runtimeconfig.json"
      Overwrite="true"
      Lines='{
  "runtimeOptions": {
    "tfm": "net10.0",
    "framework": {
      "name": "Microsoft.NETCore.App",
      "version": "10.0.0"
    }
  }
}' />
  </Target>

</Project>
