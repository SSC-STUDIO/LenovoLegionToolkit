<Window x:Class="PluginWorkbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plugin Workbench"
        Width="1560"
        Height="980"
        MinWidth="1260"
        MinHeight="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        AutomationProperties.AutomationId="PluginWorkbenchMainWindow">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="18"
                CornerRadius="24"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0"
                            Grid.Column="0">
                    <TextBlock FontSize="28"
                               FontWeight="SemiBold"
                               Text="Plugin Workbench"
                               AutomationProperties.AutomationId="WorkbenchHeaderTextBlock" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Host-level preview for plugin authors. Preview mirrors the main app shell; Real Runtime is opt-in."
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="WorkbenchDescriptionTextBlock" />
                </StackPanel>

                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Border Margin="0,0,10,0"
                            Padding="12,6"
                            CornerRadius="999"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <TextBlock x:Name="ThemeStateTextBlock"
                                   FontWeight="SemiBold"
                                   Text="Theme: System"
                                   AutomationProperties.AutomationId="ThemeStateTextBlock" />
                    </Border>
                    <Border Padding="12,6"
                            CornerRadius="999"
                            Background="{DynamicResource SystemAccentColorLight3Brush}">
                        <TextBlock x:Name="ModeStateTextBlock"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemAccentColorDark1Brush}"
                                   Text="Preview"
                                   AutomationProperties.AutomationId="ModeStateTextBlock" />
                    </Border>
                </StackPanel>

                <Grid Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="RepositoryPathTextBox"
                             Grid.Column="0"
                             Margin="0,0,12,0"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             AutomationProperties.AutomationId="RepositoryPathTextBox" />
                    <Button x:Name="RefreshButton"
                            Grid.Column="1"
                            Margin="0,0,10,0"
                            Padding="16,6"
                            Click="RefreshButton_Click"
                            Content="Refresh"
                            AutomationProperties.AutomationId="RefreshButton" />
                    <Button x:Name="BootstrapHostButton"
                            Grid.Column="2"
                            Margin="0,0,10,0"
                            Padding="16,6"
                            Click="BootstrapHostButton_Click"
                            Content="Bootstrap Host"
                            AutomationProperties.AutomationId="BootstrapHostButton" />
                    <Button x:Name="OpenZipButton"
                            Grid.Column="3"
                            Margin="0,0,10,0"
                            Padding="16,6"
                            Click="OpenZipButton_Click"
                            Content="Open ZIP"
                            AutomationProperties.AutomationId="OpenZipButton" />
                    <ComboBox x:Name="ThemeComboBox"
                              Grid.Column="4"
                              Width="130"
                              Margin="0,0,10,0"
                              SelectionChanged="ThemeComboBox_SelectionChanged"
                              AutomationProperties.AutomationId="ThemeComboBox">
                        <ComboBoxItem Content="System" Tag="System" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                    <ComboBox x:Name="ModeComboBox"
                              Grid.Column="5"
                              Width="150"
                              Margin="0,0,10,0"
                              SelectionChanged="ModeComboBox_SelectionChanged"
                              AutomationProperties.AutomationId="ModeComboBox">
                        <ComboBoxItem Content="Preview" Tag="Preview" />
                        <ComboBoxItem Content="Real Runtime" Tag="RealRuntime" />
                    </ComboBox>
                    <Button x:Name="ModeToggleButton"
                            Grid.Column="6"
                            Margin="0,0,10,0"
                            Padding="16,6"
                            Click="ModeToggleButton_Click"
                            Content="Enable Real Runtime"
                            AutomationProperties.AutomationId="ModeToggleButton" />
                    <Button x:Name="ReloadCurrentButton"
                            Grid.Column="7"
                            Padding="16,6"
                            Click="ReloadCurrentButton_Click"
                            Content="Reload Current"
                            AutomationProperties.AutomationId="ReloadCurrentButton" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="HostResourceWarningBorder"
                Grid.Row="1"
                Margin="0,14,0,14"
                Padding="14"
                CornerRadius="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                BorderThickness="1"
                Visibility="Collapsed">
            <TextBlock x:Name="HostResourceWarningTextBlock"
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="HostResourceWarningTextBlock" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="16"
                    CornerRadius="24"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Left"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="Plugins"
                                   AutomationProperties.AutomationId="PluginListHeaderTextBlock" />
                        <Button x:Name="LoadSelectedButton"
                                DockPanel.Dock="Right"
                                Padding="16,6"
                                Click="LoadSelectedButton_Click"
                                Content="Load Selected"
                                AutomationProperties.AutomationId="LoadSelectedButton" />
                    </DockPanel>

                    <ListBox x:Name="PluginListBox"
                             Grid.Row="1"
                             DisplayMemberPath="DisplayText"
                             Background="Transparent"
                             BorderThickness="0"
                             MouseDoubleClick="PluginListBox_MouseDoubleClick"
                             AutomationProperties.AutomationId="PluginListBox" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="18"
                    CornerRadius="28"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="PluginTitleTextBlock"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Text="No plugin loaded"
                                   AutomationProperties.AutomationId="PluginTitleTextBlock" />
                        <TextBlock x:Name="PluginSubtitleTextBlock"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Select a built plugin from the left or open a ZIP package."
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="PluginSubtitleTextBlock" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="0,16,0,16"
                            Padding="14"
                            CornerRadius="18"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                            BorderThickness="1">
                        <TextBlock x:Name="StatusTextBlock"
                                   Text="Idle"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="StatusTextBlock" />
                    </Border>

                    <TabControl x:Name="MainTabControl"
                                Grid.Row="2"
                                AutomationProperties.AutomationId="MainTabControl">
                        <TabItem x:Name="FeatureTabItem"
                                 Header="Feature Preview"
                                 AutomationProperties.AutomationId="FeatureTabItem">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border x:Name="FeaturePreviewHintBorder"
                                        Padding="14"
                                        CornerRadius="18"
                                        Background="{DynamicResource SystemAccentColorLight3Brush}"
                                        BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        BorderThickness="1"
                                        Visibility="Collapsed">
                                    <TextBlock Text="Preview mode keeps feature UI safe and non-destructive. Switch to Real Runtime to interact with live actions."
                                               TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="FeaturePreviewHintTextBlock" />
                                </Border>

                                <ScrollViewer Grid.Row="1"
                                              Margin="0,14,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock Text="Feature Host"
                                                   Style="{DynamicResource AppSectionTitleTextBlockStyle}" />
                                        <Border Margin="0,12,0,0"
                                                Padding="20"
                                                CornerRadius="24"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <ContentControl x:Name="FeatureContentHost"
                                                            AutomationProperties.AutomationId="FeatureContentHost" />
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="SettingsTabItem"
                                 Header="Settings Preview"
                                 AutomationProperties.AutomationId="SettingsTabItem">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border x:Name="SettingsPreviewHintBorder"
                                        Padding="14"
                                        CornerRadius="18"
                                        Background="{DynamicResource SystemAccentColorLight3Brush}"
                                        BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        BorderThickness="1"
                                        Visibility="Collapsed">
                                    <TextBlock Text="Settings preview uses the same host shell structure as the main app. Real Runtime unlocks live interactions."
                                               TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="SettingsPreviewHintTextBlock" />
                                </Border>

                                <ScrollViewer Grid.Row="1"
                                              Margin="0,14,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <Border Padding="24"
                                                CornerRadius="24"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock x:Name="SettingsShellTitleTextBlock"
                                                           Style="{DynamicResource AppPageTitleTextBlockStyle}"
                                                           Text="Plugin Settings"
                                                           AutomationProperties.AutomationId="SettingsShellTitleTextBlock" />
                                                <TextBlock x:Name="SettingsShellDescriptionTextBlock"
                                                           Margin="0,10,0,0"
                                                           Style="{DynamicResource AppPageDescriptionTextBlockStyle}"
                                                           Text="Host shell preview for plugin settings."
                                                           AutomationProperties.AutomationId="SettingsShellDescriptionTextBlock" />
                                            </StackPanel>
                                        </Border>

                                        <Border Margin="0,18,0,0"
                                                Padding="20"
                                                CornerRadius="24"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Settings"
                                                           Style="{DynamicResource AppSectionTitleTextBlockStyle}" />
                                                <Border Margin="0,16,0,0"
                                                        Padding="18"
                                                        CornerRadius="20"
                                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                    <ContentControl x:Name="SettingsContentHost"
                                                                    AutomationProperties.AutomationId="SettingsContentHost" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="OptimizationTabItem"
                                 Header="Optimization Preview"
                                 AutomationProperties.AutomationId="OptimizationTabItem">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border x:Name="OptimizationPreviewHintBorder"
                                        Padding="14"
                                        CornerRadius="18"
                                        Background="{DynamicResource SystemAccentColorLight3Brush}"
                                        BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        BorderThickness="1"
                                        Visibility="Collapsed">
                                    <TextBlock Text="Optimization actions stay disabled in Preview mode. Real Runtime enables execution and keeps a confirmation step."
                                               TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="OptimizationPreviewHintTextBlock" />
                                </Border>

                                <ListBox x:Name="OptimizationListBox"
                                         Grid.Row="1"
                                         Margin="0,14,0,0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         AutomationProperties.AutomationId="OptimizationListBox">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10"
                                                    Padding="18"
                                                    CornerRadius="22"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Text="{Binding Title}" />
                                                        <TextBlock Margin="0,8,0,0"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding Description}" />
                                                        <TextBlock Margin="0,12,0,0"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                                   Text="{Binding AppliedState}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Margin="16,0,0,0"
                                                            Padding="16,6"
                                                            IsEnabled="{Binding CanExecute}"
                                                            Click="RunOptimizationActionButton_Click"
                                                            Content="Run"
                                                            AutomationProperties.AutomationId="OptimizationRunButton"
                                                            Tag="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <Border Grid.Column="4"
                    Padding="16"
                    CornerRadius="24"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="Host Context"
                                   AutomationProperties.AutomationId="HostContextHeaderTextBlock" />

                        <TextBlock Margin="0,14,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Current source" />
                        <TextBlock x:Name="CurrentSourceTextBlock"
                                   FontWeight="SemiBold"
                                   Text="None"
                                   AutomationProperties.AutomationId="CurrentSourceTextBlock" />

                        <TextBlock Margin="0,14,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Theme" />
                        <TextBlock x:Name="ThemeDetailTextBlock"
                                   FontWeight="SemiBold"
                                   Text="System"
                                   AutomationProperties.AutomationId="ThemeDetailTextBlock" />

                        <TextBlock Margin="0,14,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Host resources" />
                        <TextBlock x:Name="ResourceStateTextBlock"
                                   FontWeight="SemiBold"
                                   Text="Pending"
                                   AutomationProperties.AutomationId="ResourceStateTextBlock" />

                        <Separator Margin="0,18,0,18" />

                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="Plugin Metadata" />

                        <TextBlock Margin="0,14,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Plugin id" />
                        <TextBlock x:Name="PluginIdTextBlock"
                                   FontWeight="SemiBold"
                                   Text="-" />

                        <TextBlock Margin="0,14,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Version" />
                        <TextBlock x:Name="PluginVersionTextBlock"
                                   FontWeight="SemiBold"
                                   Text="-" />

                        <TextBlock Margin="0,14,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Minimum LLT" />
                        <TextBlock x:Name="PluginMinVersionTextBlock"
                                   FontWeight="SemiBold"
                                   Text="-" />

                        <TextBlock Margin="0,14,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Optimization mode" />
                        <TextBlock x:Name="OptimizationStateTextBlock"
                                   FontWeight="SemiBold"
                                   Text="Not available"
                                   AutomationProperties.AutomationId="OptimizationStateTextBlock" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Expander x:Name="LogExpander"
                  Grid.Row="3"
                  Margin="0,16,0,0"
                  Padding="14"
                  Header="Logs"
                  IsExpanded="True"
                  AutomationProperties.AutomationId="LogExpander">
            <Border Padding="12"
                    CornerRadius="20"
                    Background="#111827">
                <TextBox x:Name="LogTextBox"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="12"
                         Foreground="#F9FAFB"
                         Background="Transparent"
                         BorderThickness="0"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         AutomationProperties.AutomationId="LogTextBox" />
            </Border>
        </Expander>
    </Grid>
</Window>
