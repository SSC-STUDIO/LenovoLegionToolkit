<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPluginToolProject>true</IsPluginToolProject>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\UniversalDeviceToolkit.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PluginTooling.Core\PluginTooling.Core.csproj" />
    <ProjectReference Include="..\..\SDK\UniversalDeviceToolkit.Plugins.SDK.csproj" />
    <ProjectReference Include="..\..\Plugins\Shared\UniversalDeviceToolkit.Plugins.Shared.csproj" />
   <Reference Include="UniversalDeviceToolkit.Lib">
     <HintPath>$(HostLibPath)</HintPath>
     <Private>true</Private>
   </Reference>
    <Reference Include="UniversalDeviceToolkit.Lib.Plugins">
      <HintPath>$(HostLibPluginsPath)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UniversalDeviceToolkit.Plugins.Abstractions">
      <HintPath>$(HostAbstractionsPath)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Universal Device Toolkit">
      <HintPath>$(HostWpfPath)</HintPath>
      <Private>true</Private>
    </Reference>
   <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\UniversalDeviceToolkit.ico" />
  </ItemGroup>

</Project>
