<Window x:Class="PluginWorkbench.HostedPluginContentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plugin Dialog"
        Height="760"
        Width="1160"
        MinHeight="420"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        AutomationProperties.AutomationId="HostedPluginContentWindow">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="20"
                CornerRadius="20"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <TextBlock x:Name="DialogTitleTextBlock"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Text="Plugin Dialog"
                       AutomationProperties.AutomationId="HostedDialogTitleTextBlock" />
        </Border>

        <Border Grid.Row="1"
                Margin="0,16,0,16"
                Padding="20"
                CornerRadius="20"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="ContentHost" />
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2">
            <Button Padding="16,6"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Click="CloseButton_Click"
                    Content="Close"
                    AutomationProperties.AutomationId="HostedDialogCloseButton" />
        </DockPanel>
    </Grid>
</Window>
