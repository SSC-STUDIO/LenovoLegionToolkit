<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <AssemblyName>UniversalDeviceToolkit.Plugins.SDK</AssemblyName>
    <RootNamespace>UniversalDeviceToolkit.Plugins.SDK</RootNamespace>
    <Copyright>© 2025-2026 SSC-STUDIO</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <!-- SDK is only needed during compilation, not as a standalone output -->
  <PropertyGroup>
    <OutputPath>..\..\.build\sdk\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\PluginBase.cs" Link="PluginBase.cs" />
    <Compile Include="..\PluginAttribute.cs" Link="PluginAttribute.cs" />
    <ProjectReference Include="..\..\Shared\UniversalDeviceToolkit.Plugins.Shared.csproj" />
    <Reference Include="UniversalDeviceToolkit.Lib">
      <HintPath>$(HostLibPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Exclude all unwanted files from output -->
  <ItemGroup>
    <None Remove="**\*.resources.dll" />
    <None Remove="UniversalDeviceToolkit.Lib.dll" />
    <None Remove="UniversalDeviceToolkit.Plugins.Abstractions.dll" />
  </ItemGroup>

  <Target Name="CleanUnwantedFiles" AfterTargets="Build">
    <RemoveDir Directories="$(OutputPath)\ar;$(OutputPath)\bg;$(OutputPath)\bs;$(OutputPath)\ca;$(OutputPath)\cs;$(OutputPath)\de;$(OutputPath)\el;$(OutputPath)\es;$(OutputPath)\fr;$(OutputPath)\hu;$(OutputPath)\it;$(OutputPath)\ja;$(OutputPath)\ko;$(OutputPath)\lv;$(OutputPath)\nl-nl;$(OutputPath)\pl;$(OutputPath)\pt;$(OutputPath)\pt-br;$(OutputPath)\ro;$(OutputPath)\ru;$(OutputPath)\sk;$(OutputPath)\tr;$(OutputPath)\uk;$(OutputPath)\uz-latn-uz;$(OutputPath)\vi;$(OutputPath)\zh-hans;$(OutputPath)\zh-hant" />
    <Delete Files="$(OutputPath)\UniversalDeviceToolkit.Lib.dll" />
    <Delete Files="$(OutputPath)\UniversalDeviceToolkit.Plugins.Abstractions.dll" />
  </Target>

</Project>
