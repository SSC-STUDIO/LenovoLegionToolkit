<UserControl x:Class="LenovoLegionToolkit.Plugins.ShellIntegration.ShellIntegrationSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="clr-namespace:LenovoLegionToolkit.Plugins.ShellIntegration"
             xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="920"
             AutomationProperties.AutomationId="ShellIntegrationSettingsRoot">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0">

            <!-- Hero Status Banner -->
            <Border Margin="0,0,0,20"
                    Padding="16,14"
                    CornerRadius="10"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="40" Height="40"
                            CornerRadius="8"
                            Margin="0,0,16,0"
                            Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                        <wpfui:SymbolIcon Symbol="Folder24"
                                          FontSize="20"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="White" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="{x:Static text:ShellIntegrationText.RegistrationLabel}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_registrationValueTextBlock"
                                           AutomationProperties.AutomationId="ShellIntegrationRegistrationText"
                                           Margin="6,0,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="{x:Static text:ShellIntegrationText.VersionLabel}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_versionValueTextBlock"
                                           AutomationProperties.AutomationId="ShellIntegrationVersionText"
                                           Margin="6,0,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <TextBlock Text="{x:Static text:ShellIntegrationText.ConfigLabel}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_configValueTextBlock"
                                           AutomationProperties.AutomationId="ShellIntegrationConfigText"
                                           Margin="6,0,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="200"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <wpfui:SymbolIcon x:Name="_statusIcon"
                                      Grid.Column="2"
                                      Symbol="CheckmarkCircle24"
                                      FontSize="18"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                </Grid>
            </Border>

            <!-- Main Content Cards -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Card: Actions -->
                <Border Grid.Column="0"
                        Padding="18,16"
                        CornerRadius="10"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <wpfui:SymbolIcon Symbol="Rocket24"
                                              FontSize="18"
                                              Margin="0,0,10,0"
                                              Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <TextBlock Text="{x:Static text:ShellIntegrationText.ActionsTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <TextBlock Margin="0,0,0,18"
                                   Text="{x:Static text:ShellIntegrationText.ActionsDescription}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <wpfui:Button x:Name="_enableButton"
                                      Content="{x:Static text:ShellIntegrationText.EnableButton}"
                                      AutomationProperties.AutomationId="EnableButton"
                                      HorizontalAlignment="Stretch"
                                      Appearance="Primary"
                                      Icon="Checkmark24"
                                      Margin="0,0,0,8"
                                      Click="EnableButton_Click" />
                        <wpfui:Button x:Name="_disableButton"
                                      Content="{x:Static text:ShellIntegrationText.DisableButton}"
                                      AutomationProperties.AutomationId="DisableButton"
                                      HorizontalAlignment="Stretch"
                                      Icon="Dismiss24"
                                      Margin="0,0,0,8"
                                      Click="DisableButton_Click" />
                        <wpfui:Button x:Name="_openStyleSettingsButton"
                                      Content="{x:Static text:ShellIntegrationText.OpenStyleSettingsButton}"
                                      AutomationProperties.AutomationId="OpenStyleSettingsButton"
                                      HorizontalAlignment="Stretch"
                                      Icon="PaintBrush24"
                                      Click="OpenStyleButton_Click" />
                    </StackPanel>
                </Border>

                <!-- Right Card: Info & Quick Access -->
                <Border Grid.Column="2"
                        Padding="18,16"
                        CornerRadius="10"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <wpfui:SymbolIcon Symbol="Info24"
                                              FontSize="18"
                                              Margin="0,0,10,0"
                                              Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <TextBlock Text="{x:Static text:ShellIntegrationText.PathLabel}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <TextBlock x:Name="_pathValueTextBlock"
                                   AutomationProperties.AutomationId="ShellIntegrationPathText"
                                   Margin="0,0,0,16"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="{x:Static text:ShellIntegrationText.OptimizationHint}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,0,0,18"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                        <wpfui:Button x:Name="_openShellFolderButton"
                                      Content="{x:Static text:ShellIntegrationText.OpenShellFolderButton}"
                                      AutomationProperties.AutomationId="OpenShellFolderButton"
                                      HorizontalAlignment="Stretch"
                                      Icon="FolderOpen24"
                                      Margin="0,0,0,8"
                                      Click="OpenShellFolderButton_Click" />
                        <wpfui:Button x:Name="_openConfigButton"
                                      Content="{x:Static text:ShellIntegrationText.OpenConfigButton}"
                                      AutomationProperties.AutomationId="OpenConfigButton"
                                      HorizontalAlignment="Stretch"
                                      Icon="Document24"
                                      Click="OpenConfigButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Status Bar -->
            <Border Padding="16,12"
                    CornerRadius="10"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <TextBlock x:Name="_statusTextBlock"
                           AutomationProperties.AutomationId="ShellIntegration_StatusText"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
