<UserControl x:Class="LenovoLegionToolkit.Plugins.ShellIntegration.ShellIntegrationSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="clr-namespace:LenovoLegionToolkit.Plugins.ShellIntegration"
             xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="720"
             AutomationProperties.AutomationId="ShellIntegrationSettingsRoot">

    <!-- Compact single-column layout: no dual cards / hero banners. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,12">

            <wpfui:SymbolIcon x:Name="_statusIcon"
                              Symbol="CheckmarkCircle24"
                              FontSize="1"
                              Width="0"
                              Height="0"
                              Visibility="Collapsed" />

            <TextBlock Text="{x:Static text:ShellIntegrationText.ActionsTitle}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Margin="0,4,0,10"
                       Text="{x:Static text:ShellIntegrationText.ActionsDescription}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <WrapPanel Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                    <TextBlock Text="{x:Static text:ShellIntegrationText.RegistrationLabel}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="_registrationValueTextBlock"
                               AutomationProperties.AutomationId="ShellIntegrationRegistrationText"
                               Margin="6,0,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                    <TextBlock Text="{x:Static text:ShellIntegrationText.VersionLabel}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="_versionValueTextBlock"
                               AutomationProperties.AutomationId="ShellIntegrationVersionText"
                               Margin="6,0,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="{x:Static text:ShellIntegrationText.ConfigLabel}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="_configValueTextBlock"
                               AutomationProperties.AutomationId="ShellIntegrationConfigText"
                               Margin="6,0,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="280"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </WrapPanel>

            <WrapPanel Margin="0,0,0,14">
                <wpfui:Button x:Name="_enableButton"
                              Content="{x:Static text:ShellIntegrationText.EnableButton}"
                              AutomationProperties.AutomationId="EnableButton"
                              Appearance="Primary"
                              Icon="Checkmark24"
                              Margin="0,0,8,8"
                              Padding="10,6"
                              Click="EnableButton_Click" />
                <wpfui:Button x:Name="_disableButton"
                              Content="{x:Static text:ShellIntegrationText.DisableButton}"
                              AutomationProperties.AutomationId="DisableButton"
                              Icon="Dismiss24"
                              Margin="0,0,8,8"
                              Padding="10,6"
                              Click="DisableButton_Click" />
                <wpfui:Button x:Name="_openStyleSettingsButton"
                              Content="{x:Static text:ShellIntegrationText.OpenStyleSettingsButton}"
                              AutomationProperties.AutomationId="OpenStyleSettingsButton"
                              Icon="PaintBrush24"
                              Margin="0,0,8,8"
                              Padding="10,6"
                              Click="OpenStyleButton_Click" />
                <wpfui:Button x:Name="_syncManagedConfigButton"
                              Content="{x:Static text:ShellIntegrationText.SyncManagedConfigButton}"
                              AutomationProperties.AutomationId="SyncManagedConfigButton"
                              Icon="ArrowClockwise24"
                              Margin="0,0,8,8"
                              Padding="10,6"
                              Click="SyncManagedConfigButton_Click" />
                <wpfui:Button x:Name="_resetManagedConfigButton"
                              Content="{x:Static text:ShellIntegrationText.ResetManagedConfigButton}"
                              AutomationProperties.AutomationId="ResetManagedConfigButton"
                              Margin="0,0,8,8"
                              Padding="10,6"
                              Click="ResetManagedConfigButton_Click" />
                <wpfui:Button x:Name="_exportProfileButton"
                              Content="{x:Static text:ShellIntegrationText.ExportProfileButton}"
                              AutomationProperties.AutomationId="ExportProfileButton"
                              Icon="ArrowExport24"
                              Margin="0,0,8,8"
                              Padding="10,6"
                              Click="ExportProfileButton_Click" />
                <wpfui:Button x:Name="_importProfileButton"
                              Content="{x:Static text:ShellIntegrationText.ImportProfileButton}"
                              AutomationProperties.AutomationId="ImportProfileButton"
                              Icon="ArrowImport24"
                              Margin="0,0,8,8"
                              Padding="10,6"
                              Click="ImportProfileButton_Click" />
            </WrapPanel>

            <Separator Margin="0,0,0,12" />

            <TextBlock Text="{x:Static text:ShellIntegrationText.PathLabel}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="_pathValueTextBlock"
                       AutomationProperties.AutomationId="ShellIntegrationPathText"
                       Margin="0,4,0,8"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{x:Static text:ShellIntegrationText.OptimizationHint}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Margin="0,0,0,10"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <WrapPanel Margin="0,0,0,14">
                <wpfui:Button x:Name="_openShellFolderButton"
                              Content="{x:Static text:ShellIntegrationText.OpenShellFolderButton}"
                              AutomationProperties.AutomationId="OpenShellFolderButton"
                              Icon="FolderOpen24"
                              Margin="0,0,8,8"
                              Padding="10,6"
                              Click="OpenShellFolderButton_Click" />
                <wpfui:Button x:Name="_openConfigButton"
                              Content="{x:Static text:ShellIntegrationText.OpenConfigButton}"
                              AutomationProperties.AutomationId="OpenConfigButton"
                              Icon="Document24"
                              Margin="0,0,8,8"
                              Padding="10,6"
                              Click="OpenConfigButton_Click" />
                <wpfui:Button x:Name="_openManagedConfigButton"
                              Content="{x:Static text:ShellIntegrationText.OpenManagedConfigButton}"
                              AutomationProperties.AutomationId="OpenManagedConfigButton"
                              Icon="FolderOpen24"
                              Margin="0,0,8,8"
                              Padding="10,6"
                              Click="OpenManagedConfigButton_Click" />
            </WrapPanel>

            <TextBlock Text="{x:Static text:ShellIntegrationText.PresetsTitle}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="{x:Static text:ShellIntegrationText.PresetsDescription}"
                       Margin="0,4,0,8"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <WrapPanel Margin="0,0,0,12">
                <wpfui:Button x:Name="_applyDefaultPresetButton"
                              Content="{x:Static text:ShellIntegrationText.PresetDefaultButton}"
                              AutomationProperties.AutomationId="ApplyDefaultPresetButton"
                              Icon="ArrowClockwise24"
                              Margin="0,0,8,8"
                              Padding="10,6"
                              Click="ApplyDefaultPresetButton_Click" />
                <wpfui:Button x:Name="_applyCompactDarkPresetButton"
                              Content="{x:Static text:ShellIntegrationText.PresetCompactDarkButton}"
                              AutomationProperties.AutomationId="ApplyCompactDarkPresetButton"
                              Icon="PaintBrush24"
                              Margin="0,0,8,8"
                              Padding="10,6"
                              Click="ApplyCompactDarkPresetButton_Click" />
                <wpfui:Button x:Name="_applyMinimalLightPresetButton"
                              Content="{x:Static text:ShellIntegrationText.PresetMinimalLightButton}"
                              AutomationProperties.AutomationId="ApplyMinimalLightPresetButton"
                              Icon="Document24"
                              Margin="0,0,8,8"
                              Padding="10,6"
                              Click="ApplyMinimalLightPresetButton_Click" />
            </WrapPanel>

            <TextBlock x:Name="_statusTextBlock"
                       AutomationProperties.AutomationId="ShellIntegration_StatusText"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
