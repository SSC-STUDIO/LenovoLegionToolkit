<UserControl x:Class="LenovoLegionToolkit.Plugins.ShellIntegration.ShellIntegrationSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="clr-namespace:LenovoLegionToolkit.Plugins.ShellIntegration"
             xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="860">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="0,0,0,16"
                    Padding="16"
                    CornerRadius="20"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Margin="0,0,0,14">
                        <TextBlock Margin="0,0,0,0"
                                   Text="{x:Static text:ShellIntegrationText.OverviewTitle}"
                                   Style="{StaticResource AppSectionTitleTextBlockStyle}" />

                        <TextBlock Margin="0,6,0,0"
                                   Text="{x:Static text:ShellIntegrationText.OverviewDescription}"
                                   Style="{StaticResource AppPageDescriptionTextBlockStyle}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            Padding="14"
                            CornerRadius="18"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="{x:Static text:ShellIntegrationText.RegistrationLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_registrationValueTextBlock"
                                       Margin="0,6,0,0"
                                       FontSize="18"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,10,0"
                            Padding="14"
                            CornerRadius="18"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="{x:Static text:ShellIntegrationText.VersionLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_versionValueTextBlock"
                                       Margin="0,6,0,0"
                                       FontSize="18"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="2"
                            Padding="14"
                            CornerRadius="18"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="{x:Static text:ShellIntegrationText.ConfigLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_configValueTextBlock"
                                       Margin="0,6,0,0"
                                       FontSize="16"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,8,0"
                        Padding="18"
                        CornerRadius="20"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{x:Static text:ShellIntegrationText.ActionsTitle}"
                                   Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{x:Static text:ShellIntegrationText.ActionsDescription}"
                                   Style="{StaticResource AppPageDescriptionTextBlockStyle}" />

                        <WrapPanel Margin="0,14,0,0">
                            <wpfui:Button x:Name="_enableButton"
                                          Content="{x:Static text:ShellIntegrationText.EnableButton}"
                                          AutomationProperties.AutomationId="EnableButton"
                                          Width="130"
                                          Appearance="Primary"
                                          Margin="0,0,10,10"
                                          Click="EnableButton_Click" />
                            <wpfui:Button x:Name="_disableButton"
                                          Content="{x:Static text:ShellIntegrationText.DisableButton}"
                                          AutomationProperties.AutomationId="DisableButton"
                                          Width="130"
                                          Margin="0,0,10,10"
                                          Click="DisableButton_Click" />
                            <wpfui:Button x:Name="_openStyleSettingsButton"
                                          Content="{x:Static text:ShellIntegrationText.OpenStyleSettingsButton}"
                                          AutomationProperties.AutomationId="OpenStyleSettingsButton"
                                          Margin="0,0,10,10"
                                          Padding="12,6"
                                          Click="OpenStyleButton_Click" />
                            <wpfui:Button x:Name="_openShellFolderButton"
                                          Content="{x:Static text:ShellIntegrationText.OpenShellFolderButton}"
                                          AutomationProperties.AutomationId="OpenShellFolderButton"
                                          Margin="0,0,10,10"
                                          Padding="12,6"
                                          Click="OpenShellFolderButton_Click" />
                            <wpfui:Button x:Name="_openConfigButton"
                                          Content="{x:Static text:ShellIntegrationText.OpenConfigButton}"
                                          AutomationProperties.AutomationId="OpenConfigButton"
                                          Margin="0,0,0,10"
                                          Padding="12,6"
                                          Click="OpenConfigButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="18"
                        CornerRadius="20"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{x:Static text:ShellIntegrationText.PathLabel}"
                                   Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                        <TextBlock x:Name="_pathValueTextBlock"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <Border Margin="0,18,0,0"
                                Padding="14"
                                CornerRadius="18"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Static text:ShellIntegrationText.OptimizationHint}"
                                       Style="{StaticResource AppPageDescriptionTextBlockStyle}" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Padding="16"
                    CornerRadius="20"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <wpfui:SymbolIcon x:Name="_statusIcon"
                                      Symbol="CheckmarkCircle24"
                                      FontSize="16"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Top"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="_statusTextBlock"
                               AutomationProperties.AutomationId="StatusText"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>

</UserControl>
