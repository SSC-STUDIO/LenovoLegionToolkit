<UserControl x:Class="LenovoLegionToolkit.Plugins.CustomMouse.CustomMouseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="clr-namespace:LenovoLegionToolkit.Plugins.CustomMouse"
             xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="680"
             d:DesignWidth="860">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="0,0,0,16"
                    Padding="24"
                    CornerRadius="22"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Margin="0,0,0,0"
                                   Text="{x:Static text:CustomMouseText.PageTitle}"
                                   Style="{StaticResource AppPageTitleTextBlockStyle}" />

                        <TextBlock Margin="0,10,0,0"
                                   Text="{x:Static text:CustomMouseText.LiveProfileDescription}"
                                   Style="{StaticResource AppPageDescriptionTextBlockStyle}" />
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,10,10"
                                Padding="14"
                                CornerRadius="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{x:Static text:CustomMouseText.ProfileStatusLabel}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_profileStatusValueTextBlock"
                                           Margin="0,8,0,0"
                                           FontSize="20"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,0,10"
                                Padding="14"
                                CornerRadius="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{x:Static text:CustomMouseText.CurrentDpiLabel}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_currentDpiValueTextBlock"
                                           Margin="0,8,0,0"
                                           FontSize="20"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Padding="14"
                                CornerRadius="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{x:Static text:CustomMouseText.CurrentPollingLabel}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_currentPollingValueTextBlock"
                                           Margin="0,8,0,0"
                                           FontSize="20"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,8,0"
                        Padding="20"
                        CornerRadius="20"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{x:Static text:CustomMouseText.FeatureSubtitle}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock Margin="0,18,0,6"
                                   Text="{x:Static text:CustomMouseText.DpiLabel}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="_dpiSlider"
                                    Grid.Column="0"
                                    Minimum="100"
                                    Maximum="16000"
                                    TickFrequency="100"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="InputChanged" />
                            <TextBlock x:Name="_dpiValueLabel"
                                       Grid.Column="1"
                                       MinWidth="60"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Grid>

                        <TextBlock Margin="0,18,0,6"
                                   Text="{x:Static text:CustomMouseText.PollingRateLabel}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ComboBox x:Name="_pollingRateComboBox"
                                  SelectionChanged="InputChanged">
                            <ComboBoxItem Content="125 Hz" Tag="125" />
                            <ComboBoxItem Content="250 Hz" Tag="250" />
                            <ComboBoxItem Content="500 Hz" Tag="500" />
                            <ComboBoxItem Content="1000 Hz" Tag="1000" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="20"
                        CornerRadius="20"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{x:Static text:CustomMouseText.QuickActionsTitle}"
                                   Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{x:Static text:CustomMouseText.QuickActionsDescription}"
                                   Style="{StaticResource AppPageDescriptionTextBlockStyle}" />

                        <WrapPanel Margin="0,18,0,0">
                            <wpfui:Button Content="{x:Static text:CustomMouseText.ApplyButton}"
                                          Width="110"
                                          Appearance="Primary"
                                          Margin="0,0,10,10"
                                          Click="ApplyButton_Click" />
                            <wpfui:Button Content="{x:Static text:CustomMouseText.ResetButton}"
                                          Width="110"
                                          Margin="0,0,0,10"
                                          Click="ResetButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Padding="18"
                    CornerRadius="20"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <wpfui:SymbolIcon x:Name="_statusIcon"
                                      Symbol="CheckmarkCircle24"
                                      FontSize="16"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Top"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="_statusTextBlock"
                               AutomationProperties.AutomationId="StatusText"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>

</UserControl>
