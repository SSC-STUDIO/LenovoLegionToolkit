<UserControl x:Class="LenovoLegionToolkit.Plugins.CustomMouse.CustomMouseSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="clr-namespace:LenovoLegionToolkit.Plugins.CustomMouse"
             xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="780"
             d:DesignWidth="920"
             AutomationProperties.AutomationId="CustomMouseSettingsRoot">

    <UserControl.Resources>
        <Style x:Key="CustomMouseSurfaceStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="CustomMouseSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="CustomMouseBodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="CustomMouseMetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="CustomMouseMetricValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">

            <Border Margin="0,0,0,14"
                    Padding="18,16"
                    Style="{StaticResource CustomMouseSurfaceStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="42"
                            Height="42"
                            CornerRadius="8"
                            Margin="0,0,16,0"
                            Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                        <wpfui:SymbolIcon Symbol="Cursor24"
                                          FontSize="21"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="White" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Static text:CustomMouseText.SettingsOverviewTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{x:Static text:CustomMouseText.WindowsSettingsDescription}"
                                   Style="{StaticResource CustomMouseBodyTextStyle}" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Padding="9,5"
                            Margin="18,0,0,0"
                            CornerRadius="8"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <StackPanel Orientation="Horizontal">
                            <wpfui:SymbolIcon x:Name="_statusIcon"
                                              Symbol="CheckmarkCircle24"
                                              FontSize="15"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="{x:Static text:CustomMouseText.ProfileReady}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="14,12"
                        Style="{StaticResource CustomMouseSurfaceStyle}">
                    <StackPanel>
                        <TextBlock Text="{x:Static text:CustomMouseText.PointerPreviewLabel}"
                                   Style="{StaticResource CustomMouseMetricLabelStyle}" />
                        <TextBlock x:Name="_pointerPreviewValueTextBlock"
                                   AutomationProperties.AutomationId="CustomMousePointerPreviewText"
                                   Style="{StaticResource CustomMouseMetricValueStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="14,12"
                        Style="{StaticResource CustomMouseSurfaceStyle}">
                    <StackPanel>
                        <TextBlock Text="{x:Static text:CustomMouseText.ButtonLayoutLabel}"
                                   Style="{StaticResource CustomMouseMetricLabelStyle}" />
                        <TextBlock x:Name="_buttonLayoutValueTextBlock"
                                   AutomationProperties.AutomationId="CustomMouseButtonLayoutText"
                                   Style="{StaticResource CustomMouseMetricValueStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Padding="14,12"
                        Style="{StaticResource CustomMouseSurfaceStyle}">
                    <StackPanel>
                        <TextBlock Text="{x:Static text:CustomMouseText.CursorThemeStatusLabel}"
                                   Style="{StaticResource CustomMouseMetricLabelStyle}" />
                        <TextBlock x:Name="_cursorThemeValueTextBlock"
                                   AutomationProperties.AutomationId="CustomMouseCursorThemeText"
                                   Style="{StaticResource CustomMouseMetricValueStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="18,16"
                        Style="{StaticResource CustomMouseSurfaceStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,14">
                            <wpfui:SymbolIcon Symbol="Cursor24"
                                              FontSize="18"
                                              Margin="0,0,10,0"
                                              Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <TextBlock Text="{x:Static text:CustomMouseText.WindowsSettingsTitle}"
                                       Style="{StaticResource CustomMouseSectionTitleStyle}" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static text:CustomMouseText.PointerSpeedLabel}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="_pointerSpeedValueLabel"
                                       Grid.Column="1"
                                       MinWidth="52"
                                       TextAlignment="Right"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Grid>

                        <Slider x:Name="_pointerSpeedSlider"
                                AutomationProperties.AutomationId="PointerSpeedSlider"
                                Margin="0,10,0,0"
                                Minimum="1"
                                Maximum="20"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="SettingsInputChanged" />

                        <Border Margin="0,18,0,0"
                                Padding="12,10"
                                CornerRadius="8"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <CheckBox x:Name="_swapButtonsCheckBox"
                                      AutomationProperties.AutomationId="SwapButtonsCheckBox"
                                      Content="{x:Static text:CustomMouseText.SwapButtonsLabel}"
                                      Checked="SettingsInputChanged"
                                      Unchecked="SettingsInputChanged" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="18,16"
                        Style="{StaticResource CustomMouseSurfaceStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,10">
                            <wpfui:SymbolIcon Symbol="PaintBrush24"
                                              FontSize="18"
                                              Margin="0,0,10,0"
                                              Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <TextBlock Text="{x:Static text:CustomMouseText.CursorThemeModeLabel}"
                                       Style="{StaticResource CustomMouseSectionTitleStyle}" />
                        </StackPanel>
                        <TextBlock Text="{x:Static text:CustomMouseText.CursorHint}"
                                   Style="{StaticResource CustomMouseBodyTextStyle}" />
                        <ComboBox x:Name="_cursorThemeModeComboBox"
                                  AutomationProperties.AutomationId="CursorThemeModeComboBox"
                                  Margin="0,14,0,0"
                                  MinHeight="36"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="CursorThemeModeComboBox_SelectionChanged">
                            <ComboBoxItem Content="{x:Static text:CustomMouseText.CursorThemeModeAuto}" Tag="Auto" />
                            <ComboBoxItem Content="{x:Static text:CustomMouseText.CursorThemeModeLight}" Tag="Light" />
                            <ComboBoxItem Content="{x:Static text:CustomMouseText.CursorThemeModeDark}" Tag="Dark" />
                            <ComboBoxItem Content="{x:Static text:CustomMouseText.CursorThemeModeWindowsDefault}" Tag="WindowsDefault" />
                        </ComboBox>

                        <WrapPanel Margin="0,14,0,0"
                                   HorizontalAlignment="Right">
                            <wpfui:Button Content="{x:Static text:CustomMouseText.ApplyCursorThemeNowButton}"
                                          AutomationProperties.AutomationId="ApplyCursorThemeNowButton"
                                          MinWidth="196"
                                          Margin="0,0,8,0"
                                          Icon="PaintBrush24"
                                          Padding="12,7"
                                          Click="ApplyCursorThemeNowButton_Click" />
                            <wpfui:Button Content="{x:Static text:CustomMouseText.RestoreWindowsDefaultButton}"
                                          AutomationProperties.AutomationId="RestoreWindowsDefaultButton"
                                          MinWidth="196"
                                          Icon="ArrowUndo24"
                                          Padding="12,7"
                                          Click="RestoreWindowsDefaultButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Padding="16,12"
                    Margin="0,0,0,16"
                    Style="{StaticResource CustomMouseSurfaceStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <wpfui:SymbolIcon Grid.Column="0"
                                      Symbol="Info24"
                                      FontSize="16"
                                      Margin="0,1,10,0"
                                      VerticalAlignment="Top"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="_statusTextBlock"
                               Grid.Column="1"
                               AutomationProperties.AutomationId="CustomMouse_StatusText"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <WrapPanel Grid.Column="2"
                               Margin="18,0,0,0"
                               HorizontalAlignment="Right">
                        <wpfui:Button Content="{x:Static text:CustomMouseText.SyncFromWindowsButton}"
                                      AutomationProperties.AutomationId="SyncFromWindowsButton"
                                      Icon="ArrowSync24"
                                      Margin="0,0,8,0"
                                      Padding="12,7"
                                      Click="SyncFromWindowsButton_Click" />
                        <wpfui:Button Content="{x:Static text:CustomMouseText.ReloadButton}"
                                      AutomationProperties.AutomationId="ReloadButton"
                                      Icon="ArrowClockwise24"
                                      Margin="0,0,8,0"
                                      Padding="12,7"
                                      Click="ReloadButton_Click" />
                        <wpfui:Button Content="{x:Static text:CustomMouseText.ApplyToWindowsButton}"
                                      AutomationProperties.AutomationId="ApplyToWindowsButton"
                                      Appearance="Primary"
                                      Icon="Checkmark24"
                                      Padding="14,7"
                                      Click="ApplyButton_Click" />
                    </WrapPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
