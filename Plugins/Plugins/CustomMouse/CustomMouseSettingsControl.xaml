<UserControl x:Class="LenovoLegionToolkit.Plugins.CustomMouse.CustomMouseSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="clr-namespace:LenovoLegionToolkit.Plugins.CustomMouse"
             xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="780"
             d:DesignWidth="920"
             AutomationProperties.AutomationId="CustomMouseSettingsRoot">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0">

            <!-- Hero Status Banner -->
            <Border Margin="0,0,0,20"
                    Padding="16,14"
                    CornerRadius="10"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="40" Height="40"
                            CornerRadius="8"
                            Margin="0,0,16,0"
                            Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                        <wpfui:SymbolIcon Symbol="Pen24"
                                          FontSize="20"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="White" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                <TextBlock Text="{x:Static text:CustomMouseText.PointerPreviewLabel}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_pointerPreviewValueTextBlock"
                                           AutomationProperties.AutomationId="CustomMousePointerPreviewText"
                                           Margin="6,0,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                <TextBlock Text="{x:Static text:CustomMouseText.ButtonLayoutLabel}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_buttonLayoutValueTextBlock"
                                           AutomationProperties.AutomationId="CustomMouseButtonLayoutText"
                                           Margin="6,0,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                <TextBlock Text="{x:Static text:CustomMouseText.CursorThemeStatusLabel}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_cursorThemeValueTextBlock"
                                           AutomationProperties.AutomationId="CustomMouseCursorThemeText"
                                           Margin="6,0,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>

                    <wpfui:SymbolIcon x:Name="_statusIcon"
                                      Grid.Column="2"
                                      Symbol="CheckmarkCircle24"
                                      FontSize="18"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                </Grid>
            </Border>

            <!-- Settings Cards -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Card: Pointer Settings -->
                <Border Grid.Column="0"
                        Padding="18,16"
                        CornerRadius="10"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <wpfui:SymbolIcon Symbol="Cursor24"
                                              FontSize="18"
                                              Margin="0,0,10,0"
                                              Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <TextBlock Text="{x:Static text:CustomMouseText.SettingsOverviewTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <TextBlock Margin="0,0,0,16"
                                   Text="{x:Static text:CustomMouseText.WindowsSettingsDescription}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="{x:Static text:CustomMouseText.PointerSpeedLabel}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="_pointerSpeedSlider"
                                    Grid.Column="0"
                                    AutomationProperties.AutomationId="PointerSpeedSlider"
                                    Minimum="1"
                                    Maximum="20"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SettingsInputChanged" />
                            <TextBlock x:Name="_pointerSpeedValueLabel"
                                       Grid.Column="1"
                                       MinWidth="46"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Grid>

                        <CheckBox x:Name="_swapButtonsCheckBox"
                                  AutomationProperties.AutomationId="SwapButtonsCheckBox"
                                  Content="{x:Static text:CustomMouseText.SwapButtonsLabel}"
                                  Margin="0,18,0,0"
                                  Checked="SettingsInputChanged"
                                  Unchecked="SettingsInputChanged" />
                    </StackPanel>
                </Border>

                <!-- Right Card: Cursor Theme -->
                <Border Grid.Column="2"
                        Padding="18,16"
                        CornerRadius="10"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <wpfui:SymbolIcon Symbol="PaintBrush24"
                                              FontSize="18"
                                              Margin="0,0,10,0"
                                              Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <TextBlock Text="{x:Static text:CustomMouseText.WindowsSettingsTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <TextBlock Margin="0,0,0,16"
                                   Text="{x:Static text:CustomMouseText.CursorHint}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="{x:Static text:CustomMouseText.CursorThemeModeLabel}"
                                   FontSize="13"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ComboBox x:Name="_cursorThemeModeComboBox"
                                  AutomationProperties.AutomationId="CursorThemeModeComboBox"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="CursorThemeModeComboBox_SelectionChanged">
                            <ComboBoxItem Content="{x:Static text:CustomMouseText.CursorThemeModeAuto}" Tag="Auto" />
                            <ComboBoxItem Content="{x:Static text:CustomMouseText.CursorThemeModeLight}" Tag="Light" />
                            <ComboBoxItem Content="{x:Static text:CustomMouseText.CursorThemeModeDark}" Tag="Dark" />
                            <ComboBoxItem Content="{x:Static text:CustomMouseText.CursorThemeModeWindowsDefault}" Tag="WindowsDefault" />
                        </ComboBox>

                        <wpfui:Button Content="{x:Static text:CustomMouseText.ApplyCursorThemeNowButton}"
                                      AutomationProperties.AutomationId="ApplyCursorThemeNowButton"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,16,0,0"
                                      Icon="PaintBrush24"
                                      Click="ApplyCursorThemeNowButton_Click" />
                        <wpfui:Button Content="{x:Static text:CustomMouseText.RestoreWindowsDefaultButton}"
                                      AutomationProperties.AutomationId="RestoreWindowsDefaultButton"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,8,0,0"
                                      Icon="ArrowUndo24"
                                      Click="RestoreWindowsDefaultButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Action Bar -->
            <Border Padding="16,12"
                    CornerRadius="10"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="_statusTextBlock"
                               Grid.Row="0"
                               AutomationProperties.AutomationId="CustomMouse_StatusText"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <WrapPanel Grid.Row="1"
                               HorizontalAlignment="Right">
                        <wpfui:Button Content="{x:Static text:CustomMouseText.SyncFromWindowsButton}"
                                      AutomationProperties.AutomationId="SyncFromWindowsButton"
                                      Icon="ArrowSync24"
                                      Margin="0,0,8,8"
                                      Padding="14,7"
                                      Click="SyncFromWindowsButton_Click" />
                        <wpfui:Button Content="{x:Static text:CustomMouseText.ReloadButton}"
                                      AutomationProperties.AutomationId="ReloadButton"
                                      Icon="ArrowClockwise24"
                                      Margin="0,0,8,8"
                                      Padding="14,7"
                                      Click="ReloadButton_Click" />
                        <wpfui:Button Content="{x:Static text:CustomMouseText.ApplyToWindowsButton}"
                                      AutomationProperties.AutomationId="ApplyToWindowsButton"
                                      Appearance="Primary"
                                      Icon="Checkmark24"
                                      Margin="0,0,0,8"
                                      Padding="14,7"
                                      Click="ApplyButton_Click" />
                    </WrapPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
