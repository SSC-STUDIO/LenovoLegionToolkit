<UserControl x:Class="LenovoLegionToolkit.Plugins.BatteryHealth.BatteryHealthControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="clr-namespace:LenovoLegionToolkit.Plugins.BatteryHealth"
             xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="960"
             AutomationProperties.AutomationId="BatteryHealthRoot">

    <UserControl.Resources>
        <Style x:Key="BatteryHealthSurfaceStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="BatteryHealthSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="BatteryHealthBodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="BatteryHealthMetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="BatteryHealthMetricValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">

            <!-- Hero / Overview card -->
            <Border Margin="0,0,0,14"
                    Padding="18,16"
                    Style="{StaticResource BatteryHealthSurfaceStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="42" Height="42"
                            CornerRadius="8"
                            Margin="0,0,16,0"
                            Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                        <wpfui:SymbolIcon Symbol="BatteryCharge24"
                                          FontSize="21"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Static text:BatteryHealthText.OverviewTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{x:Static text:BatteryHealthText.OverviewDescription}"
                                   Style="{StaticResource BatteryHealthBodyTextStyle}" />
                    </StackPanel>

                    <!-- Status pill -->
                    <Border Grid.Column="2"
                            Padding="9,5"
                            Margin="18,0,0,0"
                            CornerRadius="8"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <StackPanel Orientation="Horizontal">
                            <wpfui:SymbolIcon x:Name="_statusIcon"
                                              Symbol="CheckmarkCircle24"
                                              FontSize="15"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock x:Name="_statusPillText"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Metric cards: Health, Cycle Count, Charge Remaining, Wear -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="14,12"
                        Style="{StaticResource BatteryHealthSurfaceStyle}">
                    <StackPanel>
                        <TextBlock Text="{x:Static text:BatteryHealthText.HealthPercentLabel}"
                                   Style="{StaticResource BatteryHealthMetricLabelStyle}" />
                        <TextBlock x:Name="_healthValueTextBlock"
                                   AutomationProperties.AutomationId="BatteryHealth_HealthValue"
                                   Style="{StaticResource BatteryHealthMetricValueStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="14,12"
                        Style="{StaticResource BatteryHealthSurfaceStyle}">
                    <StackPanel>
                        <TextBlock Text="{x:Static text:BatteryHealthText.CycleCountLabel}"
                                   Style="{StaticResource BatteryHealthMetricLabelStyle}" />
                        <TextBlock x:Name="_cycleCountValueTextBlock"
                                   AutomationProperties.AutomationId="BatteryHealth_CycleCountValue"
                                   Style="{StaticResource BatteryHealthMetricValueStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Padding="14,12"
                        Style="{StaticResource BatteryHealthSurfaceStyle}">
                    <StackPanel>
                        <TextBlock Text="{x:Static text:BatteryHealthText.ChargeRemainingLabel}"
                                   Style="{StaticResource BatteryHealthMetricLabelStyle}" />
                        <TextBlock x:Name="_chargeRemainingValueTextBlock"
                                   AutomationProperties.AutomationId="BatteryHealth_ChargeRemainingValue"
                                   Style="{StaticResource BatteryHealthMetricValueStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="6"
                        Padding="14,12"
                        Style="{StaticResource BatteryHealthSurfaceStyle}">
                    <StackPanel>
                        <TextBlock Text="{x:Static text:BatteryHealthText.WearPercentLabel}"
                                   Style="{StaticResource BatteryHealthMetricLabelStyle}" />
                        <TextBlock x:Name="_wearValueTextBlock"
                                   AutomationProperties.AutomationId="BatteryHealth_WearValue"
                                   Style="{StaticResource BatteryHealthMetricValueStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Capacity & status detail cards -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="14,12"
                        Style="{StaticResource BatteryHealthSurfaceStyle}">
                    <StackPanel>
                        <TextBlock Text="{x:Static text:BatteryHealthText.DesignedCapacityLabel}"
                                   Style="{StaticResource BatteryHealthMetricLabelStyle}" />
                        <TextBlock x:Name="_designCapacityTextBlock"
                                   AutomationProperties.AutomationId="BatteryHealth_DesignCapacity"
                                   Style="{StaticResource BatteryHealthMetricValueStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="14,12"
                        Style="{StaticResource BatteryHealthSurfaceStyle}">
                    <StackPanel>
                        <TextBlock Text="{x:Static text:BatteryHealthText.FullChargeCapacityLabel}"
                                   Style="{StaticResource BatteryHealthMetricLabelStyle}" />
                        <TextBlock x:Name="_fullChargeCapacityTextBlock"
                                   AutomationProperties.AutomationId="BatteryHealth_FullChargeCapacity"
                                   Style="{StaticResource BatteryHealthMetricValueStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Padding="14,12"
                        Style="{StaticResource BatteryHealthSurfaceStyle}">
                    <StackPanel>
                        <TextBlock Text="{x:Static text:BatteryHealthText.HealthStateLabel}"
                                   Style="{StaticResource BatteryHealthMetricLabelStyle}" />
                        <TextBlock x:Name="_statusValueTextBlock"
                                   AutomationProperties.AutomationId="BatteryHealth_StatusValue"
                                   Style="{StaticResource BatteryHealthMetricValueStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Action bar -->
            <Border Padding="16,12"
                     Margin="0,0,0,16"
                     Style="{StaticResource BatteryHealthSurfaceStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <wpfui:SymbolIcon Grid.Column="0"
                                     x:Name="_actionBarIcon"
                                     Symbol="Info24"
                                     FontSize="16"
                                     Margin="0,1,10,0"
                                     VerticalAlignment="Top"
                                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="_statusTextBlock"
                               Grid.Column="1"
                               AutomationProperties.AutomationId="BatteryHealth_StatusText"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Margin="18,0,0,0"
                                HorizontalAlignment="Right">
                       <wpfui:Button Content="{x:Static text:BatteryHealthText.RefreshButton}"
                                     x:Name="RefreshButton"
                                     AutomationProperties.AutomationId="BatteryHealthRefreshButton"
                                     Appearance="Primary"
                                     Icon="ArrowSync24"
                                     Padding="14,7"
                                     Click="RefreshButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
