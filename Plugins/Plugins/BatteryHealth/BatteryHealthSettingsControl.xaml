<UserControl x:Class="LenovoLegionToolkit.Plugins.BatteryHealth.BatteryHealthSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="clr-namespace:LenovoLegionToolkit.Plugins.BatteryHealth"
             xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="960"
             AutomationProperties.AutomationId="BatteryHealthSettingsRoot">

    <UserControl.Resources>
        <Style x:Key="BatteryHealthSurfaceStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="BatteryHealthSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="BatteryHealthBodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">

            <!-- Hero / overview card -->
            <Border Margin="0,0,0,14"
                    Padding="18,16"
                    Style="{StaticResource BatteryHealthSurfaceStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="42" Height="42"
                            CornerRadius="8"
                            Margin="0,0,16,0"
                            Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                        <wpfui:SymbolIcon Symbol="BatteryCharge24"
                                          FontSize="21"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Static text:BatteryHealthText.SettingsPageTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{x:Static text:BatteryHealthText.SettingsPageSubtitle}"
                                   Style="{StaticResource BatteryHealthBodyTextStyle}" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Padding="9,5"
                            Margin="18,0,0,0"
                            CornerRadius="8"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <StackPanel Orientation="Horizontal">
                            <wpfui:SymbolIcon x:Name="_statusIcon"
                                              Symbol="CheckmarkCircle24"
                                              FontSize="15"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock x:Name="_statusPillText"
                                       Text="{x:Static text:BatteryHealthText.SettingsSaved}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Monitoring card -->
            <Border Margin="0,0,0,14"
                    Padding="18,16"
                    Style="{StaticResource BatteryHealthSurfaceStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,10">
                        <wpfui:SymbolIcon Symbol="Eye24"
                                          FontSize="18"
                                          Margin="0,0,10,0"
                                          Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        <TextBlock Text="{x:Static text:BatteryHealthText.MonitoringCardTitle}"
                                   Style="{StaticResource BatteryHealthSectionTitleStyle}" />
                    </StackPanel>
                    <TextBlock Text="{x:Static text:BatteryHealthText.MonitoringCardDescription}"
                               Style="{StaticResource BatteryHealthBodyTextStyle}" />
                    <Border Margin="0,14,0,0"
                            Padding="12,10"
                            CornerRadius="8"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <CheckBox x:Name="_enableMonitoringCheckBox"
                                  AutomationProperties.AutomationId="BatteryHealth_EnableMonitoringCheckBox"
                                  Content="{x:Static text:BatteryHealthText.EnableMonitoringLabel}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Thresholds card -->
            <Border Margin="0,0,0,14"
                    Padding="18,16"
                    Style="{StaticResource BatteryHealthSurfaceStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,10">
                        <wpfui:SymbolIcon Symbol="Warning24"
                                          FontSize="18"
                                          Margin="0,0,10,0"
                                          Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        <TextBlock Text="{x:Static text:BatteryHealthText.ThresholdsCardTitle}"
                                   Style="{StaticResource BatteryHealthSectionTitleStyle}" />
                    </StackPanel>
                    <TextBlock Text="{x:Static text:BatteryHealthText.LowHealthThresholdLabel}"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="_lowHealthThresholdSlider"
                                Grid.Column="0"
                                AutomationProperties.AutomationId="BatteryHealth_LowHealthThresholdSlider"
                                Minimum="50"
                                Maximum="95"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="LowHealthThresholdSlider_ValueChanged" />
                        <TextBlock x:Name="_lowHealthThresholdValueLabel"
                                   Grid.Column="1"
                                   MinWidth="48"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>

                    <TextBlock Margin="0,18,0,0"
                               Text="{x:Static text:BatteryHealthText.CriticalHealthThresholdLabel}"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="_criticalHealthThresholdSlider"
                                Grid.Column="0"
                                AutomationProperties.AutomationId="BatteryHealth_CriticalHealthThresholdSlider"
                                Minimum="10"
                                Maximum="80"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="CriticalHealthThresholdSlider_ValueChanged" />
                        <TextBlock x:Name="_criticalHealthThresholdValueLabel"
                                   Grid.Column="1"
                                   MinWidth="48"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Notifications card -->
            <Border Margin="0,0,0,14"
                    Padding="18,16"
                    Style="{StaticResource BatteryHealthSurfaceStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,10">
                        <wpfui:SymbolIcon Symbol="Alert24"
                                          FontSize="18"
                                          Margin="0,0,10,0"
                                          Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        <TextBlock Text="{x:Static text:BatteryHealthText.NotificationsCardTitle}"
                                   Style="{StaticResource BatteryHealthSectionTitleStyle}" />
                    </StackPanel>
                    <TextBlock Text="{x:Static text:BatteryHealthText.NotificationsCardDescription}"
                               Style="{StaticResource BatteryHealthBodyTextStyle}" />
                    <Border Margin="0,14,0,0"
                            Padding="12,10"
                            CornerRadius="8"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <CheckBox x:Name="_enableNotificationCheckBox"
                                  AutomationProperties.AutomationId="BatteryHealth_EnableNotificationCheckBox"
                                  Content="{x:Static text:BatteryHealthText.EnableNotificationLabel}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Action bar -->
            <Border Padding="16,12"
                     Margin="0,0,0,16"
                     Style="{StaticResource BatteryHealthSurfaceStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <wpfui:SymbolIcon Grid.Column="0"
                                     x:Name="_actionBarIcon"
                                     Symbol="Info24"
                                     FontSize="16"
                                     Margin="0,1,10,0"
                                     VerticalAlignment="Top"
                                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="_statusTextBlock"
                               Grid.Column="1"
                               AutomationProperties.AutomationId="BatteryHealthSettings_StatusText"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Margin="18,0,0,0"
                                HorizontalAlignment="Right">
                        <wpfui:Button Content="{x:Static text:BatteryHealthText.ReloadButton}"
                                      x:Name="ReloadButton"
                                      AutomationProperties.AutomationId="BatteryHealthSettings_ReloadButton"
                                      Icon="ArrowClockwise24"
                                      Margin="0,0,8,0"
                                      Padding="12,7"
                                      Click="ReloadButton_Click" />
                        <wpfui:Button Content="{x:Static text:BatteryHealthText.SaveButton}"
                                      x:Name="SaveButton"
                                      AutomationProperties.AutomationId="BatteryHealthSettings_SaveButton"
                                      Appearance="Primary"
                                      Icon="Checkmark24"
                                      Padding="14,7"
                                      Click="SaveButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>