<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Fallback design tokens for plugin standalone tests / workbench when the host
      DesignTokens dictionary is not available. Values must match UDT host:
      Compact 8 / Control 12 / Card 18 / Surface 20 / Round 999.

      Prefer StaticResource CornerRadius* / PluginCornerRadius* keys in plugin XAML.
      Colors must remain DynamicResource host/WPF-UI brushes — never hardcode hex chrome.
    -->

    <!-- Corner radius scale (host SoT) -->
    <CornerRadius x:Key="CornerRadiusNone">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusProgressBar">3</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusCompact">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusControl">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusCard">18</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSurface">20</CornerRadius>
    <CornerRadius x:Key="CornerRadiusRound">999</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSM">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMD">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLG">18</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXL">20</CornerRadius>

    <!-- Plugin-local aliases used by ViveTool (available to every plugin merging this dictionary) -->
    <CornerRadius x:Key="PluginCornerRadiusCompact">8</CornerRadius>
    <CornerRadius x:Key="PluginCornerRadiusControl">12</CornerRadius>
    <CornerRadius x:Key="PluginCornerRadiusCard">18</CornerRadius>
    <CornerRadius x:Key="PluginCornerRadiusSurface">20</CornerRadius>

    <!-- Spacing (Thickness) — optional; pages may still use raw margins carefully -->
    <Thickness x:Key="PluginSpacingXXS">4</Thickness>
    <Thickness x:Key="PluginSpacingXS">8</Thickness>
    <Thickness x:Key="PluginSpacingSM">12</Thickness>
    <Thickness x:Key="PluginSpacingMD">16</Thickness>
    <Thickness x:Key="PluginSpacingLG">24</Thickness>
    <Thickness x:Key="PluginCardPadding">16,14</Thickness>
    <Thickness x:Key="PluginSectionMargin">0,0,0,16</Thickness>

    <!-- Button heights match host -->
    <sys:Double x:Key="ButtonHeightCompact" xmlns:sys="clr-namespace:System;assembly=mscorlib">32</sys:Double>
    <sys:Double x:Key="ButtonHeightStandard" xmlns:sys="clr-namespace:System;assembly=mscorlib">36</sys:Double>

    <!-- Typography scale (subset of host) -->
    <sys:Double x:Key="PluginFontSizeSmall" xmlns:sys="clr-namespace:System;assembly=mscorlib">11</sys:Double>
    <sys:Double x:Key="PluginFontSizeCaption" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
    <sys:Double x:Key="PluginFontSizeLabel" xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
    <sys:Double x:Key="PluginFontSizeBody" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
    <sys:Double x:Key="PluginFontSizeSection" xmlns:sys="clr-namespace:System;assembly=mscorlib">15</sys:Double>
    <sys:Double x:Key="PluginFontSizeEmphasis" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
    <sys:Double x:Key="PluginFontSizeMetric" xmlns:sys="clr-namespace:System;assembly=mscorlib">28</sys:Double>
    <!-- Fallback-only text sizes outside the core scale (ViveTool BuildFallbackUi) -->
    <sys:Double x:Key="PluginFontSizeHeading" xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
    <sys:Double x:Key="PluginFontSizeTitle" xmlns:sys="clr-namespace:System;assembly=mscorlib">20</sys:Double>
    <sys:Double x:Key="PluginIconSizeMD" xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
    <sys:Double x:Key="PluginIconSizeLG" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
</ResourceDictionary>
