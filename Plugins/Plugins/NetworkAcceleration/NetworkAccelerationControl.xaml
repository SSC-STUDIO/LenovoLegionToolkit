
<UserControl x:Class="LenovoLegionToolkit.Plugins.NetworkAcceleration.NetworkAccelerationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="clr-namespace:LenovoLegionToolkit.Plugins.NetworkAcceleration"
             xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="920"
             d:DesignWidth="980">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20"
              AutomationProperties.AutomationId="NetworkAcceleration_FeatureRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="0,0,0,16"
                    Padding="24"
                    CornerRadius="20"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="{x:Static text:NetworkAccelerationText.FeatureOverviewTitle}"
                                   Style="{StaticResource AppSectionTitleTextBlockStyle}"
                                   FontWeight="Medium" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{x:Static text:NetworkAccelerationText.FeatureOverviewDescription}"
                                   Style="{StaticResource AppPageDescriptionTextBlockStyle}" />

                        <WrapPanel Margin="0,18,0,0">
                            <Border Margin="0,0,10,10"
                                    Padding="12,7"
                                    CornerRadius="999"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static text:NetworkAccelerationText.ServiceStateLabel}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="_serviceStateTextBlock"
                                               Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,10,10"
                                    Padding="12,7"
                                    CornerRadius="999"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static text:NetworkAccelerationText.CurrentModeLabel}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="_savedModeSummaryTextBlock"
                                               Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,0,10"
                                    Padding="12,7"
                                    CornerRadius="999"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static text:NetworkAccelerationText.SessionLabel}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="_sessionValueTextBlock"
                                               Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <WrapPanel Grid.Column="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top">
                        <wpfui:Button x:Name="_serviceToggleButton"
                                      Width="168"
                                      Margin="0,0,10,10"
                                      Appearance="Primary"
                                      AutomationProperties.AutomationId="NetworkAcceleration_ServiceToggleButton"
                                      Click="ServiceToggleButton_Click" />

                        <wpfui:Button Width="128"
                                      Margin="0,0,10,10"
                                      Appearance="Secondary"
                                      Content="{x:Static text:NetworkAccelerationText.RefreshButton}"
                                      AutomationProperties.AutomationId="NetworkAcceleration_RefreshButton"
                                      Click="RefreshButton_Click" />

                        <wpfui:Button Width="120"
                                      Margin="0,0,0,10"
                                      Appearance="Secondary"
                                      Content="{x:Static text:NetworkAccelerationText.MenuButton}"
                                      AutomationProperties.AutomationId="NetworkAcceleration_MenuButton"
                                      Click="MenuButton_Click" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*" />
                    <ColumnDefinition Width="0.92*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,8,0"
                        Padding="20"
                        CornerRadius="20"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{x:Static text:NetworkAccelerationText.AccelerationTargetsTitle}"
                                   Style="{StaticResource AppSectionTitleTextBlockStyle}"
                                   FontWeight="Medium" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{x:Static text:NetworkAccelerationText.AccelerationTargetsDescription}"
                                   Style="{StaticResource AppPageDescriptionTextBlockStyle}" />

                        <ListBox x:Name="_presetListBox"
                                 Margin="0,18,0,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 SelectionChanged="PresetListBox_SelectionChanged"
                                 AutomationProperties.AutomationId="NetworkAcceleration_TargetsList">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBoxItem Tag="Balanced">
                                <Border Padding="16"
                                        CornerRadius="16"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{x:Static text:NetworkAccelerationText.ModeBalancedTargetTitle}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{x:Static text:NetworkAccelerationText.ModeBalancedTargetDescription}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Padding="10,5"
                                                VerticalAlignment="Top"
                                                CornerRadius="999"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="{x:Static text:NetworkAccelerationText.ModeBalanced}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </ListBoxItem>

                            <ListBoxItem Tag="Gaming">
                                <Border Padding="16"
                                        CornerRadius="16"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{x:Static text:NetworkAccelerationText.ModeGamingTargetTitle}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{x:Static text:NetworkAccelerationText.ModeGamingTargetDescription}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Padding="10,5"
                                                VerticalAlignment="Top"
                                                CornerRadius="999"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="{x:Static text:NetworkAccelerationText.ModeGaming}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </ListBoxItem>

                            <ListBoxItem Tag="Streaming">
                                <Border Padding="16"
                                        CornerRadius="16"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{x:Static text:NetworkAccelerationText.ModeStreamingTargetTitle}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{x:Static text:NetworkAccelerationText.ModeStreamingTargetDescription}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Padding="10,5"
                                                VerticalAlignment="Top"
                                                CornerRadius="999"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="{x:Static text:NetworkAccelerationText.ModeStreaming}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="8,0,0,0">
                    <Border Padding="20"
                            CornerRadius="20"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock x:Name="_presetTitleTextBlock"
                                               Style="{StaticResource AppSectionTitleTextBlockStyle}"
                                               FontWeight="Medium" />
                                    <TextBlock x:Name="_presetSubtitleTextBlock"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource AppPageDescriptionTextBlockStyle}" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Padding="12,7"
                                        VerticalAlignment="Top"
                                        CornerRadius="999"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <TextBlock x:Name="_presetStateTextBlock"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Border>
                            </Grid>

                            <Border Margin="0,18,0,0"
                                    Padding="16"
                                    CornerRadius="16"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{x:Static text:NetworkAccelerationText.RecommendedForLabel}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="_presetRecommendationTextBlock"
                                               Grid.Row="0"
                                               Grid.Column="1"
                                               Margin="12,0,0,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                    <TextBlock Grid.Row="1"
                                               Margin="0,14,0,0"
                                               Text="{x:Static text:NetworkAccelerationText.OptimizationFocusLabel}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="_presetActionsTextBlock"
                                               Grid.Row="1"
                                               Grid.Column="1"
                                               Margin="12,14,0,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                    <TextBlock Grid.Row="2"
                                               Margin="0,14,0,0"
                                               Text="{x:Static text:NetworkAccelerationText.SessionLabel}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="_detailSessionTextBlock"
                                               Grid.Row="2"
                                               Grid.Column="1"
                                               Margin="12,14,0,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Grid>
                            </Border>

                            <WrapPanel Margin="0,18,0,0">
                                <wpfui:Button Width="176"
                                              Margin="0,0,10,10"
                                              Appearance="Primary"
                                              Content="{x:Static text:NetworkAccelerationText.RunQuickOptimizationButton}"
                                              AutomationProperties.AutomationId="NetworkAcceleration_QuickOptimizeButton"
                                              Click="QuickOptimizeButton_Click" />
                                <wpfui:Button Width="162"
                                              Margin="0,0,10,10"
                                              Appearance="Secondary"
                                              Content="{x:Static text:NetworkAccelerationText.ResetNetworkStackButton}"
                                              AutomationProperties.AutomationId="NetworkAcceleration_ResetStackButton"
                                              Click="ResetStackButton_Click" />
                                <wpfui:Button Width="120"
                                              Margin="0,0,0,10"
                                              Appearance="Secondary"
                                              Content="{x:Static text:NetworkAccelerationText.SaveModeButton}"
                                              AutomationProperties.AutomationId="NetworkAcceleration_SaveModeButton"
                                              Click="SaveModeButton_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Expander x:Name="_settingsExpander"
                              Margin="0,16,0,0"
                              IsExpanded="True">
                        <Expander.Header>
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.SettingsTitle}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Expander.Header>

                        <Border Margin="0,12,0,0"
                                Padding="18"
                                CornerRadius="20"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{x:Static text:NetworkAccelerationText.SettingsDescription}"
                                           Style="{StaticResource AppPageDescriptionTextBlockStyle}" />

                                <ComboBox x:Name="_modeComboBox"
                                          Width="230"
                                          Margin="0,16,0,0"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="ModeComboBox_SelectionChanged"
                                          AutomationProperties.AutomationId="NetworkAcceleration_ModeComboBox">
                                    <ComboBoxItem Content="{x:Static text:NetworkAccelerationText.ModeBalanced}" Tag="Balanced" />
                                    <ComboBoxItem Content="{x:Static text:NetworkAccelerationText.ModeGaming}" Tag="Gaming" />
                                    <ComboBoxItem Content="{x:Static text:NetworkAccelerationText.ModeStreaming}" Tag="Streaming" />
                                </ComboBox>

                                <TextBlock x:Name="_modeDescriptionTextBlock"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                <CheckBox x:Name="_autoOptimizeOnStartupCheckBox"
                                          Margin="0,16,0,10"
                                          Checked="SettingsCheckBox_Changed"
                                          Unchecked="SettingsCheckBox_Changed"
                                          AutomationProperties.AutomationId="NetworkAcceleration_AutoOptimizeCheckBox"
                                          Content="{x:Static text:NetworkAccelerationText.AutoOptimizeOnStartup}" />

                                <CheckBox x:Name="_resetWinsockCheckBox"
                                          Margin="0,0,0,10"
                                          Checked="SettingsCheckBox_Changed"
                                          Unchecked="SettingsCheckBox_Changed"
                                          AutomationProperties.AutomationId="NetworkAcceleration_ResetWinsockCheckBox"
                                          Content="{x:Static text:NetworkAccelerationText.ResetWinsockOnOptimize}" />

                                <CheckBox x:Name="_resetTcpIpCheckBox"
                                          Checked="SettingsCheckBox_Changed"
                                          Unchecked="SettingsCheckBox_Changed"
                                          AutomationProperties.AutomationId="NetworkAcceleration_ResetTcpIpCheckBox"
                                          Content="{x:Static text:NetworkAccelerationText.ResetTcpIpOnOptimize}" />
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Margin="0,0,0,16"
                    Padding="20"
                    CornerRadius="20"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{x:Static text:NetworkAccelerationText.LiveTelemetryTitle}"
                               Style="{StaticResource AppSectionTitleTextBlockStyle}"
                               FontWeight="Medium" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{x:Static text:NetworkAccelerationText.LiveTelemetryDescription}"
                               Style="{StaticResource AppPageDescriptionTextBlockStyle}" />

                    <Grid Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,8,8"
                                Padding="14"
                                CornerRadius="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{x:Static text:NetworkAccelerationText.CurrentDownloadLabel}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_downloadValueTextBlock"
                                           Margin="0,8,0,0"
                                           FontSize="20"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0"
                                Grid.Column="1"
                                Margin="8,0,8,8"
                                Padding="14"
                                CornerRadius="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{x:Static text:NetworkAccelerationText.CurrentUploadLabel}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_uploadValueTextBlock"
                                           Margin="0,8,0,0"
                                           FontSize="20"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0"
                                Grid.Column="2"
                                Margin="8,0,0,8"
                                Padding="14"
                                CornerRadius="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{x:Static text:NetworkAccelerationText.PeakTrafficLabel}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_peakValueTextBlock"
                                           Margin="0,8,0,0"
                                           FontSize="20"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,8,8,0"
                                Padding="14"
                                CornerRadius="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{x:Static text:NetworkAccelerationText.DownloadTotalLabel}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_downloadTotalTextBlock"
                                           Margin="0,8,0,0"
                                           FontSize="18"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="1"
                                Margin="8,8,8,0"
                                Padding="14"
                                CornerRadius="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{x:Static text:NetworkAccelerationText.UploadTotalLabel}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_uploadTotalTextBlock"
                                           Margin="0,8,0,0"
                                           FontSize="18"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="2"
                                Margin="8,8,0,0"
                                Padding="14"
                                CornerRadius="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{x:Static text:NetworkAccelerationText.ActiveAdapterLabel}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_adapterValueTextBlock"
                                           Margin="0,8,0,0"
                                           FontSize="18"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Margin="0,16,0,0"
                            Padding="14"
                            CornerRadius="16"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Static text:NetworkAccelerationText.UpdatedLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_updatedValueTextBlock"
                                       Grid.Column="1"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="3"
                    Padding="18"
                    CornerRadius="20"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <wpfui:SymbolIcon x:Name="_statusIcon"
                                      Symbol="CheckmarkCircle24"
                                      Margin="0,1,8,0"
                                      FontSize="16"
                                      VerticalAlignment="Top"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="_statusTextBlock"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="NetworkAcceleration_StatusText" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="4"
                        Visibility="Collapsed">
                <TextBlock x:Name="_downloadShareValueTextBlock" />
                <ProgressBar x:Name="_downloadShareBar" Maximum="100" />
                <TextBlock x:Name="_uploadShareValueTextBlock" />
                <ProgressBar x:Name="_uploadShareBar" Maximum="100" />
                <Canvas x:Name="_chartCanvas" Width="1" Height="1">
                    <Polygon x:Name="_downloadFillPolygon" />
                    <Polygon x:Name="_uploadFillPolygon" />
                    <Polyline x:Name="_downloadLine" />
                    <Polyline x:Name="_uploadLine" />
                </Canvas>
                <TextBlock x:Name="_chartCeilingTextBlock" />
                <TextBlock x:Name="_chartFloorTextBlock" />
                <TextBlock x:Name="_chartEmptyTextBlock" />
                <Canvas x:Name="_burstCanvas" Width="1" Height="1">
                    <Polygon x:Name="_burstFillPolygon" />
                    <Polyline x:Name="_burstLine" />
                </Canvas>
                <TextBlock x:Name="_burstEmptyTextBlock" />
                <TextBlock x:Name="_rollingAverageTextBlock" />
                <TextBlock x:Name="_burstPeakTextBlock" />
            </StackPanel>
        </Grid>
    </ScrollViewer>

</UserControl>
