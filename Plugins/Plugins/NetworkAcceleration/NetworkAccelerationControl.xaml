<UserControl x:Class="LenovoLegionToolkit.Plugins.NetworkAcceleration.NetworkAccelerationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="clr-namespace:LenovoLegionToolkit.Plugins.NetworkAcceleration"
             xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="860"
             d:DesignWidth="980">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0"
                    AutomationProperties.AutomationId="NetworkAcceleration_FeatureRoot">

            <!-- Hero Status Banner -->
            <Border Margin="0,0,0,20"
                    Padding="16,14"
                    CornerRadius="10"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="40" Height="40"
                            CornerRadius="8"
                            Margin="0,0,16,0"
                            Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                        <wpfui:SymbolIcon Symbol="Rocket24"
                                          FontSize="20"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="White" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                <TextBlock Text="{x:Static text:NetworkAccelerationText.ServiceStateLabel}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_serviceStateTextBlock"
                                           Margin="6,0,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                <TextBlock Text="{x:Static text:NetworkAccelerationText.CurrentModeLabel}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_savedModeSummaryTextBlock"
                                           Margin="6,0,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                <TextBlock Text="{x:Static text:NetworkAccelerationText.SessionLabel}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_sessionValueTextBlock"
                                           Margin="6,0,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <wpfui:Button x:Name="_serviceToggleButton"
                                      MinWidth="140"
                                      Margin="0,0,8,0"
                                      Icon="Rocket24"
                                      Appearance="Primary"
                                      AutomationProperties.AutomationId="NetworkAcceleration_ServiceToggleButton"
                                      Click="ServiceToggleButton_Click" />
                        <wpfui:Button MinWidth="36"
                                      Margin="0,0,8,0"
                                      Icon="ArrowClockwise24"
                                      AutomationProperties.AutomationId="NetworkAcceleration_RefreshButton"
                                      Click="RefreshButton_Click"
                                      ToolTip="{x:Static text:NetworkAccelerationText.RefreshButton}" />
                        <wpfui:Button MinWidth="36"
                                      Icon="Settings24"
                                      AutomationProperties.AutomationId="NetworkAcceleration_MenuButton"
                                      Click="MenuButton_Click"
                                      ToolTip="{x:Static text:NetworkAccelerationText.MenuButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Acceleration Targets & Details -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Card: Targets -->
                <Border Grid.Column="0"
                        Padding="18,16"
                        CornerRadius="10"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <wpfui:SymbolIcon Symbol="Target24"
                                              FontSize="18"
                                              Margin="0,0,10,0"
                                              Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.AccelerationTargetsTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <TextBlock Margin="0,0,0,12"
                                   Text="{x:Static text:NetworkAccelerationText.AccelerationTargetsDescription}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <ListBox x:Name="_presetListBox"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 SelectionChanged="PresetListBox_SelectionChanged"
                                 AutomationProperties.AutomationId="NetworkAcceleration_TargetsList">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBoxItem Tag="Balanced">
                                <Border Padding="12,10"
                                        CornerRadius="8"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="3"
                                                CornerRadius="2"
                                                Margin="0,1,10,1"
                                                Background="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="{x:Static text:NetworkAccelerationText.ModeBalancedTargetTitle}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{x:Static text:NetworkAccelerationText.ModeBalancedTargetDescription}"
                                                       TextWrapping="Wrap"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Top"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="{x:Static text:NetworkAccelerationText.ModeBalanced}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Grid>
                                </Border>
                            </ListBoxItem>

                            <ListBoxItem Tag="Gaming">
                                <Border Padding="12,10"
                                        CornerRadius="8"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="3"
                                                CornerRadius="2"
                                                Margin="0,1,10,1"
                                                Background="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="{x:Static text:NetworkAccelerationText.ModeGamingTargetTitle}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{x:Static text:NetworkAccelerationText.ModeGamingTargetDescription}"
                                                       TextWrapping="Wrap"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Top"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="{x:Static text:NetworkAccelerationText.ModeGaming}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Grid>
                                </Border>
                            </ListBoxItem>

                            <ListBoxItem Tag="Streaming">
                                <Border Padding="12,10"
                                        CornerRadius="8"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="3"
                                                CornerRadius="2"
                                                Margin="0,1,10,1"
                                                Background="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="{x:Static text:NetworkAccelerationText.ModeStreamingTargetTitle}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{x:Static text:NetworkAccelerationText.ModeStreamingTargetDescription}"
                                                       TextWrapping="Wrap"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Top"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="{x:Static text:NetworkAccelerationText.ModeStreaming}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Grid>
                                </Border>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Right Card: Details & Actions -->
                <Border Grid.Column="2"
                        Padding="18,16"
                        CornerRadius="10"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="_presetTitleTextBlock"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="_presetSubtitleTextBlock"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="_presetStateTextBlock"
                                       Grid.Column="1"
                                       VerticalAlignment="Top"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>

                        <!-- Detail Metrics -->
                        <Grid Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       FontSize="12"
                                       Text="{x:Static text:NetworkAccelerationText.RecommendedForLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_presetRecommendationTextBlock"
                                       Grid.Row="0" Grid.Column="1"
                                       Margin="12,0,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                            <TextBlock Grid.Row="1" Margin="0,12,0,0"
                                       FontSize="12"
                                       Text="{x:Static text:NetworkAccelerationText.OptimizationFocusLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_presetActionsTextBlock"
                                       Grid.Row="1" Grid.Column="1"
                                       Margin="12,12,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                            <TextBlock Grid.Row="2" Margin="0,12,0,0"
                                       FontSize="12"
                                       Text="{x:Static text:NetworkAccelerationText.SessionLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_detailSessionTextBlock"
                                       Grid.Row="2" Grid.Column="1"
                                       Margin="12,12,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Grid>

                        <TextBlock Text="{x:Static text:NetworkAccelerationText.PlannedStepsTitle}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Margin="0,4,0,16"
                                   Text="{x:Static text:NetworkAccelerationText.PlannedStepsDescription}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Border Margin="0,0,0,16"
                                Padding="12,10"
                                CornerRadius="8"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <TextBlock x:Name="_plannedStepsTextBlock"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>

                        <!-- Action Buttons -->
                        <wpfui:Button HorizontalAlignment="Stretch"
                                      Margin="0,0,0,8"
                                      Icon="Rocket24"
                                      Appearance="Primary"
                                      Content="{x:Static text:NetworkAccelerationText.RunQuickOptimizationButton}"
                                      AutomationProperties.AutomationId="NetworkAcceleration_QuickOptimizeButton"
                                      Click="QuickOptimizeButton_Click" />
                        <wpfui:Button HorizontalAlignment="Stretch"
                                      Margin="0,0,0,8"
                                      Icon="ArrowCounterclockwise24"
                                      Content="{x:Static text:NetworkAccelerationText.ResetNetworkStackButton}"
                                      AutomationProperties.AutomationId="NetworkAcceleration_ResetStackButton"
                                      Click="ResetStackButton_Click" />
                        <wpfui:Button HorizontalAlignment="Stretch"
                                      Icon="Checkmark24"
                                      Content="{x:Static text:NetworkAccelerationText.SaveModeButton}"
                                      AutomationProperties.AutomationId="NetworkAcceleration_SaveModeButton"
                                      Click="SaveModeButton_Click" />

                        <!-- Settings Expander -->
                        <Expander x:Name="_settingsExpander"
                                  Margin="0,16,0,0"
                                  IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="{x:Static text:NetworkAccelerationText.SettingsTitle}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Expander.Header>
                            <StackPanel Margin="0,12,0,0">
                                <ComboBox x:Name="_modeComboBox"
                                          HorizontalAlignment="Stretch"
                                          Margin="0,0,0,12"
                                          SelectionChanged="ModeComboBox_SelectionChanged"
                                          AutomationProperties.AutomationId="NetworkAcceleration_ModeComboBox">
                                    <ComboBoxItem Content="{x:Static text:NetworkAccelerationText.ModeBalanced}" Tag="Balanced" />
                                    <ComboBoxItem Content="{x:Static text:NetworkAccelerationText.ModeGaming}" Tag="Gaming" />
                                    <ComboBoxItem Content="{x:Static text:NetworkAccelerationText.ModeStreaming}" Tag="Streaming" />
                                </ComboBox>
                                <TextBlock x:Name="_modeDescriptionTextBlock"
                                           Margin="0,0,0,12"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <CheckBox x:Name="_autoOptimizeOnStartupCheckBox"
                                          Margin="0,0,0,8"
                                          Checked="SettingsCheckBox_Changed"
                                          Unchecked="SettingsCheckBox_Changed"
                                          AutomationProperties.AutomationId="NetworkAcceleration_AutoOptimizeCheckBox"
                                          Content="{x:Static text:NetworkAccelerationText.AutoOptimizeOnStartup}" />
                                <CheckBox x:Name="_resetWinsockCheckBox"
                                          Margin="0,0,0,8"
                                          Checked="SettingsCheckBox_Changed"
                                          Unchecked="SettingsCheckBox_Changed"
                                          AutomationProperties.AutomationId="NetworkAcceleration_ResetWinsockCheckBox"
                                          Content="{x:Static text:NetworkAccelerationText.ResetWinsockOnOptimize}" />
                                <CheckBox x:Name="_resetTcpIpCheckBox"
                                          Checked="SettingsCheckBox_Changed"
                                          Unchecked="SettingsCheckBox_Changed"
                                          AutomationProperties.AutomationId="NetworkAcceleration_ResetTcpIpCheckBox"
                                          Content="{x:Static text:NetworkAccelerationText.ResetTcpIpOnOptimize}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Live Telemetry Card -->
            <Border Margin="0,0,0,16"
                    Padding="18,16"
                    CornerRadius="10"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <wpfui:SymbolIcon Symbol="Pulse24"
                                              FontSize="18"
                                              Margin="0,0,10,0"
                                              Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.LiveTelemetryTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.UpdatedLabel}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="_updatedValueTextBlock"
                                       Margin="6,0,0,0"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.CurrentDownloadLabel}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_downloadValueTextBlock"
                                       Margin="0,4,0,0"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.CurrentUploadLabel}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_uploadValueTextBlock"
                                       Margin="0,4,0,0"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.PeakTrafficLabel}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_peakValueTextBlock"
                                       Margin="0,4,0,0"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.DownloadTotalLabel}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_downloadTotalTextBlock"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.UploadTotalLabel}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_uploadTotalTextBlock"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.ActiveAdapterLabel}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_adapterValueTextBlock"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Status Bar -->
            <Border Padding="16,12"
                    CornerRadius="10"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <wpfui:SymbolIcon x:Name="_statusIcon"
                                      Symbol="CheckmarkCircle24"
                                      Margin="0,1,8,0"
                                      FontSize="16"
                                      VerticalAlignment="Top"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="_statusTextBlock"
                               TextWrapping="Wrap"
                               FontSize="12"
                               AutomationProperties.AutomationId="NetworkAcceleration_StatusText" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
