<UserControl x:Class="LenovoLegionToolkit.Plugins.NetworkAcceleration.NetworkAccelerationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="clr-namespace:LenovoLegionToolkit.Plugins.NetworkAcceleration"
             xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="820"
             d:DesignWidth="980">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0"
              AutomationProperties.AutomationId="NetworkAcceleration_FeatureRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="0,0,0,20"
                    Padding="12,9"
                    CornerRadius="8"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,24,0">
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.ServiceStateLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_serviceStateTextBlock"
                                       Margin="8,0,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,24,0">
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.CurrentModeLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_savedModeSummaryTextBlock"
                                       Margin="8,0,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.SessionLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_sessionValueTextBlock"
                                       Margin="8,0,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </WrapPanel>

                    <WrapPanel Grid.Column="1"
                               Margin="20,0,0,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center">
                        <wpfui:Button x:Name="_serviceToggleButton"
                                      MinWidth="174"
                                      Margin="0,0,8,0"
                                      Icon="Rocket24"
                                      Appearance="Primary"
                                      AutomationProperties.AutomationId="NetworkAcceleration_ServiceToggleButton"
                                      Click="ServiceToggleButton_Click" />

                        <wpfui:Button MinWidth="122"
                                      Margin="0,0,8,0"
                                      Icon="ArrowClockwise24"
                                      Appearance="Secondary"
                                      Content="{x:Static text:NetworkAccelerationText.RefreshButton}"
                                      AutomationProperties.AutomationId="NetworkAcceleration_RefreshButton"
                                      Click="RefreshButton_Click" />

                        <wpfui:Button MinWidth="112"
                                      Icon="Settings24"
                                      Appearance="Secondary"
                                      Content="{x:Static text:NetworkAccelerationText.MenuButton}"
                                      AutomationProperties.AutomationId="NetworkAcceleration_MenuButton"
                                      Click="MenuButton_Click" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{x:Static text:NetworkAccelerationText.AccelerationTargetsTitle}"
                               Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                    <TextBlock Margin="0,6,0,14"
                               Text="{x:Static text:NetworkAccelerationText.AccelerationTargetsDescription}"
                               TextWrapping="Wrap"
                               Style="{StaticResource AppPageDescriptionTextBlockStyle}" />

                    <ListBox x:Name="_presetListBox"
                             BorderThickness="0"
                             Background="Transparent"
                             SelectionChanged="PresetListBox_SelectionChanged"
                             AutomationProperties.AutomationId="NetworkAcceleration_TargetsList">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBoxItem Tag="Balanced">
                            <Border Padding="0,10,0,12"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1"
                                    Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="{x:Static text:NetworkAccelerationText.ModeBalancedTargetTitle}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="{x:Static text:NetworkAccelerationText.ModeBalancedTargetDescription}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Top"
                                               FontWeight="SemiBold"
                                               Text="{x:Static text:NetworkAccelerationText.ModeBalanced}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </ListBoxItem>

                        <ListBoxItem Tag="Gaming">
                            <Border Padding="0,10,0,12"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1"
                                    Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="{x:Static text:NetworkAccelerationText.ModeGamingTargetTitle}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="{x:Static text:NetworkAccelerationText.ModeGamingTargetDescription}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Top"
                                               FontWeight="SemiBold"
                                               Text="{x:Static text:NetworkAccelerationText.ModeGaming}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </ListBoxItem>

                        <ListBoxItem Tag="Streaming">
                            <Border Padding="0,10,0,12"
                                    Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="{x:Static text:NetworkAccelerationText.ModeStreamingTargetTitle}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="{x:Static text:NetworkAccelerationText.ModeStreamingTargetDescription}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Top"
                                               FontWeight="SemiBold"
                                               Text="{x:Static text:NetworkAccelerationText.ModeStreaming}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="1"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <StackPanel Grid.Column="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,18,0">
                            <TextBlock x:Name="_presetTitleTextBlock"
                                       Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                            <TextBlock x:Name="_presetSubtitleTextBlock"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource AppPageDescriptionTextBlockStyle}" />
                        </StackPanel>

                        <TextBlock x:Name="_presetStateTextBlock"
                                   Grid.Column="1"
                                   VerticalAlignment="Top"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{x:Static text:NetworkAccelerationText.RecommendedForLabel}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="_presetRecommendationTextBlock"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Margin="12,0,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <TextBlock Grid.Row="1"
                                   Margin="0,14,0,0"
                                   Text="{x:Static text:NetworkAccelerationText.OptimizationFocusLabel}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="_presetActionsTextBlock"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="12,14,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <TextBlock Grid.Row="2"
                                   Margin="0,14,0,0"
                                   Text="{x:Static text:NetworkAccelerationText.SessionLabel}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="_detailSessionTextBlock"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="12,14,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>

                    <WrapPanel Margin="0,18,0,0">
                        <wpfui:Button MinWidth="196"
                                      Margin="0,0,8,8"
                                      Icon="Rocket24"
                                      Appearance="Primary"
                                      Content="{x:Static text:NetworkAccelerationText.RunQuickOptimizationButton}"
                                      AutomationProperties.AutomationId="NetworkAcceleration_QuickOptimizeButton"
                                      Click="QuickOptimizeButton_Click" />
                        <wpfui:Button MinWidth="178"
                                      Margin="0,0,8,8"
                                      Icon="ArrowCounterclockwise24"
                                      Appearance="Secondary"
                                      Content="{x:Static text:NetworkAccelerationText.ResetNetworkStackButton}"
                                      AutomationProperties.AutomationId="NetworkAcceleration_ResetStackButton"
                                      Click="ResetStackButton_Click" />
                        <wpfui:Button MinWidth="124"
                                      Margin="0,0,0,8"
                                      Icon="Checkmark24"
                                      Appearance="Secondary"
                                      Content="{x:Static text:NetworkAccelerationText.SaveModeButton}"
                                      AutomationProperties.AutomationId="NetworkAcceleration_SaveModeButton"
                                      Click="SaveModeButton_Click" />
                    </WrapPanel>

                    <Expander x:Name="_settingsExpander"
                              Margin="0,16,0,0"
                              IsExpanded="True">
                        <Expander.Header>
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.SettingsTitle}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Expander.Header>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.SettingsDescription}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource AppPageDescriptionTextBlockStyle}" />

                            <ComboBox x:Name="_modeComboBox"
                                      Width="230"
                                      Margin="0,14,0,0"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="ModeComboBox_SelectionChanged"
                                      AutomationProperties.AutomationId="NetworkAcceleration_ModeComboBox">
                                <ComboBoxItem Content="{x:Static text:NetworkAccelerationText.ModeBalanced}" Tag="Balanced" />
                                <ComboBoxItem Content="{x:Static text:NetworkAccelerationText.ModeGaming}" Tag="Gaming" />
                                <ComboBoxItem Content="{x:Static text:NetworkAccelerationText.ModeStreaming}" Tag="Streaming" />
                            </ComboBox>

                            <TextBlock x:Name="_modeDescriptionTextBlock"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                            <CheckBox x:Name="_autoOptimizeOnStartupCheckBox"
                                      Margin="0,14,0,10"
                                      Checked="SettingsCheckBox_Changed"
                                      Unchecked="SettingsCheckBox_Changed"
                                      AutomationProperties.AutomationId="NetworkAcceleration_AutoOptimizeCheckBox"
                                      Content="{x:Static text:NetworkAccelerationText.AutoOptimizeOnStartup}" />

                            <CheckBox x:Name="_resetWinsockCheckBox"
                                      Margin="0,0,0,10"
                                      Checked="SettingsCheckBox_Changed"
                                      Unchecked="SettingsCheckBox_Changed"
                                      AutomationProperties.AutomationId="NetworkAcceleration_ResetWinsockCheckBox"
                                      Content="{x:Static text:NetworkAccelerationText.ResetWinsockOnOptimize}" />

                            <CheckBox x:Name="_resetTcpIpCheckBox"
                                      Checked="SettingsCheckBox_Changed"
                                      Unchecked="SettingsCheckBox_Changed"
                                      AutomationProperties.AutomationId="NetworkAcceleration_ResetTcpIpCheckBox"
                                      Content="{x:Static text:NetworkAccelerationText.ResetTcpIpOnOptimize}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,1"
                    Padding="0,16,0,16"
                    Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.LiveTelemetryTitle}"
                                       Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{x:Static text:NetworkAccelerationText.LiveTelemetryDescription}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource AppPageDescriptionTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top">
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.UpdatedLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_updatedValueTextBlock"
                                       Margin="8,0,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,18,16">
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.CurrentDownloadLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_downloadValueTextBlock"
                                       Margin="0,5,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,0,18,16">
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.CurrentUploadLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_uploadValueTextBlock"
                                       Margin="0,5,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="2"
                                    Margin="0,0,0,16">
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.PeakTrafficLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_peakValueTextBlock"
                                       Margin="0,5,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,18,0">
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.DownloadTotalLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_downloadTotalTextBlock"
                                       Margin="0,5,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,0,18,0">
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.UploadTotalLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_uploadTotalTextBlock"
                                       Margin="0,5,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="2">
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.ActiveAdapterLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_adapterValueTextBlock"
                                       Margin="0,5,0,0"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal">
                <wpfui:SymbolIcon x:Name="_statusIcon"
                                  Symbol="CheckmarkCircle24"
                                  Margin="0,1,8,0"
                                  FontSize="16"
                                  VerticalAlignment="Top"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="_statusTextBlock"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="NetworkAcceleration_StatusText" />
            </StackPanel>
        </Grid>
    </ScrollViewer>

</UserControl>
