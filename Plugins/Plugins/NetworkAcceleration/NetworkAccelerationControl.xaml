
<UserControl x:Class="LenovoLegionToolkit.Plugins.NetworkAcceleration.NetworkAccelerationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="clr-namespace:LenovoLegionToolkit.Plugins.NetworkAcceleration"
             xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="920"
             d:DesignWidth="980">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20"
              AutomationProperties.AutomationId="NetworkAcceleration_FeatureRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="0,0,0,16"
                    Padding="20"
                    CornerRadius="20"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{x:Static text:NetworkAccelerationText.FeatureOverviewTitle}"
                               Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{x:Static text:NetworkAccelerationText.FeatureOverviewDescription}"
                               Style="{StaticResource AppPageDescriptionTextBlockStyle}" />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Margin="0,0,8,0"
                                Padding="14"
                                CornerRadius="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{x:Static text:NetworkAccelerationText.CurrentDownloadLabel}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_downloadValueTextBlock"
                                           Margin="0,8,0,0"
                                           FontSize="22"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Margin="8,0"
                                Padding="14"
                                CornerRadius="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{x:Static text:NetworkAccelerationText.CurrentUploadLabel}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_uploadValueTextBlock"
                                           Margin="0,8,0,0"
                                           FontSize="22"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Margin="8,0"
                                Padding="14"
                                CornerRadius="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{x:Static text:NetworkAccelerationText.PeakTrafficLabel}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_peakValueTextBlock"
                                           Margin="0,8,0,0"
                                           FontSize="22"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3"
                                Margin="8,0,0,0"
                                Padding="14"
                                CornerRadius="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{x:Static text:NetworkAccelerationText.ActiveAdapterLabel}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_adapterValueTextBlock"
                                           Margin="0,8,0,0"
                                           FontSize="18"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,0,0,16"
                    Padding="20"
                    CornerRadius="20"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.LiveTelemetryTitle}"
                                       Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{x:Static text:NetworkAccelerationText.LiveTelemetryDescription}"
                                       Style="{StaticResource AppPageDescriptionTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,16,0">
                                <Ellipse Width="10"
                                         Height="10"
                                         Margin="0,4,6,0"
                                         Fill="#FF4F9CFF" />
                                <TextBlock Text="{x:Static text:NetworkAccelerationText.DownloadLegend}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10"
                                         Height="10"
                                         Margin="0,4,6,0"
                                         Fill="#FF27C7A8" />
                                <TextBlock Text="{x:Static text:NetworkAccelerationText.UploadLegend}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,16,0,0"
                            Height="260"
                            CornerRadius="16"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid Margin="18,18,18,30"
                                  IsHitTestVisible="False">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                        BorderThickness="0,0,0,1" />
                                <Border Grid.Row="1"
                                        BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                        BorderThickness="0,0,0,1" />
                                <Border Grid.Row="2"
                                        BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                        BorderThickness="0,0,0,1" />
                            </Grid>

                            <Canvas x:Name="_chartCanvas"
                                    Margin="18,18,18,30"
                                    SizeChanged="ChartCanvas_SizeChanged">
                                <Polygon x:Name="_downloadFillPolygon"
                                         Fill="#224F9CFF" />
                                <Polygon x:Name="_uploadFillPolygon"
                                         Fill="#1E27C7A8" />
                                <Polyline x:Name="_downloadLine"
                                          Stroke="#FF4F9CFF"
                                          StrokeThickness="2.4"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                <Polyline x:Name="_uploadLine"
                                          Stroke="#FF27C7A8"
                                          StrokeThickness="2.4"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                            </Canvas>

                            <TextBlock x:Name="_chartCeilingTextBlock"
                                       Margin="18,10,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <TextBlock x:Name="_chartFloorTextBlock"
                                       Margin="18,0,0,8"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Bottom"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <TextBlock x:Name="_chartEmptyTextBlock"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{x:Static text:NetworkAccelerationText.ChartEmptyState}" />
                        </Grid>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Margin="0,0,8,0"
                                Padding="14"
                                CornerRadius="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.DownloadTotalLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_downloadTotalTextBlock"
                                       Margin="0,6,0,0"
                                       FontSize="18"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Margin="8,0"
                                Padding="14"
                                CornerRadius="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.UploadTotalLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_uploadTotalTextBlock"
                                       Margin="0,6,0,0"
                                       FontSize="18"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Margin="8,0,0,0"
                                Padding="14"
                                CornerRadius="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.UpdatedLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_updatedValueTextBlock"
                                       Margin="0,6,0,0"
                                       FontSize="18"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2"
                  Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.95*" />
                    <ColumnDefinition Width="1.05*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,8,0"
                        Padding="20"
                        CornerRadius="20"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{x:Static text:NetworkAccelerationText.TrafficMixTitle}"
                                   Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{x:Static text:NetworkAccelerationText.TrafficMixDescription}"
                                   Style="{StaticResource AppPageDescriptionTextBlockStyle}" />

                        <StackPanel Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static text:NetworkAccelerationText.DownloadShareLabel}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_downloadShareValueTextBlock"
                                           Grid.Column="1"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Grid>
                            <ProgressBar x:Name="_downloadShareBar"
                                         Margin="0,8,0,0"
                                         Height="10"
                                         Maximum="100"
                                         Foreground="#FF4F9CFF"
                                         Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static text:NetworkAccelerationText.UploadShareLabel}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_uploadShareValueTextBlock"
                                           Grid.Column="1"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Grid>
                            <ProgressBar x:Name="_uploadShareBar"
                                         Margin="0,8,0,0"
                                         Height="10"
                                         Maximum="100"
                                         Foreground="#FF27C7A8"
                                         Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="20"
                        CornerRadius="20"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{x:Static text:NetworkAccelerationText.BurstHistoryTitle}"
                                   Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{x:Static text:NetworkAccelerationText.BurstHistoryDescription}"
                                   Style="{StaticResource AppPageDescriptionTextBlockStyle}" />

                        <Border Margin="0,16,0,0"
                                Height="170"
                                CornerRadius="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Canvas x:Name="_burstCanvas"
                                        Margin="14"
                                        SizeChanged="BurstCanvas_SizeChanged">
                                    <Polygon x:Name="_burstFillPolygon"
                                             Fill="#224F9CFF" />
                                    <Polyline x:Name="_burstLine"
                                              Stroke="#FF4F9CFF"
                                              StrokeThickness="2.2"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                </Canvas>
                                <TextBlock x:Name="_burstEmptyTextBlock"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{x:Static text:NetworkAccelerationText.BurstChartEmptyState}" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Margin="0,0,8,0"
                                    Padding="14"
                                    CornerRadius="16"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static text:NetworkAccelerationText.RollingAverageLabel}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="_rollingAverageTextBlock"
                                               Margin="0,8,0,0"
                                               FontSize="18"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="14"
                                    CornerRadius="16"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static text:NetworkAccelerationText.BurstPeakLabel}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="_burstPeakTextBlock"
                                               Margin="0,8,0,0"
                                               FontSize="18"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3"
                  Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,8,0"
                        Padding="20"
                        CornerRadius="20"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{x:Static text:NetworkAccelerationText.PreferredModeTitle}"
                                   Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{x:Static text:NetworkAccelerationText.PreferredModeDescription}"
                                   Style="{StaticResource AppPageDescriptionTextBlockStyle}" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="_modeComboBox"
                                      Width="230"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="ModeComboBox_SelectionChanged"
                                      AutomationProperties.AutomationId="NetworkAcceleration_ModeComboBox">
                                <ComboBoxItem Content="{x:Static text:NetworkAccelerationText.ModeBalanced}" Tag="Balanced" />
                                <ComboBoxItem Content="{x:Static text:NetworkAccelerationText.ModeGaming}" Tag="Gaming" />
                                <ComboBoxItem Content="{x:Static text:NetworkAccelerationText.ModeStreaming}" Tag="Streaming" />
                            </ComboBox>

                            <wpfui:Button Grid.Column="1"
                                          Width="120"
                                          Margin="10,0,0,0"
                                          Content="{x:Static text:NetworkAccelerationText.SaveModeButton}"
                                          Appearance="Secondary"
                                          AutomationProperties.AutomationId="NetworkAcceleration_SaveModeButton"
                                          Click="SaveModeButton_Click" />
                        </Grid>

                        <Border Margin="0,16,0,0"
                                Padding="14"
                                CornerRadius="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{x:Static text:NetworkAccelerationText.CurrentModeLabel}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_modeDescriptionTextBlock"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="20"
                        CornerRadius="20"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{x:Static text:NetworkAccelerationText.QuickActionsTitle}"
                                   Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{x:Static text:NetworkAccelerationText.QuickActionsDescription}"
                                   Style="{StaticResource AppPageDescriptionTextBlockStyle}" />

                        <WrapPanel Margin="0,16,0,0">
                            <wpfui:Button Content="{x:Static text:NetworkAccelerationText.RunQuickOptimizationButton}"
                                          Width="190"
                                          Margin="0,0,10,10"
                                          Appearance="Primary"
                                          AutomationProperties.AutomationId="NetworkAcceleration_QuickOptimizeButton"
                                          Click="QuickOptimizeButton_Click" />
                            <wpfui:Button Content="{x:Static text:NetworkAccelerationText.ResetNetworkStackButton}"
                                          Width="180"
                                          Margin="0,0,0,10"
                                          AutomationProperties.AutomationId="NetworkAcceleration_ResetStackButton"
                                          Click="ResetStackButton_Click" />
                        </WrapPanel>

                        <Border Margin="0,6,0,0"
                                Padding="12"
                                CornerRadius="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.AdminHint}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="4"
                    Padding="18"
                    CornerRadius="20"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{x:Static text:NetworkAccelerationText.StatusCardTitle}"
                               Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <wpfui:SymbolIcon x:Name="_statusIcon"
                                          Symbol="CheckmarkCircle24"
                                          FontSize="16"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Top"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="_statusTextBlock"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="NetworkAcceleration_StatusText" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>

</UserControl>
