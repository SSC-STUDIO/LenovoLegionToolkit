<UserControl x:Class="LenovoLegionToolkit.Plugins.NetworkAcceleration.NetworkAccelerationSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="clr-namespace:LenovoLegionToolkit.Plugins.NetworkAcceleration"
             xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="920">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0"
                    AutomationProperties.AutomationId="NetworkAcceleration_SettingsRoot">

            <!-- Hero Status Banner -->
            <Border Margin="0,0,0,20"
                    Padding="16,14"
                    CornerRadius="10"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="40" Height="40"
                            CornerRadius="8"
                            Margin="0,0,16,0"
                            Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                        <wpfui:SymbolIcon Symbol="Settings24"
                                          FontSize="20"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="White" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.CurrentModeLabel}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_modeSummaryTextBlock"
                                       Margin="6,0,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <wpfui:SymbolIcon x:Name="_statusIcon"
                                          Symbol="CheckmarkCircle24"
                                          FontSize="16"
                                          Margin="0,0,8,0"
                                          Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        <TextBlock x:Name="_statusTextBlock"
                                   AutomationProperties.AutomationId="NetworkAcceleration_SettingsStatusText"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Settings Cards -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Card: Options -->
                <Border Grid.Column="0"
                        Padding="18,16"
                        CornerRadius="10"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <wpfui:SymbolIcon Symbol="Options24"
                                              FontSize="18"
                                              Margin="0,0,10,0"
                                              Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.SettingsTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <TextBlock Margin="0,0,0,16"
                                   Text="{x:Static text:NetworkAccelerationText.SettingsDescription}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <CheckBox x:Name="_autoOptimizeOnStartupCheckBox"
                                  Margin="0,0,0,12"
                                  Checked="SettingsCheckBox_Changed"
                                  Unchecked="SettingsCheckBox_Changed"
                                  AutomationProperties.AutomationId="NetworkAcceleration_AutoOptimizeCheckBox"
                                  Content="{x:Static text:NetworkAccelerationText.AutoOptimizeOnStartup}" />

                        <CheckBox x:Name="_resetWinsockCheckBox"
                                  Margin="0,0,0,12"
                                  Checked="SettingsCheckBox_Changed"
                                  Unchecked="SettingsCheckBox_Changed"
                                  AutomationProperties.AutomationId="NetworkAcceleration_ResetWinsockCheckBox"
                                  Content="{x:Static text:NetworkAccelerationText.ResetWinsockOnOptimize}" />

                        <CheckBox x:Name="_resetTcpIpCheckBox"
                                  Checked="SettingsCheckBox_Changed"
                                  Unchecked="SettingsCheckBox_Changed"
                                  AutomationProperties.AutomationId="NetworkAcceleration_ResetTcpIpCheckBox"
                                  Content="{x:Static text:NetworkAccelerationText.ResetTcpIpOnOptimize}" />
                    </StackPanel>
                </Border>

                <!-- Right Card: Summary -->
                <Border Grid.Column="2"
                        Padding="18,16"
                        CornerRadius="10"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <wpfui:SymbolIcon Symbol="Info24"
                                              FontSize="18"
                                              Margin="0,0,10,0"
                                              Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <TextBlock Text="{x:Static text:NetworkAccelerationText.SettingsSummaryTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <TextBlock Margin="0,0,0,16"
                                   Text="{x:Static text:NetworkAccelerationText.SettingsSummaryDescription}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       FontSize="12"
                                       Text="{x:Static text:NetworkAccelerationText.AutoOptimizeOnStartup}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_startupSummaryTextBlock"
                                       Grid.Row="0" Grid.Column="1"
                                       Margin="12,0,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                            <TextBlock Grid.Row="1" Margin="0,12,0,0"
                                       FontSize="12"
                                       Text="{x:Static text:NetworkAccelerationText.ResetWinsockOnOptimize}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_winsockSummaryTextBlock"
                                       Grid.Row="1" Grid.Column="1"
                                       Margin="12,12,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                            <TextBlock Grid.Row="2" Margin="0,12,0,0"
                                       FontSize="12"
                                       Text="{x:Static text:NetworkAccelerationText.ResetTcpIpOnOptimize}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_tcpSummaryTextBlock"
                                       Grid.Row="2" Grid.Column="1"
                                       Margin="12,12,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Action Bar -->
            <Border Padding="16,12"
                    CornerRadius="10"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{x:Static text:NetworkAccelerationText.AdminHint}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <wpfui:Button Grid.Column="1"
                                  MinWidth="140"
                                  Margin="18,0,0,0"
                                  Appearance="Primary"
                                  Icon="Save24"
                                  Content="{x:Static text:NetworkAccelerationText.SaveSettingsButton}"
                                  AutomationProperties.AutomationId="NetworkAcceleration_SaveSettingsButton"
                                  Click="SaveButton_Click" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
