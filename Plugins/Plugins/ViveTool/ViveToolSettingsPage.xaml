<UserControl
    x:Class="LenovoLegionToolkit.Plugins.ViveTool.ViveToolSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:pluginRes="clr-namespace:LenovoLegionToolkit.Plugins.ViveTool.Resources"
    AutomationProperties.AutomationId="ViveToolSettingsRoot">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,16,16">
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="22"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,24,0">
                        <Border Padding="10,4"
                                HorizontalAlignment="Left"
                                CornerRadius="999"
                                Background="#122B579A">
                            <TextBlock Text="{x:Static pluginRes:Resource.ViveTool_ViveToolStatus}"
                                       Style="{StaticResource AppHeroBadgeTextBlockStyle}"
                                       Foreground="#FF5CA9FF" />
                        </Border>

                        <TextBlock Margin="0,12,0,0"
                                   Style="{StaticResource AppPageTitleTextBlockStyle}"
                                   Text="{x:Static pluginRes:Resource.ViveTool_BinaryPathTitle}" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <wpfui:SymbolIcon x:Name="_statusIcon"
                                              Symbol="CheckmarkCircle24"
                                              FontSize="16"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Top"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="_statusTextBlock"
                                       Style="{StaticResource AppPageDescriptionTextBlockStyle}" />
                        </StackPanel>

                        <Grid x:Name="_downloadProgressGrid"
                              Margin="0,14,0,0"
                              Visibility="Collapsed">
                            <ProgressBar x:Name="_downloadProgressBar"
                                         Height="8"
                                         Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                         BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                         BorderThickness="1"
                                         Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                         HorizontalAlignment="Stretch" />
                            <TextBlock x:Name="_downloadProgressText"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,12,0,0" />
                        </Grid>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="16"
                            CornerRadius="16"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="{x:Static pluginRes:Resource.ViveTool_PathDescription}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <WrapPanel Margin="0,18,0,0">
                                <wpfui:Button x:Name="_gitHubButton"
                                              Content="{x:Static pluginRes:Resource.ViveTool_GitHub}"
                                              Icon="Open24"
                                              Click="GitHubButton_Click"
                                              Padding="12,6"
                                              Margin="0,0,8,8" />
                                <wpfui:Button x:Name="_downloadViveToolButton"
                                              Content="{x:Static pluginRes:Resource.ViveTool_Download}"
                                              Appearance="Primary"
                                              Click="DownloadViveToolButton_Click"
                                              Padding="12,6"
                                              Margin="0,0,8,8" />
                                <wpfui:Button x:Name="_refreshStatusButton"
                                              Content="{x:Static pluginRes:Resource.ViveTool_Refresh}"
                                              Click="RefreshStatusButton_Click"
                                              Padding="12,6"
                                              Margin="0,0,0,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="22">
                <StackPanel>
                    <TextBlock Text="{x:Static pluginRes:Resource.ViveTool_BinaryPathTitle}"
                               Style="{StaticResource AppSectionTitleTextBlockStyle}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <wpfui:TextBox Grid.Column="0"
                                       x:Name="_viveToolPathTextBox"
                                       PlaceholderText="{x:Static pluginRes:Resource.ViveTool_PathPlaceholder}"
                                       Margin="0,0,8,0"
                                       IsReadOnly="True" />
                        <wpfui:Button Grid.Column="1"
                                      x:Name="_browseViveToolButton"
                                      Content="{x:Static pluginRes:Resource.ViveTool_Browse}"
                                      Click="BrowseViveToolButton_Click"
                                      Padding="12,6"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center" />
                        <wpfui:Button Grid.Column="2"
                                      x:Name="_importConfigButton"
                                      Content="{x:Static pluginRes:Resource.ViveTool_ImportConfig}"
                                      Click="ImportConfigButton_Click"
                                      Padding="12,6"
                                      VerticalAlignment="Center" />
                    </Grid>

                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12"
                            Margin="0,14,0,0">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="18"
                                   Text="{x:Static pluginRes:Resource.ViveTool_PathDescription}" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
