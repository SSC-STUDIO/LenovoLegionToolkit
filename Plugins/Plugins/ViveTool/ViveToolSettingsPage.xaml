<UserControl
    x:Class="LenovoLegionToolkit.Plugins.ViveTool.ViveToolSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:pluginRes="clr-namespace:LenovoLegionToolkit.Plugins.ViveTool.Resources"
    AutomationProperties.AutomationId="ViveToolSettingsRoot">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="0,0,0,16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,24,0"
                                VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource AppPageDescriptionTextBlockStyle}"
                                   Text="{x:Static pluginRes:Resource.ViveTool_PathDescription}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="18"
                            CornerRadius="18"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="{x:Static pluginRes:Resource.ViveTool_ViveToolStatus}"
                                       Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,10,0,0">
                                <wpfui:SymbolIcon x:Name="_statusIcon"
                                                  Symbol="CheckmarkCircle24"
                                                  FontSize="16"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Top"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="_statusTextBlock"
                                           Style="{StaticResource AppPageDescriptionTextBlockStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel x:Name="_downloadProgressGrid"
                                        Margin="0,14,0,0"
                                        Visibility="Collapsed">
                                <ProgressBar x:Name="_downloadProgressBar"
                                             Height="8"
                                             Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                             BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                             BorderThickness="1"
                                             Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                             HorizontalAlignment="Stretch" />
                                <TextBlock x:Name="_downloadProgressText"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,8,0"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="{x:Static pluginRes:Resource.ViveTool_BinaryPathTitle}"
                                   Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource AppPageDescriptionTextBlockStyle}"
                                   Text="{x:Static pluginRes:Resource.ViveTool_PathDescription}" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <wpfui:TextBox Grid.Column="0"
                                           x:Name="_viveToolPathTextBox"
                                           PlaceholderText="{x:Static pluginRes:Resource.ViveTool_PathPlaceholder}"
                                           Margin="0,0,8,0"
                                           IsReadOnly="True" />
                            <wpfui:Button Grid.Column="1"
                                          x:Name="_browseViveToolButton"
                                          Content="{x:Static pluginRes:Resource.ViveTool_Browse}"
                                          Click="BrowseViveToolButton_Click"
                                          Padding="12,6"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center" />
                            <wpfui:Button Grid.Column="2"
                                          x:Name="_importConfigButton"
                                          Content="{x:Static pluginRes:Resource.ViveTool_ImportConfig}"
                                          Click="ImportConfigButton_Click"
                                          Padding="12,6"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Margin="8,0,0,0"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="{x:Static pluginRes:Resource.ViveTool_GitHub}"
                                   Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource AppPageDescriptionTextBlockStyle}"
                                   Text="{x:Static pluginRes:Resource.ViveTool_ImportConfigDescription}" />

                        <WrapPanel Margin="0,18,0,0">
                            <wpfui:Button x:Name="_gitHubButton"
                                          Content="{x:Static pluginRes:Resource.ViveTool_GitHub}"
                                          Icon="Open24"
                                          Click="GitHubButton_Click"
                                          Padding="12,6"
                                          Margin="0,0,8,8" />
                            <wpfui:Button x:Name="_downloadViveToolButton"
                                          Content="{x:Static pluginRes:Resource.ViveTool_Download}"
                                          Appearance="Primary"
                                          Click="DownloadViveToolButton_Click"
                                          Padding="12,6"
                                          Margin="0,0,8,8" />
                            <wpfui:Button x:Name="_refreshStatusButton"
                                          Content="{x:Static pluginRes:Resource.ViveTool_Refresh}"
                                          Click="RefreshStatusButton_Click"
                                          Padding="12,6"
                                          Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="18">
                <StackPanel Orientation="Horizontal">
                    <wpfui:SymbolIcon Symbol="Info24"
                                      FontSize="16"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Top"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Static pluginRes:Resource.ViveTool_ImportConfigDescription}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
