<UserControl x:Class="LenovoLegionToolkit.Plugins.ViveTool.ViveToolSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:pluginRes="clr-namespace:LenovoLegionToolkit.Plugins.ViveTool.Resources"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="920"
             AutomationProperties.AutomationId="ViveToolSettingsRoot">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="0,0,0,16"
                    Padding="24"
                    CornerRadius="20"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,24,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Static pluginRes:Resource.ViveTool_ViveToolStatus}"
                                   Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{x:Static pluginRes:Resource.ViveTool_PathDescription}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource AppPageDescriptionTextBlockStyle}" />

                        <Border Margin="0,18,0,0"
                                Padding="14"
                                CornerRadius="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{x:Static pluginRes:Resource.ViveTool_ImportConfigTitle}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{x:Static pluginRes:Resource.ViveTool_ImportConfigDescription}"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource AppPageDescriptionTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Padding="18"
                                CornerRadius="18"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{x:Static pluginRes:Resource.ViveTool_ViveToolStatus}"
                                           Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,12,0,0">
                                    <wpfui:SymbolIcon x:Name="_statusIcon"
                                                      Symbol="CheckmarkCircle24"
                                                      FontSize="16"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Top"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="_statusTextBlock"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource AppPageDescriptionTextBlockStyle}" />
                                </StackPanel>

                                <Border Margin="0,14,0,0"
                                        Padding="12"
                                        CornerRadius="14"
                                        Background="{DynamicResource ControlFillColorTertiaryBrush}">
                                    <StackPanel x:Name="_downloadProgressGrid"
                                                Visibility="Collapsed">
                                        <TextBlock Text="{x:Static pluginRes:Resource.ViveTool_Downloading}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ProgressBar x:Name="_downloadProgressBar"
                                                     Height="8"
                                                     Margin="0,10,0,0"
                                                     Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                     BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                     BorderThickness="1"
                                                     Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                     HorizontalAlignment="Stretch" />
                                        <TextBlock x:Name="_downloadProgressText"
                                                   Margin="0,8,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Margin="0,12,0,0"
                                Padding="14"
                                CornerRadius="16"
                                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <wpfui:SymbolIcon Symbol="Warning24"
                                                  FontSize="16"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Top"
                                                  Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Static pluginRes:Resource.ViveTool_WarningMessage}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,8,0"
                        Padding="20"
                        CornerRadius="20"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{x:Static pluginRes:Resource.ViveTool_BinaryPathTitle}"
                                   Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{x:Static pluginRes:Resource.ViveTool_PathDescription}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource AppPageDescriptionTextBlockStyle}" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <wpfui:TextBox Grid.Column="0"
                                           x:Name="_viveToolPathTextBox"
                                           PlaceholderText="{x:Static pluginRes:Resource.ViveTool_PathPlaceholder}"
                                           Margin="0,0,8,0"
                                           IsReadOnly="True" />
                            <wpfui:Button Grid.Column="1"
                                          x:Name="_browseViveToolButton"
                                          Content="{x:Static pluginRes:Resource.ViveTool_Browse}"
                                          Click="BrowseViveToolButton_Click"
                                          Padding="12,6"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="20"
                        CornerRadius="20"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{x:Static pluginRes:Resource.ViveTool_GitHub}"
                                   Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{x:Static pluginRes:Resource.ViveTool_ImportDescription}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource AppPageDescriptionTextBlockStyle}" />

                        <WrapPanel Margin="0,18,0,0">
                            <wpfui:Button x:Name="_gitHubButton"
                                          Content="{x:Static pluginRes:Resource.ViveTool_GitHub}"
                                          Icon="Open24"
                                          Click="GitHubButton_Click"
                                          Padding="12,6"
                                          Margin="0,0,8,8" />
                            <wpfui:Button x:Name="_downloadViveToolButton"
                                          Content="{x:Static pluginRes:Resource.ViveTool_Download}"
                                          Appearance="Primary"
                                          Click="DownloadViveToolButton_Click"
                                          Padding="12,6"
                                          Margin="0,0,8,8" />
                            <wpfui:Button x:Name="_refreshStatusButton"
                                          Content="{x:Static pluginRes:Resource.ViveTool_Refresh}"
                                          Click="RefreshStatusButton_Click"
                                          Padding="12,6"
                                          Margin="0,0,8,8" />
                            <wpfui:Button x:Name="_importConfigButton"
                                          Content="{x:Static pluginRes:Resource.ViveTool_ImportConfig}"
                                          Click="ImportConfigButton_Click"
                                          Padding="12,6"
                                          Margin="0,0,0,8" />
                        </WrapPanel>

                        <Border Margin="0,18,0,0"
                                Padding="14"
                                CornerRadius="16"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Static pluginRes:Resource.ViveTool_ImportConfigDescription}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource AppPageDescriptionTextBlockStyle}" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Padding="18"
                    CornerRadius="20"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <wpfui:SymbolIcon Symbol="Info24"
                                      FontSize="16"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Top"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Static pluginRes:Resource.ViveTool_ImportDescription}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
