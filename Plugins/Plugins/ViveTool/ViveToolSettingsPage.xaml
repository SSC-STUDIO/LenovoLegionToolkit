<UserControl x:Class="LenovoLegionToolkit.Plugins.ViveTool.ViveToolSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:pluginRes="clr-namespace:LenovoLegionToolkit.Plugins.ViveTool.Resources"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="920"
             AutomationProperties.AutomationId="ViveToolSettingsRoot">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="0,0,0,18"
                    Padding="12,9"
                    CornerRadius="8"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <wpfui:SymbolIcon x:Name="_statusIcon"
                                      Symbol="CheckmarkCircle24"
                                      FontSize="16"
                                      Margin="0,1,8,0"
                                      VerticalAlignment="Top"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="_statusTextBlock"
                                   AutomationProperties.AutomationId="ViveToolSettingsStatusText"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource AppPageDescriptionTextBlockStyle}" />
                        <StackPanel x:Name="_downloadProgressGrid"
                                    AutomationProperties.AutomationId="ViveToolSettingsDownloadProgressPanel"
                                    Margin="0,10,0,0"
                                    Visibility="Collapsed">
                            <ProgressBar x:Name="_downloadProgressBar"
                                         AutomationProperties.AutomationId="ViveToolSettingsDownloadProgressBar"
                                         Height="8"
                                         Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                         BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                         BorderThickness="1"
                                         Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                         HorizontalAlignment="Stretch" />
                            <TextBlock x:Name="_downloadProgressText"
                                       AutomationProperties.AutomationId="ViveToolSettingsDownloadProgressText"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{x:Static pluginRes:Resource.ViveTool_BinaryPathTitle}"
                               Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                    <TextBlock Margin="0,6,0,12"
                               Text="{x:Static pluginRes:Resource.ViveTool_PathDescription}"
                               TextWrapping="Wrap"
                               Style="{StaticResource AppPageDescriptionTextBlockStyle}" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <wpfui:TextBox Grid.Column="0"
                                   x:Name="_viveToolPathTextBox"
                                   AutomationProperties.AutomationId="ViveToolSettingsPathTextBox"
                                   PlaceholderText="{x:Static pluginRes:Resource.ViveTool_PathPlaceholder}"
                                   Margin="0,0,8,0"
                                   IsReadOnly="True" />
                    <wpfui:Button Grid.Column="1"
                                  x:Name="_browseViveToolButton"
                                  AutomationProperties.AutomationId="ViveToolSettingsBrowseButton"
                                  Content="{x:Static pluginRes:Resource.ViveTool_Browse}"
                                  Click="BrowseViveToolButton_Click"
                                  Padding="12,6"
                                  VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,16,0,0"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="{x:Static pluginRes:Resource.ViveTool_GitHub}"
                                   Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{x:Static pluginRes:Resource.ViveTool_ImportDescription}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource AppPageDescriptionTextBlockStyle}" />
                    </StackPanel>

                    <WrapPanel Grid.Column="1" VerticalAlignment="Top">
                        <wpfui:Button x:Name="_gitHubButton"
                                      AutomationProperties.AutomationId="ViveToolSettingsGitHubButton"
                                      Content="{x:Static pluginRes:Resource.ViveTool_GitHub}"
                                      Icon="Open24"
                                      Click="GitHubButton_Click"
                                      Padding="12,6"
                                      Margin="0,0,8,8" />
                        <wpfui:Button x:Name="_downloadViveToolButton"
                                      AutomationProperties.AutomationId="ViveToolSettingsDownloadButton"
                                      Content="{x:Static pluginRes:Resource.ViveTool_Download}"
                                      Appearance="Primary"
                                      Click="DownloadViveToolButton_Click"
                                      Padding="12,6"
                                      Margin="0,0,8,8" />
                        <wpfui:Button x:Name="_refreshStatusButton"
                                      AutomationProperties.AutomationId="ViveToolSettingsRefreshStatusButton"
                                      Content="{x:Static pluginRes:Resource.ViveTool_Refresh}"
                                      Icon="ArrowClockwise24"
                                      Click="RefreshStatusButton_Click"
                                      Padding="12,6"
                                      Margin="0,0,8,8" />
                        <wpfui:Button x:Name="_importConfigButton"
                                      AutomationProperties.AutomationId="ViveToolSettingsImportConfigButton"
                                      Content="{x:Static pluginRes:Resource.ViveTool_ImportConfig}"
                                      Icon="ArrowImport24"
                                      Click="ImportConfigButton_Click"
                                      Padding="12,6"
                                      Margin="0,0,0,8" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Padding="12,9"
                    CornerRadius="8"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <wpfui:SymbolIcon Symbol="Warning24"
                                      FontSize="16"
                                      Margin="0,1,8,0"
                                      VerticalAlignment="Top"
                                      Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Static pluginRes:Resource.ViveTool_WarningMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
