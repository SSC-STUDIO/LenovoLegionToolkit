<UserControl
    x:Class="LenovoLegionToolkit.Plugins.ViveTool.ViveToolPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
    xmlns:plugin="clr-namespace:LenovoLegionToolkit.Plugins.ViveTool"
    xmlns:pluginRes="clr-namespace:LenovoLegionToolkit.Plugins.ViveTool.Resources"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.Plugins.ViveTool.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    AutomationProperties.AutomationId="ViveToolPageRoot"
    FlowDirection="LeftToRight"
    Loaded="Page_Loaded"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="Auto"
    Unloaded="Page_Unloaded"
    UseLayoutRounding="True">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <utils:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <plugin:FeatureStatusConverter x:Key="FeatureStatusConverter" />

        <Style x:Key="FeatureRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
            <Setter Property="Padding" Value="0,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="1">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="2">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{x:Static pluginRes:Resource.ViveTool_PageTitle}"
                               Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{x:Static pluginRes:Resource.ViveTool_PageDescription}"
                               TextWrapping="Wrap"
                               Style="{StaticResource AppPageDescriptionTextBlockStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            MinWidth="260"
                            Margin="24,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding ViveToolStatusDescription}"
                               AutomationProperties.AutomationId="ViveToolStatusDescriptionText"
                               TextWrapping="Wrap"
                               TextAlignment="Right"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding ViveToolPath}"
                               AutomationProperties.AutomationId="ViveToolPathText"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               TextAlignment="Right"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,0,0,12"
                    Padding="12,9"
                    CornerRadius="8"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <wpfui:SymbolIcon Symbol="Warning24"
                                      FontSize="16"
                                      Margin="0,1,8,0"
                                      VerticalAlignment="Top"
                                      Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Static pluginRes:Resource.ViveTool_WarningMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,0,0,12"
                    Padding="14"
                    CornerRadius="8"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                    BorderThickness="1"
                    Visibility="{Binding IsViveToolAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="{x:Static pluginRes:Resource.ViveTool_MissingToolMessage}"
                                   Style="{StaticResource AppSubsectionTitleTextBlockStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{x:Static pluginRes:Resource.ViveTool_PathDescription}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource AppPageDescriptionTextBlockStyle}" />
                    </StackPanel>

                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <wpfui:Button Content="{x:Static pluginRes:Resource.ViveTool_GoToSettings}"
                                      AutomationProperties.AutomationId="ViveToolMissingGoToSettingsButton"
                                      Appearance="Primary"
                                      Icon="Settings24"
                                      Click="GoToSettingsButton_Click"
                                      Padding="14,6"
                                      Margin="0,0,8,0" />
                        <wpfui:Button Content="{x:Static pluginRes:Resource.ViveTool_Refresh}"
                                      AutomationProperties.AutomationId="ViveToolMissingRefreshStatusButton"
                                      Icon="ArrowClockwise24"
                                      Click="RefreshStatusButton_Click"
                                      Padding="14,6" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3"
                  Margin="0,0,0,12"
                  Visibility="{Binding IsViveToolAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <wpfui:TextBox x:Name="_searchTextBox"
                               AutomationProperties.AutomationId="ViveToolSearchTextBox"
                               Grid.Column="0"
                               Height="36"
                               FontSize="13"
                               Icon="Search24"
                               PlaceholderText="{x:Static pluginRes:Resource.ViveTool_SearchPlaceholder}"
                               TextChanged="SearchTextBox_TextChanged"
                               Margin="0,0,12,0" />

                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="_featureCountTextBlock"
                               AutomationProperties.AutomationId="ViveToolFeatureCountText"
                               MinWidth="96"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <wpfui:Button x:Name="_importButton"
                                  AutomationProperties.AutomationId="ViveToolImportButton"
                                  Appearance="Primary"
                                  Icon="ArrowImport24"
                                  Content="{x:Static pluginRes:Resource.ViveTool_Import}"
                                  Click="ImportButton_Click"
                                  Margin="0,0,8,0"
                                  Padding="14,6" />
                    <wpfui:Button x:Name="_refreshListButton"
                                  AutomationProperties.AutomationId="ViveToolRefreshListButton"
                                  Icon="ArrowClockwise24"
                                  Content="{x:Static pluginRes:Resource.ViveTool_RefreshList}"
                                  Click="RefreshListButton_Click"
                                  Margin="0,0,8,0"
                                  Padding="14,6" />
                    <wpfui:Button Content="{x:Static pluginRes:Resource.ViveTool_GoToSettings}"
                                  AutomationProperties.AutomationId="ViveToolFeatureGoToSettingsButton"
                                  Icon="Settings24"
                                  Click="GoToSettingsButton_Click"
                                  Padding="14,6" />
                </WrapPanel>
            </Grid>

            <Grid Grid.Row="4"
                  Visibility="{Binding IsViveToolAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel x:Name="_loadingPanel"
                            AutomationProperties.AutomationId="ViveToolLoadingPanel"
                            HorizontalAlignment="Center"
                            Margin="0,36,0,40"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <wpfui:ProgressRing Height="20"
                                        IsIndeterminate="True"
                                        Margin="0,0,12,0"
                                        Width="20" />
                    <TextBlock FontSize="14"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{x:Static pluginRes:Resource.ViveTool_Loading}" />
                </StackPanel>

                <DataGrid x:Name="_featuresDataGrid"
                          AutomationProperties.AutomationId="ViveToolFeaturesDataGrid"
                          AutoGenerateColumns="False"
                          Background="Transparent"
                          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          ItemsSource="{Binding Features}"
                          MaxHeight="700"
                          RowHeight="48"
                          RowStyle="{StaticResource FeatureRowStyle}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Id}"
                                            Header="{x:Static pluginRes:Resource.ViveTool_FeatureId}"
                                            Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Name}"
                                            Header="{x:Static pluginRes:Resource.ViveTool_FeatureName}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Status, Converter={StaticResource FeatureStatusConverter}}"
                                            Header="{x:Static pluginRes:Resource.ViveTool_Status}"
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="1">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="2">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="{x:Static pluginRes:Resource.ViveTool_Actions}"
                                                Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <wpfui:Button Appearance="Primary"
                                                      AutomationProperties.AutomationId="{Binding Id, StringFormat=ViveToolEnableFeatureButton_{0}}"
                                                      Click="EnableFeatureButton_Click"
                                                      Content="{x:Static pluginRes:Resource.ViveTool_Enable}"
                                                      FontSize="12"
                                                      Icon="Checkmark24"
                                                      Margin="0,0,8,0"
                                                      Padding="10,4"
                                                      Tag="{Binding Id}" />
                                        <wpfui:Button Click="DisableFeatureButton_Click"
                                                      AutomationProperties.AutomationId="{Binding Id, StringFormat=ViveToolDisableFeatureButton_{0}}"
                                                      Content="{x:Static pluginRes:Resource.ViveTool_Disable}"
                                                      FontSize="12"
                                                      Icon="Dismiss24"
                                                      Padding="10,4"
                                                      Tag="{Binding Id}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="_emptyStatePanel"
                            AutomationProperties.AutomationId="ViveToolEmptyStatePanel"
                            HorizontalAlignment="Center"
                            Margin="0,48,0,40"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <wpfui:SymbolIcon Symbol="Search24"
                                      FontSize="26"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Margin="0,12,0,0"
                               FontSize="16"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{x:Static pluginRes:Resource.ViveTool_NoFeaturesFound}"
                               TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
