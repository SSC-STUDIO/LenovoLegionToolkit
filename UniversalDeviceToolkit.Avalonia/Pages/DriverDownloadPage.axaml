<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:UniversalDeviceToolkit.Avalonia.Localization"
             xmlns:controls="using:UniversalDeviceToolkit.Avalonia.Controls"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="UniversalDeviceToolkit.Avalonia.Pages.DriverDownloadPage">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16"
                    Margin="32,24,32,32"
                    MaxWidth="900"
                    HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <controls:LocalizedTextBlock Text="{local:Loc Key=WindowsOptimizationPage_Tab_DriverDownload, Fallback=Driver downloads}"
                                             FontSize="{StaticResource FontSizeDisplaySection}"
                                             FontWeight="Medium"
                                             OverflowMode="Wrap"
                                             MaxLines="2"
                                             automation:AutomationProperties.AutomationId="AvaloniaDriverDownloadTitle" />
                <controls:LocalizedTextBlock Text="{local:Loc Key=WindowsOptimizationPage_DriverEmpty_NotScanned_Message, Fallback=Choose a source and scan to list compatible driver downloads.}"
                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                             OverflowMode="Wrap"
                                             MaxLines="3" />
            </StackPanel>

            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusCard}"
                    Padding="16">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="10">
                    <ComboBox x:Name="SourceComboBox"
                              ItemsSource="{Binding Sources}"
                              SelectedIndex="0"
                              automation:AutomationProperties.AutomationId="AvaloniaDriverSource" />
                    <TextBox x:Name="MachineTypeTextBox"
                             Grid.Column="1"
                             Watermark="{local:Loc Key=PackagesPage_MachineType_Placeholder, Fallback=Machine type}"
                             automation:AutomationProperties.AutomationId="AvaloniaDriverMachineType" />
                    <ComboBox x:Name="OsComboBox"
                              Grid.Column="2"
                              automation:AutomationProperties.AutomationId="AvaloniaDriverOperatingSystem" />
                    <Button Grid.Column="3"
                            Content="{local:Loc Key=WindowsOptimizationPage_Scan_Button, Fallback=Scan}"
                             Click="ScanButton_Click"
                             automation:AutomationProperties.AutomationId="AvaloniaDriverScan" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBox x:Name="DownloadPathTextBox"
                                 Watermark="{local:Loc Key=PackagesPage_DownloadTo_Placeholder, Fallback=Download folder}"
                                 LostFocus="DownloadPathTextBox_LostFocus"
                                 automation:AutomationProperties.AutomationId="AvaloniaDriverDownloadPath" />
                        <Button Grid.Column="1"
                                Content="{local:Loc Key=PackagesPage_DownloadTo, Fallback=Browse}"
                                Click="BrowseDownloadPathButton_Click"
                                automation:AutomationProperties.AutomationId="AvaloniaDriverBrowseDownloadPath" />
                        <Button Grid.Column="2"
                                Content="{local:Loc Key=PackagesPage_OpenDownloadTo, Fallback=Open folder}"
                                Click="OpenDownloadPathButton_Click"
                                automation:AutomationProperties.AutomationId="AvaloniaDriverOpenDownloadPath" />
                    </Grid>
                </Grid>
            </Border>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBox x:Name="FilterTextBox"
                         Watermark="{local:Loc Key=Filter, Fallback=Filter}"
                         TextChanged="FilterTextBox_TextChanged"
                         automation:AutomationProperties.AutomationId="AvaloniaDriverFilter" />
                <CheckBox x:Name="OnlyUpdatesCheckBox"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Content="{local:Loc Key=PackagesPage_OnlyShowUpdates, Fallback=Only show updates}"
                          Click="OnlyUpdatesCheckBox_Click"
                          automation:AutomationProperties.AutomationId="AvaloniaDriverOnlyUpdates" />
                <ComboBox x:Name="SortComboBox"
                          Grid.Column="2"
                          MinWidth="140"
                          SelectionChanged="SortComboBox_SelectionChanged"
                          automation:AutomationProperties.AutomationId="AvaloniaDriverSort">
                    <ComboBoxItem Content="{local:Loc Key=PackagesPage_Sort_Name, Fallback=Name}" Tag="Name" />
                    <ComboBoxItem Content="{local:Loc Key=PackagesPage_Sort_Category, Fallback=Category}" Tag="Category" />
                    <ComboBoxItem Content="{local:Loc Key=PackagesPage_Sort_Date, Fallback=Version}" Tag="Version" />
                </ComboBox>
            </Grid>
            <controls:LocalizedTextBlock x:Name="StateText"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          OverflowMode="Wrap"
                                          MaxLines="3" />
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusCard}"
                    Padding="12">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                    <Button Content="{local:Loc Key=WindowsOptimizationPage_SelectRecommended_Button, Fallback=Select recommended}"
                            Click="SelectRecommendedButton_Click"
                            automation:AutomationProperties.AutomationId="AvaloniaDriverSelectRecommended" />
                    <Button x:Name="StartPauseButton"
                            Grid.Column="1"
                            Content="{local:Loc Key=WindowsOptimizationPage_StartAll_Button, Fallback=Start selected}"
                            Click="StartPauseButton_Click"
                            automation:AutomationProperties.AutomationId="AvaloniaDriverStartPause" />
                    <Button Grid.Column="2"
                            Content="{local:Loc Key=Hide, Fallback=Hide selected}"
                            Click="HideSelectedButton_Click"
                            automation:AutomationProperties.AutomationId="AvaloniaDriverHideSelected" />
                    <Button x:Name="RestoreHiddenButton"
                            Grid.Column="4"
                            Content="{local:Loc Key=WindowsOptimizationPage_ShowHiddenDownloads, Fallback=Show hidden downloads}"
                            Click="RestoreHiddenButton_Click"
                            automation:AutomationProperties.AutomationId="AvaloniaDriverRestoreHidden" />
                </Grid>
            </Border>
            <StackPanel x:Name="PackagesPanel"
                        Spacing="8"
                        automation:AutomationProperties.AutomationId="AvaloniaDriverPackages" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
