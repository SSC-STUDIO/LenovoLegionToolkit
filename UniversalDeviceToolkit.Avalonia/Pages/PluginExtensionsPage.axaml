<UserControl
    x:Class="UniversalDeviceToolkit.Avalonia.Pages.PluginExtensionsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="using:UniversalDeviceToolkit.Avalonia.Resources"
    xmlns:custom="using:UniversalDeviceToolkit.Avalonia.Controls.Custom"
    xmlns:utils="using:UniversalDeviceToolkit.Avalonia.Utils"
    xmlns:ui="using:UniversalDeviceToolkit.Avalonia.Controls"
    x:Name="PluginExtensionsPageRoot"
    AutomationProperties.AutomationId="PluginExtensionsPageRoot"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}">

    <UserControl.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <utils:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <utils:BooleanAndConverter x:Key="BooleanAndConverter" />
        <utils:TextToVisibilityConverter x:Key="TextToVisibilityConverter" />
        <utils:PercentageToScaleConverter x:Key="PercentageToScaleConverter" />

        <ControlTheme x:Key="PluginListItemContainerTheme" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding PluginId, StringFormat=PluginCard_{0}}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ListBox.pluginListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style Selector="Border.pluginIcon">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusCard}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style Selector="StackPanel.inlineMetric">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,18,0" />
        </Style>

        <Style Selector="Border.metadataBadge">
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusCard}" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>

        <Style Selector="TextBlock.pluginCardSecondaryLine">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmallCaption}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Lightweight row chrome only — no card fill/stroke; shimmer lives on child blocks. -->
        <Style Selector="Border.pluginSkeletonRow">
            <Setter Property="MinHeight" Value="84" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.pluginStatusBadge">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMD}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.pluginCard">
            <Setter Property="MinHeight" Value="84" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusCard}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.pluginCard:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>

        <!-- Shared detail row action chrome (install / configure / open / uninstall). -->
        <Style Selector="ui|Button.detailAction">
            <Setter Property="Width" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="{StaticResource IconSizeMD}" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMD}" />
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ui|Button.detailPrimaryAction">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorBrush}" />
        </Style>
        <Style Selector="ui|Button.detailSecondaryAction" />
        <Style Selector="ui|Button.detailDangerAction">
            <Setter Property="Foreground" Value="{DynamicResource StatusCriticalTextBrush}" />
        </Style>

        <!-- Skeleton shimmer blocks (driven by the shared appSkeletonShimmerBlock class, Loading.axaml). -->
        <Style Selector="Border.skeletonShimmerBlock">
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSM}" />
        </Style>
    </UserControl.Styles>

    <custom:DynamicScrollViewer
        x:Name="_scrollViewer"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
    <Grid Margin="0,0,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,16,0,10">
            <TextBlock
                x:Name="_titleTextBlock"
                Focusable="True"
                Classes="appPageTitleTextBlock"
                Text="{x:Static resources:Resource.PluginExtensionsPage_Title}" />
            <TextBlock
                x:Name="_descriptionTextBlock"
                Margin="0,6,0,0"
                Focusable="True"
                Classes="appPageDescriptionTextBlock"
                Text="{x:Static resources:Resource.PluginExtensionsPage_Description}" />
        </StackPanel>

        <!-- Offline / store-failure strip: never leave a blank page without recovery. -->
        <Border
            x:Name="_storeOfflineBanner"
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="12,10"
            IsVisible="False"
            Background="{DynamicResource ControlFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerRadiusCard}"
            AutomationProperties.AutomationId="PluginStoreOfflineBanner">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource IconSizeMD}"
                    Symbol="CloudDismiss24"
                    Foreground="{DynamicResource StatusWarningBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="_storeOfflineTitleText"
                        FontSize="{DynamicResource FontSizeSmallBody}"
                        FontWeight="Medium"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{x:Static resources:Resource.PluginExtensionsPage_StoreUnavailableTitle}" />
                    <TextBlock
                        x:Name="_storeOfflineMessageText"
                        Margin="0,2,0,0"
                        FontSize="{DynamicResource FontSizeSmallCaption}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="{x:Static resources:Resource.PluginExtensionsPage_StoreUnavailableMessage}" />
                </StackPanel>
                <ui:Button
                    x:Name="_storeRetryButton"
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    MinWidth="88"
                    VerticalAlignment="Center"
                    Appearance="Secondary"
                    AutomationProperties.AutomationId="PluginStoreRetryButton"
                    Click="StoreRetryButton_Click"
                    Content="{x:Static resources:Resource.PluginExtensionsPage_StoreRetry}" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,0,0,8"
                Padding="12,6"
                CornerRadius="{StaticResource CornerRadiusCard}"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                IsVisible="False">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <StackPanel Classes="inlineMetric">
                        <ui:SymbolIcon Symbol="Apps24" FontSize="{StaticResource IconSizeBadge}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{x:Static resources:Resource.PluginExtensionsPage_SummaryTotal}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="_summaryTotalTextBlock" Margin="6,0,0,0" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="0" />
                    </StackPanel>

                    <StackPanel Classes="inlineMetric">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="{StaticResource IconSizeBadge}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{x:Static resources:Resource.PluginExtensionsPage_SummaryInstalled}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="_summaryInstalledTextBlock" Margin="6,0,0,0" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="0" />
                    </StackPanel>

                    <StackPanel Classes="inlineMetric">
                        <ui:SymbolIcon Symbol="ArrowCircleUp24" FontSize="{StaticResource IconSizeBadge}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{x:Static resources:Resource.PluginExtensionsPage_SummaryUpdatesReady}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="_summaryUpdatesTextBlock" Margin="6,0,0,0" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="0" />
                    </StackPanel>

                    <StackPanel Classes="inlineMetric">
                        <ui:SymbolIcon Symbol="Pulse24" FontSize="{StaticResource IconSizeBadge}" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{x:Static resources:Resource.PluginExtensionsPage_SummaryStorePulse}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="_summaryStorePulseValueTextBlock" Margin="6,0,0,0" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="0" />
                    </StackPanel>
                </WrapPanel>

                <TextBlock x:Name="_summaryHintTextBlock"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{x:Static resources:Resource.PluginExtensionsPage_SummaryCheckingAvailability}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox
                x:Name="_searchTextBox"
                AutomationProperties.AutomationId="PluginSearchTextBox"
                Grid.Column="0"
                Height="36"
                MinWidth="240"
                Watermark="{x:Static resources:Resource.PluginExtensionsPage_SearchPlaceholder}"
                TextChanged="SearchTextBox_TextChanged"
                ClearButtonEnabled="True"
                Margin="0,0,12,0">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>

            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                <ComboBox
                    x:Name="_filterComboBox"
                    AutomationProperties.AutomationId="PluginFilterComboBox"
                    AutomationProperties.Name="{x:Static resources:Resource.PluginExtensionsPage_FilterAll}"
                    ToolTip.Tip="{x:Static resources:Resource.Filter}"
                    MinWidth="142"
                    Height="36"
                    Margin="8,0,0,0"
                    SelectionChanged="FilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="{x:Static resources:Resource.PluginExtensionsPage_FilterAll}" Tag="All" IsSelected="True" />
                    <ComboBoxItem Content="{x:Static resources:Resource.PluginExtensionsPage_FilterInstalled}" Tag="Installed" />
                    <ComboBoxItem Content="{x:Static resources:Resource.PluginExtensionsPage_FilterNotInstalled}" Tag="NotInstalled" />
                </ComboBox>

                <ui:Button
                    x:Name="_bulkImportButton"
                    AutomationProperties.AutomationId="PluginBulkImportButton"
                    Appearance="Secondary"
                    Margin="8,0,0,0"
                    Height="36"
                    Click="BulkImportButton_Click"
                    ToolTip.Tip="{x:Static resources:Resource.PluginExtensionsPage_BulkImportTooltip}"
                    Content="{x:Static resources:Resource.PluginExtensionsPage_ImportFromFiles}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Open24" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button
                    x:Name="_refreshButton"
                    AutomationProperties.AutomationId="PluginRefreshButton"
                    AutomationProperties.Name="{x:Static resources:Resource.PluginExtensionsPage_RefreshTooltip}"
                    Appearance="Secondary"
                    Margin="8,0,0,0"
                    Height="36"
                    Click="RefreshButton_Click"
                    ToolTip.Tip="{x:Static resources:Resource.PluginExtensionsPage_RefreshTooltip}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowClockwise24" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button
                    x:Name="_bulkUpdateButton"
                    AutomationProperties.AutomationId="PluginBulkUpdateButton"
                    Appearance="Primary"
                    Margin="8,0,0,0"
                    Height="36"
                    Click="BulkUpdateButton_Click"
                    IsVisible="False"
                    ToolTip.Tip="{x:Static resources:Resource.PluginExtensionsPage_UpdateAllTooltip}"
                    Content="{x:Static resources:Resource.PluginExtensionsPage_UpdateAll}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowCircleUp24" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button
                    x:Name="_bulkInstallButton"
                    AutomationProperties.AutomationId="PluginBulkInstallButton"
                    Appearance="Primary"
                    Margin="8,0,0,0"
                    Height="36"
                    Click="BulkInstallButton_Click"
                    IsVisible="False"
                    ToolTip.Tip="{x:Static resources:Resource.PluginExtensionsPage_InstallAllTooltip}"
                    Content="{x:Static resources:Resource.PluginExtensionsPage_InstallAll}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Open24" />
                    </ui:Button.Icon>
                </ui:Button>
            </WrapPanel>
        </Grid>
        <Grid Grid.Row="5">
            <!-- Hidden until load finishes so skeleton is never covered by an empty list panel. -->
            <Grid x:Name="_pluginListPanel" IsVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="_resultsCountTextBlock"
                    AutomationProperties.AutomationId="PluginResultsCountText"
                    Grid.Row="0"
                    Margin="2,0,0,6"
                    FontSize="{DynamicResource FontSizeSmallCaption}"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    IsVisible="False" />

                <ListBox x:Name="_pluginsListBox"
                         Grid.Row="1"
                         AutomationProperties.AutomationId="PluginListBox"
                         Classes="pluginListBox"
                         Padding="0,0,0,24"
                         ClipToBounds="False"
                         SelectionMode="Single"
                         SelectionChanged="PluginsListBox_SelectionChanged"
                         DoubleTapped="PluginListBox_MouseDoubleClick"
                         ItemContainerTheme="{StaticResource PluginListItemContainerTheme}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border AutomationProperties.AutomationId="{Binding PluginId, StringFormat=PluginCard_{0}}"
                                    Classes="pluginCard">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{x:Static resources:Resource.PluginExtensionsPage_OpenFolder}" Click="ContextMenu_OpenFolder_Click" Tag="{Binding PluginId}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="FolderOpen24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{x:Static resources:Resource.PluginExtensionsPage_CopyId}" Click="ContextMenu_CopyId_Click" Tag="{Binding PluginId}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Copy24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{x:Static resources:Resource.PluginExtensionsPage_Uninstall}" Click="PluginUninstallButton_Click" Tag="{Binding PluginId}" IsVisible="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Delete24" Foreground="{DynamicResource StatusCriticalTextBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid ClipToBounds="True">
                                    <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Column="0"
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            VerticalAlignment="Center"
                                            Classes="pluginIcon"
                                            Background="{Binding IconBackground}">
                                            <Grid>
                                                <TextBlock Text="{Binding IconLetter}"
                                                           FontSize="{DynamicResource FontSizePageDescription}"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Border Background="{DynamicResource SystemAccentColorBrush}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Width="16"
                                                        Height="16"
                                                        CornerRadius="{StaticResource CornerRadiusCard}"
                                                        Margin="0,0,1,1"
                                                        BorderBrush="{DynamicResource ControlFillColorDefaultBrush}"
                                                        BorderThickness="2"
                                                        IsVisible="{Binding ShouldShowInstalledActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <ui:SymbolIcon Symbol="Checkmark12"
                                                                   FontSize="{StaticResource IconSizeOverlay}"
                                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Grid.Row="0"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center">
                                            <WrapPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="{DynamicResource FontSizeBody}"
                                                           FontWeight="Medium"
                                                           MaxWidth="320"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding Version}"
                                                           Margin="8,1,0,0"
                                                           FontSize="{DynamicResource FontSizeSmallCaption}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Border Classes="pluginStatusBadge"
                                                        IsVisible="{Binding ShouldShowStatusBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="{DynamicResource FontSizeDenseCaption}"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <Border Classes="pluginStatusBadge"
                                                        IsVisible="{Binding IsLocal, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{x:Static resources:Resource.PluginExtensionsPage_LocalBadge}"
                                                               FontSize="{DynamicResource FontSizeDenseCaption}"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </WrapPanel>

                                            <TextBlock Text="{Binding SecondaryLineText}"
                                                       Classes="pluginCardSecondaryLine"
                                                       IsVisible="{Binding ShouldShowSecondaryLine, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <ItemsControl ItemsSource="{Binding Tags}"
                                                          Margin="0,6,0,0"
                                                          IsVisible="{Binding HasTags, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Classes="pluginStatusBadge">
                                                            <TextBlock Text="{Binding}"
                                                                       FontSize="{DynamicResource FontSizeDenseCaption}"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Grid.Row="0"
                                                Grid.RowSpan="4"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal"
                                                    IsVisible="{Binding IsInstalling, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <ui:Button x:Name="PluginUpdateButton"
                                                       AutomationProperties.AutomationId="{Binding DataContext.PluginId, RelativeSource={RelativeSource AncestorType=ListBoxItem}, StringFormat=PluginInstallButton_{0}}"
                                                       AutomationProperties.Name="{Binding DataContext.InstallButtonText, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       Classes="detailAction detailPrimaryAction"
                                                       Click="PluginInstallButton_Click"
                                                       Tag="{Binding DataContext.PluginId, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       ToolTip.Tip="{Binding DataContext.InstallButtonText, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       IsVisible="{Binding DataContext.ShouldShowInstallButton, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="ArrowDownload24"
                                                                   Foreground="{DynamicResource SystemAccentColorBrush}" />
                                                </ui:Button.Icon>
                                            </ui:Button>

                                            <ui:Button AutomationProperties.AutomationId="{Binding DataContext.PluginId, RelativeSource={RelativeSource AncestorType=ListBoxItem}, StringFormat=PluginConfigureButton_{0}}"
                                                       AutomationProperties.Name="{Binding DataContext.ConfigureButtonText, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       Classes="detailAction detailSecondaryAction"
                                                       ToolTip.Tip="{Binding DataContext.ConfigureButtonText, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       IsVisible="{Binding DataContext.ShouldShowConfigureButton, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Click="PluginConfigureButton_Click"
                                                       Tag="{Binding DataContext.PluginId, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Settings24"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </ui:Button.Icon>
                                            </ui:Button>

                                            <ui:Button AutomationProperties.AutomationId="{Binding DataContext.PluginId, RelativeSource={RelativeSource AncestorType=ListBoxItem}, StringFormat=PluginOpenButton_{0}}"
                                                       AutomationProperties.Name="{Binding DataContext.OpenButtonText, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       Classes="detailAction detailSecondaryAction"
                                                       Click="PluginOpenButton_Click"
                                                       Tag="{Binding DataContext.PluginId, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       ToolTip.Tip="{Binding DataContext.OpenButtonText, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                <ui:Button.IsVisible>
                                                    <MultiBinding Converter="{StaticResource BooleanAndConverter}">
                                                        <Binding Path="DataContext.ShouldShowInstalledActions" RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                                                        <Binding Path="DataContext.SupportsOpenAction" RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                                                    </MultiBinding>
                                                </ui:Button.IsVisible>
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Open24"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </ui:Button.Icon>
                                            </ui:Button>

                                            <ui:Button AutomationProperties.AutomationId="{Binding DataContext.PluginId, RelativeSource={RelativeSource AncestorType=ListBoxItem}, StringFormat=PluginUninstallButton_{0}}"
                                                       AutomationProperties.Name="{Binding DataContext.UninstallButtonText, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       Classes="detailAction detailDangerAction"
                                                       IsVisible="{Binding DataContext.ShouldShowInstalledActions, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Click="PluginUninstallButton_Click"
                                                       Tag="{Binding DataContext.PluginId, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       ToolTip.Tip="{Binding DataContext.UninstallButtonText, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Delete24"
                                                                   Foreground="{DynamicResource StatusCriticalTextBrush}" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                        </StackPanel>

                                        <custom:ProgressRing Classes="appLoadingRingCompact"
                                                             Width="24"
                                                             Height="24"
                                                             IsIndeterminate="{Binding IsInstallProgressIndeterminate}"
                                                             Progress="{Binding InstallProgress}"
                                                             IsVisible="{Binding IsInstalling, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Margin="0,6,12,0"
                                               FontSize="{DynamicResource FontSizeSmallCaption}"
                                               Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="54"
                                               ToolTip.Tip="{Binding Description}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               IsVisible="{Binding ShouldShowCardDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <Grid Grid.Row="2"
                                          Grid.Column="1"
                                          Margin="0,8,0,0">
                                        <ui:Button
                                            Padding="9,0"
                                            Height="28"
                                            HorizontalAlignment="Left"
                                            Appearance="Transparent"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                            AutomationProperties.AutomationId="{Binding PluginId, StringFormat=PluginDetailsToggleButton_{0}}"
                                            Click="PluginDetailsToggleButton_Click"
                                            Tag="{Binding PluginId}"
                                            ToolTip.Tip="{Binding ToggleDetailsTooltip}"
                                            IsVisible="{Binding HasExpandableContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon FontSize="{StaticResource IconSizeSM}"
                                                               Margin="0,0,6,0"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Symbol="{Binding ToggleDetailsSymbol}" />
                                                <TextBlock Text="{Binding ToggleDetailsText}"
                                                           VerticalAlignment="Center"
                                                           FontSize="{DynamicResource FontSizeSmallCaption}" />
                                            </StackPanel>
                                        </ui:Button>
                                    </Grid>

                                    <StackPanel Grid.Row="3"
                                                Grid.Column="1"
                                                Grid.ColumnSpan="2"
                                                Margin="0,8,0,0"
                                                IsVisible="{Binding ShowExpandedDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Padding="12"
                                                CornerRadius="{StaticResource CornerRadiusMD}"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel IsVisible="{Binding HasDetailedDescription, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding DetailsLabel}"
                                                               FontSize="{DynamicResource FontSizeSmallCaption}"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{Binding DetailedDescription}"
                                                               Margin="0,4,0,0"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </StackPanel>

                                                <StackPanel Margin="0,10,0,0"
                                                            IsVisible="{Binding HasUsageGuide, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding UsageGuideLabel}"
                                                               FontSize="{DynamicResource FontSizeSmallCaption}"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{Binding UsageGuide}"
                                                               Margin="0,4,0,0"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </StackPanel>

                                                <StackPanel Margin="0,10,0,0"
                                                            IsVisible="{Binding HasUpdateDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <WrapPanel>
                                                        <TextBlock Text="{x:Static resources:Resource.PluginExtensionsPage_VersionLabel}"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{Binding NewVersion}"
                                                                   Margin="6,0,14,0"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{Binding ReleaseDate}"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   IsVisible="{Binding HasReleaseDate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Changelog}"
                                                               Margin="0,4,0,0"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="54"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                               IsVisible="{Binding HasChangelog, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    </Grid>

                                    <Border Height="2"
                                            VerticalAlignment="Bottom"
                                            HorizontalAlignment="Stretch"
                                            Background="{DynamicResource SystemAccentColorBrush}"
                                            Opacity="0.85"
                                            RenderTransformOrigin="0,0.5"
                                            IsVisible="{Binding ShouldShowDeterminateInstallFill, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding InstallProgress, Converter={StaticResource PercentageToScaleConverter}}" ScaleY="1" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!--
              Visible by default so the first navigation frame is skeleton shimmer (code-behind snaps in).
              Transparent host + lightweight rows (4.x-style) — only shimmer blocks animate.
            -->
            <Grid
                x:Name="_loadingIndicator"
                AutomationProperties.AutomationId="PluginLoadingIndicator"
                ZIndex="2"
                IsVisible="True"
                Opacity="1"
                ClipToBounds="True"
                Background="Transparent">
                <StackPanel Margin="0,4,0,0">
                    <Border Width="128"
                            Height="12"
                            Margin="2,0,0,8"
                            HorizontalAlignment="Left"
                            Classes="appSkeletonShimmerBlock" />

                    <Border Classes="pluginSkeletonRow">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" Classes="appSkeletonShimmerBlock" />
                            <StackPanel Grid.Column="1" Margin="12,2,0,0">
                                <Border Width="220" Height="14" HorizontalAlignment="Left" Classes="appSkeletonShimmerBlock" />
                                <Border Width="128" Height="10" Margin="0,10,0,0" HorizontalAlignment="Left" Classes="appSkeletonShimmerBlock" />
                                <Border Height="10" Margin="0,12,52,0" Classes="appSkeletonShimmerBlock" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Classes="pluginSkeletonRow">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" Classes="appSkeletonShimmerBlock" />
                            <StackPanel Grid.Column="1" Margin="12,2,0,0">
                                <Border Width="194" Height="14" HorizontalAlignment="Left" Classes="appSkeletonShimmerBlock" />
                                <Border Width="116" Height="10" Margin="0,10,0,0" HorizontalAlignment="Left" Classes="appSkeletonShimmerBlock" />
                                <Border Height="10" Margin="0,12,68,0" Classes="appSkeletonShimmerBlock" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Classes="pluginSkeletonRow">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" Classes="appSkeletonShimmerBlock" />
                            <StackPanel Grid.Column="1" Margin="12,2,0,0">
                                <Border Width="172" Height="14" HorizontalAlignment="Left" Classes="appSkeletonShimmerBlock" />
                                <Border Width="98" Height="10" Margin="0,10,0,0" HorizontalAlignment="Left" Classes="appSkeletonShimmerBlock" />
                                <Border Height="10" Margin="0,12,84,0" Classes="appSkeletonShimmerBlock" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <custom:EmptyState
                x:Name="_noPluginsMessage"
                AutomationProperties.AutomationId="PluginNoPluginsMessage"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="False"
                Description="{x:Static resources:Resource.PluginExtensionsPage_EmptyStoreMessage}"
                Icon="Archive24"
                Title="{x:Static resources:Resource.PluginExtensionsPage_NoPluginsAvailable}" />

            <StackPanel
                x:Name="_noResultsStackPanel"
                AutomationProperties.AutomationId="PluginNoResultsMessage"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="False">
                <ui:SymbolIcon Symbol="SearchVisual24"
                               FontSize="{StaticResource IconSizeHeroSM}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="0,0,0,14" />
                <TextBlock
                    Text="{x:Static resources:Resource.PluginExtensionsPage_NoResults}"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    FontSize="{DynamicResource FontSizeCaption}"
                    TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
    </custom:DynamicScrollViewer>
</UserControl>
