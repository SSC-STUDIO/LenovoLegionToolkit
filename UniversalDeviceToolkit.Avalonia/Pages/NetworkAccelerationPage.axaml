<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:UniversalDeviceToolkit.Avalonia.Localization"
             xmlns:controls="using:UniversalDeviceToolkit.Avalonia.Controls"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="UniversalDeviceToolkit.Avalonia.Pages.NetworkAccelerationPage">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16"
                    Margin="32,24,32,32"
                    MaxWidth="900"
                    HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <controls:LocalizedTextBlock Text="{local:Loc Key=NetworkAccelerationPage_Title, Fallback=Network acceleration}"
                                             FontSize="{StaticResource FontSizeDisplaySection}"
                                             FontWeight="Medium"
                                             OverflowMode="Wrap"
                                             MaxLines="2"
                                             automation:AutomationProperties.AutomationId="AvaloniaNetworkAccelerationTitle" />
                <controls:LocalizedTextBlock Text="{local:Loc Key=NetworkAccelerationPage_Subtitle, Fallback=Route selected domains through the local network worker.}"
                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                             OverflowMode="Wrap"
                                             MaxLines="3"
                                             automation:AutomationProperties.AutomationId="AvaloniaNetworkAccelerationDescription" />
            </StackPanel>

            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusCard}"
                    Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="3">
                            <controls:LocalizedTextBlock Text="{local:Loc Key=NetworkAccelerationPage_EnableLabel, Fallback=Enable network acceleration}"
                                                         FontWeight="Medium"
                                                         OverflowMode="Wrap"
                                                         MaxLines="2" />
                            <controls:LocalizedTextBlock x:Name="StatusText"
                                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                         OverflowMode="Wrap"
                                                         MaxLines="3" />
                        </StackPanel>
                        <CheckBox x:Name="EnabledCheckBox"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  automation:AutomationProperties.AutomationId="AvaloniaNetworkAccelerationEnabled"
                                  automation:AutomationProperties.Name="{local:Loc Key=NetworkAccelerationPage_EnableLabel, Fallback=Enable network acceleration}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <controls:LocalizedTextBlock Text="{local:Loc Key=NetworkAccelerationPage_ModeLabel, Fallback=Mode}"
                                                     VerticalAlignment="Center"
                                                     OverflowMode="Ellipsis"
                                                     MaxLines="1" />
                        <ComboBox x:Name="ModeComboBox"
                                  Grid.Column="1"
                                  MinWidth="190"
                                  automation:AutomationProperties.AutomationId="AvaloniaNetworkAccelerationMode"
                                  automation:AutomationProperties.Name="{local:Loc Key=NetworkAccelerationPage_ModeLabel, Fallback=Mode}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="StartStopButton"
                        Content="{local:Loc Key=NetworkAccelerationPage_Start, Fallback=Start}"
                                Click="StartStopButton_Click"
                                automation:AutomationProperties.AutomationId="AvaloniaNetworkAccelerationStartStop" />
                        <Button Content="{local:Loc Key=NetworkAccelerationPage_RunDiagnostics, Fallback=Run diagnostics}"
                                Click="DiagnosticsButton_Click"
                                automation:AutomationProperties.AutomationId="AvaloniaNetworkAccelerationDiagnostics" />
                        <Button Content="{local:Loc Key=NetworkAccelerationPage_Restore, Fallback=Restore system network}"
                                Click="RestoreButton_Click"
                                automation:AutomationProperties.AutomationId="AvaloniaNetworkAccelerationRestore" />
                    </StackPanel>
                    <controls:LocalizedTextBlock x:Name="DiagnosticsText"
                                                 IsVisible="False"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                 OverflowMode="Wrap"
                                                 MaxLines="4" />
                </StackPanel>
            </Border>

            <Border x:Name="RuntimeCard"
                    IsVisible="False"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusCard}"
                    Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <controls:LocalizedTextBlock Text="{local:Loc Key=NetworkAccelerationPage_RuntimeHeading, Fallback=Live proxy activity}"
                                                     FontSize="{StaticResource FontSizeSubsection}"
                                                     FontWeight="Medium"
                                                     OverflowMode="Wrap"
                                                     MaxLines="2" />
                        <controls:LocalizedTextBlock x:Name="RuntimeHealthText"
                                                     Grid.Column="1"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                     OverflowMode="Ellipsis"
                                                     MaxLines="1" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <StackPanel Spacing="2">
                            <controls:LocalizedTextBlock Text="{local:Loc Key=NetworkAccelerationPage_Upload, Fallback=Upload}"
                                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                         OverflowMode="Ellipsis"
                                                         MaxLines="1" />
                            <TextBlock x:Name="UploadValueText" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <controls:LocalizedTextBlock Text="{local:Loc Key=NetworkAccelerationPage_Download, Fallback=Download}"
                                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                         OverflowMode="Ellipsis"
                                                         MaxLines="1" />
                            <TextBlock x:Name="DownloadValueText" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <controls:LocalizedTextBlock Text="{local:Loc Key=NetworkAccelerationPage_Connections, Fallback=Connections}"
                                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                         OverflowMode="Ellipsis"
                                                         MaxLines="1" />
                            <TextBlock x:Name="ConnectionsValueText" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                    <controls:LocalizedTextBlock x:Name="RuntimeStatusText"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                 OverflowMode="Wrap"
                                                 MaxLines="2" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <StackPanel Spacing="6">
                            <controls:LocalizedTextBlock Text="{local:Loc Key=NetworkAccelerationPage_ConnectionStats, Fallback=Current connections}"
                                                         FontWeight="Medium"
                                                         OverflowMode="Wrap"
                                                         MaxLines="2" />
                            <StackPanel x:Name="ConnectionsPanel" Spacing="4" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <controls:LocalizedTextBlock Text="{local:Loc Key=NetworkAccelerationPage_DestinationStats, Fallback=Destination statistics}"
                                                         FontWeight="Medium"
                                                         OverflowMode="Wrap"
                                                         MaxLines="2" />
                            <StackPanel x:Name="DestinationsPanel" Spacing="4" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Expander x:Name="DiagnosticsExpander"
                      automation:AutomationProperties.AutomationId="AvaloniaNetworkAccelerationDetailedDiagnostics">
                <Expander.Header>
                    <controls:LocalizedTextBlock Text="{local:Loc Key=NetworkAccelerationPage_DetailedDiagnostics, Fallback=Detailed network diagnostics}"
                                                 FontSize="{StaticResource FontSizeSubsection}"
                                                 FontWeight="Medium"
                                                 OverflowMode="Wrap"
                                                 MaxLines="2" />
                </Expander.Header>
                <StackPanel Spacing="16" Margin="0,12,0,0">
                    <StackPanel Spacing="6">
                        <controls:LocalizedTextBlock Text="{local:Loc Key=NetworkAccelerationPage_NatDiagnostics, Fallback=NAT connectivity}"
                                                     FontWeight="Medium"
                                                     OverflowMode="Wrap"
                                                     MaxLines="2" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="NatStunHostTextBox"
                                     Text="stun.miwifi.com"
                                     Watermark="STUN host"
                                     automation:AutomationProperties.AutomationId="AvaloniaNetworkAccelerationNatStunHost" />
                            <Button x:Name="NatDiagnosticButton"
                                    Grid.Column="1"
                                    Content="{local:Loc Key=NetworkAccelerationPage_Detect, Fallback=Detect}"
                                    Click="NatDiagnosticButton_Click"
                                    automation:AutomationProperties.AutomationId="AvaloniaNetworkAccelerationNatDetect" />
                        </Grid>
                        <controls:LocalizedTextBlock x:Name="NatDiagnosticResultText"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                     OverflowMode="Wrap"
                                                     MaxLines="4" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <controls:LocalizedTextBlock Text="{local:Loc Key=NetworkAccelerationPage_DnsDiagnostics, Fallback=DNS resolution}"
                                                     FontWeight="Medium"
                                                     OverflowMode="Wrap"
                                                     MaxLines="2" />
                        <TextBox x:Name="DnsDomainTextBox"
                                 Text="store.steampowered.com"
                                 Watermark="Domain"
                                 automation:AutomationProperties.AutomationId="AvaloniaNetworkAccelerationDnsDomain" />
                        <TextBox x:Name="DnsServerTextBox"
                                 Watermark="Custom DNS server (optional)"
                                 automation:AutomationProperties.AutomationId="AvaloniaNetworkAccelerationDnsServer" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <CheckBox x:Name="DnsUseDohCheckBox"
                                      Content="{local:Loc Key=NetworkAccelerationPage_UseDoh, Fallback=Use DNS over HTTPS}"
                                      VerticalAlignment="Center"
                                      automation:AutomationProperties.AutomationId="AvaloniaNetworkAccelerationDnsUseDoh" />
                            <Button x:Name="DnsDiagnosticButton"
                                    Grid.Column="1"
                                    Content="{local:Loc Key=NetworkAccelerationPage_Detect, Fallback=Detect}"
                                    Click="DnsDiagnosticButton_Click"
                                    automation:AutomationProperties.AutomationId="AvaloniaNetworkAccelerationDnsDetect" />
                        </Grid>
                        <TextBox x:Name="DnsDohUrlTextBox"
                                 Text="https://doh.pub/dns-query"
                                 Watermark="DoH URL"
                                 automation:AutomationProperties.AutomationId="AvaloniaNetworkAccelerationDnsDohUrl" />
                        <controls:LocalizedTextBlock x:Name="DnsDiagnosticResultText"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                     OverflowMode="Wrap"
                                                     MaxLines="6" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <controls:LocalizedTextBlock Text="{local:Loc Key=NetworkAccelerationPage_Ipv6Diagnostics, Fallback=IPv6 connectivity}"
                                                         FontWeight="Medium"
                                                         OverflowMode="Wrap"
                                                         MaxLines="2" />
                            <Button x:Name="Ipv6DiagnosticButton"
                                    Grid.Column="1"
                                    Content="{local:Loc Key=NetworkAccelerationPage_Detect, Fallback=Detect}"
                                    Click="Ipv6DiagnosticButton_Click"
                                    automation:AutomationProperties.AutomationId="AvaloniaNetworkAccelerationIpv6Detect" />
                        </Grid>
                        <controls:LocalizedTextBlock x:Name="Ipv6DiagnosticResultText"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                     OverflowMode="Wrap"
                                                     MaxLines="4" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <controls:LocalizedTextBlock Text="{local:Loc Key=NetworkAccelerationPage_DomainGroupsLabel, Fallback=Domain groups}"
                                         FontSize="{StaticResource FontSizeSubsection}"
                                         FontWeight="Medium"
                                         OverflowMode="Wrap"
                                         MaxLines="2" />
            <StackPanel x:Name="GroupsPanel"
                        Spacing="8"
                        automation:AutomationProperties.AutomationId="AvaloniaNetworkAccelerationGroups" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
