<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:UniversalDeviceToolkit.Avalonia.Controls"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="UniversalDeviceToolkit.Avalonia.Pages.SettingsCapabilityView"
             automation:AutomationProperties.AutomationId="AvaloniaSettingsCapabilityView">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16"
                    Margin="32,24,32,32"
                    MaxWidth="820"
                    HorizontalAlignment="Left">
            <controls:LocalizedTextBlock x:Name="TitleBlock"
                                         FontSize="{StaticResource FontSizeDisplaySection}"
                                         FontWeight="Medium"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                         OverflowMode="Wrap"
                                         MaxLines="2"
                                         automation:AutomationProperties.AutomationId="SettingsCapabilityTitle" />
            <controls:LocalizedTextBlock x:Name="DescriptionBlock"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                         OverflowMode="Wrap"
                                         MaxLines="3"
                                         automation:AutomationProperties.AutomationId="SettingsCapabilityDescription" />

            <Border x:Name="AvailabilityCard"
                    Background="{DynamicResource StatusInfoBackgroundBrush}"
                    BorderBrush="{DynamicResource StatusInfoBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusCard}"
                    Padding="16">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="{StaticResource CornerRadiusRound}"
                            Background="{DynamicResource StatusInfoBrush}"
                            VerticalAlignment="Top">
                        <controls:NavigationIcon IconIdentifier="Info24"
                                                 FontSize="{StaticResource IconSizeMD}"
                                                 Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <controls:LocalizedTextBlock x:Name="StatusTitleBlock"
                                                     FontSize="{StaticResource FontSizeSubsection}"
                                                     FontWeight="Medium"
                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                     OverflowMode="Wrap"
                                                     MaxLines="2"
                                                     automation:AutomationProperties.AutomationId="SettingsCapabilityStatusTitle" />
                        <controls:LocalizedTextBlock x:Name="StatusMessageBlock"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                     OverflowMode="Wrap"
                                                     MaxLines="4"
                                                     automation:AutomationProperties.AutomationId="SettingsCapabilityStatusMessage" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ActionFeedbackBar"
                    Classes="infoBar informational"
                    IsVisible="False"
                    automation:AutomationProperties.AutomationId="SettingsActionFeedback">
                <StackPanel Spacing="4">
                    <controls:LocalizedTextBlock x:Name="ActionFeedbackTitleBlock"
                                                 Classes="infoBarTitle"
                                                 OverflowMode="Wrap"
                                                 MaxLines="2" />
                    <controls:LocalizedTextBlock x:Name="ActionFeedbackMessageBlock"
                                                 Classes="infoBarMessage"
                                                 OverflowMode="Wrap"
                                                 MaxLines="3" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="OptionsPanel"
                        Spacing="8"
                        automation:AutomationProperties.AutomationId="SettingsCapabilityOptions" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
