<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:UniversalDeviceToolkit.Avalonia.Controls"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="UniversalDeviceToolkit.Avalonia.Pages.SettingsCapabilityView"
             automation:AutomationProperties.AutomationId="AvaloniaSettingsCapabilityView">
    <StackPanel Spacing="16"
                MaxWidth="680"
                HorizontalAlignment="Left">
        <controls:LocalizedTextBlock x:Name="TitleBlock"
                   FontSize="{StaticResource FontSizeDisplaySection}"
                   FontWeight="Medium"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   OverflowMode="Wrap"
                   MaxLines="2"
                   automation:AutomationProperties.AutomationId="SettingsCapabilityTitle" />

        <controls:LocalizedTextBlock x:Name="DescriptionBlock"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   OverflowMode="Wrap"
                   MaxLines="3"
                   Margin="0,0,0,8"
                   automation:AutomationProperties.AutomationId="SettingsCapabilityDescription" />

        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusCard}"
                Padding="16">
            <Grid ColumnDefinitions="Auto,*">
                <Border Width="40"
                        Height="40"
                        Background="{DynamicResource StatusInfoBackgroundBrush}"
                        CornerRadius="{StaticResource CornerRadiusControl}"
                        VerticalAlignment="Top">
                    <TextBlock Text="i"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource StatusInfoBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1"
                            Margin="16,0,0,0"
                            Spacing="5">
                    <controls:LocalizedTextBlock x:Name="StatusTitleBlock"
                               FontSize="{StaticResource FontSizeSubsection}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               OverflowMode="Wrap"
                               MaxLines="2"
                               automation:AutomationProperties.AutomationId="SettingsCapabilityStatusTitle" />
                    <controls:LocalizedTextBlock x:Name="StatusMessageBlock"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               OverflowMode="Wrap"
                               MaxLines="3"
                               automation:AutomationProperties.AutomationId="SettingsCapabilityStatusMessage" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusCard}"
                Padding="16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <controls:LocalizedTextBlock Text="{Binding FeatureLabel}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               OverflowMode="Wrap"
                               MaxLines="2" />
                    <controls:LocalizedTextBlock Text="{Binding FeatureMessage}"
                               FontSize="{StaticResource FontSizeSmallCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               OverflowMode="Wrap"
                               MaxLines="3" />
                </StackPanel>
                <Button Grid.Column="1"
                        IsEnabled="False"
                        MinWidth="{StaticResource ButtonMinWidthStandard}"
                        Content="{Binding UnavailableLabel}"
                        automation:AutomationProperties.AutomationId="SettingsCapabilityUnavailableButton"
                        automation:AutomationProperties.Name="{Binding UnavailableLabel}"
                        Margin="16,0,0,0" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
