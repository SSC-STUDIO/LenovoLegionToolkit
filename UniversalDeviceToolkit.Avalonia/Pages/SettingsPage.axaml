<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:UniversalDeviceToolkit.Avalonia.Localization"
             xmlns:controls="using:UniversalDeviceToolkit.Avalonia.Controls"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="UniversalDeviceToolkit.Avalonia.Pages.SettingsPage">

    <Grid ColumnDefinitions="280,Auto,*">
        <!-- Left Navigation Bar -->
        <Border Grid.Column="0"
                Background="{DynamicResource NavigationPaneBackgroundBrush}"
                Padding="12,16">
            <DockPanel>
                <controls:LocalizedTextBlock DockPanel.Dock="Top"
                           Text="{local:Loc Key=Settings_Title, Fallback=Settings}"
                           FontSize="{StaticResource FontSizeDisplaySection}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           OverflowMode="Wrap"
                           MaxLines="2"
                           automation:AutomationProperties.Name="{local:Loc Key=Settings_Title, Fallback=Settings}"
                           Margin="12,0,0,16"/>

                <ListBox x:Name="SettingsNavigationList"
                         automation:AutomationProperties.AutomationId="AvaloniaSettingsNavigationList"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedIndex="{Binding SelectedNavigationIndex}"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2"
                                  ColumnDefinitions="Auto,*"
                                  automation:AutomationProperties.AutomationId="{Binding Key}">
                                <controls:NavigationIcon Grid.Column="0"
                                           IconIdentifier="{Binding IconIdentifier}"
                                           FontSize="{StaticResource IconSizeMD}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,12,0"
                                           Width="24"
                                           Height="24" />
                                <controls:LocalizedTextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Stretch"
                                           MinWidth="0"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           OverflowMode="Ellipsis"
                                           MaxLines="1"
                                           automation:AutomationProperties.Name="{Binding Title}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="16,12,12,12"/>
                            <Setter Property="Margin" Value="0,0,0,2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusControl}"/>
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Splitter area (visual separator) -->
        <Border Grid.Column="1" Width="1"
                Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

        <!-- Right Content Area -->
        <ScrollViewer Grid.Column="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Border Background="{DynamicResource AppSurfaceCardBrush}"
                    Padding="{StaticResource ContentPaddingPage}">
                <ContentControl Content="{Binding SelectedContent}" />
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
