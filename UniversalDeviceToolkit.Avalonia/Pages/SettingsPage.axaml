<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:UniversalDeviceToolkit.Avalonia.Localization"
             xmlns:controls="using:UniversalDeviceToolkit.Avalonia.Controls"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="UniversalDeviceToolkit.Avalonia.Pages.SettingsPage">

    <Grid ColumnDefinitions="280,Auto,*">
        <!-- Left Navigation Bar -->
        <Border Grid.Column="0"
                Background="{DynamicResource NavigationPaneBackgroundBrush}"
                Padding="12,16">
            <DockPanel>
                <controls:LocalizedTextBlock DockPanel.Dock="Top"
                           Text="{local:Loc Key=Settings_Title, Fallback=Settings}"
                           FontSize="{StaticResource FontSizePageTitle}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           OverflowMode="Wrap"
                           MaxLines="2"
                           automation:AutomationProperties.Name="{local:Loc Key=Settings_Title, Fallback=Settings}"
                           Margin="12,0,0,16"/>

                <ListBox x:Name="SettingsNavigationList"
                         automation:AutomationProperties.AutomationId="AvaloniaSettingsNavigationList"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedIndex="{Binding SelectedNavigationIndex}"
                         SelectionChanged="SettingsNavigationList_SelectionChanged"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2"
                                  ColumnDefinitions="Auto,*"
                                  automation:AutomationProperties.AutomationId="{Binding Key}">
                                <controls:NavigationIcon Grid.Column="0"
                                           IconIdentifier="{Binding IconIdentifier}"
                                           FontSize="{StaticResource IconSizeMD}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,12,0"
                                           Width="24"
                                           Height="24" />
                                <controls:LocalizedTextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Stretch"
                                           MinWidth="0"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           OverflowMode="Ellipsis"
                                           MaxLines="1"
                                           automation:AutomationProperties.Name="{Binding Title}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="16,12,12,12"/>
                            <Setter Property="Margin" Value="0,0,0,2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusControl}"/>
                            <Setter Property="automation:AutomationProperties.Name" Value="{Binding Title}"/>
                            <Setter Property="automation:AutomationProperties.AutomationId" Value="{Binding Key}"/>
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Splitter area (visual separator) -->
        <Border Grid.Column="1" Width="1"
                Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

        <!-- Right Content Area -->
        <ScrollViewer Grid.Column="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Border Background="{DynamicResource AppSurfaceCardBrush}"
                    Padding="{StaticResource ContentPaddingPage}">
                <ContentControl x:Name="SelectedContentHost" />
            </Border>
        </ScrollViewer>

        <!-- Loading skeleton (WPF parity: nav rows + settings cards while loading). -->
        <Grid x:Name="LoadingSkeleton" Grid.ColumnSpan="3" IsVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="12,16">
                <StackPanel Margin="4,0,0,0">
                    <Grid Margin="0,0,0,2" Height="44" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6"
                                Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                        <Border Grid.Column="1" Width="118" Height="12" HorizontalAlignment="Left" CornerRadius="4"
                                Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                    </Grid>
                    <Grid Margin="0,0,0,2" Height="44" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6"
                                Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                        <Border Grid.Column="1" Width="96" Height="12" HorizontalAlignment="Left" CornerRadius="4"
                                Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                    </Grid>
                    <Grid Margin="0,0,0,2" Height="44" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6"
                                Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                        <Border Grid.Column="1" Width="132" Height="12" HorizontalAlignment="Left" CornerRadius="4"
                                Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                    </Grid>
                    <Grid Margin="0,0,0,2" Height="44" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6"
                                Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                        <Border Grid.Column="1" Width="84" Height="12" HorizontalAlignment="Left" CornerRadius="4"
                                Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                    </Grid>
                    <Grid Margin="0,0,0,2" Height="44" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6"
                                Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                        <Border Grid.Column="1" Width="108" Height="12" HorizontalAlignment="Left" CornerRadius="4"
                                Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                    </Grid>
                    <Grid Margin="0,0,0,2" Height="44" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6"
                                Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                        <Border Grid.Column="1" Width="124" Height="12" HorizontalAlignment="Left" CornerRadius="4"
                                Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" Margin="24,16,0,0">
                <Border Margin="0,0,0,16" Padding="16" CornerRadius="{StaticResource CornerRadiusCard}"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="8">
                            <Border Width="180" Height="16" HorizontalAlignment="Left" CornerRadius="4"
                                    Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                            <Border Width="260" Height="12" HorizontalAlignment="Left" CornerRadius="4"
                                    Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="20" CornerRadius="10"
                                Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                    </Grid>
                </Border>
                <Border MinHeight="120" Padding="16" CornerRadius="{StaticResource CornerRadiusCard}"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1">
                    <StackPanel VerticalAlignment="Center" Spacing="8">
                        <Border Width="200" Height="16" HorizontalAlignment="Left" CornerRadius="4"
                                Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                        <Border Width="320" Height="12" HorizontalAlignment="Left" CornerRadius="4"
                                Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                        <Border Height="28" Margin="0,6,0,0" CornerRadius="4"
                                Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
