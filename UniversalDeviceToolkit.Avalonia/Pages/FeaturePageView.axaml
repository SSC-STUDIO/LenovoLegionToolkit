<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:UniversalDeviceToolkit.Avalonia.Controls"
             xmlns:local="using:UniversalDeviceToolkit.Avalonia.Localization"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="UniversalDeviceToolkit.Avalonia.Pages.FeaturePageView"
             automation:AutomationProperties.AutomationId="AvaloniaFeaturePage">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18"
                    Margin="32,24,32,32"
                    MaxWidth="920"
                    HorizontalAlignment="Left">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                <Border Width="48"
                        Height="48"
                        CornerRadius="{StaticResource CornerRadiusControl}"
                        Background="{DynamicResource StatusNeutralBackgroundBrush}"
                        VerticalAlignment="Top">
                    <controls:NavigationIcon x:Name="PageIcon"
                                             FontSize="{StaticResource IconSizeLG}"
                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                    <controls:LocalizedTextBlock x:Name="PageTitle"
                                                 FontSize="{StaticResource FontSizeDisplaySection}"
                                                 FontWeight="Medium"
                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                 OverflowMode="Wrap"
                                                 MaxLines="2"
                                                 automation:AutomationProperties.AutomationId="FeaturePageTitle" />
                    <controls:LocalizedTextBlock x:Name="PageDescription"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                 OverflowMode="Wrap"
                                                 MaxLines="3"
                                                 automation:AutomationProperties.AutomationId="FeaturePageDescription" />
                </StackPanel>
            </Grid>

            <Border x:Name="StatusCard"
                    Background="{DynamicResource StatusInfoBackgroundBrush}"
                    BorderBrush="{DynamicResource StatusInfoBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusCard}"
                    Padding="16">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border x:Name="StatusIconBackground"
                            Width="36"
                            Height="36"
                            CornerRadius="{StaticResource CornerRadiusRound}"
                            Background="{DynamicResource StatusInfoBrush}"
                            VerticalAlignment="Top">
                        <controls:NavigationIcon IconIdentifier="Info24"
                                                 FontSize="{StaticResource IconSizeMD}"
                                                 Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <controls:LocalizedTextBlock x:Name="StatusTitle"
                                                     FontSize="{StaticResource FontSizeSubsection}"
                                                     FontWeight="Medium"
                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                     OverflowMode="Wrap"
                                                     MaxLines="2"
                                                     automation:AutomationProperties.AutomationId="FeaturePageStatusTitle" />
                        <controls:LocalizedTextBlock x:Name="StatusMessage"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                     OverflowMode="Wrap"
                                                     MaxLines="4"
                                                     automation:AutomationProperties.AutomationId="FeaturePageStatusMessage" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="OptimizationToolbar"
                    IsVisible="False"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusCard}"
                    Padding="12">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="OptimizationModeButton"
                                Content="{local:Loc Key=WindowsOptimizationPage_Tab_Optimization, Fallback=Optimization}"
                                Click="OptimizationModeButton_Click"
                                automation:AutomationProperties.AutomationId="AvaloniaOptimizationModeButton" />
                        <Button x:Name="CleanupModeButton"
                                Content="{local:Loc Key=WindowsOptimizationPage_Tab_Cleanup, Fallback=Cleanup}"
                                Click="CleanupModeButton_Click"
                                automation:AutomationProperties.AutomationId="AvaloniaCleanupModeButton" />
                        <Button x:Name="NetworkAccelerationButton"
                                Content="{local:Loc Key=WindowsOptimizationPage_Tab_NetworkAcceleration, Fallback=Network acceleration}"
                                Click="NetworkAccelerationButton_Click"
                                automation:AutomationProperties.AutomationId="AvaloniaNetworkAccelerationButton" />
                        <Button x:Name="DriverDownloadButton"
                                Content="{local:Loc Key=WindowsOptimizationPage_Tab_DriverDownload, Fallback=Driver downloads}"
                                Click="DriverDownloadButton_Click"
                                automation:AutomationProperties.AutomationId="AvaloniaDriverDownloadButton" />
                        <Button x:Name="PluginImportButton"
                                Content="{local:Loc Key=PluginExtensionsPage_ImportFromFiles, Fallback=Import from files}"
                                Click="PluginImportButton_Click"
                                IsVisible="False"
                                automation:AutomationProperties.AutomationId="AvaloniaPluginImportButton" />
                    </StackPanel>
                    <Grid x:Name="PluginCatalogToolbar"
                          IsVisible="False"
                          ColumnDefinitions="*,160,Auto,Auto,Auto"
                          ColumnSpacing="8">
                        <TextBox x:Name="PluginSearchBox"
                                 Watermark="{local:Loc Key=PluginExtensionsPage_Search, Fallback=Search plugins}"
                                 automation:AutomationProperties.AutomationId="AvaloniaPluginSearchBox" />
                        <ComboBox x:Name="PluginFilterBox"
                                  Grid.Column="1"
                                  SelectedIndex="0"
                                  automation:AutomationProperties.AutomationId="AvaloniaPluginFilterBox"
                                  automation:AutomationProperties.Name="{local:Loc Key=PluginExtensionsPage_FilterAll, Fallback=All}">
                            <ComboBoxItem Content="{local:Loc Key=PluginExtensionsPage_FilterAll, Fallback=All}" />
                            <ComboBoxItem Content="{local:Loc Key=PluginExtensionsPage_FilterInstalled, Fallback=Installed}" />
                            <ComboBoxItem Content="{local:Loc Key=PluginExtensionsPage_FilterAvailable, Fallback=Available}" />
                            <ComboBoxItem Content="{local:Loc Key=PluginExtensionsPage_FilterUpdates, Fallback=Updates}" />
                        </ComboBox>
                        <Button x:Name="PluginRefreshButton"
                                Grid.Column="2"
                                Content="{local:Loc Key=PluginExtensionsPage_Refresh, Fallback=Refresh}"
                                Click="PluginRefreshButton_Click"
                                automation:AutomationProperties.AutomationId="AvaloniaPluginRefreshButton" />
                        <Button x:Name="PluginUpdateButton"
                                Grid.Column="3"
                                Content="{local:Loc Key=PluginExtensionsPage_CheckUpdates, Fallback=Check updates}"
                                Click="PluginUpdateButton_Click"
                                automation:AutomationProperties.AutomationId="AvaloniaPluginCheckUpdatesButton" />
                        <Button x:Name="PluginInstallButton"
                                Grid.Column="4"
                                Content="{local:Loc Key=PluginExtensionsPage_InstallAll, Fallback=Install all}"
                                Click="PluginInstallButton_Click"
                                automation:AutomationProperties.AutomationId="AvaloniaPluginInstallAllButton" />
                    </Grid>
                    <StackPanel x:Name="OptimizationCommands"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Button x:Name="ApplyRecommendedButton"
                                Content="{local:Loc Key=WindowsOptimizationPage_SelectRecommended_Button, Fallback=Select recommended}"
                                Click="OptimizationCommandButton_Click"
                                Tag="optimization-apply-recommended"
                                automation:AutomationProperties.AutomationId="AvaloniaApplyRecommendedButton" />
                        <Button x:Name="ApplySelectedButton"
                                Content="{local:Loc Key=Common_Apply, Fallback=Apply selected}"
                                Click="OptimizationCommandButton_Click"
                                Tag="optimization-apply-selected"
                                automation:AutomationProperties.AutomationId="AvaloniaOptimizationApplySelectedButton" />
                        <Button x:Name="OptimizationClearButton"
                                Content="{local:Loc Key=WindowsOptimizationPage_ClearSelection_Button, Fallback=Clear selection}"
                                Click="OptimizationCommandButton_Click"
                                Tag="optimization-clear-selection"
                                automation:AutomationProperties.AutomationId="AvaloniaOptimizationClearButton" />
                    </StackPanel>
                    <StackPanel x:Name="CleanupCommands"
                                Orientation="Horizontal"
                                Spacing="8"
                                IsVisible="False">
                        <Button Content="{local:Loc Key=WindowsOptimizationPage_Scan_Button, Fallback=Scan selected}"
                                Click="OptimizationCommandButton_Click"
                                Tag="cleanup-scan"
                                automation:AutomationProperties.AutomationId="AvaloniaCleanupScanButton" />
                        <Button Content="{local:Loc Key=WindowsOptimizationPage_RunCleanup_Button, Fallback=Run selected}"
                                Click="OptimizationCommandButton_Click"
                                Tag="cleanup-run"
                                automation:AutomationProperties.AutomationId="AvaloniaCleanupRunButton" />
                        <Button Content="{local:Loc Key=WindowsOptimizationPage_ClearSelection_Button, Fallback=Clear selection}"
                                Click="OptimizationCommandButton_Click"
                                Tag="cleanup-clear"
                                automation:AutomationProperties.AutomationId="AvaloniaCleanupClearButton" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="CatalogOfflineBanner"
                    IsVisible="False"
                    Classes="infoBar error">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="CatalogOfflineTitle"
                                   FontWeight="Medium"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Text="{local:Loc Key=PluginExtensionsPage_StoreOffline_Title, Fallback=Plugin store unavailable}" />
                        <TextBlock x:Name="CatalogOfflineMessage"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="CatalogRetryButton"
                            Grid.Column="1"
                            Content="{local:Loc Key=PluginExtensionsPage_Retry, Fallback=Retry}"
                            Click="CatalogRetryButton_Click"
                            VerticalAlignment="Center"
                            automation:AutomationProperties.AutomationId="AvaloniaPluginCatalogRetryButton" />
                </Grid>
            </Border>

            <StackPanel x:Name="CatalogSummaryPanel"
                        IsVisible="False"
                        Orientation="Horizontal"
                        Spacing="8" />

            <Border x:Name="CleanupProgressCard"
                    IsVisible="False"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusCard}"
                    Padding="16">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <controls:LocalizedTextBlock x:Name="CleanupProgressText"
                                                     FontWeight="Medium"
                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                     OverflowMode="Wrap"
                                                     MaxLines="2"
                                                     automation:AutomationProperties.AutomationId="AvaloniaCleanupProgressText" />
                        <controls:LocalizedTextBlock x:Name="CleanupProgressPercentage"
                                                     Grid.Column="1"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <ProgressBar x:Name="CleanupProgressBar"
                                 IsIndeterminate="True"
                                 Height="6"
                                 automation:AutomationProperties.AutomationId="AvaloniaCleanupProgressBar" />
                    <controls:LocalizedTextBlock x:Name="CleanupSummaryText"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                 OverflowMode="Wrap"
                                                 MaxLines="3"
                                                 IsVisible="False"
                                                 automation:AutomationProperties.AutomationId="AvaloniaCleanupSummaryText" />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="FeatureItems"
                          automation:AutomationProperties.AutomationId="FeaturePageItems" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
