<UserControl
    x:Class="UniversalDeviceToolkit.Avalonia.Pages.WindowsOptimization.NetworkAccelerationControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="using:UniversalDeviceToolkit.Avalonia.Controls.Custom"
    xmlns:charts="using:UniversalDeviceToolkit.Avalonia.Controls.Charts"
    xmlns:resources="using:UniversalDeviceToolkit.Avalonia.Resources"
    xmlns:utils="using:UniversalDeviceToolkit.Avalonia.Utils"
    xmlns:ui="using:UniversalDeviceToolkit.Avalonia.Controls"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}">

    <UserControl.Resources>
        <Style x:Key="NaModeComboStyle" Selector="ComboBox">
            <Setter Property="MinWidth" Value="168" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmallCaption}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="NaDiagComboStyle" Selector="ComboBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="NaServiceExpanderStyle" Selector="custom|CardExpander">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ui|Button.naSecondaryButton">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        </Style>
        <Style Selector="TextBlock.naDiagTitle">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.naDiagLabel">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.naDiagValue">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.naDiagInput">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="custom|CardExpander.naPanelExpander">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusControl}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBlock.naServiceName">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmallCaption}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style Selector="Border.naSubItemRow">
            <Setter Property="Padding" Value="28,2,4,2" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="TextBlock.naSubItemName">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style Selector="TextBlock.naSubItemDomain">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxWidth" Value="260" />
        </Style>
        <Style Selector="Border.naBetaTag">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.naModeRow">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmallCaption}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.naTrafficLabel">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.naTrafficValue">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmallCaption}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Border.naBrandIcon">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,8,0" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <custom:DynamicScrollViewer
            AutomationProperties.AutomationId="NetworkAccelerationPageScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Border
                Margin="0,0,8,16"
                AutomationProperties.AutomationId="NetworkAccelerationControlCard">
                <StackPanel>
                    <Border
                        Padding="12,8"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        AutomationProperties.AutomationId="NetworkAccelerationRunStatusBar">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse
                                    x:Name="_runStateDot"
                                    Width="10"
                                    Height="10"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="_runStateText" Classes="naDiagTitle" />
                                    <TextBlock x:Name="_runHealthText" Classes="naTrafficLabel" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="18,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Classes="naTrafficLabel" Text="{x:Static resources:Resource.NetworkAccelerationPage_ModeLabel}" />
                                    <ComboBox
                                        x:Name="_modeComboBox"
                                        Classes="naModeCombo"
                                        AutomationProperties.AutomationId="NetworkAccelerationModeSelector"
                                        SelectionChanged="ModeComboBox_SelectionChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Classes="naTrafficLabel" Text="{x:Static resources:Resource.NetworkAccelerationPage_TargetsHeading}" />
                                    <TextBlock x:Name="_selectedTargetsText" Classes="naTrafficValue" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Margin="0,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Classes="naTrafficLabel" Text="{x:Static resources:Resource.NetworkAccelerationPage_PortLabel}" />
                                    <TextBlock x:Name="_runPortText" Classes="naTrafficValue" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                x:Name="_runErrorText"
                                Margin="0,6,0,0"
                                MaxWidth="520"
                                Foreground="{DynamicResource StatusCriticalBrush}"
                                TextWrapping="Wrap"
                                IsVisible="False" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="_trafficSection" Margin="0,12,0,0" IsVisible="False">
                        <TextBlock x:Name="_trafficHeadingText" Margin="0,0,0,6" Classes="appSectionLabelTextBlock" />
                        <Border
                            Padding="12,10"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusCard}"
                            AutomationProperties.AutomationId="NetworkAccelerationTrafficCard">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Classes="naTrafficLabel" Text="{x:Static resources:Resource.NetworkAccelerationPage_Metric_Upload}" />
                                        <TextBlock x:Name="_trafficUploadValue" Classes="naTrafficValue" Text="-" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Classes="naTrafficLabel" Text="{x:Static resources:Resource.NetworkAccelerationPage_Metric_Download}" />
                                        <TextBlock x:Name="_trafficDownloadValue" Classes="naTrafficValue" Text="-" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Classes="naTrafficLabel" Text="{x:Static resources:Resource.NetworkAccelerationPage_Metric_Connections}" />
                                        <TextBlock x:Name="_trafficConnectionsValue" Classes="naTrafficValue" Text="-" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                        <TextBlock x:Name="_trafficTotalLabel" Classes="naTrafficLabel" />
                                        <TextBlock x:Name="_trafficTotalValue" Classes="naTrafficValue" Text="-" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock x:Name="_runtimeHealthLabel" Classes="naTrafficLabel" />
                                        <TextBlock x:Name="_runtimeHealthValue" Classes="naTrafficValue" Text="-" />
                                    </StackPanel>
                                </Grid>
                                <Grid Height="156">
                                    <charts:TrendChartControl
                                        x:Name="_trafficChart"
                                        Capacity="60"
                                        GridlineBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BaselineBrush="{DynamicResource PaletteOrangeBrush}"
                                        ScaleLabelBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                        PlotPadding="44,4,4,6" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="44,6,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                        <Rectangle Width="8" Height="8" RadiusX="4" RadiusY="4" Fill="{DynamicResource PaletteOrangeBrush}" VerticalAlignment="Center" />
                                        <TextBlock Margin="6,0,0,0" Classes="naTrafficLabel" Text="{x:Static resources:Resource.NetworkAccelerationPage_Metric_Upload}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="8" Height="8" RadiusX="4" RadiusY="4" Fill="{DynamicResource PaletteLightBlueBrush}" VerticalAlignment="Center" />
                                        <TextBlock Margin="6,0,0,0" Classes="naTrafficLabel" Text="{x:Static resources:Resource.NetworkAccelerationPage_Metric_Download}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="_trafficStatusText" Margin="44,6,0,0" Classes="appMutedTextBlock" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Margin="0,0,5,0" Padding="10,8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusSmall}">
                                <StackPanel>
                                    <TextBlock x:Name="_connectionsHeading" Classes="naDiagTitle" />
                                    <TextBlock x:Name="_currentConnectionsText" Margin="0,3,0,6" Classes="naTrafficLabel" />
                                    <ItemsControl x:Name="_connectionListPanel" AutomationProperties.AutomationId="NetworkAccelerationConnectionsList" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Margin="5,0,0,0" Padding="10,8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusSmall}">
                                <StackPanel>
                                    <TextBlock x:Name="_destinationsHeading" Classes="naDiagTitle" />
                                    <TextBlock x:Name="_destinationsSummaryText" Margin="0,3,0,6" Classes="naTrafficLabel" />
                                    <ItemsControl x:Name="_destinationListPanel" AutomationProperties.AutomationId="NetworkAccelerationDestinationsList" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <Grid Margin="0,14,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Classes="appSectionLabelTextBlock" Text="{x:Static resources:Resource.NetworkAccelerationPage_TargetsHeading}" />
                            <TextBlock Classes="appMutedTextBlock" Text="{x:Static resources:Resource.NetworkAccelerationPage_DomainGroupsHint}" />
                        </StackPanel>
                        <TextBox
                            x:Name="_targetSearchBox"
                            Grid.Column="1"
                            Width="200"
                            MinHeight="28"
                            Padding="8,4"
                            VerticalContentAlignment="Center"
                            TextChanged="TargetSearchBox_TextChanged"
                            AutomationProperties.AutomationId="NetworkAccelerationTargetSearchBox" />
                    </Grid>
                    <ItemsControl x:Name="_serviceListPanel" AutomationProperties.AutomationId="NetworkAccelerationDomainsCard" />
                    <custom:EmptyState
                        x:Name="_domainGroupsEmptyState"
                        Margin="0,8,0,8"
                        Icon="Globe24"
                        Title="{x:Static resources:Resource.NetworkAccelerationPage_DomainGroupsEmptyTitle}"
                        Description="{x:Static resources:Resource.NetworkAccelerationPage_DomainGroupsEmptyDescription}"
                        IsVisible="False"
                        AutomationProperties.AutomationId="NetworkAccelerationDomainGroupsEmptyState" />
                    <TextBlock Margin="0,2,0,0" Classes="appMutedTextBlock" Text="{x:Static resources:Resource.NetworkAccelerationPage_SelectionHint}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Margin="0,0,6,0" MinHeight="76" Padding="12,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Appearance="Secondary" Icon="Info24" Click="NatStatus_Click" AutomationProperties.AutomationId="NetworkAccelerationNatSection">
                            <StackPanel>
                                <TextBlock Classes="naDiagTitle" Text="{x:Static resources:Resource.NaDiag_NatTitle}" />
                                <TextBlock x:Name="_natSummaryText" Classes="naTrafficLabel" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Grid.Column="1" Margin="3,0" MinHeight="76" Padding="12,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Appearance="Secondary" Icon="Info24" Click="DnsStatus_Click" AutomationProperties.AutomationId="NetworkAccelerationDnsSection">
                            <StackPanel>
                                <TextBlock Classes="naDiagTitle" Text="{x:Static resources:Resource.NaDiag_DnsTitle}" />
                                <TextBlock x:Name="_dnsSummaryText" Classes="naTrafficLabel" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Grid.Column="2" Margin="6,0,0,0" MinHeight="76" Padding="12,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Appearance="Secondary" Icon="Info24" Click="Ipv6Status_Click" AutomationProperties.AutomationId="NetworkAccelerationIpv6Section">
                            <StackPanel>
                                <TextBlock Classes="naDiagTitle" Text="{x:Static resources:Resource.NaDiag_Ipv6Title}" />
                                <TextBlock x:Name="_ipv6SummaryText" Classes="naTrafficLabel" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <Expander
                        x:Name="_advancedExpander"
                        Margin="0,14,0,0"
                        IsExpanded="False"
                        AutomationProperties.AutomationId="NetworkAccelerationAdvancedExpander">
                        <Expander.Header>
                            <TextBlock FontSize="{DynamicResource FontSizeSmallCaption}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static resources:Resource.NetworkAccelerationPage_AdvancedHeading}" />
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Classes="appMutedTextBlock" Text="{x:Static resources:Resource.NetworkAccelerationPage_AdvancedBody}" />
                            <TextBlock x:Name="_modeText" Margin="0,8,0,0" FontSize="{DynamicResource FontSizeSmallCaption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="_portText" Margin="0,2,0,8" FontSize="{DynamicResource FontSizeSmallCaption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Border Padding="10,8" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusControl}">
                                <StackPanel>
                                    <TextBlock FontSize="{DynamicResource FontSizeSmallCaption}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static resources:Resource.NetworkAccelerationPage_DangerZoneHeading}" />
                                    <TextBlock Margin="0,4,0,8" Classes="appMutedTextBlock" Text="{x:Static resources:Resource.NetworkAccelerationPage_RestoreHint}" />
                                    <ui:Button
                                        x:Name="_restoreButton"
                                        HorizontalAlignment="Left"
                                        Classes="naSecondaryButton"
                                        Appearance="Secondary"
                                        Icon="ArrowReset24"
                                        AutomationProperties.AutomationId="NetworkAccelerationRestoreButton"
                                        AutomationProperties.Name="{x:Static resources:Resource.NetworkAccelerationPage_RestoreNetwork}"
                                        Click="RestoreButton_Click"
                                        Content="{x:Static resources:Resource.NetworkAccelerationPage_RestoreNetwork}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </custom:DynamicScrollViewer>

        <Popup x:Name="_natDetailsPopup" Placement="Pointer" IsOpen="False">
            <Border Width="360" Padding="14,12" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusControl}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Classes="naDiagTitle" Text="{x:Static resources:Resource.NaDiag_NatTitle}" />
                        <ui:Button x:Name="_natDetectButton" Grid.Column="1" Classes="naSecondaryButton" Appearance="Secondary" Icon="ArrowSync24" Click="NatDetectButton_Click" Content="{x:Static resources:Resource.NaDiag_Detect}" AutomationProperties.AutomationId="NetworkAccelerationNatDetectButton" />
                    </Grid>
                    <ComboBox x:Name="_natStunCombo" Margin="0,10,0,6" MinHeight="28" AutomationProperties.AutomationId="NetworkAccelerationNatStunCombo" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Classes="naDiagLabel" Text="{x:Static resources:Resource.NaDiag_NatType}" />
                        <TextBlock x:Name="_natTypeText" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Classes="naDiagValue" Text="{x:Static resources:Resource.NaDiag_Unknown}" />
                        <TextBlock Grid.Row="1" Classes="naDiagLabel" Text="{x:Static resources:Resource.NaDiag_LocalIp}" />
                        <TextBlock x:Name="_natLocalIpText" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Classes="naDiagValue" Text="-" />
                        <TextBlock Grid.Row="2" Classes="naDiagLabel" Text="{x:Static resources:Resource.NaDiag_PublicIp}" />
                        <TextBlock x:Name="_natPublicIpText" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Classes="naDiagValue" Text="-" />
                        <TextBlock Grid.Row="3" Classes="naDiagLabel" Text="{x:Static resources:Resource.NaDiag_Internet}" />
                        <TextBlock x:Name="_natInternetText" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" Classes="naDiagValue" Text="-" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="_dnsDetailsPopup" Placement="Pointer" IsOpen="False">
            <Border Width="420" Padding="14,12" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusControl}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Classes="naDiagTitle" Text="{x:Static resources:Resource.NaDiag_DnsTitle}" />
                        <ui:Button x:Name="_dnsDetectButton" Grid.Column="1" Classes="naSecondaryButton" Appearance="Secondary" Icon="ArrowSync24" Click="DnsDetectButton_Click" Content="{x:Static resources:Resource.NaDiag_Detect}" AutomationProperties.AutomationId="NetworkAccelerationDnsDetectButton" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Classes="naDiagLabel" Text="{x:Static resources:Resource.NaDiag_DnsDomain}" />
                        <TextBox x:Name="_dnsDomainInput" Grid.Row="0" Grid.Column="1" Margin="8,0,0,5" Classes="naDiagInput" Text="store.steampowered.com" />
                        <TextBlock Grid.Row="1" Classes="naDiagLabel" Text="{x:Static resources:Resource.NaDiag_CustomDns}" />
                        <ComboBox x:Name="_dnsServerCombo" Grid.Row="1" Grid.Column="1" Margin="8,0,0,5" Classes="naDiagCombo" />
                        <TextBlock Grid.Row="2" Classes="naDiagLabel" Text="{x:Static resources:Resource.NaDiag_EnableDoh}" />
                        <ui:ToggleSwitch x:Name="_dnsDohToggle" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" IsChecked="True" />
                        <TextBlock Grid.Row="3" Classes="naDiagLabel" Text="{x:Static resources:Resource.NaDiag_DohUrl}" />
                        <ComboBox x:Name="_dnsDohUrlCombo" Grid.Row="3" Grid.Column="1" Margin="8,0,0,5" Classes="naDiagCombo" />
                        <TextBlock Grid.Row="4" Classes="naDiagLabel" Text="{x:Static resources:Resource.NaDiag_Latency}" />
                        <TextBlock x:Name="_dnsLatencyText" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right" Classes="naDiagValue" Text="-" />
                        <TextBlock Grid.Row="5" Classes="naDiagLabel" Text="{x:Static resources:Resource.NaDiag_ResolvedAddress}" />
                        <TextBlock x:Name="_dnsResolvedText" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Right" Classes="naDiagValue" Text="-" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="_ipv6DetailsPopup" Placement="Pointer" IsOpen="False">
            <Border Width="360" Padding="14,12" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusControl}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Classes="naDiagTitle" Text="{x:Static resources:Resource.NaDiag_Ipv6Title}" />
                        <ui:Button x:Name="_ipv6DetectButton" Grid.Column="1" Classes="naSecondaryButton" Appearance="Secondary" Icon="ArrowSync24" Click="Ipv6DetectButton_Click" Content="{x:Static resources:Resource.NaDiag_Detect}" AutomationProperties.AutomationId="NetworkAccelerationIpv6DetectButton" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Classes="naDiagLabel" Text="{x:Static resources:Resource.NaDiag_Ipv6Support}" />
                        <TextBlock x:Name="_ipv6SupportText" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Classes="naDiagValue" Text="-" />
                        <TextBlock Grid.Row="1" Classes="naDiagLabel" Text="{x:Static resources:Resource.NaDiag_Ipv6Address}" />
                        <TextBlock x:Name="_ipv6AddressText" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Classes="naDiagValue" Text="-" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
