<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:UniversalDeviceToolkit.Avalonia.Localization"
             xmlns:controls="using:UniversalDeviceToolkit.Avalonia.Controls"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="UniversalDeviceToolkit.Avalonia.Pages.AutomationPage"
             automation:AutomationProperties.AutomationId="AvaloniaAutomationPage">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,16"
                    Spacing="18"
                    HorizontalAlignment="Left">
            <StackPanel Spacing="0">
                <controls:LocalizedTextBlock x:Name="PageTitle"
                                             FontSize="{StaticResource FontSizePageTitle}"
                                             FontWeight="Medium"
                                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                             Margin="0,16,0,8"
                                             OverflowMode="Wrap"
                                             MaxLines="2"
                                             automation:AutomationProperties.AutomationId="AutomationPageTitle" />
                <controls:LocalizedTextBlock x:Name="PageDescription"
                                             FontSize="{StaticResource FontSizePageDescription}"
                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                             Margin="0,0,0,24"
                                             OverflowMode="Wrap"
                                             MaxLines="3"
                                             automation:AutomationProperties.AutomationId="AutomationPageDescription" />
            </StackPanel>

            <!-- Automatic pipelines section (WPF parity: toggle card + pipeline list + add button). -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusCard}"
                    Padding="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                        <controls:LocalizedTextBlock x:Name="EnabledTitle"
                                                     FontWeight="Medium"
                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                     OverflowMode="Wrap"
                                                     MaxLines="2" />
                        <controls:LocalizedTextBlock x:Name="EnabledDescription"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                     OverflowMode="Wrap"
                                                     MaxLines="3" />
                    </StackPanel>
                    <CheckBox x:Name="EnabledToggle"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              MinWidth="48"
                              automation:AutomationProperties.AutomationId="AutomationEnableAutomaticPipelinesToggle"
                              automation:AutomationProperties.Name="{Binding #EnabledTitle.Text}" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Spacing="4">
                    <controls:LocalizedTextBlock x:Name="PipelinesTitle"
                                                 FontSize="{StaticResource FontSizeSection}"
                                                 FontWeight="Medium"
                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                 OverflowMode="Wrap"
                                                 MaxLines="2" />
                    <controls:LocalizedTextBlock x:Name="PipelinesDescription"
                                                 FontSize="{StaticResource FontSizePageDescription}"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                 OverflowMode="Wrap"
                                                 MaxLines="3" />
                </StackPanel>
                <Button x:Name="AddAutomaticButton"
                        Grid.Column="1"
                        MinWidth="132"
                        VerticalAlignment="Center"
                        automation:AutomationProperties.AutomationId="AutomationAddAutomaticPipelineButton" />
            </Grid>

            <StackPanel x:Name="AutomaticPipelineList" Spacing="8"
                        automation:AutomationProperties.AutomationId="AutomationPipelineList" />
            <controls:LocalizedTextBlock x:Name="AutomaticEmptyText"
                                         IsVisible="False"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                         OverflowMode="Wrap"
                                         MaxLines="3"
                                         automation:AutomationProperties.AutomationId="AutomationPipelineEmptyState" />

            <!-- Manual quick actions section (WPF parity). -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,24,0,0">
                <StackPanel Spacing="4">
                    <controls:LocalizedTextBlock x:Name="QuickActionsTitle"
                                                 FontSize="{StaticResource FontSizeSection}"
                                                 FontWeight="Medium"
                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                 OverflowMode="Wrap"
                                                 MaxLines="2" />
                    <controls:LocalizedTextBlock x:Name="QuickActionsDescription"
                                                 FontSize="{StaticResource FontSizePageDescription}"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                 OverflowMode="Wrap"
                                                 MaxLines="3" />
                </StackPanel>
                <Button x:Name="AddButton"
                        Grid.Column="1"
                        MinWidth="132"
                        VerticalAlignment="Center"
                        automation:AutomationProperties.AutomationId="AutomationAddManualPipelineButton" />
            </Grid>

            <StackPanel x:Name="ManualPipelineList" Spacing="8"
                        automation:AutomationProperties.AutomationId="AutomationManualPipelineList" />
            <controls:LocalizedTextBlock x:Name="ManualEmptyText"
                                         IsVisible="False"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                         OverflowMode="Wrap"
                                         MaxLines="3"
                                         automation:AutomationProperties.AutomationId="AutomationManualPipelineEmptyState" />

            <Border x:Name="FeedbackBar"
                    Classes="infoBar informational"
                    IsVisible="False"
                    automation:AutomationProperties.AutomationId="AutomationFeedback">
                <controls:LocalizedTextBlock x:Name="FeedbackMessageBlock"
                                             Classes="infoBarMessage"
                                             OverflowMode="Wrap"
                                             MaxLines="3" />
            </Border>

            <StackPanel x:Name="SaveRevertPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        IsVisible="False">
                <Button x:Name="SaveButton"
                        MinWidth="108"
                        automation:AutomationProperties.AutomationId="AutomationSaveButton" />
                <Button x:Name="RevertButton"
                        MinWidth="108"
                        automation:AutomationProperties.AutomationId="AutomationRevertButton" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
