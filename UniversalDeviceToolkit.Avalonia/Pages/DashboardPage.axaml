<UserControl
    x:Class="UniversalDeviceToolkit.Avalonia.Pages.DashboardPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:controls="using:UniversalDeviceToolkit.Avalonia.Controls"
    xmlns:custom="using:UniversalDeviceToolkit.Avalonia.Controls.Custom"
    xmlns:dashboard="using:UniversalDeviceToolkit.Avalonia.Controls.Dashboard"
    xmlns:resources="using:UniversalDeviceToolkit.Avalonia.Resources"
    xmlns:utils="using:UniversalDeviceToolkit.Avalonia.Utils"
    xmlns:ui="using:UniversalDeviceToolkit.Avalonia.Controls"
    automation:AutomationProperties.AutomationId="DashboardPageRoot"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    Initialized="DashboardPage_Initialized"
    SizeChanged="DashboardPage_SizeChanged">

    <UserControl.Styles>
        <Style Selector="Border.dashboardSkeletonShimmerBlock">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSM}" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="utils:SkeletonShimmer.IsEnabled" Value="True" />
            <Setter Property="utils:SkeletonShimmer.DelaySeconds" Value="-1" />
        </Style>

        <Style Selector="Border.dashboardListSkeletonCard">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusCard}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!--
          Sensors skeleton mirrors SensorsControl overlay layout:
          title + model subtitle, GaugeSizeMD + 3 metric rows, trend well, 3-item legend.
        -->
        <Style Selector="Border.dashboardSensorsSkeletonCard">
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Padding" Value="8,10" />
            <Setter Property="MinHeight" Value="280" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceCardBrush}" />
        </Style>

        <Style Selector="StackPanel.dashboardSensorsSkeletonSection">
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style Selector="Border.dashboardSensorsSkeletonTitle">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="utils:SkeletonShimmer.IsEnabled" Value="True" />
            <Setter Property="utils:SkeletonShimmer.DelaySeconds" Value="-1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Width" Value="72" />
            <Setter Property="MaxWidth" Value="120" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="Border.dashboardSensorsSkeletonSubtitle">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="utils:SkeletonShimmer.IsEnabled" Value="True" />
            <Setter Property="utils:SkeletonShimmer.DelaySeconds" Value="-1" />
            <Setter Property="Height" Value="14" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Width" Value="140" />
            <Setter Property="MaxWidth" Value="220" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,1,0,0" />
        </Style>

        <Style Selector="Border.dashboardSensorsSkeletonGauge">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="utils:SkeletonShimmer.IsEnabled" Value="True" />
            <Setter Property="utils:SkeletonShimmer.DelaySeconds" Value="-1" />
            <Setter Property="Width" Value="{StaticResource GaugeSizeMD}" />
            <Setter Property="Height" Value="{StaticResource GaugeSizeMD}" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusRound}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.dashboardSensorsSkeletonLabel">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="utils:SkeletonShimmer.IsEnabled" Value="True" />
            <Setter Property="utils:SkeletonShimmer.DelaySeconds" Value="-1" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Width" Value="56" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.dashboardSensorsSkeletonBar">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="utils:SkeletonShimmer.IsEnabled" Value="True" />
            <Setter Property="utils:SkeletonShimmer.DelaySeconds" Value="-1" />
            <Setter Property="Height" Value="3.5" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MaxWidth" Value="260" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusProgressBar}" />
        </Style>

        <Style Selector="Border.dashboardSensorsSkeletonValue">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="utils:SkeletonShimmer.IsEnabled" Value="True" />
            <Setter Property="utils:SkeletonShimmer.DelaySeconds" Value="-1" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Width" Value="64" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.dashboardSensorsSkeletonTrendPanel">
            <Setter Property="Margin" Value="0,14,0,0" />
            <Setter Property="Height" Value="76" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMD}" />
            <Setter Property="Background" Value="{DynamicResource ChartSurfaceBrush}" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="Border.dashboardSensorsSkeletonTrendFill">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="utils:SkeletonShimmer.IsEnabled" Value="True" />
            <Setter Property="utils:SkeletonShimmer.DelaySeconds" Value="-1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
        </Style>

        <Style Selector="WrapPanel.dashboardSensorsSkeletonLegendPanel">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Orientation" Value="Horizontal" />
        </Style>

        <Style Selector="StackPanel.dashboardSensorsSkeletonLegendItem">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,4" />
        </Style>

        <Style Selector="Border.dashboardSensorsSkeletonLegendDot">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="utils:SkeletonShimmer.IsEnabled" Value="True" />
            <Setter Property="utils:SkeletonShimmer.DelaySeconds" Value="-1" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="Border.dashboardSensorsSkeletonLegendText">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="utils:SkeletonShimmer.IsEnabled" Value="True" />
            <Setter Property="utils:SkeletonShimmer.DelaySeconds" Value="-1" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <custom:DynamicScrollViewer
        x:Name="_scrollViewer"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <controls:LoadableControl
            x:Name="_loader"
            Margin="0,0,0,12"
            ContentVisibilityWhileLoading="True">
            <controls:LoadableControl.LoadingContent>
                <StackPanel
                    Margin="0,16,0,0"
                    automation:AutomationProperties.AutomationId="DashboardLoadingSkeleton"
                    automation:AutomationProperties.Name="{x:Static resources:Resource.DashboardPage_Title}">

                    <!--
                      Single page-owned skeleton: sensors card + feature groups.
                      NavigationStore skips its generic shell because DashboardPage owns loading chrome.
                      Content stays Opacity 0 while loading, so SensorsControl overlay cannot paint —
                      the page skeleton must include the sensor-card silhouette.
                    -->
                    <Border
                        x:Name="_skeletonSensorsCard"
                        automation:AutomationProperties.AutomationId="DashboardSensorsLoadingSkeleton"
                        Classes="dashboardSensorsSkeletonCard">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- CPU: title+model, gauge+3 metrics, trend, legend -->
                            <StackPanel Grid.Column="0" Classes="dashboardSensorsSkeletonSection">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Classes="dashboardSensorsSkeletonTitle" Width="72" />
                                    <Border Grid.Column="1" Classes="dashboardSensorsSkeletonSubtitle" Width="168" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Classes="dashboardSensorsSkeletonGauge" />
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" MinWidth="72" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Grid.Column="0" Classes="dashboardSensorsSkeletonLabel" Width="52" />
                                        <Border Grid.Row="0" Grid.Column="1" Classes="dashboardSensorsSkeletonBar" />
                                        <Border Grid.Row="0" Grid.Column="2" Classes="dashboardSensorsSkeletonValue" Width="58" />
                                        <Border Grid.Row="1" Grid.Column="0" Classes="dashboardSensorsSkeletonLabel" Width="44" />
                                        <Border Grid.Row="1" Grid.Column="1" Classes="dashboardSensorsSkeletonBar" />
                                        <Border Grid.Row="1" Grid.Column="2" Classes="dashboardSensorsSkeletonValue" Width="48" />
                                        <Border Grid.Row="2" Grid.Column="0" Classes="dashboardSensorsSkeletonLabel" Width="40" />
                                        <Border Grid.Row="2" Grid.Column="1" Classes="dashboardSensorsSkeletonBar" />
                                        <Border Grid.Row="2" Grid.Column="2" Classes="dashboardSensorsSkeletonValue" Width="36" />
                                    </Grid>
                                </Grid>
                                <Border Classes="dashboardSensorsSkeletonTrendPanel">
                                    <Border Classes="dashboardSensorsSkeletonTrendFill" />
                                </Border>
                                <WrapPanel Classes="dashboardSensorsSkeletonLegendPanel">
                                    <StackPanel Classes="dashboardSensorsSkeletonLegendItem">
                                        <Border Classes="dashboardSensorsSkeletonLegendDot" />
                                        <Border Classes="dashboardSensorsSkeletonLegendText" Width="42" />
                                    </StackPanel>
                                    <StackPanel Classes="dashboardSensorsSkeletonLegendItem">
                                        <Border Classes="dashboardSensorsSkeletonLegendDot" />
                                        <Border Classes="dashboardSensorsSkeletonLegendText" Width="52" />
                                    </StackPanel>
                                    <StackPanel Classes="dashboardSensorsSkeletonLegendItem">
                                        <Border Classes="dashboardSensorsSkeletonLegendDot" />
                                        <Border Classes="dashboardSensorsSkeletonLegendText" Width="36" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Battery -->
                            <StackPanel Grid.Column="1" Classes="dashboardSensorsSkeletonSection">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Classes="dashboardSensorsSkeletonTitle" Width="56" />
                                    <Border Grid.Column="1" Classes="dashboardSensorsSkeletonSubtitle" Width="120" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Classes="dashboardSensorsSkeletonGauge" />
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" MinWidth="72" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Grid.Column="0" Classes="dashboardSensorsSkeletonLabel" Width="40" />
                                        <Border Grid.Row="0" Grid.Column="1" Classes="dashboardSensorsSkeletonBar" />
                                        <Border Grid.Row="0" Grid.Column="2" Classes="dashboardSensorsSkeletonValue" Width="52" />
                                        <Border Grid.Row="1" Grid.Column="0" Classes="dashboardSensorsSkeletonLabel" Width="48" />
                                        <Border Grid.Row="1" Grid.Column="1" Classes="dashboardSensorsSkeletonBar" />
                                        <Border Grid.Row="1" Grid.Column="2" Classes="dashboardSensorsSkeletonValue" Width="56" />
                                        <Border Grid.Row="2" Grid.Column="0" Classes="dashboardSensorsSkeletonLabel" Width="36" />
                                        <Border Grid.Row="2" Grid.Column="1" Classes="dashboardSensorsSkeletonBar" />
                                        <Border Grid.Row="2" Grid.Column="2" Classes="dashboardSensorsSkeletonValue" Width="60" />
                                    </Grid>
                                </Grid>
                                <Border Classes="dashboardSensorsSkeletonTrendPanel">
                                    <Border Classes="dashboardSensorsSkeletonTrendFill" />
                                </Border>
                                <WrapPanel Classes="dashboardSensorsSkeletonLegendPanel">
                                    <StackPanel Classes="dashboardSensorsSkeletonLegendItem">
                                        <Border Classes="dashboardSensorsSkeletonLegendDot" />
                                        <Border Classes="dashboardSensorsSkeletonLegendText" Width="36" />
                                    </StackPanel>
                                    <StackPanel Classes="dashboardSensorsSkeletonLegendItem">
                                        <Border Classes="dashboardSensorsSkeletonLegendDot" />
                                        <Border Classes="dashboardSensorsSkeletonLegendText" Width="44" />
                                    </StackPanel>
                                    <StackPanel Classes="dashboardSensorsSkeletonLegendItem">
                                        <Border Classes="dashboardSensorsSkeletonLegendDot" />
                                        <Border Classes="dashboardSensorsSkeletonLegendText" Width="36" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>

                            <!-- GPU -->
                            <StackPanel Grid.Column="2" Classes="dashboardSensorsSkeletonSection">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Classes="dashboardSensorsSkeletonTitle" Width="48" />
                                    <Border Grid.Column="1" Classes="dashboardSensorsSkeletonSubtitle" Width="152" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Classes="dashboardSensorsSkeletonGauge" />
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" MinWidth="72" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Grid.Column="0" Classes="dashboardSensorsSkeletonLabel" Width="52" />
                                        <Border Grid.Row="0" Grid.Column="1" Classes="dashboardSensorsSkeletonBar" />
                                        <Border Grid.Row="0" Grid.Column="2" Classes="dashboardSensorsSkeletonValue" Width="58" />
                                        <Border Grid.Row="1" Grid.Column="0" Classes="dashboardSensorsSkeletonLabel" Width="44" />
                                        <Border Grid.Row="1" Grid.Column="1" Classes="dashboardSensorsSkeletonBar" />
                                        <Border Grid.Row="1" Grid.Column="2" Classes="dashboardSensorsSkeletonValue" Width="48" />
                                        <Border Grid.Row="2" Grid.Column="0" Classes="dashboardSensorsSkeletonLabel" Width="40" />
                                        <Border Grid.Row="2" Grid.Column="1" Classes="dashboardSensorsSkeletonBar" />
                                        <Border Grid.Row="2" Grid.Column="2" Classes="dashboardSensorsSkeletonValue" Width="36" />
                                    </Grid>
                                </Grid>
                                <Border Classes="dashboardSensorsSkeletonTrendPanel">
                                    <Border Classes="dashboardSensorsSkeletonTrendFill" />
                                </Border>
                                <WrapPanel Classes="dashboardSensorsSkeletonLegendPanel">
                                    <StackPanel Classes="dashboardSensorsSkeletonLegendItem">
                                        <Border Classes="dashboardSensorsSkeletonLegendDot" />
                                        <Border Classes="dashboardSensorsSkeletonLegendText" Width="42" />
                                    </StackPanel>
                                    <StackPanel Classes="dashboardSensorsSkeletonLegendItem">
                                        <Border Classes="dashboardSensorsSkeletonLegendDot" />
                                        <Border Classes="dashboardSensorsSkeletonLegendText" Width="52" />
                                    </StackPanel>
                                    <StackPanel Classes="dashboardSensorsSkeletonLegendItem">
                                        <Border Classes="dashboardSensorsSkeletonLegendDot" />
                                        <Border Classes="dashboardSensorsSkeletonLegendText" Width="36" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="_skeletonGroupsGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="_skeletonGroup0" Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
                            <Border Width="132" Height="29" Margin="0,0,0,24" HorizontalAlignment="Left" Classes="dashboardSkeletonShimmerBlock" />
                            <Border Classes="dashboardListSkeletonCard">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="0"
                                        Margin="0,0,12,0"
                                        Classes="appSkeletonListItemIcon" />
                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="180"
                                        Classes="appSkeletonListItemPrimaryLine" />
                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="220"
                                        Margin="0,8,0,0"
                                        Classes="appSkeletonListItemSecondaryLine" />
                                </Grid>
                            </Border>
                            <Border Classes="dashboardListSkeletonCard">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="0"
                                        Margin="0,0,12,0"
                                        Classes="appSkeletonListItemIcon" />
                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="160"
                                        Classes="appSkeletonListItemPrimaryLine" />
                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="200"
                                        Margin="0,8,0,0"
                                        Classes="appSkeletonListItemSecondaryLine" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="_skeletonGroup1" Grid.Row="0" Grid.Column="1" Margin="0,0,16,0">
                            <Border Width="112" Height="29" Margin="0,0,0,24" HorizontalAlignment="Left" Classes="dashboardSkeletonShimmerBlock" />
                            <Border Classes="dashboardListSkeletonCard">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Margin="0,1,12,0" Classes="appSkeletonListItemIcon" />
                                    <Border Grid.Column="1" Width="196" Classes="appSkeletonListItemSingleLine" />
                                </Grid>
                            </Border>
                            <Border Classes="dashboardListSkeletonCard">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Margin="0,1,12,0" Classes="appSkeletonListItemIcon" />
                                    <Border Grid.Column="1" Width="172" Classes="appSkeletonListItemSingleLine" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="_skeletonGroup2" Grid.Row="0" Grid.Column="2" Margin="0,0,16,0">
                            <Border Width="144" Height="29" Margin="0,0,0,24" HorizontalAlignment="Left" Classes="dashboardSkeletonShimmerBlock" />
                            <Border Classes="dashboardListSkeletonCard">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Margin="0,0,12,0" Classes="appSkeletonListItemIcon" />
                                    <Border Grid.Row="0" Grid.Column="1" Width="176" Classes="appSkeletonListItemPrimaryLine" />
                                    <Border Grid.Row="1" Grid.Column="1" Width="216" Margin="0,8,0,0" Classes="appSkeletonListItemSecondaryLine" />
                                </Grid>
                            </Border>
                            <Border Classes="dashboardListSkeletonCard">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Margin="0,1,12,0" Classes="appSkeletonListItemIcon" />
                                    <Border Grid.Column="1" Width="188" Classes="appSkeletonListItemSingleLine" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </controls:LoadableControl.LoadingContent>

            <Grid
                x:Name="_dashboardContentRoot"
                IsHitTestVisible="False"
                Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <dashboard:SensorsControl x:Name="_sensors" Grid.Row="0" Margin="0,16,16,0" />
                <Grid x:Name="_content" Grid.Row="1" VerticalAlignment="Stretch" />
            </Grid>
        </controls:LoadableControl>
    </custom:DynamicScrollViewer>
</UserControl>
