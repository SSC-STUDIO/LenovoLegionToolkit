<UserControl xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="using:UniversalDeviceToolkit.Avalonia.Localization"
                 xmlns:controls="using:UniversalDeviceToolkit.Avalonia.Controls"
                 xmlns:automation="using:Avalonia.Automation"
                 x:Class="UniversalDeviceToolkit.Avalonia.Pages.DashboardPage">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Margin="32">

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                    <controls:LocalizedTextBlock Text="{local:Loc Key=Dashboard_Title, Fallback=Dashboard}"
                               FontSize="{StaticResource FontSizePageTitle}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               OverflowMode="Wrap"
                               MaxLines="2" />
                    <controls:LocalizedTextBlock Text="{local:Loc Key=Dashboard_Subtitle, Fallback=Device health and controls}"
                               FontSize="{StaticResource FontSizeSmallBody}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               OverflowMode="Wrap"
                               MaxLines="2" />
                    <controls:LocalizedTextBlock Text="{Binding DeviceName}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="{StaticResource FontSizeSmallCaption}"
                               OverflowMode="Ellipsis"
                               MaxLines="1" />
                </StackPanel>
                <Button Grid.Column="1"
                        x:Name="DashboardRefreshButton"
                        automation:AutomationProperties.AutomationId="AvaloniaDashboardRefreshButton"
                        Command="{Binding RefreshCommand}"
                        ToolTip.Tip="{local:Loc Key=Dashboard_Refresh, Fallback=Refresh dashboard}"
                        Padding="10,6"
                        MinWidth="80"
                        CornerRadius="{StaticResource CornerRadiusControl}"
                        Background="{DynamicResource ButtonBackgroundBrush}"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:NavigationIcon IconIdentifier="ArrowSync24"
                                                 FontSize="{StaticResource IconSizeCompact}" />
                        <controls:LocalizedTextBlock Text="{local:Loc Key=Dashboard_Refresh, Fallback=Refresh}"
                                                     OverflowMode="Ellipsis"
                                                     MaxLines="1" />
                    </StackPanel>
                </Button>
                <Border Grid.Column="2"
                        Background="{DynamicResource StatusSuccessBackgroundBrush}"
                        BorderBrush="{DynamicResource StatusSuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusRound}"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <controls:LocalizedTextBlock Text="{Binding DeviceSupport}"
                               Foreground="{DynamicResource StatusSuccessBrush}"
                               FontSize="{StaticResource FontSizeSmallCaption}"
                               FontWeight="SemiBold"
                               OverflowMode="Ellipsis"
                               MaxLines="1" />
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <controls:LocalizedTextBlock Text="{local:Loc Key=Dashboard_Power, Fallback=Power}"
                                                         FontSize="{StaticResource FontSizeBody}"
                                                         FontWeight="Medium"
                                                         OverflowMode="Ellipsis"
                                                         MaxLines="1" />
                            <controls:LocalizedTextBlock Text="{Binding PowerStatus}"
                                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                         OverflowMode="Ellipsis"
                                                         MaxLines="2" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="PowerRefreshButton"
                                Command="{Binding RefreshCommand}"
                                automation:AutomationProperties.AutomationId="AvaloniaPowerRefreshButton"
                                automation:AutomationProperties.Name="{local:Loc Key=Dashboard_Refresh, Fallback=Refresh}"
                                ToolTip.Tip="{local:Loc Key=Dashboard_Refresh, Fallback=Refresh}"
                                Padding="8"
                                MinWidth="36"
                                VerticalAlignment="Center">
                            <controls:NavigationIcon IconIdentifier="ArrowSync24"
                                                     FontSize="{StaticResource IconSizeCompact}" />
                        </Button>
                    </Grid>
                </Border>
                <Border Grid.Column="1"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="16">
                    <StackPanel Spacing="4">
                        <controls:LocalizedTextBlock Text="{local:Loc Key=Dashboard_LastUpdated, Fallback=Last updated}"
                                                     FontSize="{StaticResource FontSizeBody}"
                                                     FontWeight="Medium"
                                                     OverflowMode="Ellipsis"
                                                     MaxLines="1" />
                        <controls:LocalizedTextBlock Text="{Binding LastUpdatedText}"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                     OverflowMode="Ellipsis"
                                                     MaxLines="1" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="16"
                        ToolTip.Tip="{Binding DiscreteGpuState.Error}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Spacing="2" MinWidth="0">
                                <controls:LocalizedTextBlock Text="{local:Loc Key=DiscreteGPUControl_Title, Fallback=Discrete GPU}"
                                                             FontSize="{StaticResource FontSizeBody}"
                                                             FontWeight="Medium"
                                                             OverflowMode="Ellipsis"
                                                             MaxLines="1" />
                                <controls:LocalizedTextBlock Text="{local:Loc Key=DiscreteGPUControl_Message, Fallback=Monitor and manage the discrete GPU.}"
                                                             FontSize="{StaticResource FontSizeSmallCaption}"
                                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                             OverflowMode="Wrap"
                                                             MaxLines="2" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource StatusInfoBackgroundBrush}"
                                    BorderBrush="{DynamicResource StatusInfoBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerRadiusRound}"
                                    Padding="8,4">
                                <controls:LocalizedTextBlock Text="{Binding DiscreteGpuState.Status}"
                                                             Foreground="{DynamicResource StatusInfoBrush}"
                                                             FontSize="{StaticResource FontSizeSmallCaption}"
                                                             FontWeight="SemiBold"
                                                             OverflowMode="Ellipsis"
                                                             MaxLines="1" />
                            </Border>
                        </Grid>
                        <controls:LocalizedTextBlock Grid.Row="1"
                                                     Text="{Binding DiscreteGpuState.PerformanceState}"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                     OverflowMode="Ellipsis"
                                                     MaxLines="1" />
                        <controls:LocalizedTextBlock Grid.Row="2"
                                                     Text="{Binding DiscreteGpuState.ProcessCount, StringFormat={}{0} processes}"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                     OverflowMode="Ellipsis"
                                                     MaxLines="1" />
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding KillDiscreteGpuProcessesCommand}"
                                    IsEnabled="{Binding DiscreteGpuState.CanKillProcesses}"
                                    Padding="8,4"
                                    ToolTip.Tip="{local:Loc Key=DiscreteGPUControl_KillApps, Fallback=Stop GPU apps}"
                                    automation:AutomationProperties.Name="{local:Loc Key=DiscreteGPUControl_KillApps, Fallback=Stop GPU apps}">
                                <controls:LocalizedTextBlock Text="{local:Loc Key=DiscreteGPUControl_KillApps, Fallback=Stop apps}"
                                                             OverflowMode="Ellipsis"
                                                             MaxLines="1" />
                            </Button>
                            <Button Command="{Binding RestartDiscreteGpuCommand}"
                                    IsEnabled="{Binding DiscreteGpuState.CanRestart}"
                                    Padding="8,4"
                                    ToolTip.Tip="{local:Loc Key=DiscreteGPUControl_RestartGPU, Fallback=Restart GPU}"
                                    automation:AutomationProperties.Name="{local:Loc Key=DiscreteGPUControl_RestartGPU, Fallback=Restart GPU}">
                                <controls:LocalizedTextBlock Text="{local:Loc Key=DiscreteGPUControl_RestartGPU, Fallback=Restart GPU}"
                                                             OverflowMode="Ellipsis"
                                                             MaxLines="1" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="16"
                        ToolTip.Tip="{Binding GpuOverclockState.Error}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Spacing="2" MinWidth="0">
                                <controls:LocalizedTextBlock Text="{local:Loc Key=OverclockDiscreteGPUControl_Title, Fallback=Overclock GPU}"
                                                             FontSize="{StaticResource FontSizeBody}"
                                                             FontWeight="Medium"
                                                             OverflowMode="Ellipsis"
                                                             MaxLines="1" />
                                <controls:LocalizedTextBlock Text="{local:Loc Key=OverclockDiscreteGPUControl_Message, Fallback=Tune GPU core and memory offsets.}"
                                                             FontSize="{StaticResource FontSizeSmallCaption}"
                                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                             OverflowMode="Wrap"
                                                             MaxLines="2" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding GpuOverclockEnabled, Mode=TwoWay}"
                                          IsEnabled="{Binding GpuOverclockState.IsAvailable}"
                                          automation:AutomationProperties.Name="{local:Loc Key=OverclockDiscreteGPUControl_Title, Fallback=Overclock GPU}" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <controls:LocalizedTextBlock Text="{local:Loc Key=OverclockDiscreteGPUSettingsWindow_CoreFrequencyOffset_Title, Fallback=Core frequency offset}"
                                                         VerticalAlignment="Center"
                                                         OverflowMode="Ellipsis"
                                                         MaxLines="1" />
                            <controls:LocalizedTextBlock Grid.Column="1"
                                                         Text="{Binding GpuCoreDeltaMhz, StringFormat={}{0:0} MHz}"
                                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                         OverflowMode="Ellipsis"
                                                         MaxLines="1" />
                        </Grid>
                        <Slider Grid.Row="2"
                                Minimum="{Binding GpuCoreMinimum}"
                                Maximum="{Binding GpuOverclockState.MaxCoreDeltaMhz}"
                                Value="{Binding GpuCoreDeltaMhz, Mode=TwoWay}"
                                IsEnabled="{Binding GpuOverclockState.IsAvailable}"
                                automation:AutomationProperties.Name="{local:Loc Key=OverclockDiscreteGPUSettingsWindow_CoreFrequencyOffset_Title, Fallback=Core frequency offset}" />
                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <controls:LocalizedTextBlock Text="{local:Loc Key=OverclockDiscreteGPUSettingsWindow_MemoryFrequencyOffset_Title, Fallback=Memory frequency offset}"
                                                         VerticalAlignment="Center"
                                                         OverflowMode="Ellipsis"
                                                         MaxLines="1" />
                            <controls:LocalizedTextBlock Grid.Column="1"
                                                         Text="{Binding GpuMemoryDeltaMhz, StringFormat={}{0:0} MHz}"
                                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                         OverflowMode="Ellipsis"
                                                         MaxLines="1" />
                        </Grid>
                        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Slider Minimum="{Binding GpuMemoryMinimum}"
                                    Maximum="{Binding GpuOverclockState.MaxMemoryDeltaMhz}"
                                    Value="{Binding GpuMemoryDeltaMhz, Mode=TwoWay}"
                                    IsEnabled="{Binding GpuOverclockState.IsAvailable}"
                                    automation:AutomationProperties.Name="{local:Loc Key=OverclockDiscreteGPUSettingsWindow_MemoryFrequencyOffset_Title, Fallback=Memory frequency offset}" />
                            <Button Grid.Column="1"
                                    Command="{Binding ApplyGpuOverclockCommand}"
                                    IsEnabled="{Binding GpuOverclockState.IsAvailable}"
                                    Padding="8,4"
                                    ToolTip.Tip="{local:Loc Key=Dashboard_Apply, Fallback=Apply}"
                                    automation:AutomationProperties.Name="{local:Loc Key=Dashboard_Apply, Fallback=Apply}">
                                <controls:LocalizedTextBlock Text="{local:Loc Key=Dashboard_Apply, Fallback=Apply}"
                                                             OverflowMode="Ellipsis"
                                                             MaxLines="1" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusCard}"
                    Padding="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2" MinWidth="0">
                        <controls:LocalizedTextBlock Text="{local:Loc Key=TurnOffMonitorsControl_Title, Fallback=Turn off monitors}"
                                                     FontSize="{StaticResource FontSizeBody}"
                                                     FontWeight="Medium"
                                                     OverflowMode="Ellipsis"
                                                     MaxLines="1" />
                        <controls:LocalizedTextBlock Text="{local:Loc Key=TurnOffMonitorsControl_Message, Fallback=Turn off connected displays.}"
                                                     FontSize="{StaticResource FontSizeSmallCaption}"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                     OverflowMode="Wrap"
                                                     MaxLines="2" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding TurnOffMonitorsCommand}"
                            Padding="10,6"
                            ToolTip.Tip="{local:Loc Key=TurnOffMonitorsControl_Title, Fallback=Turn off monitors}"
                            automation:AutomationProperties.Name="{local:Loc Key=TurnOffMonitorsControl_Title, Fallback=Turn off monitors}">
                        <controls:LocalizedTextBlock Text="{local:Loc Key=TurnOffMonitorsControl_Title, Fallback=Turn off}"
                                                     OverflowMode="Ellipsis"
                                                     MaxLines="1" />
                    </Button>
                </Grid>
            </Border>

            <!-- Persisted dashboard layout -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <StackPanel Spacing="2">
                    <controls:LocalizedTextBlock Text="{local:Loc Key=Dashboard_Layout, Fallback=Dashboard layout}"
                                                 FontSize="{StaticResource FontSizeSubsection}"
                                                 FontWeight="Medium"
                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                 OverflowMode="Ellipsis"
                                                 MaxLines="1" />
                    <controls:LocalizedTextBlock Text="{local:Loc Key=Dashboard_LayoutDescription, Fallback=Choose the groups and order shown on the dashboard.}"
                                                 FontSize="{StaticResource FontSizeSmallCaption}"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                 OverflowMode="Wrap"
                                                 MaxLines="2" />
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding ToggleLayoutEditorCommand}"
                        Padding="10,6"
                        MinWidth="110"
                        automation:AutomationProperties.AutomationId="AvaloniaDashboardEditLayoutButton"
                        automation:AutomationProperties.Name="{local:Loc Key=Dashboard_EditLayout, Fallback=Edit layout}"
                        ToolTip.Tip="{local:Loc Key=Dashboard_EditLayout, Fallback=Edit layout}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:NavigationIcon IconIdentifier="Edit24"
                                                 FontSize="{StaticResource IconSizeCompact}" />
                        <controls:LocalizedTextBlock Text="{local:Loc Key=Dashboard_EditLayout, Fallback=Edit}"
                                                     OverflowMode="Ellipsis"
                                                     MaxLines="1" />
                    </StackPanel>
                </Button>
            </Grid>

            <ItemsControl ItemsSource="{Binding DashboardGroups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300"
                                Margin="0,0,12,12"
                                Padding="14"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadiusCard}"
                                automation:AutomationProperties.Name="{Binding DisplayName}">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <controls:LocalizedTextBlock Text="{Binding DisplayName}"
                                                                 FontSize="{StaticResource FontSizeBody}"
                                                                 FontWeight="Medium"
                                                                 OverflowMode="Ellipsis"
                                                                 MaxLines="1"
                                                                 MinWidth="0" />
                                    <Button Grid.Column="1"
                                            Command="{Binding DataContext.MoveDashboardGroupUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="4"
                                            MinWidth="28"
                                            ToolTip.Tip="{local:Loc Key=Dashboard_MoveUp, Fallback=Move up}"
                                            automation:AutomationProperties.Name="{local:Loc Key=Dashboard_MoveUp, Fallback=Move up}">
                                        <controls:NavigationIcon IconIdentifier="ChevronUp24"
                                                                 FontSize="{StaticResource IconSizeCompact}" />
                                    </Button>
                                    <Button Grid.Column="2"
                                            Command="{Binding DataContext.MoveDashboardGroupDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="4"
                                            MinWidth="28"
                                            ToolTip.Tip="{local:Loc Key=Dashboard_MoveDown, Fallback=Move down}"
                                            automation:AutomationProperties.Name="{local:Loc Key=Dashboard_MoveDown, Fallback=Move down}">
                                        <controls:NavigationIcon IconIdentifier="ChevronDown24"
                                                                 FontSize="{StaticResource IconSizeCompact}" />
                                    </Button>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto"
                                                  ColumnSpacing="6"
                                                  MinWidth="0"
                                                  IsVisible="{Binding IsStandardControl}"
                                                  ToolTip.Tip="{Binding StateError}">
                                                <controls:NavigationIcon IconIdentifier="{Binding IconIdentifier}"
                                                                         FontSize="{StaticResource IconSizeCompact}"
                                                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                         VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="1"
                                                            Spacing="2"
                                                            MinWidth="0"
                                                            VerticalAlignment="Center">
                                                    <controls:LocalizedTextBlock Text="{Binding DisplayName}"
                                                                                 FontSize="{StaticResource FontSizeSmallCaption}"
                                                                                 FontWeight="Medium"
                                                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                                 OverflowMode="Ellipsis"
                                                                                 MaxLines="1"
                                                                                 MinWidth="0" />
                                                    <controls:LocalizedTextBlock Text="{Binding StateDisplayText}"
                                                                                 FontSize="{StaticResource FontSizeSmallCaption}"
                                                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                 OverflowMode="Ellipsis"
                                                                                 MaxLines="1"
                                                                                 MinWidth="0" />
                                                </StackPanel>
                                                <ComboBox Grid.Column="2"
                                                          IsVisible="{Binding HasOptions}"
                                                          ItemsSource="{Binding Options}"
                                                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                          Width="132"
                                                          MinWidth="96"
                                                          VerticalAlignment="Center"
                                                          automation:AutomationProperties.Name="{Binding DisplayName}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <controls:LocalizedTextBlock Text="{Binding DisplayName}"
                                                                                         OverflowMode="Ellipsis"
                                                                                         MaxLines="1" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Grid.Column="3"
                                                        IsVisible="{Binding HasOptions}"
                                                        Command="{Binding DataContext.SetDashboardItemStateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="3"
                                                        MinWidth="28"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="{local:Loc Key=Dashboard_Apply, Fallback=Apply}"
                                                        automation:AutomationProperties.Name="{local:Loc Key=Dashboard_Apply, Fallback=Apply}">
                                                    <controls:NavigationIcon IconIdentifier="Checkmark24"
                                                                             FontSize="{StaticResource IconSizeCompact}" />
                                                </Button>
                                                <Button Grid.Column="4"
                                                        IsVisible="{Binding DataContext.IsLayoutEditorOpen, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding DataContext.MoveDashboardItemUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="3"
                                                        MinWidth="24"
                                                        ToolTip.Tip="{local:Loc Key=Dashboard_MoveUp, Fallback=Move up}"
                                                        automation:AutomationProperties.Name="{local:Loc Key=Dashboard_MoveUp, Fallback=Move up}">
                                                    <controls:NavigationIcon IconIdentifier="ChevronUp24"
                                                                             FontSize="{StaticResource IconSizeCompact}" />
                                                </Button>
                                                <Button Grid.Column="5"
                                                        IsVisible="{Binding DataContext.IsLayoutEditorOpen, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding DataContext.MoveDashboardItemDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="3"
                                                        MinWidth="24"
                                                        ToolTip.Tip="{local:Loc Key=Dashboard_MoveDown, Fallback=Move down}"
                                                        automation:AutomationProperties.Name="{local:Loc Key=Dashboard_MoveDown, Fallback=Move down}">
                                                    <controls:NavigationIcon IconIdentifier="ChevronDown24"
                                                                             FontSize="{StaticResource IconSizeCompact}" />
                                                </Button>
                                                <Button Grid.Column="6"
                                                        IsVisible="{Binding DataContext.IsLayoutEditorOpen, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding DataContext.RemoveDashboardItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="3"
                                                        MinWidth="24"
                                                        ToolTip.Tip="{local:Loc Key=Dashboard_Remove, Fallback=Remove}"
                                                        automation:AutomationProperties.Name="{local:Loc Key=Dashboard_Remove, Fallback=Remove}">
                                                    <controls:NavigationIcon IconIdentifier="Delete24"
                                                                             FontSize="{StaticResource IconSizeCompact}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Expander IsExpanded="{Binding IsLayoutEditorOpen}"
                      IsVisible="{Binding IsLayoutEditorOpen}"
                      Header="{local:Loc Key=Dashboard_LayoutEditor, Fallback=Edit dashboard layout}">
                <Border Margin="0,4,0,0"
                        Padding="14"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusCard}">
                    <StackPanel Spacing="10">
                        <ItemsControl ItemsSource="{Binding DashboardGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                                        <controls:LocalizedTextBlock Text="{Binding DisplayName}"
                                                                     VerticalAlignment="Center"
                                                                     OverflowMode="Ellipsis"
                                                                     MaxLines="1" />
                                        <TextBox Grid.Column="1"
                                                 IsVisible="{Binding IsCustom}"
                                                 Text="{Binding CustomName, Mode=TwoWay}"
                                                 Watermark="{local:Loc Key=Dashboard_CustomGroupName, Fallback=Custom group name}"
                                                 MinWidth="160" />
                                        <Button Grid.Column="2"
                                                IsVisible="{Binding IsCustom}"
                                                Command="{Binding DataContext.RemoveDashboardGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="6"
                                                ToolTip.Tip="{local:Loc Key=Dashboard_RemoveGroup, Fallback=Remove group}"
                                                automation:AutomationProperties.Name="{local:Loc Key=Dashboard_RemoveGroup, Fallback=Remove group}">
                                            <controls:NavigationIcon IconIdentifier="Delete24"
                                                                     FontSize="{StaticResource IconSizeCompact}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding AddCustomDashboardGroupCommand}"
                                    Padding="10,6"
                                    automation:AutomationProperties.AutomationId="AvaloniaDashboardAddGroupButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:NavigationIcon IconIdentifier="Add24"
                                                             FontSize="{StaticResource IconSizeCompact}" />
                                    <controls:LocalizedTextBlock Text="{local:Loc Key=Dashboard_AddGroup, Fallback=Add group}"
                                                                 OverflowMode="Ellipsis"
                                                                 MaxLines="1" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RestoreDefaultDashboardLayoutCommand}"
                                    Padding="10,6"
                                    automation:AutomationProperties.AutomationId="AvaloniaDashboardRestoreLayoutButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:NavigationIcon IconIdentifier="ArrowReset24"
                                                             FontSize="{StaticResource IconSizeCompact}" />
                                    <controls:LocalizedTextBlock Text="{local:Loc Key=Dashboard_RestoreLayout, Fallback=Restore defaults}"
                                                                 OverflowMode="Ellipsis"
                                                                 MaxLines="1" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SaveDashboardLayoutCommand}"
                                    Padding="10,6"
                                    Background="{DynamicResource AccentBackgroundBrush}"
                                    Foreground="{DynamicResource TextOnAccentBrush}"
                                    automation:AutomationProperties.AutomationId="AvaloniaDashboardSaveLayoutButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:NavigationIcon IconIdentifier="Save24"
                                                             FontSize="{StaticResource IconSizeCompact}" />
                                    <controls:LocalizedTextBlock Text="{local:Loc Key=Dashboard_SaveLayout, Fallback=Save layout}"
                                                                 OverflowMode="Ellipsis"
                                                                 MaxLines="1" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <controls:LocalizedTextBlock Text="{Binding LayoutStatusText}"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                     OverflowMode="Wrap"
                                                     MaxLines="2" />
                    </StackPanel>
                </Border>
            </Expander>

            <!-- Feature Groups -->
            <TextBlock Text="{local:Loc Key=Dashboard_FeatureGroups, Fallback=Feature Groups}"
                       FontSize="{StaticResource FontSizeSubsection}"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <ItemsControl ItemsSource="{Binding FeatureGroups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="cardControl" Width="300" Margin="0,0,12,12"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadiusCard}">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="16" RowSpacing="10">
                                <controls:LocalizedTextBlock Text="{Binding Title}"
                                           Classes="cardTitle"
                                           OverflowMode="Wrap"
                                           MaxLines="2" />
                                <controls:LocalizedTextBlock Grid.Row="1" Text="{Binding Description}"
                                           Classes="cardDescription"
                                           OverflowMode="Wrap"
                                           MaxLines="3" />
                                <Border Grid.Row="2" Classes="badge" HorizontalAlignment="Left"
                                        Background="{DynamicResource StatusInfoBackgroundBrush}"
                                        BorderBrush="{DynamicResource StatusInfoBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource CornerRadiusRound}"
                                        Padding="8,4"
                                        Margin="0,2,0,0">
                                    <controls:LocalizedTextBlock Text="{Binding Status}"
                                               Foreground="{DynamicResource StatusInfoBrush}"
                                               FontSize="{StaticResource FontSizeSmallCaption}"
                                               OverflowMode="Ellipsis"
                                               MaxLines="1" />
                                </Border>
                                <Button Grid.Row="3"
                                        HorizontalAlignment="Left"
                                        Padding="8,4"
                                        MinWidth="36"
                                        IsVisible="{Binding IsNavigable}"
                                        IsEnabled="{Binding IsNavigable}"
                                        Command="{Binding DataContext.OpenFeatureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding Title}"
                                        automation:AutomationProperties.Name="{Binding Title}"
                                        automation:AutomationProperties.AutomationId="DashboardFeatureOpenButton">
                                    <controls:NavigationIcon IconIdentifier="ArrowRight24"
                                                             FontSize="{StaticResource IconSizeCompact}" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Sensors Panel -->
            <Grid ColumnDefinitions="*,Auto"
                  Margin="0,8,0,0">
                <controls:LocalizedTextBlock Text="{local:Loc Key=Dashboard_Sensors, Fallback=Sensors}"
                                             FontSize="{StaticResource FontSizeSubsection}"
                                             FontWeight="Medium"
                                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                             VerticalAlignment="Center"
                                             OverflowMode="Ellipsis"
                                             MaxLines="1" />
                <ToggleSwitch Grid.Column="1"
                              IsChecked="{Binding ShowSensors, Mode=TwoWay}"
                              automation:AutomationProperties.AutomationId="AvaloniaDashboardShowSensorsToggle"
                              automation:AutomationProperties.Name="{local:Loc Key=Dashboard_Sensors, Fallback=Sensors}"
                              ToolTip.Tip="{local:Loc Key=Dashboard_Sensors, Fallback=Sensors}"
                              MinWidth="120"
                              HorizontalContentAlignment="Left"
                              VerticalAlignment="Center" />
            </Grid>

            <ItemsControl ItemsSource="{Binding TelemetryCards}"
                          IsVisible="{Binding ShowSensors}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="cardControl"
                                Width="320"
                                Margin="0,0,12,12"
                                IsVisible="{Binding IsVisible}"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadiusCard}"
                                Padding="16"
                                automation:AutomationProperties.Name="{Binding Title}">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <controls:NavigationIcon IconIdentifier="{Binding IconIdentifier}"
                                                             FontSize="{StaticResource IconSizeMD}"
                                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                             VerticalAlignment="Top" />
                                    <controls:LocalizedTextBlock Grid.Column="1"
                                                                 Text="{Binding Title}"
                                                                 FontSize="{StaticResource FontSizeBody}"
                                                                 FontWeight="Medium"
                                                                 OverflowMode="Ellipsis"
                                                                 MaxLines="1"
                                                                 MinWidth="0" />
                                    <controls:LocalizedTextBlock Grid.Column="2"
                                                                 Text="{Binding StatusText}"
                                                                 FontSize="{StaticResource FontSizeSmallCaption}"
                                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                 OverflowMode="Ellipsis"
                                                                 MaxLines="1"
                                                                 MaxWidth="92" />
                                </Grid>
                                <controls:LocalizedTextBlock Grid.Row="1"
                                                             Text="{Binding Description}"
                                                             FontSize="{StaticResource FontSizeSmallCaption}"
                                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                             OverflowMode="Wrap"
                                                             MaxLines="2" />
                                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Border Width="82"
                                            Height="82"
                                            CornerRadius="{StaticResource CornerRadiusRound}"
                                            Background="{DynamicResource StatusInfoBackgroundBrush}"
                                            BorderBrush="{DynamicResource StatusInfoBrush}"
                                            BorderThickness="2"
                                            VerticalAlignment="Center">
                                        <controls:LocalizedTextBlock Text="{Binding PrimaryValue}"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     TextAlignment="Center"
                                                                     MaxWidth="74"
                                                                     OverflowMode="Ellipsis"
                                                                     MaxLines="2"
                                                                     FontSize="{StaticResource FontSizeSmallCaption}"
                                                                     FontWeight="SemiBold"
                                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <controls:LocalizedTextBlock Text="{Binding PrimaryValue}"
                                                                     FontSize="{StaticResource FontSizeGaugeValue}"
                                                                     FontWeight="SemiBold"
                                                                     OverflowMode="Ellipsis"
                                                                     MaxLines="1" />
                                        <controls:LocalizedTextBlock Text="{Binding StatusText}"
                                                                     FontSize="{StaticResource FontSizeSmallCaption}"
                                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                     OverflowMode="Ellipsis"
                                                                     MaxLines="1" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Grid.Row="3"
                                             IsVisible="{Binding HasPrimaryProgress}"
                                             Value="{Binding PrimaryProgressPercent}"
                                             Maximum="100"
                                             Height="6"
                                             CornerRadius="{StaticResource CornerRadiusProgressBar}"
                                             Foreground="{DynamicResource AccentBackgroundBrush}"
                                             Background="{DynamicResource ChartTrackBrush}" />
                                <controls:TrendSparkline Grid.Row="4"
                                                         ItemsSource="{Binding History}"
                                                         Height="52"
                                                         Margin="0,2,0,0"
                                                         Stroke="{DynamicResource AccentBackgroundBrush}"
                                                         Fill="{DynamicResource ChartSurfaceBrush}" />
                                <ItemsControl Grid.Row="5"
                                              IsVisible="{Binding IsAvailable}"
                                              ItemsSource="{Binding Metrics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <controls:LocalizedTextBlock Text="{Binding Name}"
                                                                             FontSize="{StaticResource FontSizeSmallCaption}"
                                                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                             OverflowMode="Ellipsis"
                                                                             MaxLines="1" />
                                                <controls:LocalizedTextBlock Grid.Column="1"
                                                                             Text="{Binding DisplayValue}"
                                                                             FontSize="{StaticResource FontSizeSmallCaption}"
                                                                             FontWeight="Medium"
                                                                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                             OverflowMode="Ellipsis"
                                                                             MaxLines="1" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
