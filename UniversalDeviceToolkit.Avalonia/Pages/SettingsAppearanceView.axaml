<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:UniversalDeviceToolkit.Avalonia.Localization"
             xmlns:controls="using:UniversalDeviceToolkit.Avalonia.Controls"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="UniversalDeviceToolkit.Avalonia.Pages.SettingsAppearanceView">
    <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
        <controls:LocalizedTextBlock Text="{local:Loc Key=Appearance_Title, Fallback=Appearance}"
                   FontSize="{StaticResource FontSizeDisplaySection}"
                   FontWeight="Medium"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   OverflowMode="Wrap"
                   MaxLines="2"/>

        <controls:LocalizedTextBlock Text="{local:Loc Key=Appearance_Description, Fallback=Customize the look and feel of the application.}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   OverflowMode="Wrap"
                   MaxLines="3"
                   Margin="0,0,0,8"/>

        <!-- Unified theme & accent configuration (mirrors the WPF Appearance area) -->
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusCard}"
                Padding="14,12">
            <StackPanel Spacing="10">
                <!-- 1. Global interface color mode -->
                <controls:LocalizedTextBlock Text="{local:Loc Key=Appearance_ThemeMode, Fallback=Global interface color mode}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           OverflowMode="Wrap"
                           MaxLines="2"/>

                <!-- 2. Three mode preview cards: 120x84 macOS window previews
                     (title bar + traffic lights / content / dock), selected = accent border. -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <controls:AccessibleButton x:Name="ThemeLightCard" Tag="Light" Click="ThemeCard_Click"
                            AutomationName="{local:Loc Key=Appearance_Light, Fallback=Light}"
                            Padding="0" Background="Transparent" BorderThickness="0">
                        <StackPanel Spacing="6">
                            <Border x:Name="ThemeLightPreview" Width="120" Height="84" CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="#FFF6F6F6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="16"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="14"/>
                                    </Grid.RowDefinitions>
                                    <!-- Title bar with macOS traffic lights -->
                                    <Border Grid.Row="0" Background="#FFE8E8E8">
                                        <StackPanel Margin="5,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="3">
                                            <Ellipse Width="6" Height="6" Fill="#FFFF5F57"/>
                                            <Ellipse Width="6" Height="6" Fill="#FFFEBC2E"/>
                                            <Ellipse Width="6" Height="6" Fill="#FF28C840"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Content area: sidebar + search bar + content lines -->
                                    <Grid Grid.Row="1" Background="#FFFFFFFF" Margin="7,6,7,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,2,0,0" VerticalAlignment="Top" Spacing="4">
                                            <Border Height="5" Width="10" Background="#FFECECEC" CornerRadius="2" HorizontalAlignment="Left"/>
                                            <Border Height="5" Width="10" Background="#FFF1F1F1" CornerRadius="2" HorizontalAlignment="Left"/>
                                            <Border Height="5" Width="10" Background="#FFF1F1F1" CornerRadius="2" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Top" Spacing="4">
                                            <Border Height="9" Background="#FFF0F0F0" CornerRadius="3"/>
                                            <Border Height="4" Background="#FFEDEDED" CornerRadius="2" Margin="0,0,18,0"/>
                                            <Border Height="4" Background="#FFF2F2F2" CornerRadius="2" Margin="0,0,30,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- Dock -->
                                    <Border Grid.Row="2" Background="#FFE0E0E0">
                                        <StackPanel Margin="6,2,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                            <Border Width="10" Height="10" Background="#FFC9C9C9" CornerRadius="2.5"/>
                                            <Border Width="10" Height="10" Background="#FFC9C9C9" CornerRadius="2.5"/>
                                            <Border Width="10" Height="10" Background="#FFC9C9C9" CornerRadius="2.5"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Text="{local:Loc Key=Appearance_Light, Fallback=Light}" FontWeight="Medium" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </controls:AccessibleButton>
                    <controls:AccessibleButton x:Name="ThemeDarkCard" Tag="Dark" Click="ThemeCard_Click"
                            AutomationName="{local:Loc Key=Appearance_Dark, Fallback=Dark}"
                            Padding="0" Background="Transparent" BorderThickness="0">
                        <StackPanel Spacing="6">
                            <Border x:Name="ThemeDarkPreview" Width="120" Height="84" CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="#FF202020">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="16"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="14"/>
                                    </Grid.RowDefinitions>
                                    <!-- Title bar with macOS traffic lights -->
                                    <Border Grid.Row="0" Background="#FF2C2C2C">
                                        <StackPanel Margin="5,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="3">
                                            <Ellipse Width="6" Height="6" Fill="#FFFF5F57"/>
                                            <Ellipse Width="6" Height="6" Fill="#FFFEBC2E"/>
                                            <Ellipse Width="6" Height="6" Fill="#FF28C840"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Content area: sidebar + search bar + content lines -->
                                    <Grid Grid.Row="1" Background="#FF262626" Margin="7,6,7,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,2,0,0" VerticalAlignment="Top" Spacing="4">
                                            <Border Height="5" Width="10" Background="#FF333333" CornerRadius="2" HorizontalAlignment="Left"/>
                                            <Border Height="5" Width="10" Background="#FF383838" CornerRadius="2" HorizontalAlignment="Left"/>
                                            <Border Height="5" Width="10" Background="#FF383838" CornerRadius="2" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Top" Spacing="4">
                                            <Border Height="9" Background="#FF333333" CornerRadius="3"/>
                                            <Border Height="4" Background="#FF2F2F2F" CornerRadius="2" Margin="0,0,18,0"/>
                                            <Border Height="4" Background="#FF3A3A3A" CornerRadius="2" Margin="0,0,30,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- Dock -->
                                    <Border Grid.Row="2" Background="#FF343434">
                                        <StackPanel Margin="6,2,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                            <Border Width="10" Height="10" Background="#FF4A4A4A" CornerRadius="2.5"/>
                                            <Border Width="10" Height="10" Background="#FF4A4A4A" CornerRadius="2.5"/>
                                            <Border Width="10" Height="10" Background="#FF4A4A4A" CornerRadius="2.5"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Text="{local:Loc Key=Appearance_Dark, Fallback=Dark}" FontWeight="Medium" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </controls:AccessibleButton>
                    <controls:AccessibleButton x:Name="ThemeSystemCard" Tag="System" Click="ThemeCard_Click"
                            AutomationName="{local:Loc Key=Appearance_System, Fallback=Follow system}"
                            Padding="0" Background="Transparent" BorderThickness="0">
                        <StackPanel Spacing="6">
                            <Border x:Name="ThemeSystemPreview" Width="120" Height="84" CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <Border.Background>
                                    <!-- Split light/dark preview: left half light, right half dark. -->
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                        <GradientStop Offset="0" Color="#FFF6F6F6"/>
                                        <GradientStop Offset="0.5" Color="#FFF6F6F6"/>
                                        <GradientStop Offset="0.5" Color="#FF202020"/>
                                        <GradientStop Offset="1" Color="#FF202020"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="16"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="14"/>
                                    </Grid.RowDefinitions>
                                    <!-- Title bar with macOS traffic lights (neutral overlay on the split) -->
                                    <Border Grid.Row="0" Background="#40000000">
                                        <StackPanel Margin="5,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="3">
                                            <Ellipse Width="6" Height="6" Fill="#FFFF5F57"/>
                                            <Ellipse Width="6" Height="6" Fill="#FFFEBC2E"/>
                                            <Ellipse Width="6" Height="6" Fill="#FF28C840"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Content area: sidebar + search bar + content lines (neutral overlay on the split) -->
                                    <Grid Grid.Row="1" Margin="7,6,7,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,2,0,0" VerticalAlignment="Top" Spacing="4">
                                            <Border Height="5" Width="10" Background="#2A000000" CornerRadius="2" HorizontalAlignment="Left"/>
                                            <Border Height="5" Width="10" Background="#22000000" CornerRadius="2" HorizontalAlignment="Left"/>
                                            <Border Height="5" Width="10" Background="#22000000" CornerRadius="2" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Top" Spacing="4">
                                            <Border Height="9" Background="#2A000000" CornerRadius="3"/>
                                            <Border Height="4" Background="#22000000" CornerRadius="2" Margin="0,0,18,0"/>
                                            <Border Height="4" Background="#1E000000" CornerRadius="2" Margin="0,0,30,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- Dock -->
                                    <Border Grid.Row="2" Background="#40000000">
                                        <StackPanel Margin="6,2,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                            <Border Width="10" Height="10" Background="#55000000" CornerRadius="2.5"/>
                                            <Border Width="10" Height="10" Background="#55000000" CornerRadius="2.5"/>
                                            <Border Width="10" Height="10" Background="#55000000" CornerRadius="2.5"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Text="{local:Loc Key=Appearance_System, Fallback=Follow system}" FontWeight="Medium" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </controls:AccessibleButton>
                </StackPanel>

                <!-- 3. Apply accent color to the whole theme -->
                <CheckBox x:Name="ApplyAccentColorToThemeCheckBox"
                          automation:AutomationProperties.Name="{local:Loc Key=Appearance_ApplyAccent, Fallback=Apply accent color to theme}"
                          FontWeight="Medium"
                          Content="{local:Loc Key=Appearance_ApplyAccent, Fallback=Change system color when changing the global interface color}"
                          IsCheckedChanged="ApplyAccentColorToThemeCheckBox_IsCheckedChanged"/>

                <CheckBox x:Name="ApplyAccentColorToSystemCheckBox"
                          automation:AutomationProperties.Name="{local:Loc Key=Appearance_ApplyAccentSystem, Fallback=Apply accent color to Windows}"
                          FontWeight="Medium"
                          Content="{local:Loc Key=Appearance_ApplyAccentSystem, Fallback=Apply accent color to Windows}"
                          IsCheckedChanged="ApplyAccentColorToSystemCheckBox_IsCheckedChanged"/>

                <!-- 4. Separator -->
                <Border Height="1" Margin="0,4"
                        Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                <!-- 5. Global interface accent color -->
                <TextBlock Text="{local:Loc Key=Appearance_Accent, Fallback=Global interface accent color}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                <!-- 6. Accent color swatches -->
                <ItemsControl x:Name="AccentSwatches">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- BorderBrush/BorderThickness bind to the precomputed selection visuals
                                 (selected = 2.5px accent border), so the current accent stays highlighted. -->
                            <controls:AccessibleButton Width="36" Height="36" Margin="0,0,8,8"
                                    AutomationName="{Binding DisplayName}"
                                    Padding="2" CornerRadius="18"
                                    Background="Transparent"
                                    BorderBrush="{Binding SelectionBorderBrush}"
                                    BorderThickness="{Binding SelectionBorderThickness}"
                                    Tag="{Binding}"
                                    Click="AccentColorSwatch_Click">
                                <Border Width="32" Height="32" CornerRadius="16" Background="{Binding Brush}"/>
                            </controls:AccessibleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- The WPF appearance page exposes these values as persisted settings. Keep them in
             the cross-platform preference store so switching hosts does not discard them. -->
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusCard}"
                Padding="16">
            <StackPanel Spacing="10">
                <controls:LocalizedTextBlock Text="{local:Loc Key=Appearance_Advanced, Fallback=Appearance options}"
                                             FontSize="{StaticResource FontSizeSubsection}"
                                             FontWeight="Medium"
                                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                             OverflowMode="Wrap"
                                             MaxLines="2" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="2">
                        <controls:LocalizedTextBlock Text="{local:Loc Key=Appearance_TemperatureUnit, Fallback=Temperature unit}"
                                                     OverflowMode="Wrap"
                                                     MaxLines="2" />
                        <controls:LocalizedTextBlock Text="{local:Loc Key=Appearance_TemperatureUnitDescription, Fallback=Choose how temperatures are displayed.}"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                     OverflowMode="Wrap"
                                                     MaxLines="3" />
                    </StackPanel>
                    <ComboBox x:Name="TemperatureComboBox"
                              Grid.Column="1"
                              MinWidth="150"
                              SelectionChanged="TemperatureComboBox_SelectionChanged"
                              AutomationProperties.Name="{local:Loc Key=Appearance_TemperatureUnit, Fallback=Temperature unit}">
                        <ComboBoxItem Content="{local:Loc Key=Celsius, Fallback=°C}" Tag="Celsius" />
                        <ComboBoxItem Content="{local:Loc Key=Fahrenheit, Fallback=°F}" Tag="Fahrenheit" />
                    </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="2">
                        <controls:LocalizedTextBlock Text="{local:Loc Key=Appearance_Font, Fallback=Application font}"
                                                     OverflowMode="Wrap"
                                                     MaxLines="2" />
                        <controls:LocalizedTextBlock Text="{local:Loc Key=Appearance_FontDescription, Fallback=Choose the application font family.}"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                     OverflowMode="Wrap"
                                                     MaxLines="3" />
                    </StackPanel>
                    <ComboBox x:Name="FontComboBox"
                              Grid.Column="1"
                              MinWidth="190"
                              SelectionChanged="FontComboBox_SelectionChanged"
                              AutomationProperties.Name="{local:Loc Key=Appearance_Font, Fallback=Application font}">
                        <ComboBoxItem Content="{Binding Tag, RelativeSource={RelativeSource Self}}" Tag="Default" />
                        <ComboBoxItem Content="{Binding Tag, RelativeSource={RelativeSource Self}}" Tag="Segoe UI Variable" />
                        <ComboBoxItem Content="{Binding Tag, RelativeSource={RelativeSource Self}}" Tag="Microsoft YaHei UI" />
                        <ComboBoxItem Content="{Binding Tag, RelativeSource={RelativeSource Self}}" Tag="DengXian" />
                        <ComboBoxItem Content="{Binding Tag, RelativeSource={RelativeSource Self}}" Tag="Noto Sans CJK SC" />
                    </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="2">
                        <controls:LocalizedTextBlock Text="{local:Loc Key=Appearance_UiScale, Fallback=Interface scale}"
                                                     OverflowMode="Wrap"
                                                     MaxLines="2" />
                        <controls:LocalizedTextBlock Text="{local:Loc Key=Appearance_UiScaleDescription, Fallback=Adjust text and control density together.}"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                     OverflowMode="Wrap"
                                                     MaxLines="3" />
                    </StackPanel>
                    <ComboBox x:Name="UiScaleComboBox"
                              Grid.Column="1"
                              MinWidth="150"
                              SelectionChanged="UiScaleComboBox_SelectionChanged"
                              AutomationProperties.Name="{local:Loc Key=Appearance_UiScale, Fallback=Interface scale}">
                        <ComboBoxItem Content="{local:Loc Key=Compact, Fallback=Compact}" Tag="Compact" />
                        <ComboBoxItem Content="{local:Loc Key=Standard, Fallback=Standard}" Tag="Standard" />
                        <ComboBoxItem Content="{local:Loc Key=Large, Fallback=Large}" Tag="Large" />
                        <ComboBoxItem Content="{local:Loc Key=ExtraLarge, Fallback=Extra large}" Tag="ExtraLarge" />
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Language -->
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusCard}"
                Padding="16">
            <StackPanel Spacing="8">
                <TextBlock Text="{local:Loc Key=Appearance_Language, Fallback=Language}"
                           FontSize="{StaticResource FontSizeSubsection}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="{local:Loc Key=Appearance_LanguageDescription, Fallback=Select the display language for the application.}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="{StaticResource FontSizeSmallCaption}"/>
                <controls:AccessibleComboBox x:Name="LanguageComboBox" Name="Language"
                          AutomationName="{local:Loc Key=Appearance_Language, Fallback=Language}"
                          MinWidth="220" HorizontalAlignment="Left"
                          Margin="0,8,0,0" SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <controls:LocalizedTextBlock Text="{Binding DisplayName}"
                                                         OverflowMode="Ellipsis"
                                                         MaxLines="1"
                                                         MinWidth="0" />
                         </DataTemplate>
                    </ComboBox.ItemTemplate>
                </controls:AccessibleComboBox>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:AccessibleButton x:Name="InstallLanguageButton"
                                               Content="{local:Loc Key=SettingsPage_Language_Install, Fallback=Install}"
                                               AutomationName="{local:Loc Key=SettingsPage_Language_Install, Fallback=Install}"
                                               Click="InstallLanguageButton_Click" />
                    <controls:AccessibleButton x:Name="UninstallLanguageButton"
                                               Content="{local:Loc Key=SettingsPage_Language_Uninstall, Fallback=Uninstall}"
                                               AutomationName="{local:Loc Key=SettingsPage_Language_Uninstall, Fallback=Uninstall}"
                                               Click="UninstallLanguageButton_Click" />
                </StackPanel>
                <StackPanel x:Name="LanguageOperationPanel" IsVisible="False" Spacing="4">
                    <controls:LocalizedTextBlock x:Name="LanguageOperationStatus"
                                                 Text="{local:Loc Key=SettingsPage_Language_Installing, Fallback=Installing language pack}"
                                                 OverflowMode="Ellipsis"
                                                 MaxLines="1" />
                    <ProgressBar x:Name="LanguageOperationProgress" Minimum="0" Maximum="1" Height="6" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
