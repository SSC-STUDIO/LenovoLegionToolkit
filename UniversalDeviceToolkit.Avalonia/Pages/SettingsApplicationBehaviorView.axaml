<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UniversalDeviceToolkit.Avalonia.Pages.SettingsApplicationBehaviorView">
    <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
        <TextBlock Text="Application Behavior"
                   FontSize="{StaticResource FontSizeDisplaySection}"
                   FontWeight="Medium"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

        <TextBlock Text="Configure how the application behaves on startup and during use."
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <!-- Startup Behavior -->
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusCard}"
                Padding="16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Launch at Startup"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Automatically start the application when Windows starts."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="{StaticResource FontSizeSmallCaption}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="False"/>
            </Grid>
        </Border>

        <!-- Minimize to Tray -->
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusCard}"
                Padding="16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Minimize to System Tray"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Keep the application running in the system tray when closed."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="{StaticResource FontSizeSmallCaption}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="True"/>
            </Grid>
        </Border>

        <!-- Auto-refresh -->
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusCard}"
                Padding="16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Auto-refresh Hardware Data"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Periodically poll hardware sensors for updated readings."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="{StaticResource FontSizeSmallCaption}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="True"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
