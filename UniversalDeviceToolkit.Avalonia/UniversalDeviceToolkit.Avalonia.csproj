<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <DisableUdtForceX64>true</DisableUdtForceX64>
    <RootNamespace>UniversalDeviceToolkit.Avalonia</RootNamespace>
    <AssemblyName>udt-gui</AssemblyName>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <!-- AVLN3001: pages/window take constructor-injected services, so their .axaml
         resources are not reachable via the runtime URI loader (they are created
         from code with explicit args). That is intentional; suppress the noise. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <!-- Keep Windows-only dependencies out of Linux/macOS restore and build graphs.
       Windows retains both the portable and desktop Avalonia targets. -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <TargetFrameworks>net10.0;net10.0-windows10.0.26100.0</TargetFrameworks>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)\packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <TargetFramework>net10.0</TargetFramework>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages.lock.unix.json</NuGetLockFilePath>
  </PropertyGroup>

  <!--
    Windows TFM branch: opts OUT of the portable x64-skip so the shipping graph
    stamps win-x64 (required when referencing UniversalDeviceToolkit.Lib, whose
    Directory.Build.props force x64). Portable net10.0 branch keeps host-native RID.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.26100.0'">
    <DisableUdtForceX64>false</DisableUdtForceX64>
    <!-- Windows apps reference WinDesktop (WPF/WinForms); only win-x64 exists. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <ProjectReference Include="..\UniversalDeviceToolkit.ViewModels\UniversalDeviceToolkit.ViewModels.csproj" />
    <ProjectReference Include="..\UniversalDeviceToolkit.Lib.Abstractions\UniversalDeviceToolkit.Lib.Abstractions.csproj" />
    <ProjectReference Include="..\UniversalDeviceToolkit.Lib.Shared\UniversalDeviceToolkit.Lib.Shared.csproj" />
    <ProjectReference Include="..\UniversalDeviceToolkit.Platform.Linux\UniversalDeviceToolkit.Platform.Linux.csproj" />
    <ProjectReference Include="..\UniversalDeviceToolkit.Platform.MacOS\UniversalDeviceToolkit.Platform.MacOS.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.26100.0'">
    <ProjectReference Include="..\UniversalDeviceToolkit.Lib\UniversalDeviceToolkit.Lib.csproj" />
    <ProjectReference Include="..\UniversalDeviceToolkit.Lib.Automation\UniversalDeviceToolkit.Lib.Automation.csproj" />
    <ProjectReference Include="..\UniversalDeviceToolkit.Lib.Macro\UniversalDeviceToolkit.Lib.Macro.csproj" />
    <ProjectReference Include="..\UniversalDeviceToolkit.Lib.Plugins\UniversalDeviceToolkit.Lib.Plugins.csproj" />
    <ProjectReference Include="..\UniversalDeviceToolkit.Platform.Windows\UniversalDeviceToolkit.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Use the root-level icon as the tray icon resource -->
    <AvaloniaResource Include="..\Assets\Icon.ico" Link="Assets\udt-icon.ico" />
    <None Include="..\resources\device-packs.json"
          Link="resources\device-packs.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
