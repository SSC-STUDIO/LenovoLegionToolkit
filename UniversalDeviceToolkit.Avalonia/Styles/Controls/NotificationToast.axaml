<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- NotificationToast: toast notification (corner popup, auto-dismiss) -->
    <Style Selector="Border.notificationToast">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusCard}" />
        <Setter Property="Background" Value="{DynamicResource NotificationGlassSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NotificationGlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinWidth" Value="300" />
        <Setter Property="MaxWidth" Value="400" />
    </Style>

    <!-- Toast title and message -->
    <Style Selector="Border.notificationToast > StackPanel > TextBlock.toastTitle">
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>
    <Style Selector="Border.notificationToast > StackPanel > TextBlock.toastMessage">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- Toast severity variants -->
    <Style Selector="Border.notificationToast.success">
        <Setter Property="BorderBrush" Value="{DynamicResource StatusSuccessBrush}" />
    </Style>
    <Style Selector="Border.notificationToast.warning">
        <Setter Property="BorderBrush" Value="{DynamicResource StatusWarningBrush}" />
    </Style>
    <Style Selector="Border.notificationToast.error">
        <Setter Property="BorderBrush" Value="{DynamicResource StatusCriticalBrush}" />
    </Style>
    <Style Selector="Border.notificationToast.info">
        <Setter Property="BorderBrush" Value="{DynamicResource StatusInfoBrush}" />
    </Style>

</Styles>
