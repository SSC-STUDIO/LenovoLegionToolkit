<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DynamicScrollBar: thin scrollbar that widens on hover -->
    <!-- Vertical ScrollBar -->
    <Style Selector="ScrollBar.dynamic:vertical">
        <Setter Property="Width" Value="8" />
        <Setter Property="Margin" Value="2" />
    </Style>
    <Style Selector="ScrollBar.dynamic:vertical:pointerover">
        <Setter Property="Width" Value="14" />
    </Style>

    <!-- Horizontal ScrollBar -->
    <Style Selector="ScrollBar.dynamic:horizontal">
        <Setter Property="Height" Value="8" />
        <Setter Property="Margin" Value="2" />
    </Style>
    <Style Selector="ScrollBar.dynamic:pointerover:horizontal">
        <Setter Property="Height" Value="14" />
    </Style>

    <!-- Thumb styling -->
    <Style Selector="ScrollBar.dynamic Thumb">
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFill}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusRound}" />
    </Style>
    <Style Selector="ScrollBar.dynamic Thumb:pointerover">
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFillHover}" />
    </Style>
    <Style Selector="ScrollBar.dynamic Thumb:pressed">
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFillPressed}" />
    </Style>

</Styles>
