<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- InfoBar: information/warning/error notification bar -->
    <Style Selector="Border.infoBar">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusCard}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Informational variant -->
    <Style Selector="Border.infoBar.informational">
        <Setter Property="Background" Value="{DynamicResource StatusInfoBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StatusInfoBrush}" />
    </Style>

    <!-- Success variant -->
    <Style Selector="Border.infoBar.success">
        <Setter Property="Background" Value="{DynamicResource StatusSuccessBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StatusSuccessBrush}" />
    </Style>

    <!-- Warning variant -->
    <Style Selector="Border.infoBar.warning">
        <Setter Property="Background" Value="{DynamicResource StatusWarningBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StatusWarningBrush}" />
    </Style>

    <!-- Error variant -->
    <Style Selector="Border.infoBar.error">
        <Setter Property="Background" Value="{DynamicResource StatusCriticalBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StatusCriticalBrush}" />
    </Style>

    <!-- InfoBar text styling -->
    <Style Selector="Border.infoBar > StackPanel > TextBlock.infoBarTitle">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>
    <Style Selector="Border.infoBar > StackPanel > TextBlock.infoBarMessage">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

</Styles>
