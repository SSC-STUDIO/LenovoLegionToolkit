<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="using:UniversalDeviceToolkit.Avalonia.Controls.Custom"
    xmlns:ui="using:UniversalDeviceToolkit.Avalonia.Controls"
    xmlns:converters="using:Avalonia.Data.Converters">

    <!--
      Unified empty state (V1): centered hero icon + title + description + optional action.
      Directional margins follow the spacing scale (XS 8 / MD 16 / LG 24), matching the
      InfoBar.axaml convention; uniform spacing uses the DesignTokens thickness resources.
      WPF DataTriggers (Title/Description/ActionContent null/empty → collapse) became
      IsVisible bindings via StringConverters.IsNotNullOrEmpty.
    -->
    <Styles.Resources>
        <ResourceDictionary>
            <ControlTheme x:Key="{x:Type custom:EmptyState}" TargetType="custom:EmptyState">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <ControlTemplate TargetType="custom:EmptyState">
                        <Border
                            Padding="{StaticResource SpacingLG}"
                            Background="{TemplateBinding Background}">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <ui:SymbolIcon
                                    Margin="0,0,0,16"
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource IconSizeHero}"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Symbol="{TemplateBinding Icon}" />
                                <TextBlock
                                    x:Name="TitleText"
                                    HorizontalAlignment="Center"
                                    FontSize="{DynamicResource FontSizeSubsection}"
                                    FontWeight="Medium"
                                    Text="{TemplateBinding Title}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    IsVisible="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock
                                    x:Name="DescriptionText"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="{DynamicResource FontSizeCaption}"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{TemplateBinding Description}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    IsVisible="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
                                <ContentPresenter
                                    x:Name="ActionPresenter"
                                    Margin="0,24,0,0"
                                    HorizontalAlignment="Center"
                                    Content="{TemplateBinding ActionContent}"
                                    IsVisible="{Binding ActionContent, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>

</Styles>
