<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System">

    <!-- Navigation shell widths -->
    <sys:Double x:Key="NavigationWidthCollapsed">70</sys:Double>
    <sys:Double x:Key="NavigationWidthExpanded">220</sys:Double>

    <!-- Drop shadow tokens (BlurRadius, Opacity) -->
    <sys:Double x:Key="ElevationShadowLowBlurRadius">8</sys:Double>
    <sys:Double x:Key="ElevationShadowLowOpacity">0.1</sys:Double>
    <sys:Double x:Key="ElevationShadowMediumBlurRadius">12</sys:Double>
    <sys:Double x:Key="ElevationShadowMediumOpacity">0.15</sys:Double>

    <!--
      Shared low-elevation shadows for shell/content borders.
      WPF DropShadowEffect replaced by BoxShadows strings (offsetX offsetY blur spread color).
      Consumers: Border.BoxShadow="{DynamicResource Key}".
    -->
    <BoxShadows x:Key="ElevationShadowLowEffect">0 2 8 0 #1A000000</BoxShadows>
    <BoxShadows x:Key="ElevationShadowMediumEffect">0 3 12 0 #26000000</BoxShadows>
    <BoxShadows x:Key="NotificationGlassShadowEffect">0 3 14 0 #2E000000</BoxShadows>

</ResourceDictionary>
