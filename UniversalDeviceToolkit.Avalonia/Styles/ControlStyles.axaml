<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Shared control chrome loaded AFTER Fluent defaults.
      Only targets interactive controls — never implicit Border styles.

      Selector="TextBox" matches plain TextBox plus PasswordBox and NumberBox (both derive
      from Avalonia TextBox; type selectors match derived StyleKeys).
      FocusVisualStyle is gone — keyboard focus uses the :focus-visible pseudo-class.
      Keyed styles kept as BasedOn targets; application uses the class styles.
    -->

    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource ButtonHeightStandard}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Old WPF-UI ComboBox chrome: full rounded field, stable selection text, native popup. -->
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="{StaticResource ButtonHeightStandard}" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style Selector="ComboBox.appComboBox">
        <Setter Property="MinHeight" Value="{StaticResource ButtonHeightStandard}" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <!-- Pill-style status chip for compact badges (not full cards). -->
    <Style Selector="Border.appStatusChipBorder">
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusRound}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--
      Content-hugging status pill (dot + label, promoted from NetworkAccelerationControl).
      Keep HorizontalAlignment=Left — Stretch + CornerRadius=999 paints a full-width
      capsule streak across the page. Distinct from AppStatusChipBorderStyle (asymmetric
      padding + layout setters); do not merge without re-checking rendered metrics.
    -->
    <Style Selector="Border.appStatusPillBorder">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusRound}" />
        <Setter Property="Padding" Value="9,4,11,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Ellipse.appStatusDotEllipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Margin" Value="0,0,7,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Compact metric tile (WrapPanel-friendly; pairs with AppMetric*TextBlockStyle). -->
    <Style Selector="Border.appMetricTileBorder">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusControl}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="MinWidth" Value="108" />
        <Setter Property="MinHeight" Value="56" />
    </Style>

    <!-- Thin horizontal section divider. -->
    <Style Selector="Border.appDividerBorder">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,10,0,10" />
        <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- Default tooltip: rounded corners matching the control corner language so every
         tooltip in the app renders with the same radius; background uses the card
         surface and a thin stroke keeps it readable on both light and dark surfaces. -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource CornerRadiusControl}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</Styles>
