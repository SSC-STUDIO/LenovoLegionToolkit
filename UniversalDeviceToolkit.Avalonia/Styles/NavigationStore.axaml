<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="using:UniversalDeviceToolkit.Avalonia.Controls.Custom"
    xmlns:ui="using:UniversalDeviceToolkit.Avalonia.Controls"
    xmlns:overflow="using:UniversalDeviceToolkit.Avalonia.Behaviors"
    xmlns:resources="using:UniversalDeviceToolkit.Avalonia.Resources"
    xmlns:sys="using:System">

    <!--
      NavigationStore chrome. WPF triggers became property-equals selectors:
        [IsActive=True]                            �?NavigationItem.IsActive
        [(custom|NavigationStore.NavigationPaneExpanded)=True/False] �?attached property
        [IsExpanded=True/False]                    �?NavigationStore.IsExpanded
      Keyed style NavigationStoreItem is kept for compatibility (Avalonia has no
      ItemContainerStyle �?item theming comes from the type-keyed ControlTheme).
      VirtualizingStackPanel.IsVirtualizing / KeyboardNavigation.DirectionalNavigation
      do not exist in Avalonia 11 and were dropped (ItemsControl virtualizes by default).
    -->
    <Styles.Resources>
        <ResourceDictionary>
            <Style x:Key="NavigationStoreItem" Selector="custom|NavigationItem">
                <Setter Property="MinWidth" Value="64" />
                <Setter Property="MaxWidth" Value="84" />
                <Setter Property="MinHeight" Value="60" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="IconSize" Value="24" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefault}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondary}" />
                <Setter Property="IconForeground" Value="{DynamicResource TextFillColorSecondary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefault}" />
                <Setter Property="Focusable" Value="True" />
                <Setter Property="IsTabStop" Value="True" />
            </Style>

            <ControlTheme x:Key="{x:Type custom:NavigationItem}" TargetType="custom:NavigationItem">
                <Setter Property="MinWidth" Value="64" />
                <Setter Property="MaxWidth" Value="84" />
                <Setter Property="MinHeight" Value="60" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="IconSize" Value="24" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefault}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondary}" />
                <Setter Property="IconForeground" Value="{DynamicResource TextFillColorSecondary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefault}" />
                <Setter Property="Focusable" Value="True" />
                <Setter Property="IsTabStop" Value="True" />
                <Setter Property="Template">
                    <ControlTemplate TargetType="custom:NavigationItem">
                        <Border
                            x:Name="MainBorder"
                            Padding="6"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusCompact}">
                            <Grid>
                                <Rectangle
                                    x:Name="ActiveRectangle"
                                    Width="4"
                                    Height="24"
                                    Margin="-4,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Opacity="0"
                                    RadiusX="2"
                                    RadiusY="2"
                                    Fill="{DynamicResource SystemAccentColorSecondary}" />

                                <!-- Compact mode: icon above label, vertical accent bar -->
                                <Grid
                                    x:Name="CompactLayout"
                                    HorizontalAlignment="Stretch"
                                    Opacity="1"
                                    RenderTransformOrigin="0.5,0.5"
                                    RenderTransform="translate(0px, 0px)">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ui:SymbolIcon
                                        x:Name="CompactIcon"
                                        Grid.Row="0"
                                        Margin="0,1,0,0"
                                        FontSize="{TemplateBinding IconSize}"
                                        Foreground="{TemplateBinding IconForeground}"
                                        Symbol="{TemplateBinding Icon}" />

                                    <Image
                                        x:Name="CompactImage"
                                        Grid.Row="0"
                                        Width="24"
                                        Height="24"
                                        Margin="6,4"
                                        Source="{TemplateBinding Image}"
                                        Stretch="Uniform"
                                        IsVisible="False" />

                                    <Grid
                                        x:Name="ContentGrid"
                                        Grid.Row="1"
                                        MaxHeight="30"
                                        Margin="0,4,0,0">
                                        <ContentPresenter x:Name="ElementContentPresenter" HorizontalAlignment="Center">
                                            <ContentPresenter.Content>
                                                <TextBlock
                                                    FontSize="{DynamicResource FontSizeMicro}"
                                                    Foreground="{TemplateBinding Foreground}"
                                                    Text="{TemplateBinding Content}"
                                                    TextAlignment="Center"
                                                    TextWrapping="Wrap"
                                                    TextTrimming="CharacterEllipsis"
                                                    AutomationProperties.Name="{TemplateBinding Content}"
                                                    overflow:LocalizedOverflowBehavior.IsEnabled="True"
                                                    overflow:LocalizedOverflowBehavior.Mode="Wrap"
                                                    overflow:LocalizedOverflowBehavior.MaxLines="2" />
                                            </ContentPresenter.Content>
                                        </ContentPresenter>
                                    </Grid>
                                </Grid>

                                <Grid
                                    x:Name="ExpandedLayout"
                                    MinHeight="40"
                                    ClipToBounds="True"
                                    Opacity="0"
                                    RenderTransformOrigin="0,0.5"
                                    RenderTransform="translate(-8px, 0px)"
                                    IsVisible="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon
                                        x:Name="ExpandedIcon"
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="{TemplateBinding IconSize}"
                                        Foreground="{TemplateBinding IconForeground}"
                                        Symbol="{TemplateBinding Icon}" />

                                    <Image
                                        x:Name="ExpandedImage"
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Source="{TemplateBinding Image}"
                                        Stretch="Uniform"
                                        IsVisible="False" />

                                    <TextBlock
                                        x:Name="ExpandedLabelText"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource FontSizeSmallBody}"
                                        Foreground="{TemplateBinding Foreground}"
                                        Text="{TemplateBinding Content}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        AutomationProperties.Name="{TemplateBinding Content}"
                                        overflow:LocalizedOverflowBehavior.IsEnabled="True"
                                        overflow:LocalizedOverflowBehavior.Mode="Ellipsis"
                                        overflow:LocalizedOverflowBehavior.MaxLines="1" />
                                </Grid>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter>

                <!-- ===== Layout mode (compact / expanded) ===== -->
                <Style Selector="^ /template/ Grid#CompactLayout">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="{StaticResource AnimationDurationMedium}" Easing="CubicEaseOut" />
                            <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource AnimationDurationMedium}" Easing="CubicEaseOut" />
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="^ /template/ Grid#ExpandedLayout">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="RenderTransform" Value="translate(-8px, 0px)" />
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="{StaticResource AnimationDurationMedium}" Easing="CubicEaseOut" />
                            <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource AnimationDurationMedium}" Easing="CubicEaseOut" />
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="^[(custom|NavigationStore.NavigationPaneExpanded)=True]">
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MaxWidth" Value="{x:Static sys:Double.PositiveInfinity}" />
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="ToolTip.Tip" Value="{x:Null}" />
                </Style>
                <Style Selector="^[(custom|NavigationStore.NavigationPaneExpanded)=True] /template/ Border#MainBorder">
                    <Setter Property="Padding" Value="8,0,10,0" />
                    <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusCompact}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Style>
                <Style Selector="^[(custom|NavigationStore.NavigationPaneExpanded)=True] /template/ Grid#CompactLayout">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^[(custom|NavigationStore.NavigationPaneExpanded)=True] /template/ Grid#ExpandedLayout">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^[(custom|NavigationStore.NavigationPaneExpanded)=False]">
                    <Setter Property="ToolTip.Tip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                </Style>

                <!-- ===== Active state ===== -->
                <Style Selector="^[IsActive=True] /template/ Rectangle#ActiveRectangle">
                    <Setter Property="Opacity" Value="1" />
                </Style>
                <Style Selector="^[IsActive=True]">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Style>
                <Style Selector="^[IsActive=True] /template/ Border#MainBorder">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefault}" />
                </Style>
                <Style Selector="^[IsActive=True] /template/ ui|SymbolIcon#CompactIcon">
                    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorSecondary}" />
                </Style>
                <Style Selector="^[IsActive=True] /template/ ui|SymbolIcon#ExpandedIcon">
                    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorSecondary}" />
                </Style>
                <Style Selector="^[IsActive=True] /template/ TextBlock#ExpandedLabelText">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="FontWeight" Value="Medium" />
                </Style>
                <Style Selector="^[IsActive=True][(custom|NavigationStore.NavigationPaneExpanded)=False] /template/ Grid#ContentGrid">
                    <Setter Property="MaxHeight" Value="0" />
                    <Setter Property="Opacity" Value="0" />
                </Style>

                <!-- ===== Image / icon visibility ===== -->
                <Style Selector="^[HasImage=True] /template/ ui|SymbolIcon#CompactIcon">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^[HasImage=True] /template/ ui|SymbolIcon#ExpandedIcon">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^[HasImage=True] /template/ Image#CompactImage">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^[HasImage=True] /template/ Image#ExpandedImage">
                    <Setter Property="IsVisible" Value="True" />
                </Style>

                <!-- ===== Hover states ===== -->
                <Style Selector="^:pointerover /template/ Border#MainBorder">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefault}" />
                </Style>
                <Style Selector="^:pointerover[IsActive=False][(custom|NavigationStore.NavigationPaneExpanded)=False] /template/ ui|SymbolIcon#CompactIcon">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Style>
                <Style Selector="^:pointerover[IsActive=False][(custom|NavigationStore.NavigationPaneExpanded)=False] /template/ Grid#ContentGrid">
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Style>
                <Style Selector="^:pointerover[IsActive=False][(custom|NavigationStore.NavigationPaneExpanded)=True] /template/ ui|SymbolIcon#ExpandedIcon">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Style>
                <Style Selector="^:pointerover[IsActive=False][(custom|NavigationStore.NavigationPaneExpanded)=True] /template/ TextBlock#ExpandedLabelText">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="{x:Type custom:NavigationStore}" TargetType="custom:NavigationStore">
                <!-- The main window supplies the shell-level backdrop wash. Repainting it here
                     makes Acrylic look like a solid navigation block. -->
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="MinWidth" Value="{StaticResource NavigationWidthCollapsed}" />
                <Setter Property="MaxWidth" Value="{StaticResource NavigationWidthCollapsed}" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <ControlTemplate TargetType="custom:NavigationStore">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderThickness="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <custom:DynamicScrollViewer
                                    x:Name="PART_MainItemsScrollViewer"
                                    Grid.Row="0"
                                    Margin="0"
                                    Padding="0"
                                    Width="{TemplateBinding Width}"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsControl
                                        x:Name="PART_MainItems"
                                        MinWidth="64"
                                        MaxWidth="84"
                                        Width="{TemplateBinding Width}"
                                        Focusable="False"                                        ItemsSource="{TemplateBinding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel HorizontalAlignment="Stretch" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </custom:DynamicScrollViewer>

                                <ItemsControl
                                    x:Name="PART_FooterItems"
                                    Grid.Row="1"
                                    MinWidth="64"
                                    MaxWidth="84"
                                    Width="{TemplateBinding Width}"
                                    Margin="0"
                                    Focusable="False"                                    ItemsSource="{TemplateBinding Footer}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel HorizontalAlignment="Stretch" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <!--
                                  Isolate DataContext to the Button itself so the icon glyphs can bind
                                  Foreground directly (Avalonia has no PressedForeground DataContext pitfall,
                                  kept for parity with the WPF layout).
                                -->
                                <ui:Button
                                    x:Name="PART_TogglePaneButton"
                                    Grid.Row="2"
                                    Margin="0,4,0,8"
                                    Padding="6"
                                    HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="NavigationPaneToggle"
                                    AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_NavigationItems_Title}"
                                    Appearance="Transparent"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Focusable="True"
                                    DataContext="{Binding RelativeSource={RelativeSource Self}}"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    MouseOverBackground="{DynamicResource ControlFillColorSecondaryBrush}"
                                    MouseOverBorderBrush="Transparent"
                                    PressedForeground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <Grid>
                                        <ui:SymbolIcon
                                            x:Name="PART_CollapseIcon"
                                            FontSize="{StaticResource IconSizeCompact}"
                                            Foreground="{Binding Foreground}"
                                            Symbol="ChevronLeft24" />
                                        <ui:SymbolIcon
                                            x:Name="PART_ExpandIcon"
                                            FontSize="{StaticResource IconSizeCompact}"
                                            Foreground="{Binding Foreground}"
                                            Symbol="ChevronRight24"
                                            IsVisible="False" />
                                    </Grid>
                                </ui:Button>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter>

                <Style Selector="^[IsExpanded=False] /template/ ui|SymbolIcon#PART_CollapseIcon">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^[IsExpanded=False] /template/ ui|SymbolIcon#PART_ExpandIcon">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^ /template/ Button#PART_TogglePaneButton:pressed">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                </Style>
                <Style Selector="^[IsExpanded=True] /template/ ui|SymbolIcon#PART_CollapseIcon">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^[IsExpanded=True] /template/ ui|SymbolIcon#PART_ExpandIcon">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^[IsExpanded=True] /template/ Button#PART_TogglePaneButton">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="Margin" Value="8,4,0,8" />
                </Style>
                <Style Selector="^[IsExpanded=True] /template/ ItemsControl#PART_MainItems">
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MaxWidth" Value="{x:Static sys:Double.PositiveInfinity}" />
                </Style>
                <Style Selector="^[IsExpanded=True] /template/ ItemsControl#PART_FooterItems">
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MaxWidth" Value="{x:Static sys:Double.PositiveInfinity}" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>

</Styles>
