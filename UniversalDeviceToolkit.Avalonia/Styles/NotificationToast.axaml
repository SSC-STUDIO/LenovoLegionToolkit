<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="using:UniversalDeviceToolkit.Avalonia.Controls.Custom"
    xmlns:ui="using:UniversalDeviceToolkit.Avalonia.Controls"
    xmlns:resources="using:UniversalDeviceToolkit.Avalonia.Resources"
    xmlns:sys="using:System">

    <!--
      UDT notification toast language �?glass card matching AppStatusBanner.
      Template structure adapted from WPF-UI Snackbar (MIT) with UDT tokens.

      Target: SnackbarPresenter (Controls/Custom). The WPF IsShown trigger became a
      :shown pseudo-class contract �?SnackbarPresenter.Show()/ShowAsync() must call
      PseudoClasses.Set(":shown", true) while visible (and clear it when dismissed).
      The close button is a named part (PART_CloseButton); the WPF TemplateButtonCommand
      binding has no Avalonia equivalent �?the presenter should wire its Click to the
      Closed event in OnApplyTemplate. Exit hides instantly (off-canvas), reported.
    -->
    <Styles.Resources>
        <ResourceDictionary>
            <sys:Double x:Key="NotificationToastWidth">400</sys:Double>
            <Thickness x:Key="NotificationToastPadding">12,10</Thickness>
            <Thickness x:Key="NotificationToastMargin">0,0,0,0</Thickness>

            <Style x:Key="NotificationCloseButtonStyle" Selector="ui|Button">
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="MouseOverBackground" Value="Transparent" />
                <Setter Property="MouseOverBorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Focusable" Value="True" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <ControlTheme x:Key="{x:Type custom:SnackbarPresenter}" TargetType="custom:SnackbarPresenter">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="{DynamicResource NotificationGlassSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NotificationGlassBorderBrush}" />
                <Setter Property="Margin" Value="{StaticResource NotificationToastMargin}" />
                <Setter Property="Width" Value="{StaticResource NotificationToastWidth}" />
                <Setter Property="MinWidth" Value="{StaticResource NotificationToastWidth}" />
                <Setter Property="MaxWidth" Value="{StaticResource NotificationToastWidth}" />
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Template">
                    <ControlTemplate TargetType="custom:SnackbarPresenter">
                        <Grid
                            x:Name="CardBorderContainer"
                            Opacity="0"
                            RenderTransform="translate(0px, 200px)"
                            AutomationProperties.Name="{TemplateBinding Title}">
                            <Grid.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="{StaticResource AnimationDurationSlow}" Easing="ExponentialEaseOut" />
                                    <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource AnimationDurationSlow}" Easing="ExponentialEaseOut" />
                                </Transitions>
                            </Grid.Transitions>
                            <Border
                                x:Name="CardBorder"
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="{StaticResource NotificationToastPadding}"
                                VerticalAlignment="Bottom"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadiusCard}"
                                BoxShadow="{StaticResource NotificationGlassShadowEffect}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter
                                        x:Name="IconChrome"
                                        Width="28"
                                        Height="28"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Content="{TemplateBinding Icon}"
                                        TextElement.FontSize="20"
                                        TextElement.Foreground="{TemplateBinding Foreground}" />

                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <ContentPresenter
                                            x:Name="TitleContentPresenter"
                                            Grid.Row="0"
                                            Content="{TemplateBinding Title}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            TextWrapping="Wrap"
                                            TextElement.FontSize="{DynamicResource FontSizeBody}"
                                            TextElement.FontWeight="Medium"
                                            TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                        <ContentPresenter
                                            Grid.Row="1"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            TextWrapping="Wrap"
                                            TextElement.FontSize="{DynamicResource FontSizeCaption}"
                                            TextElement.FontWeight="Regular"
                                            TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Grid>

                                    <ui:Button
                                        x:Name="PART_CloseButton"
                                        Grid.Column="2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Classes="notificationCloseButton"
                                        AutomationProperties.Name="{x:Static resources:Resource.CloseNotification_AutomationName}"
                                        ToolTip.Tip="{x:Static resources:Resource.Close_Tooltip}">
                                        <ui:SymbolIcon FontSize="14" Symbol="Dismiss20" />
                                    </ui:Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter>

                <!-- Slide/fade in while shown; off-canvas + transparent otherwise. -->
                <Style Selector="^:shown /template/ Grid#CardBorderContainer">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
                </Style>

                <Style Selector="^[IsCloseButtonEnabled=False] /template/ Button#PART_CloseButton">
                    <Setter Property="IsVisible" Value="False" />
                </Style>

                <!-- Severity via icon accent only �?keep glass surface for all appearances. -->
                <Style Selector="^[Appearance=Secondary]">
                    <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
                </Style>
                <Style Selector="^[Appearance=Success]">
                    <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
                </Style>
                <Style Selector="^[Appearance=Info]">
                    <Setter Property="Foreground" Value="{DynamicResource StatusInfoBrush}" />
                </Style>
                <Style Selector="^[Appearance=Caution]">
                    <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
                </Style>
                <Style Selector="^[Appearance=Danger]">
                    <Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
                </Style>
                <Style Selector="^[Appearance=Primary]">
                    <Setter Property="Foreground" Value="{DynamicResource StatusInfoBrush}" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="ui|Button.notificationCloseButton">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MouseOverBackground" Value="Transparent" />
        <Setter Property="MouseOverBorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ui|Button.notificationCloseButton:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="ui|Button.notificationCloseButton:pressed">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

</Styles>
