<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="using:UniversalDeviceToolkit.Avalonia.Controls.Custom"
    xmlns:sys="using:System">

    <!--
      CardControl theme (replaces the WPF-UI default + customizations).
      The Content/Header/Icon null triggers (margin trimming) are dropped: Avalonia
      ContentPresenters collapse to zero size when content is null, so the extra
      margins only apply when content exists — report as minor simplification.
    -->
    <Styles.Resources>
        <ResourceDictionary>
            <!-- WPF-UI default tokens kept for template references. -->
            <Thickness x:Key="CardControlIconMargin">0,0,12,0</Thickness>
            <sys:Double x:Key="CardControlIconSize">24</sys:Double>

            <ControlTheme x:Key="{x:Type custom:CardControl}" TargetType="custom:CardControl">
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusCard}" />
                <Setter Property="Background" Value="{DynamicResource AppSurfaceCardBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <!-- Compact vertical rhythm: trim the default 14,16,14,16 card padding to 14,12,14,12. -->
                <Setter Property="Padding" Value="14,12,14,12" />
                <!--
                  Vertical card layout: icon + header on the first row, control content below.
                  (The default Wpf.Ui CardControl template stacks icon | header | content horizontally,
                  which leaves the left text column sparse next to tall right-side controls.)
                -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="custom:CardControl">
                            <Border
                                x:Name="ContentBorder"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                MinWidth="{TemplateBinding MinWidth}"
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ContentControl
                                            x:Name="ControlIcon"
                                            Grid.Column="0"
                                            Margin="{StaticResource CardControlIconMargin}"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding Icon}"
                                            Focusable="False"
                                            FontSize="{StaticResource CardControlIconSize}"
                                            Foreground="{TemplateBinding Foreground}" />
                                        <ContentPresenter
                                            x:Name="HeaderContentPresenter"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding Header}"
                                            TextElement.Foreground="{TemplateBinding Foreground}" />
                                    </Grid>
                                    <ContentPresenter
                                        x:Name="ContentPresenter"
                                        Grid.Row="1"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top"
                                        Content="{TemplateBinding Content}"
                                        TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>

</Styles>
