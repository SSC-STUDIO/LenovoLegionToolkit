<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="using:UniversalDeviceToolkit.Avalonia.Controls.Custom">

    <!--
      Badge theme. WPF appearance triggers became property-equals selectors
      ([Appearance=Primary] etc.) — no control code changes required.
    -->
    <Styles.Resources>
        <ResourceDictionary>
            <ControlTheme x:Key="{x:Type custom:Badge}" TargetType="custom:Badge">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimary}" />
                <Setter Property="Background" Value="{DynamicResource SystemAccentColorSecondary}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <ControlTemplate TargetType="custom:Badge">
                        <Border
                            x:Name="Border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusCompact}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter>

                <Style Selector="^[Appearance=Primary]">
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimary}" />
                </Style>
                <Style Selector="^[Appearance=Transparent]">
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="^[Appearance=Secondary]">
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                </Style>
                <Style Selector="^[Appearance=Info]">
                    <Setter Property="Background" Value="{DynamicResource PaletteLightBlueBrush}" />
                </Style>
                <Style Selector="^[Appearance=Caution]">
                    <Setter Property="Background" Value="{DynamicResource PaletteOrangeBrush}" />
                </Style>
                <Style Selector="^[Appearance=Danger]">
                    <Setter Property="Background" Value="{DynamicResource PaletteRedBrush}" />
                </Style>
                <Style Selector="^[Appearance=Success]">
                    <Setter Property="Background" Value="{DynamicResource PaletteGreenBrush}" />
                </Style>
                <Style Selector="^[Appearance=Dark]">
                    <Setter Property="Background" Value="{DynamicResource ControlStrongFillColorDarkBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorLightPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                </Style>
                <Style Selector="^[Appearance=Light]">
                    <Setter Property="Background" Value="{DynamicResource ControlStrongFillColorLightBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDarkPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>

</Styles>
