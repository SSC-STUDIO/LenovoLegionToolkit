<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Typography. The WPF SystemFonts.MessageFontFamilyKey key has no Avalonia equivalent;
      AppFontFamily is the canonical key. Keyed styles are kept (BasedOn targets for other
      files); application uses the class styles (e.g. Classes="appPageTitleTextBlock").
    -->
    <Styles.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="AppFontFamily">Segoe UI, Microsoft YaHei UI, Microsoft YaHei, Noto Sans CJK SC, SimSun</FontFamily>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Control">
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="TextElement.FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>

    <Style Selector="Window">
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="TextElement.FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>

    <!-- WPF Page style folded into UserControl (Avalonia has no Page control). -->
    <Style Selector="UserControl">
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="TextElement.FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="TextElement.FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>

    <Style Selector="TextBlock.appPageTitleTextBlock">
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizePageTitle}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.appDisplaySectionTitleTextBlock">
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplaySection}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.appSectionTitleTextBlock">
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSection}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.appSubsectionTitleTextBlock">
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSubsection}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.appPageDescriptionTextBlock">
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizePageDescription}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style Selector="TextBlock.appCaptionTextBlock">
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.appHeroBadgeTextBlock">
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="TextBlock.appBodyTextBlock">
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="TextElement.FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.appTitleBarDeviceInfoTextBlock">
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitleBarDeviceInfo}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.appSmallBodyTextBlock">
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmallBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Dense wrapped hint/caption text (promoted from NetworkAccelerationControl). -->
    <Style Selector="TextBlock.appMutedTextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeDenseCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="15" />
    </Style>

    <!-- Compact in-card section heading (smaller than AppSubsectionTitleTextBlockStyle). -->
    <Style Selector="TextBlock.appSectionLabelTextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmallCaption}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- Label inside AppStatusPillBorderStyle. -->
    <Style Selector="TextBlock.appStatusPillTextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmallCaption}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Metric tile readout value (pairs with AppMetricTileBorderStyle). -->
    <Style Selector="TextBlock.appMetricValueTextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizePageDescription}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style Selector="TextBlock.appMetricUnitTextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeMicro}" />
        <Setter Property="Margin" Value="4,0,0,2" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</Styles>
