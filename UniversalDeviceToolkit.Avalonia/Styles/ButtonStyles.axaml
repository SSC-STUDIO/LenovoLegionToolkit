<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:UniversalDeviceToolkit.Avalonia.Controls">

    <!--
      Button chrome. NOTE: the WPF-UI BasedOn chain does not exist in Avalonia 11.3
      (Style has no BasedOn — only ControlTheme does), so keyed styles are flattened and
      kept as inert key holders; application styles use classes (Button.appButtonCompact).
      Implicit Selector="Button" chrome applies to all buttons; the full ui:Button theme
      (template + Appearance variants + hover/press/disabled states) lives in the
      type-keyed ControlTheme. PressedForeground/MouseOver* etc. are ui:Button-only,
      so those setters target ui|Button selectors.
    -->
    <Styles.Resources>
        <ResourceDictionary>
            <Style x:Key="AppButtonCompact" />
            <Style x:Key="AppButtonStandard" />
            <Style x:Key="AppButtonPrimary" />
            <Style x:Key="AppButtonLarge" />

            <ControlTheme x:Key="{x:Type ui:Button}" TargetType="ui:Button">
                <Setter Property="MinHeight" Value="{StaticResource ButtonHeightCompact}" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusControl}" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <ControlTemplate TargetType="ui:Button">
                        <Border
                            x:Name="PART_ContentBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="6"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <ContentPresenter Content="{TemplateBinding Icon}" VerticalAlignment="Center" />
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter>

                <Style Selector="^:pointerover /template/ Border#PART_ContentBorder">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                </Style>
                <Style Selector="^:pressed /template/ Border#PART_ContentBorder">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.5" />
                </Style>
                <Style Selector="^[Appearance=Primary]">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    <Setter Property="PressedForeground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Style>
                <Style Selector="^[Appearance=Primary]:pointerover /template/ Border#PART_ContentBorder">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                </Style>
                <Style Selector="^[Appearance=Primary]:pressed /template/ Border#PART_ContentBorder">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                </Style>
                <Style Selector="^[Appearance=Secondary]">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                </Style>
                <Style Selector="^[Appearance=Tertiary]">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                </Style>
                <Style Selector="^[Appearance=Transparent]">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Style>
                <Style Selector="^[Appearance=Success]">
                    <Setter Property="Background" Value="{DynamicResource StatusSuccessBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource StatusSuccessBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Style>
                <Style Selector="^[Appearance=Caution]">
                    <Setter Property="Background" Value="{DynamicResource StatusWarningBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource StatusWarningBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Style>
                <Style Selector="^[Appearance=Danger]">
                    <Setter Property="Background" Value="{DynamicResource StatusCriticalBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource StatusCriticalBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Style>
                <Style Selector="^[Appearance=Info]">
                    <Setter Property="Background" Value="{DynamicResource StatusInfoBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource StatusInfoBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="{StaticResource ButtonHeightCompact}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusControl}" />
    </Style>

    <Style Selector="ui|Button">
        <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- Compact Button Style -->
    <Style Selector="ui|Button.appButtonCompact">
        <Setter Property="MinWidth" Value="{StaticResource ButtonMinWidthCompact}" />
        <Setter Property="Height" Value="{StaticResource ButtonHeightCompact}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusControl}" />
        <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Standard Button Style -->
    <Style Selector="ui|Button.appButtonStandard">
        <Setter Property="MinWidth" Value="{StaticResource ButtonMinWidthStandard}" />
        <Setter Property="Height" Value="{StaticResource ButtonHeightStandard}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusControl}" />
    </Style>

    <!-- Primary Button Style (height 36 = standard primary) -->
    <Style Selector="ui|Button.appButtonPrimary">
        <Setter Property="Appearance" Value="Primary" />
        <Setter Property="MinWidth" Value="{StaticResource ButtonMinWidthStandard}" />
        <Setter Property="Height" Value="{StaticResource ButtonHeightStandard}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusControl}" />
        <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="PressedForeground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>

    <!-- Large Button Style -->
    <Style Selector="ui|Button.appButtonLarge">
        <Setter Property="MinWidth" Value="{StaticResource ButtonMinWidthLarge}" />
        <Setter Property="Height" Value="{StaticResource ButtonHeightLarge}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSubsection}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusControl}" />
    </Style>

</Styles>
