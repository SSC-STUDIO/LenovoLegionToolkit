<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="clr-namespace:UniversalDeviceToolkit.WPF.Controls.Custom">

    <!--  ReSharper disable Xaml.StaticResourceNotResolved  -->

    <!--
      WPF-UI CardAction has no CornerRadius DP — it binds template Border to Border.CornerRadius
      (defaults to ControlCornerRadius ≈ 4–8). Match CardControl / CardExpander (CornerRadiusCard = 18).
    -->
    <Style BasedOn="{StaticResource DefaultUiCardActionStyle}" TargetType="{x:Type custom:CardAction}">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Background" Value="{DynamicResource AppSurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Border.CornerRadius" Value="{StaticResource CornerRadiusCard}" />
    </Style>

    <!--  ReSharper restore Xaml.StaticResourceNotResolved  -->

</ResourceDictionary>
