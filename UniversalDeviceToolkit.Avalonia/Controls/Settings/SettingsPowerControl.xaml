<UserControl
    x:Class="UniversalDeviceToolkit.WPF.Controls.Settings.SettingsPowerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:UniversalDeviceToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:UniversalDeviceToolkit.WPF.Controls.Custom"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:UniversalDeviceToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,12">
            <custom:CardControl x:Name="_godModeFnQSwitchableCard" AutomationProperties.AutomationId="GodModeFnQSwitchableCard" Margin="0,0,0,8">
                <Grid MinHeight="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:CardHeaderControl
                        Grid.Column="0"
                        Margin="0,0,16,0"
                        Title="{x:Static resources:Resource.Settings_GodModeFnQSwitchable_Title}"
                        Subtitle="{x:Static resources:Resource.Settings_GodModeFnQSwitchable_Message}" />
                    <wpfui:ToggleSwitch
                        x:Name="_godModeFnQSwitchableToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="GodModeFnQSwitchableToggle"
                        AutomationProperties.Name="{x:Static resources:Resource.Settings_GodModeFnQSwitchable_Title}"
                        Click="GodModeFnQSwitchableToggle_Click" />
                </Grid>
            </custom:CardControl>

            <custom:CardControl x:Name="_powerModeMappingCard" AutomationProperties.AutomationId="PowerModeMappingCard" Margin="0,0,0,8">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_PowerModeMapping_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_PowerModeMapping_Message}" />
                </custom:CardControl.Header>
                <ComboBox
                    x:Name="_powerModeMappingComboBox"
                    AutomationProperties.AutomationId="PowerModeMappingComboBox"
                    MinWidth="160"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_PowerModeMapping_Title}"
                    MaxDropDownHeight="Auto"
                    SelectionChanged="PowerModeMappingComboBox_SelectionChanged" />
            </custom:CardControl>

            <custom:CardAction
                x:Name="_powerModesCard"
                AutomationProperties.AutomationId="PowerModesCard"
                Margin="0,0,0,8"
                Click="PowerModes_Click">
                <custom:CardAction.Content>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_WindowsPowerModes_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_WindowsPowerModes_Message}" />
                </custom:CardAction.Content>
            </custom:CardAction>

            <custom:CardAction
                x:Name="_windowsPowerPlansCard"
                AutomationProperties.AutomationId="WindowsPowerPlansCard"
                Margin="0,0,0,8"
                Click="WindowsPowerPlans_Click">
                <custom:CardAction.Content>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_WindowsPowerPlans_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_WindowsPowerPlans_Message}" />
                </custom:CardAction.Content>
            </custom:CardAction>

            <custom:CardControl
                x:Name="_windowsPowerPlansControlPanelCard"
                AutomationProperties.AutomationId="WindowsPowerPlansControlPanelCard"
                Margin="0,0,0,8"
                Click="WindowsPowerPlansControlPanel_Click">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_WindowsPowerPlansControlPanel_Title}">
                        <controls:CardHeaderControl.Accessory>
                            <wpfui:SymbolIcon
                                Margin="4,0,0,0"
                                FontSize="{StaticResource IconSizeCardGlyph}"
                                Symbol="Open24" />
                        </controls:CardHeaderControl.Accessory>
                    </controls:CardHeaderControl>
                </custom:CardControl.Header>
            </custom:CardControl>

            <custom:CardControl Margin="0,0,0,8">
                <Grid MinHeight="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:CardHeaderControl
                        Grid.Column="0"
                        Margin="0,0,16,0"
                        Title="{x:Static resources:Resource.SettingsPage_OnBatterySinceReset_Title}"
                        Subtitle="{x:Static resources:Resource.SettingsPage_OnBatterySinceReset_Message}" />
                    <wpfui:ToggleSwitch
                        x:Name="_onBatterySinceResetToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="OnBatterySinceResetToggle"
                        AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_OnBatterySinceReset_Title}"
                        Click="OnBatterySinceResetToggle_Click" />
                </Grid>
            </custom:CardControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
