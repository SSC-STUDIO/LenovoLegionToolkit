<UserControl
    x:Class="UniversalDeviceToolkit.Avalonia.Controls.Shell.AppNotificationHost"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:UniversalDeviceToolkit.Avalonia.Controls"
    xmlns:resources="using:UniversalDeviceToolkit.Avalonia.Resources"
    Width="{StaticResource NotificationToastWidth}"
    MinWidth="{StaticResource NotificationToastWidth}"
    MaxWidth="{StaticResource NotificationToastWidth}"
    HorizontalAlignment="Right"
    VerticalAlignment="Bottom"
    Focusable="False"
    Background="Transparent"
    AutomationProperties.AutomationId="AppNotificationHost"
    AutomationProperties.Name="{x:Static resources:Resource.AppNotificationHost_AccessibleName}">
    <!--
      Bottom-right toast stack: up to 3 rows fully visible; overflow scrolls inside a fixed max height.
      Card width matches Snackbar / AppStatusBanner via NotificationToastWidth.
      New items append at the bottom. Close buttons never invoke notification primary actions.
    -->
    <!-- ~3 toast rows (~100px each + margins) stay fully visible; overflow scrolls. -->
    <UserControl.Styles>
        <Style Selector="ProgressBar.toastProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Height="{TemplateBinding Height}">
                            <Border
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource CornerRadiusProgressBar}" />
                            <Grid x:Name="PART_Track" ClipToBounds="True">
                                <Border
                                    x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="{StaticResource CornerRadiusProgressBar}" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Styles>
    <ScrollViewer
        x:Name="_scrollViewer"
        MaxHeight="320"
        HorizontalAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        Focusable="False"
        Padding="0">
        <ItemsControl
            x:Name="_items"
            HorizontalAlignment="Stretch"
            AutomationProperties.AutomationId="AppNotificationList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerTheme>
                <ControlTheme TargetType="ContentPresenter">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                </ControlTheme>
            </ItemsControl.ItemContainerTheme>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Vertical spacing only — full NotificationToastWidth for every card. -->
                    <Border
                            x:Name="ToastBorder"
                            Margin="0,5,0,11"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            MinWidth="{StaticResource NotificationToastWidth}"
                            Background="{DynamicResource NotificationGlassSurfaceBrush}"
                            BorderBrush="{DynamicResource NotificationGlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusCard}"
                            BoxShadow="{DynamicResource NotificationGlassShadowEffect}"
                            PointerEntered="Toast_MouseEnter"
                            PointerExited="Toast_MouseLeave"
                            AutomationProperties.AutomationId="{Binding AutomationId}"
                            AutomationProperties.Name="{Binding AccessibilityName}">
                        <Grid>
                            <Grid Margin="12,10,12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Severity-tinted icon chip. -->
                            <Grid
                                Grid.Column="0"
                                Width="34"
                                Height="34"
                                VerticalAlignment="Center">
                                <Border
                                    CornerRadius="{StaticResource CornerRadiusSmall}"
                                    Background="{Binding IconBrush}"
                                    Opacity="0.14" />
                                <ui:SymbolIcon
                                    FontSize="19"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Symbol="{Binding IconSymbol}"
                                    Foreground="{Binding IconBrush}" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="{DynamicResource FontSizeSmallBody}"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding DisplayTitle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="{DynamicResource FontSizeSmallCaption}"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{Binding Message}"
                                    TextWrapping="Wrap"
                                    IsVisible="{Binding MessageVisibility}" />
                                <ProgressBar
                                    Margin="0,7,0,1"
                                    Classes="toastProgressBar"
                                    Value="{Binding ProgressPercent, Mode=OneWay}"
                                    Foreground="{Binding IconBrush}"
                                    IsVisible="{Binding ProgressVisibility}" />
                            </StackPanel>
                            <ui:Button
                                Grid.Column="2"
                                VerticalAlignment="Top"
                                Classes="notificationCloseButton"
                                ToolTip.Tip="{x:Static resources:Resource.AppNotificationHost_Close}"
                                AutomationProperties.AutomationId="{Binding CloseAutomationId}"
                                AutomationProperties.Name="{x:Static resources:Resource.AppNotificationHost_Close}"
                                Click="CloseButton_Click"
                                Tag="{Binding Id}">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="{StaticResource IconSizeSM}" />
                            </ui:Button>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
