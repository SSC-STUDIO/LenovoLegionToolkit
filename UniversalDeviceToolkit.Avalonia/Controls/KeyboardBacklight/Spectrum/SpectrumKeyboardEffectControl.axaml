<UserControl
    x:Class="UniversalDeviceToolkit.Avalonia.Controls.KeyboardBacklight.Spectrum.SpectrumKeyboardEffectControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:UniversalDeviceToolkit.Avalonia.Controls"
    xmlns:custom="using:UniversalDeviceToolkit.Avalonia.Controls.Custom"
    xmlns:resources="using:UniversalDeviceToolkit.Avalonia.Resources"
    xmlns:ui="using:UniversalDeviceToolkit.Avalonia.Controls">

    <custom:CardControl
        Margin="0,0,0,8"
        Click="ButtonBase_OnClick"
        Icon="Star24">
        <custom:CardControl.Header>
            <controls:CardHeaderControl x:Name="_cardHeaderControl" />
        </custom:CardControl.Header>
        <StackPanel Orientation="Horizontal">
            <ui:Button
                Click="Edit_Click"
                Icon="Edit24"
                ToolTip.Tip="{x:Static resources:Resource.Edit}" />
            <ui:Button
                Margin="8,0,0,0"
                Click="Delete_Click"
                Icon="Dismiss24"
                ToolTip.Tip="{x:Static resources:Resource.Delete}" />
        </StackPanel>
    </custom:CardControl>

</UserControl>
