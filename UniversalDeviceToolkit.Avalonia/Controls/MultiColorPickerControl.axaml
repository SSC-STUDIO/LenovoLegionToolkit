<UserControl
    x:Class="UniversalDeviceToolkit.Avalonia.Controls.MultiColorPickerControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:UniversalDeviceToolkit.Avalonia.Controls">
    <StackPanel Orientation="Horizontal">

        <StackPanel x:Name="_buttons" Orientation="Horizontal" />

        <ui:Button
            x:Name="_addButton"
            Width="38"
            Height="38"
            Margin="8,0,0,0"
            Appearance="Primary"
            Click="AddButton_Click"
            Icon="Add24" />

    </StackPanel>
</UserControl>
