<UserControl
    x:Class="UniversalDeviceToolkit.Avalonia.Controls.Macro.AbstractMacroEventControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:UniversalDeviceToolkit.Avalonia.Controls"
    xmlns:custom="using:UniversalDeviceToolkit.Avalonia.Controls.Custom"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <custom:CardControl x:Name="_card" Margin="0,0,0,8">
        <custom:CardControl.Header>
            <controls:CardHeaderControl x:Name="_header" />
        </custom:CardControl.Header>
    </custom:CardControl>
</UserControl>
