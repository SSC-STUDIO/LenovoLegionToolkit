<controls:AbstractRefreshingControl
    x:Class="UniversalDeviceToolkit.WPF.Controls.Dashboard.TurnOffMonitorsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:UniversalDeviceToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:UniversalDeviceToolkit.WPF.Controls.Custom"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <custom:CardControl Margin="0,0,0,8" Icon="Desktop24">
        <custom:CardControl.Header>
            <Grid MinHeight="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:CardHeaderControl
                    Grid.Column="0"
                    Margin="0,0,16,0"
                    Title="{x:Static resources:Resource.TurnOffMonitorsControl_Title}"
                    Subtitle="{x:Static resources:Resource.TurnOffMonitorsControl_Message}" />
                <wpfui:Button
                    x:Name="_turnOffButton"
                    Grid.Column="1"
                    MinWidth="120"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static resources:Resource.TurnOffMonitorsControl_Title}"
                    Click="TurnOffButton_Click"
                    Content="{x:Static resources:Resource.TurnOffMonitorsControl_TurnOff}"
                    Focusable="True" />
            </Grid>
        </custom:CardControl.Header>
    </custom:CardControl>
</controls:AbstractRefreshingControl>
