<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
        <TargetFramework>$(UDTTargetFramework)</TargetFramework>
		<RootNamespace>UniversalDeviceToolkit.WPF</RootNamespace>
		<OutputType>WinExe</OutputType>
		<!-- Canonical brand icons live in repo-root Assets/ (single source of truth). -->
		<ApplicationIcon>..\Assets\Icon.ico</ApplicationIcon>
		<AssemblyName>Universal Device Toolkit</AssemblyName>
		<!-- WPF and WinForms expose overlapping type names; keep imports explicit. -->
		<ImplicitUsings>disable</ImplicitUsings>
		<Copyright>$(ProjectCopyright)</Copyright>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<IsUdtShippingApp>true</IsUdtShippingApp>
		<SelfContained>false</SelfContained>
		<PublishSingleFile>false</PublishSingleFile>
		<PublishReadyToRun>false</PublishReadyToRun>
		<PublishUrl>publish\</PublishUrl>
		<IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
		<RollForward>Major</RollForward>
	</PropertyGroup>
	<PropertyGroup>
		<ApplicationManifest>App.manifest</ApplicationManifest>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<NeutralLanguage>en</NeutralLanguage>
		<SatelliteResourceLanguages>$(UdtSatelliteResourceLanguages)</SatelliteResourceLanguages>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
	  <DebugType>portable</DebugType>
	</PropertyGroup>
	<Target Name="ValidateMainWindowUpdateIndicatorBindings" BeforeTargets="MarkupCompilePass1">
		<Error
			Condition="$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Windows\MainWindow.xaml').Contains('MouseLeftButtonDown=&quot;UpdateIndicator_Click&quot;'))"
			Text="MainWindow.xaml must not bind UpdateIndicator_Click to MouseLeftButtonDown. Wire mouse handlers in MainWindow.xaml.cs instead." />
		<Error
			Condition="$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Windows\MainWindow.xaml').Contains('MouseRightButtonDown=&quot;UpdateIndicator_Click&quot;'))"
			Text="MainWindow.xaml must not bind UpdateIndicator_Click to MouseRightButtonDown. Wire mouse handlers in MainWindow.xaml.cs instead." />
	</Target>
	<ItemGroup>
		<PackageReference Include="Autofac" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="Humanizer" />
		<PackageReference Include="PixiEditor.ColorPicker" />
		<PackageReference Include="PixiEditor.ColorPicker.Models" />
		<PackageReference Include="WPF-UI" />
		<PackageReference Include="WpfScreenHelper" />
		<PackageReference Include="Markdig" />
		<PackageReference Include="Markdig.Wpf" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\UniversalDeviceToolkit.Lib\UniversalDeviceToolkit.Lib.csproj" />
		<ProjectReference Include="..\UniversalDeviceToolkit.Lib.Plugins\UniversalDeviceToolkit.Lib.Plugins.csproj" />
		<ProjectReference Include="..\UniversalDeviceToolkit.Lib.Automation\UniversalDeviceToolkit.Lib.Automation.csproj" />
		<ProjectReference Include="..\UniversalDeviceToolkit.Lib.Macro\UniversalDeviceToolkit.Lib.Macro.csproj" />
		<ProjectReference Include="..\UniversalDeviceToolkit.CLI.Lib\UniversalDeviceToolkit.CLI.Lib.csproj" />
		<ProjectReference Include="..\UniversalDeviceToolkit.ViewModels\UniversalDeviceToolkit.ViewModels.csproj" />
		<ProjectReference Include="..\UniversalDeviceToolkit.Lib.Shared\UniversalDeviceToolkit.Lib.Shared.csproj" />
		<ProjectReference Include="..\UniversalDeviceToolkit.Platform.Windows\UniversalDeviceToolkit.Platform.Windows.csproj" />
		<!-- Build worker beside the app; do not load it as a managed reference. -->
		<ProjectReference Include="..\UniversalDeviceToolkit.NetworkProxy\UniversalDeviceToolkit.NetworkProxy.csproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
		</ProjectReference>
	</ItemGroup>
	<!-- Copy NetworkProxy exe next to the main app so the launcher can find it. -->
	<Target Name="CopyNetworkProxyWorker" AfterTargets="Build">
		<PropertyGroup>
			<_NetworkProxyOutDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\UniversalDeviceToolkit.NetworkProxy\bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\'))</_NetworkProxyOutDir>
		</PropertyGroup>
		<ItemGroup>
			<_NetworkProxyFiles Include="$(_NetworkProxyOutDir)UniversalDeviceToolkit.NetworkProxy.exe"
			                    Condition="Exists('$(_NetworkProxyOutDir)UniversalDeviceToolkit.NetworkProxy.exe')" />
			<_NetworkProxyFiles Include="$(_NetworkProxyOutDir)UniversalDeviceToolkit.NetworkProxy.dll"
			                    Condition="Exists('$(_NetworkProxyOutDir)UniversalDeviceToolkit.NetworkProxy.dll')" />
			<_NetworkProxyFiles Include="$(_NetworkProxyOutDir)UniversalDeviceToolkit.NetworkProxy.runtimeconfig.json"
			                    Condition="Exists('$(_NetworkProxyOutDir)UniversalDeviceToolkit.NetworkProxy.runtimeconfig.json')" />
			<_NetworkProxyFiles Include="$(_NetworkProxyOutDir)UniversalDeviceToolkit.NetworkProxy.deps.json"
			                    Condition="Exists('$(_NetworkProxyOutDir)UniversalDeviceToolkit.NetworkProxy.deps.json')" />
		</ItemGroup>
		<Copy SourceFiles="@(_NetworkProxyFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(_NetworkProxyFiles)' != ''" />
	</Target>
	<ItemGroup>
		<!-- Local plugin runtime assets are generated under the monorepo's ignored cache. -->
		<Content Include="..\Plugins\.build\sdk\UniversalDeviceToolkit.Plugins.SDK.dll"
		         Link="UniversalDeviceToolkit.Plugins.SDK.dll"
		         CopyToOutputDirectory="PreserveNewest"
		         Condition="Exists('..\Plugins\.build\sdk\UniversalDeviceToolkit.Plugins.SDK.dll')" />
		<Content Include="..\Plugins\.build\shared\UniversalDeviceToolkit.Plugins.Shared.dll"
		         Link="UniversalDeviceToolkit.Plugins.Shared.dll"
		         CopyToOutputDirectory="PreserveNewest"
		         Condition="Exists('..\Plugins\.build\shared\UniversalDeviceToolkit.Plugins.Shared.dll')" />
	</ItemGroup>
	<ItemGroup>
		<!-- Pack URIs stay pack://.../Assets/... via Link; files are not duplicated under WPF/Assets. -->
		<Resource Include="..\Assets\Icon.ico" Link="Assets\Icon.ico" />
		<Resource Include="..\Assets\Logo.png" Link="Assets\Logo.png" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Update="Assets\AssetResources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>AssetResources.resx</DependentUpon>
	  </Compile>
	  <Compile Update="Resources\Resource.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resource.resx</DependentUpon>
	  </Compile>
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Update="Assets\AssetResources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>AssetResources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Resources\Resource.resx">
	    <Generator>PublicResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resource.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

	<Target Name="CreateSatelliteResourceOutputDirectories" BeforeTargets="_CopyFilesMarkedCopyLocal;CopyFilesToOutputDirectory">
		<ItemGroup>
			<SatelliteResourceOutputDirectory Include="$(OutDir)%(ReferenceCopyLocalPaths.DestinationSubDirectory)" Condition="'%(ReferenceCopyLocalPaths.DestinationSubDirectory)' != ''" />
		</ItemGroup>
		<MakeDir Directories="@(SatelliteResourceOutputDirectory)" Condition="'@(SatelliteResourceOutputDirectory)' != ''" />
	</Target>

</Project>
