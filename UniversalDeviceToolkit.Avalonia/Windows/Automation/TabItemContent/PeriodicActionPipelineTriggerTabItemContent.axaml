<UserControl
    x:Class="UniversalDeviceToolkit.Avalonia.Windows.Automation.TabItemContent.PeriodicAutomationPipelineTriggerTabItemContent"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="using:UniversalDeviceToolkit.Avalonia.Resources"
    xmlns:ui="using:UniversalDeviceToolkit.Avalonia.Controls"
    Initialized="PeriodicAutomationPipelineTriggerTabItemContent_Initialized">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Text="{x:Static resources:Resource.PeriodicActionPipelineTriggerTabItemContent_PeriodMinutes}" />

            <TextBlock
                Grid.Column="0"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Text=":" />

            <ui:NumberBox
                x:Name="_periodPickerMinutes"
                Grid.Column="1"
                ClearButtonEnabled="False"
                MaxDecimalPlaces="0"
                Maximum="1440"
                Minimum="1" />
        </Grid>
    </StackPanel>
</UserControl>
