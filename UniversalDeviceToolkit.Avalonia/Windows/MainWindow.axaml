<local:BaseWindow
    x:Class="UniversalDeviceToolkit.Avalonia.Windows.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="using:UniversalDeviceToolkit.Avalonia.Controls.Custom"
    xmlns:shell="using:UniversalDeviceToolkit.Avalonia.Controls.Shell"
    xmlns:local="using:UniversalDeviceToolkit.Avalonia.Windows"
    xmlns:pages="using:UniversalDeviceToolkit.Avalonia.Pages"
    xmlns:primitives="using:Avalonia.Controls.Primitives"
    xmlns:resources="using:UniversalDeviceToolkit.Avalonia.Resources"
    xmlns:utils="using:UniversalDeviceToolkit.Avalonia.Utils"
    xmlns:ui="using:UniversalDeviceToolkit.Avalonia.Controls"
    Title="{x:Static utils:AppDisplayName.Value}"
    Width="1024"
    Height="640"
    MinWidth="1024"
    MinHeight="640"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}">

    <!--
      AVALONIA: WPF keyed styles (BasedOn wpfui:Button) became class-selector styles
      referenced via Classes="titleBarLog" / Classes="titleBarDeviceInfo". Pseudo-class
      triggers (IsMouseOver/IsPressed/IsKeyboardFocused) became :pointerover/:pressed/:focus.
    -->
    <local:BaseWindow.Styles>
        <Style Selector="Button.titleBarLog">
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusControl}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeTitleBarDeviceInfo}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="ui|Button.titleBarDeviceInfo">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeTitleBarDeviceInfo}" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSM}" />
        </Style>
        <Style Selector="ui|Button.titleBarDeviceInfo:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="ui|Button.titleBarDeviceInfo:pressed">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="ui|Button.titleBarDeviceInfo:focus">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </local:BaseWindow.Styles>

    <Grid
        Background="{DynamicResource AppNavigationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <custom:TitleBar
            x:Name="_mainTitleBar"
            Grid.Row="0"
            Height="38"
            CanMaximize="True"
            ShowMaximize="True"
            Background="Transparent"
            Title="">
            <custom:TitleBar.CenterContent>
                <TextBlock
                    x:Name="_title"
                    MaxWidth="760"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FlowDirection="LeftToRight"
                    Focusable="False"
                    FontSize="{DynamicResource FontSizeTitleBarDeviceInfo}"
                    FontWeight="Medium"
                    IsHitTestVisible="False"
                    Classes="appCaptionTextBlock"
                    Text="{x:Static utils:AppDisplayName.Value}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </custom:TitleBar.CenterContent>

            <custom:TitleBar.TrailingContent>
                <StackPanel
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:Button
                        x:Name="_openLogIndicator"
                        Margin="0,0,8,0"
                        Appearance="Caution"
                        Classes="titleBarLog"
                        AutomationProperties.AutomationId="OpenLogIndicator"
                        AutomationProperties.Name="{x:Static resources:Resource.MainWindow_OpenLogsTooltip}"
                        Content="{x:Static resources:Resource.MainWindow_LogIndicatorLabel}"
                        ToolTip.Tip="{x:Static resources:Resource.MainWindow_OpenLogsTooltip}"
                        Cursor="Hand"
                        Focusable="True"
                        VerticalAlignment="Center"
                        Click="OpenLogIndicator_Click"
                        KeyDown="OpenLogIndicator_KeyDown"
                        IsVisible="False" />

                    <ui:Button
                        x:Name="_deviceInfoIndicator"
                        Height="28"
                        MaxWidth="260"
                        Padding="8,2,8,2"
                        AutomationProperties.AutomationId="DeviceInfoIndicator"
                        Cursor="Hand"
                        Focusable="True"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Classes="titleBarDeviceInfo"
                        VerticalAlignment="Center"
                        Click="DeviceInfoIndicator_Click"
                        KeyDown="DeviceInfoIndicator_KeyDown"
                        IsVisible="False">
                        <TextBlock
                            x:Name="_deviceInfoIndicatorText"
                            Classes="appTitleBarDeviceInfoTextBlock" />
                    </ui:Button>
                </StackPanel>
            </custom:TitleBar.TrailingContent>
        </custom:TitleBar>

        <Grid
            x:Name="_contentGrid"
            Grid.Row="1"
            Margin="12,0,0,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <!-- Hit-test only; the continuous chrome edge is the content surface left border. -->
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <custom:NavigationStore
                x:Name="_navigationStore"
                AutomationProperties.AutomationId="MainNavigationStore"
                Grid.Column="0"
                Margin="0,0,0,12"
                Frame="{Binding ElementName=_rootFrame}"
                SelectedPageIndex="0">

                <custom:NavigationStore.Items>
                    <custom:NavigationItem
                        x:Name="_dashboardItem"
                        AutomationProperties.AccessKey="D"
                        AutomationProperties.AutomationId="DashboardNavItem"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_Dashboard}"
                        Icon="Home24"
                        PageTag="dashboard"
                        PageType="{x:Type pages:DashboardPage}"
                        ToolTip.Tip="{x:Static resources:Resource.MainWindow_NavigationItem_Dashboard}" />
                    <custom:NavigationItem
                        x:Name="_keyboardItem"
                        AutomationProperties.AccessKey="K"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_Keyboard}"
                        Icon="Keyboard24"
                        PageTag="keyboardBacklight"
                        PageType="{x:Type pages:KeyboardBacklightPage}"
                        ToolTip.Tip="{x:Static resources:Resource.MainWindow_NavigationItem_Keyboard}" />
                    <custom:NavigationItem
                        x:Name="_automationItem"
                        AutomationProperties.AccessKey="A"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_Actions}"
                        Icon="Rocket24"
                        PageTag="automation"
                        PageType="{x:Type pages:AutomationPage}"
                        ToolTip.Tip="{x:Static resources:Resource.MainWindow_NavigationItem_Actions}" />
                    <custom:NavigationItem
                        x:Name="_macroItem"
                        AutomationProperties.AccessKey="M"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_Macro}"
                        Icon="ReceiptPlay24"
                        PageTag="macro"
                        PageType="{x:Type pages:MacroPage}"
                        ToolTip.Tip="{x:Static resources:Resource.MainWindow_NavigationItem_Macro}" />
                    <custom:NavigationItem
                        x:Name="_windowsOptimizationItem"
                        AutomationProperties.AccessKey="W"
                        AutomationProperties.AutomationId="WindowsOptimizationNavItem"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_WindowsOptimization}"
                        Icon="Gauge24"
                        PageTag="windowsOptimization"
                        PageType="{x:Type pages:WindowsOptimizationPage}"
                        ToolTip.Tip="{x:Static resources:Resource.MainWindow_NavigationItem_WindowsOptimization}" />
                </custom:NavigationStore.Items>

                <custom:NavigationStore.Footer>
                    <custom:NavigationItem
                        x:Name="_pluginExtensionsItem"
                        AutomationProperties.AccessKey="P"
                        AutomationProperties.AutomationId="PluginExtensionsNavItem"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_PluginExtensions}"
                        Icon="Apps24"
                        PageTag="pluginExtensions"
                        PageType="{x:Type pages:PluginExtensionsPage}"
                        IsVisible="True"
                        ToolTip.Tip="{x:Static resources:Resource.MainWindow_NavigationItem_PluginExtensions}" />

                    <custom:NavigationItem
                        x:Name="_settingsItem"
                        AutomationProperties.AccessKey="S"
                        AutomationProperties.AutomationId="SettingsNavItem"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_Settings}"
                        Icon="Settings24"
                        PageTag="settings"
                        PageType="{x:Type pages:SettingsPage}"
                        ToolTip.Tip="{x:Static resources:Resource.MainWindow_NavigationItem_Settings}" />
                    <custom:NavigationItem
                        x:Name="_aboutItem"
                        AutomationProperties.AccessKey="B"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_About}"
                        Icon="Info24"
                        PageTag="about"
                        PageType="{x:Type pages:AboutPage}"
                        ToolTip.Tip="{x:Static resources:Resource.MainWindow_NavigationItem_About}" />
                </custom:NavigationStore.Footer>

            </custom:NavigationStore>

            <!-- Resize grip only (no free-floating vertical stroke). -->
            <primitives:Thumb
                x:Name="_navigationSplitter"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Width="10"
                HorizontalAlignment="Left"
                Margin="0,0,0,12"
                Cursor="SizeWE"
                DragCompleted="NavigationSplitter_DragCompleted"
                DragDelta="NavigationSplitter_DragDelta">
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>

            <!-- Left + top borders share CornerRadiusSurfaceTop so the vertical edge and
                 top edge meet as one continuous stroke through the rounded corner. -->
            <Border
                x:Name="_contentSurfaceBorder"
                Grid.Column="2"
                Background="{DynamicResource AppSurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                ClipToBounds="True"
                CornerRadius="{StaticResource CornerRadiusSurfaceTop}">
                <!-- AVALONIA: WPF Frame replaced by ContentControl (NavigationStore.Frame contract).
                     NavigationUIVisibility has no Avalonia equivalent and was dropped. -->
                <ContentControl
                    x:Name="_rootFrame"
                    AutomationProperties.AutomationId="MainRootFrame"
                    Margin="24,0,0,0" />
            </Border>

        </Grid>

        <StackPanel
            x:Name="_statusNotificationStack"
            Grid.Row="1"
            Grid.RowSpan="5"
            Margin="0,0,18,18"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Panel.ZIndex="100">
            <!-- Unified multi-toast host (success 5s, max height + scroll, bottom-right). -->
            <shell:AppNotificationHost
                x:Name="_appNotificationHost"
                Margin="0,0,0,8"
                HorizontalAlignment="Right" />
            <custom:SnackbarPresenter
                x:Name="_snackbarPresenter"
                Margin="0,0,0,10"
                HorizontalAlignment="Right"
                IsVisible="False" />
            <shell:AppStatusBanner
                x:Name="_vantageIndicator"
                IsPersistent="True"
                Message="{x:Static resources:Resource.MainWindows_VantageRunning}"
                Severity="Warning" />

            <shell:AppStatusBanner
                x:Name="_legionZoneIndicator"
                IsPersistent="True"
                Message="{x:Static resources:Resource.MainWindow_LegionZoneRunning}"
                Severity="Warning" />

            <shell:AppStatusBanner
                x:Name="_fnKeysIndicator"
                IsPersistent="True"
                Message="{x:Static resources:Resource.MainWindows_FnKeysRunning}"
                Severity="Warning" />

            <shell:AppStatusBanner
                x:Name="_pluginExtensionsIndicator"
                IsPersistent="True"
                Message="{x:Static resources:Resource.MainWindow_PluginExtensionsDisabledNotice}"
                Severity="Warning"
                ToolTip.Tip="{x:Static resources:Resource.MainWindow_PluginExtensionsDisabledNotice}" />

            <shell:AppStatusBanner
                x:Name="_updateIndicator"
                Cursor="Hand"
                Focusable="True"
                IsPersistent="True"
                KeyDown="UpdateIndicator_KeyDown"
                Message="{x:Static resources:Resource.MainWindow_UpdateAvailable}"
                Severity="Success"
                ToolTip.Tip="{x:Static resources:Resource.MainWindow_UpdateAvailable}" />
        </StackPanel>

    </Grid>
</local:BaseWindow>
