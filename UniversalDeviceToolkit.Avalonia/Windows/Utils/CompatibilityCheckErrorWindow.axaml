<local:BaseWindow
    x:Class="UniversalDeviceToolkit.Avalonia.Windows.Utils.CompatibilityCheckErrorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UniversalDeviceToolkit.Avalonia.Windows"
    xmlns:resources="using:UniversalDeviceToolkit.Avalonia.Resources"
    xmlns:utils="using:UniversalDeviceToolkit.Avalonia.Utils"
    xmlns:ui="using:UniversalDeviceToolkit.Avalonia.Controls"
    xmlns:custom="using:UniversalDeviceToolkit.Avalonia.Controls.Custom"
    Title="{x:Static resources:Resource.CompatibilityCheckErrorWindow_Title}"
    MinWidth="700"
    MinHeight="500"
    MaxWidth="900"
    MaxHeight="650"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    Loaded="Window_Loaded"
    Topmost="True"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <custom:TitleBar
            Title="{x:Static resources:Resource.CompatibilityCheckErrorWindow_Title}"
            Grid.Row="0"
            CanMaximize="True"
            ShowMaximize="True"
            ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Error Icon -->
            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Grid.RowSpan="2"
                Margin="0,0,20,0"
                VerticalAlignment="Top">
                <ui:SymbolIcon 
                    FontSize="{StaticResource IconSizeHeroXXL}" 
                    Symbol="ErrorCircle24"
                    Foreground="{DynamicResource StatusCriticalBrush}" />
            </StackPanel>

            <!-- Main Error Message -->
            <StackPanel Grid.Row="0" Grid.Column="1">
                <TextBlock
                    x:Name="_mainMessageTextBlock"
                    Margin="0,0,0,12"
                    Focusable="True"
                    Classes="appSectionTitleTextBlock"
                    TextWrapping="Wrap" />
                
                <TextBlock
                    Margin="0,0,0,16"
                    Classes="appPageDescriptionTextBlock"
                    Text="{x:Static resources:Resource.CompatibilityCheckErrorWindow_Description}"
                    />
            </StackPanel>

            <!-- Error Details -->
            <Border
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,0,0,16"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusCompact}"
                Padding="12"
                MaxHeight="200">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto">
                    <TextBlock
                        x:Name="_errorDetailsTextBlock"
                        FontFamily="Consolas, Courier New"
                        FontSize="{DynamicResource FontSizeSmallCaption}"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <!-- Troubleshooting Tips -->
            <Expander
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,0,0,20"
                Header="{x:Static resources:Resource.CompatibilityCheckErrorWindow_TroubleshootingTitle}"
                IsExpanded="False">
                <StackPanel Margin="12,8,0,0">
                    <TextBlock
                        Margin="0,0,0,8"
                        TextWrapping="Wrap">
                        <Run Text="•" FontWeight="Medium" /><Run Text=" " />
                        <Run Text="{x:Static resources:Resource.CompatibilityCheckErrorWindow_Tip1}" />
                    </TextBlock>
                    <TextBlock
                        Margin="0,0,0,8"
                        TextWrapping="Wrap">
                        <Run Text="•" FontWeight="Medium" /><Run Text=" " />
                        <Run Text="{x:Static resources:Resource.CompatibilityCheckErrorWindow_Tip2}" />
                    </TextBlock>
                    <TextBlock
                        Margin="0,0,0,8"
                        TextWrapping="Wrap">
                        <Run Text="•" FontWeight="Medium" /><Run Text=" " />
                        <Run Text="{x:Static resources:Resource.CompatibilityCheckErrorWindow_Tip3}" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="•" FontWeight="Medium" /><Run Text=" " />
                        <Run Text="{x:Static resources:Resource.CompatibilityCheckErrorWindow_Tip4}" />
                    </TextBlock>
                </StackPanel>
            </Expander>

            <!-- Action Buttons -->
            <Grid
                Grid.Row="3"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,0,0,0"
                HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button
                    x:Name="_openLogButton"
                    Grid.Column="0"
                    MinWidth="140"
                    Appearance="Secondary"
                    Click="OpenLogButton_Click"
                    Content="{x:Static resources:Resource.CompatibilityCheckErrorWindow_OpenLog}" />
                <ui:Button
                    Grid.Column="2"
                    MinWidth="120"
                    Appearance="Primary"
                    Click="CloseButton_Click"
                    Content="{x:Static resources:Resource.Close}" />
            </Grid>
        </Grid>
    </Grid>

</local:BaseWindow>
