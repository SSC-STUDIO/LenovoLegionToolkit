<local:BaseWindow
    x:Class="UniversalDeviceToolkit.Avalonia.Windows.Utils.LanguageSelectorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UniversalDeviceToolkit.Avalonia.Windows"
    xmlns:resources="using:UniversalDeviceToolkit.Avalonia.Resources"
    xmlns:utils="using:UniversalDeviceToolkit.Avalonia.Utils"
    xmlns:ui="using:UniversalDeviceToolkit.Avalonia.Controls"
    xmlns:custom="using:UniversalDeviceToolkit.Avalonia.Controls.Custom"
    Title="{x:Static utils:AppDisplayName.Value}"
    Width="450"
    Height="300"
    MinWidth="450"
    MinHeight="300"
    MaxWidth="520"
    MaxHeight="320"
    Closed="LanguageSelectorWindow_OnClosed"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    CanResize="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <custom:TitleBar
            Title="{x:Static utils:AppDisplayName.Value}"
            Grid.Row="0"
            CanMaximize="false"
            ShowMaximize="false"
            ShowMinimize="false" />

        <Grid Grid.Row="1" Margin="20,18,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,18,0"
                VerticalAlignment="Top">
                <ui:SymbolIcon FontSize="{StaticResource IconSizeHero}" Symbol="LocalLanguage24" />
            </StackPanel>

            <ScrollViewer
                Grid.Row="0"
                Grid.Column="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <TextBlock
                        Margin="0,0,0,12"
                        Focusable="True"
                        FontWeight="Medium"
                        Text="{x:Static resources:Resource.LanguageSelectorWindow_SelectLanguage}"
                        TextWrapping="Wrap" />

                    <ComboBox x:Name="_languageComboBox" />

                    <TextBlock
                        x:Name="_statusText"
                        Margin="0,12,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        IsVisible="False" />

                    <Grid
                        x:Name="_installProgressPanel"
                        Margin="0,8,0,0"
                        IsVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar
                            x:Name="_installProgressBar"
                            Grid.Column="0"
                            Height="6"
                            IsIndeterminate="True"
                            Maximum="1"
                            Minimum="0" />
                        <TextBlock
                            x:Name="_installPercentText"
                            Grid.Column="1"
                            MinWidth="40"
                            Margin="12,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <Grid
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,20,0,0"
                HorizontalAlignment="Right">

                <ui:Button
                    x:Name="_okButton"
                    MinWidth="120"
                    Appearance="Primary"
                    Click="OK_Click"
                    Content="{x:Static resources:Resource.Continue}" />

                <StackPanel
                    x:Name="_failureActionsPanel"
                    Orientation="Horizontal"
                    IsVisible="False">
                    <ui:Button
                        x:Name="_retryButton"
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Appearance="Primary"
                        Click="Retry_Click"
                        Content="{x:Static resources:Resource.LanguageSelector_RetryButton}" />
                    <ui:Button
                        x:Name="_continueEnglishButton"
                        MinWidth="140"
                        Margin="0,0,8,0"
                        Click="ContinueEnglish_Click"
                        Content="{x:Static resources:Resource.LanguageSelector_ContinueInEnglishButton}" />
                    <ui:Button
                        x:Name="_exitButton"
                        MinWidth="88"
                        Click="Exit_Click"
                        Content="{x:Static resources:Resource.Exit}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>

</local:BaseWindow>
