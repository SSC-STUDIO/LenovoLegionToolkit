<local:BaseWindow
    x:Class="UniversalDeviceToolkit.Avalonia.Windows.Utils.ActionDetailsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:UniversalDeviceToolkit.Avalonia.Controls"
    xmlns:custom="using:UniversalDeviceToolkit.Avalonia.Controls.Custom"
    xmlns:resources="using:UniversalDeviceToolkit.Avalonia.Resources"
    xmlns:local="using:UniversalDeviceToolkit.Avalonia.Windows"
    Title="{x:Static resources:Resource.ActionDetailsWindow_Title}"
    Height="600"
    Width="800"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <custom:TitleBar
            AutomationProperties.AutomationId="ActionDetailsWindowTitleBar"
            Grid.Row="0"
            CanMaximize="false"
            ShowMaximize="false"
            Title="{x:Static resources:Resource.ActionDetailsWindow_Title}" />

        <ScrollViewer Grid.Row="1" Margin="20,12,20,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Action title -->
                <TextBlock
                    x:Name="_titleTextBlock"
                    FontSize="{DynamicResource FontSizeMidHeader}"
                    FontWeight="Medium"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,8"
                    TextWrapping="Wrap" />

                <!-- Action description -->
                <TextBlock
                    x:Name="_descriptionTextBlock"
                    FontSize="{DynamicResource FontSizeCaption}"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,20"
                    TextWrapping="Wrap" />

                <!-- Technical implementation details -->
                <custom:CardControl Margin="0,0,0,16">
                    <custom:CardControl.Header>
                        <TextBlock
                            FontSize="{DynamicResource FontSizePageDescription}"
                            FontWeight="Medium"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{x:Static resources:Resource.ActionDetailsWindow_TechnicalDetails}" />
                    </custom:CardControl.Header>
                    <StackPanel Margin="0,12,0,0">
                        <!-- Implementation type -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                FontWeight="Medium"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{x:Static resources:Resource.ActionDetailsWindow_ImplementationType}" />
                            <TextBlock
                                x:Name="_implementationTypeTextBlock"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </Grid>

                        <!-- Detailed information -->
                        <Border
                            x:Name="_detailsBorder"
                            Padding="12"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusCompact}">
                            <ScrollViewer
                                MaxHeight="300"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="_detailsStackPanel" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </custom:CardControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Close button -->
        <Grid Grid.Row="2" Margin="20" HorizontalAlignment="Right">
            <ui:Button
                AutomationProperties.AutomationId="ActionDetailsWindowCloseButton"
                Content="{x:Static resources:Resource.ActionDetailsWindow_Close_Button}"
                Appearance="Primary"
                Click="CloseButton_Click"
                MinWidth="100" />
        </Grid>
    </Grid>
</local:BaseWindow>
