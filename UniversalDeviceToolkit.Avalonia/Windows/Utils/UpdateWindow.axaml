<local:BaseWindow
    x:Class="UniversalDeviceToolkit.Avalonia.Windows.Utils.UpdateWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UniversalDeviceToolkit.Avalonia.Windows"
    xmlns:resources="using:UniversalDeviceToolkit.Avalonia.Resources"
    xmlns:utils="using:UniversalDeviceToolkit.Avalonia.Utils"
    xmlns:ui="using:UniversalDeviceToolkit.Avalonia.Controls"
    xmlns:custom="using:UniversalDeviceToolkit.Avalonia.Controls.Custom"
    Title="{x:Static resources:Resource.UpdateWindow_Title}"
    MinWidth="720"
    MinHeight="520"
    MaxWidth="720"
    MaxHeight="560"
    Closing="UpdateWindow_Closing"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    Loaded="UpdateWindow_Loaded"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.Resources>
            <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <utils:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <custom:TitleBar
            Grid.Row="0"
            CanMaximize="false"
            ShowMaximize="false"
            ShowMinimize="false" />

        <Grid
            Grid.Row="0"
            Height="24"
            Margin="12,8,12,8">
            <TextBlock
                VerticalAlignment="Center"
                Focusable="True"
                IsHitTestVisible="False"
                Classes="appCaptionTextBlock"
                Text="{x:Static resources:Resource.UpdateWindow_Title}" />
        </Grid>

        <Grid Grid.Row="1" Margin="24,8,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: icon + title hierarchy + version chip -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="48"
                    Height="48"
                    Margin="0,0,16,0"
                    VerticalAlignment="Top"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusControl}">
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource IconSizeLG}"
                        Foreground="{DynamicResource StatusInfoBrush}"
                        Symbol="ArrowCircleUp24" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        Focusable="True"
                        Classes="appSectionTitleTextBlock"
                        Text="{x:Static resources:Resource.UpdateWindow_WhatsNew}" />

                    <TextBlock
                        Margin="0,4,0,0"
                        Focusable="True"
                        Classes="appPageDescriptionTextBlock"
                        Text="{x:Static resources:Resource.UpdateWindow_Title}" />

                    <WrapPanel Margin="0,10,0,0">
                        <Border
                            x:Name="_versionBadge"
                            Margin="0,0,8,0"
                            Padding="10,4"
                            Background="{DynamicResource StatusInfoBackgroundBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusControl}"
                            IsVisible="False">
                            <TextBlock
                                x:Name="_versionBadgeText"
                                Classes="appHeroBadgeTextBlock"
                                Foreground="{DynamicResource StatusInfoBrush}"
                                VerticalAlignment="Center" />
                        </Border>

                        <Border
                            x:Name="_releaseDateBadge"
                            Padding="10,4"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusControl}"
                            IsVisible="False">
                            <TextBlock
                                x:Name="_releaseDateText"
                                FontSize="{DynamicResource FontSizeCaption}"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Grid>

            <!-- Release notes card -->
            <Border
                Grid.Row="1"
                Padding="16,14"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusCard}">
                <!-- AVALONIA: Markdig.Wpf MarkdownViewer is not available; the markdown is
                     parsed with the Markdig core library in UpdateWindow code-behind and
                     rendered into _markdownContainer (headings/lists/code/quotes). -->
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="_markdownContainer" />
                </ScrollViewer>
            </Border>

            <!-- Progress + horizontal action bar -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <ProgressBar
                    x:Name="_downloadProgressBar"
                    Height="4"
                    Margin="0,0,0,12"
                    IsIndeterminate="True"
                    Maximum="1"
                    Minimum="0"
                    IsVisible="{Binding IsDownloading, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Grid HorizontalAlignment="Right">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:Button
                        x:Name="_cancelDownloadButton"
                        Grid.Column="0"
                        MinWidth="{StaticResource ButtonMinWidthStandard}"
                        Height="{StaticResource ButtonHeightStandard}"
                        Appearance="Secondary"
                        AutomationProperties.Name="{x:Static resources:Resource.Cancel}"
                        Click="CancelDownloadButton_Click"
                        Content="{x:Static resources:Resource.Cancel}" />

                    <ui:Button
                        x:Name="_downloadButton"
                        Grid.Column="2"
                        MinWidth="{StaticResource ButtonMinWidthStandard}"
                        Height="{StaticResource ButtonHeightStandard}"
                        Appearance="Primary"
                        AutomationProperties.Name="{x:Static resources:Resource.Update}"
                        Click="DownloadButton_Click"
                        Content="{x:Static resources:Resource.Update}"
                        IsEnabled="{Binding HasUpdates, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</local:BaseWindow>
