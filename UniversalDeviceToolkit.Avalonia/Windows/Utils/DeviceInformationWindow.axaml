<local:BaseWindow
    x:Class="UniversalDeviceToolkit.Avalonia.Windows.Utils.DeviceInformationWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:UniversalDeviceToolkit.Avalonia.Controls"
    xmlns:custom="using:UniversalDeviceToolkit.Avalonia.Controls.Custom"
    xmlns:local="using:UniversalDeviceToolkit.Avalonia.Windows"
    xmlns:localUtils="using:UniversalDeviceToolkit.Avalonia.Windows.Utils"
    xmlns:resources="using:UniversalDeviceToolkit.Avalonia.Resources"
    xmlns:utils="using:UniversalDeviceToolkit.Avalonia.Utils"
    Title="{x:Static resources:Resource.DeviceInformationWindow_Title}"
    Width="600"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    Loaded="DeviceInformationWindow_Loaded"
    CanResize="False"
    CanMinimize="True"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.Resources>
            <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <Style x:Key="DeviceInfoLabelTextStyle" Selector="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="DeviceInfoValueTextStyle" Selector="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.Styles>
            <Style Selector="Border.deviceInfoRow">
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style Selector="Border.deviceInfoRow:pointerover">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Style>
        </Grid.Styles>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <custom:TitleBar
            Grid.Row="0"
            Title="{x:Static resources:Resource.DeviceInformationWindow_Title}"
            CanMaximize="false"
            ShowMaximize="false"
            ShowMinimize="false" />

        <custom:DynamicScrollViewer
            x:Name="_contentScrollViewer"
            Grid.Row="1"
            Margin="0,4,0,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,8,16,16">

                <!-- Title lives only in TitleBar; content starts with the info card. -->
                <custom:CardControl Margin="0,0,0,12" Padding="0">
                    <custom:CardControl.Header>
                        <StackPanel>
                        <Border Classes="deviceInfoRow" PointerReleased="DeviceInfoRow_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.75*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Classes="deviceInfoLabelText" Text="{x:Static resources:Resource.DeviceInformationWindow_Manufacturer_Title}" />
                                <TextBlock x:Name="_manufacturerLabel" Grid.Column="1" Classes="deviceInfoValueText" />
                            </Grid>
                        </Border>
                        <Border Classes="deviceInfoRow" PointerReleased="DeviceInfoRow_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.75*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Classes="deviceInfoLabelText" Text="{x:Static resources:Resource.DeviceInformationWindow_Model_Title}" />
                                <TextBlock x:Name="_modelLabel" Grid.Column="1" Classes="deviceInfoValueText" />
                            </Grid>
                        </Border>
                        <Border Classes="deviceInfoRow" PointerReleased="DeviceInfoRow_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.75*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Classes="deviceInfoLabelText" Text="{x:Static resources:Resource.DeviceInformationWindow_MachineType_Title}" />
                                <TextBlock x:Name="_mtmLabel" Grid.Column="1" Classes="deviceInfoValueText" />
                            </Grid>
                        </Border>
                        <Border Classes="deviceInfoRow" PointerReleased="DeviceInfoRow_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.75*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Classes="deviceInfoLabelText" Text="{x:Static resources:Resource.DeviceInformationWindow_SerialNumber_Title}" />
                                <TextBlock x:Name="_serialNumberLabel" Grid.Column="1" Classes="deviceInfoValueText" />
                            </Grid>
                        </Border>
                        <Border Classes="deviceInfoRow" BorderThickness="0" PointerReleased="DeviceInfoRow_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.75*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Classes="deviceInfoLabelText" Text="{x:Static resources:Resource.DeviceInformationWindow_BiosVersion_Title}" />
                                <TextBlock x:Name="_biosLabel" Grid.Column="1" Classes="deviceInfoValueText" />
                            </Grid>
                        </Border>
                        </StackPanel>
                    </custom:CardControl.Header>
                </custom:CardControl>

                <StackPanel
                    x:Name="_hardwareInfo"
                    IsVisible="{Binding HasHardwareInfo, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=localUtils:DeviceInformationWindow}}">
                    <TextBlock
                        Margin="0,4,0,10"
                        Focusable="True"
                        Classes="appSectionTitleTextBlock"
                        Text="{x:Static resources:Resource.DeviceInformationWindow_Hardware_Title}" />

                    <custom:CardControl Margin="0,0,0,12" Padding="0">
                        <custom:CardControl.Header>
                            <StackPanel>
                            <Border
                                x:Name="_cpuRow"
                                Classes="deviceInfoRow"
                                PointerReleased="DeviceInfoRow_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.75*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Classes="deviceInfoLabelText" Text="{x:Static resources:Resource.FanCurveControl_CPU}" />
                                    <TextBlock x:Name="_cpuLabel" Grid.Column="1" Classes="deviceInfoValueText" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <Border
                                x:Name="_gpuRow"
                                Classes="deviceInfoRow"
                                PointerReleased="DeviceInfoRow_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.75*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Classes="deviceInfoLabelText" Text="{x:Static resources:Resource.FanCurveControl_GPU}" />
                                    <TextBlock x:Name="_gpuLabel" Grid.Column="1" Classes="deviceInfoValueText" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <Border
                                x:Name="_memoryRow"
                                Classes="deviceInfoRow"
                                PointerReleased="DeviceInfoRow_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.75*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Classes="deviceInfoLabelText" Text="{x:Static resources:Resource.DeviceInformationWindow_Memory_Title}" />
                                    <TextBlock x:Name="_memoryLabel" Grid.Column="1" Classes="deviceInfoValueText" />
                                </Grid>
                            </Border>
                            <Border
                                x:Name="_baseBoardRow"
                                Classes="deviceInfoRow"
                                PointerReleased="DeviceInfoRow_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.75*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Classes="deviceInfoLabelText" Text="{x:Static resources:Resource.DeviceInformationWindow_BaseBoard_Title}" />
                                    <TextBlock x:Name="_baseBoardLabel" Grid.Column="1" Classes="deviceInfoValueText" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <Border
                                x:Name="_chassisRow"
                                Classes="deviceInfoRow"
                                BorderThickness="0"
                                PointerReleased="DeviceInfoRow_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.75*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Classes="deviceInfoLabelText" Text="{x:Static resources:Resource.DeviceInformationWindow_Chassis_Title}" />
                                    <TextBlock x:Name="_chassisLabel" Grid.Column="1" Classes="deviceInfoValueText" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            </StackPanel>
                        </custom:CardControl.Header>
                    </custom:CardControl>
                </StackPanel>

                <StackPanel
                    x:Name="_warrantyInfo"
                    IsVisible="{Binding HasWarrantyInfo, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=localUtils:DeviceInformationWindow}}">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Focusable="True"
                            Classes="appSectionTitleTextBlock"
                            Text="{x:Static resources:Resource.DeviceInformationWindow_Warranty_Title}" />
                        <ui:Button
                            x:Name="_refreshWarrantyButton"
                            Grid.Column="1"
                            AutomationProperties.Name="{x:Static resources:Resource.DeviceInformationWindow_Refresh}"
                            Click="RefreshWarrantyButton_OnClick"
                            Icon="ArrowClockwise32"
                            ToolTip.Tip="{x:Static resources:Resource.DeviceInformationWindow_Refresh}" />
                    </Grid>

                    <custom:CardControl Margin="0,0,0,8" Padding="0">
                        <custom:CardControl.Header>
                            <StackPanel>
                            <Border Classes="deviceInfoRow" PointerReleased="DeviceInfoRow_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.75*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Classes="deviceInfoLabelText" Text="{x:Static resources:Resource.DeviceInformationWindow_WarrantyStartDate_Title}" />
                                    <TextBlock x:Name="_warrantyStartLabel" Grid.Column="1" Classes="deviceInfoValueText" Text="-" />
                                </Grid>
                            </Border>
                            <Border Classes="deviceInfoRow" BorderThickness="0" PointerReleased="DeviceInfoRow_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.75*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Classes="deviceInfoLabelText" Text="{x:Static resources:Resource.DeviceInformationWindow_WarrantyEndDate_Title}" />
                                    <TextBlock x:Name="_warrantyEndLabel" Grid.Column="1" Classes="deviceInfoValueText" Text="-" />
                                </Grid>
                            </Border>
                            </StackPanel>
                        </custom:CardControl.Header>
                    </custom:CardControl>

                    <!-- CardControl-matching radius (CardAction has no CornerRadius DP in WPF-UI 4.x). -->
                    <Border
                        x:Name="_warrantyLinkCardAction"
                        Margin="0,0,0,8"
                        Padding="16,14"
                        AutomationProperties.AutomationId="DeviceInformationWarrantyLinkCard"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Cursor="Hand"
                        Classes="deviceInfoRow"
                        PointerReleased="WarrantyLinkCardAction_OnClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource IconSizeCardGlyph}"
                                Symbol="Open24" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Static resources:Resource.DeviceInformationWindow_LenovoSupport}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>

        </custom:DynamicScrollViewer>

        <custom:SnackbarPresenter
            x:Name="_snackBarPresenter"
            Grid.Row="1"
            HorizontalAlignment="Center" />
    </Grid>
</local:BaseWindow>
