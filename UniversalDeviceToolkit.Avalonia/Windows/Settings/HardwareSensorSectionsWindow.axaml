<local:BaseWindow
    x:Class="UniversalDeviceToolkit.Avalonia.Windows.Settings.HardwareSensorSectionsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="using:UniversalDeviceToolkit.Avalonia.Controls.Custom"
    xmlns:local="using:UniversalDeviceToolkit.Avalonia.Windows"
    xmlns:resources="using:UniversalDeviceToolkit.Avalonia.Resources"
    xmlns:ui="using:UniversalDeviceToolkit.Avalonia.Controls"
    xmlns:utils="using:UniversalDeviceToolkit.Avalonia.Utils"
    Title="{x:Static resources:Resource.HardwareSensorSectionsWindow_Title}"
    Width="420"
    Height="420"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    CanResize="False"
    WindowStartupLocation="CenterOwner">
    <local:BaseWindow.Resources>
        <ControlTheme x:Key="SensorSectionListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource CornerRadiusControl}"
                        Padding="12,8">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>

                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </local:BaseWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <custom:TitleBar
            Title="{x:Static resources:Resource.HardwareSensorSectionsWindow_Title}"
            CanMaximize="False"
            ShowMaximize="False"
            ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" Margin="20,8,20,8">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,12"
                    FontWeight="Medium"
                    Text="{x:Static resources:Resource.SensorSections_Visible_Title}" />
                <StackPanel x:Name="_visibilityPanel" />

                <TextBlock
                    Margin="0,16,0,8"
                    FontWeight="Medium"
                    Text="{x:Static resources:Resource.SensorSections_Order_Title}" />
                <StackPanel x:Name="_orderHost" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <ui:Button
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Click="MoveUp_Click"
                        Content="{x:Static resources:Resource.SensorSections_MoveUp}" />
                    <ui:Button
                        MinWidth="88"
                        Click="MoveDown_Click"
                        Content="{x:Static resources:Resource.SensorSections_MoveDown}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Margin="20,0,20,20"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                MinWidth="100"
                Margin="0,0,8,0"
                Click="Cancel_Click"
                Content="{x:Static resources:Resource.Cancel}" />
            <ui:Button
                MinWidth="100"
                Appearance="Primary"
                Click="Save_Click"
                Content="{x:Static resources:Resource.SaveButton}" />
        </StackPanel>
    </Grid>
</local:BaseWindow>
