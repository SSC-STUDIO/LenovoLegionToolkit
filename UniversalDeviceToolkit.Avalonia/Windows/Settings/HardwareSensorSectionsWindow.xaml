<local:BaseWindow
    x:Class="UniversalDeviceToolkit.WPF.Windows.Settings.HardwareSensorSectionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:UniversalDeviceToolkit.WPF.Windows"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:UniversalDeviceToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.HardwareSensorSectionsWindow_Title}"
    Width="420"
    Height="420"
    ExtendsContentIntoTitleBar="True"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <local:BaseWindow.Resources>
        <Style x:Key="SensorSectionListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerRadiusControl}"
                            Padding="12,8"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:BaseWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <wpfui:TitleBar
            Title="{x:Static resources:Resource.HardwareSensorSectionsWindow_Title}"
            CanMaximize="False"
            ShowMaximize="False"
            ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" Margin="20,8,20,8">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,12"
                    FontWeight="Medium"
                    Text="{x:Static resources:Resource.SensorSections_Visible_Title}" />
                <StackPanel x:Name="_visibilityPanel" />

                <TextBlock
                    Margin="0,16,0,8"
                    FontWeight="Medium"
                    Text="{x:Static resources:Resource.SensorSections_Order_Title}" />
                <StackPanel x:Name="_orderHost" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <wpfui:Button
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Click="MoveUp_Click"
                        Content="{x:Static resources:Resource.SensorSections_MoveUp}" />
                    <wpfui:Button
                        MinWidth="88"
                        Click="MoveDown_Click"
                        Content="{x:Static resources:Resource.SensorSections_MoveDown}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Margin="20,0,20,20"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <wpfui:Button
                MinWidth="100"
                Margin="0,0,8,0"
                Click="Cancel_Click"
                Content="{x:Static resources:Resource.Cancel}" />
            <wpfui:Button
                MinWidth="100"
                Appearance="Primary"
                Click="Save_Click"
                Content="{x:Static resources:Resource.SaveButton}" />
        </StackPanel>
    </Grid>
</local:BaseWindow>
