<local:BaseWindow
    x:Class="UniversalDeviceToolkit.Avalonia.Windows.Dashboard.EditDashboardWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:UniversalDeviceToolkit.Avalonia.Controls"
    xmlns:custom="using:UniversalDeviceToolkit.Avalonia.Controls.Custom"
    xmlns:local="using:UniversalDeviceToolkit.Avalonia.Windows"
    xmlns:resources="using:UniversalDeviceToolkit.Avalonia.Resources"
    xmlns:utils="using:UniversalDeviceToolkit.Avalonia.Utils"
    xmlns:ui="using:UniversalDeviceToolkit.Avalonia.Controls"
    Title="{x:Static resources:Resource.EditDashboardWindow_Title}"
    Width="700"
    Height="700"
    MinWidth="600"
    MinHeight="400"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    CanResize="False"
    CanMinimize="True"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <custom:TitleBar
            Grid.Row="0"
            CanMaximize="false"
            ShowMaximize="false"
            ShowMinimize="false" />

        <Grid
            Grid.Row="0"
            Height="24"
            Margin="12,8,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Classes="appCaptionTextBlock"
                IsHitTestVisible="False"
                Text="{x:Static resources:Resource.EditDashboardWindow_Title}" />
        </Grid>

        <custom:InfoBar
            x:Name="_infoBar"
            Title="{x:Static resources:Resource.EditDashboardWindow_Disclaimer_Message}"
            Grid.Row="1"
            Margin="12,0,16,16"
            IsClosable="False"
            IsOpen="True"
            Severity="Informational" />

        <controls:LoadableControl
            x:Name="_loader"
            Grid.Row="2"
            Margin="12,0,0,0"
            IndicatorVerticalAlignment="Center">
            <custom:DynamicScrollViewer x:Name="_groupsScrollViewer">
                <StackPanel>
                    <custom:CardControl Margin="0,0,16,16">
                        <Grid MinHeight="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:CardHeaderControl
                                Grid.Column="0"
                                Margin="0,0,16,0"
                                Title="{x:Static resources:Resource.EditDashboardWindow_Sensors}" />
                            <ui:ToggleSwitch
                                x:Name="_sensorsSwitch"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Static resources:Resource.EditDashboardWindow_Sensors}" />
                        </Grid>
                    </custom:CardControl>
                    <StackPanel x:Name="_groupsStackPanel" Margin="0,0,16,0" />
                </StackPanel>
            </custom:DynamicScrollViewer>
        </controls:LoadableControl>

        <Grid
            x:Name="_applyRevertStackPanel"
            Grid.Row="3"
            Margin="12"
            IsVisible="False">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button
                Grid.Column="0"
                MinWidth="120"
                Appearance="Secondary"
                Click="AddButton_Click"
                Content="{x:Static resources:Resource.Add}" />
            <ui:Button
                Grid.Column="1"
                MinWidth="120"
                Margin="12,0,0,0"
                Appearance="Secondary"
                Click="DefaultButton_Click"
                Content="{x:Static resources:Resource.Default}" />
            <ui:Button
                Grid.Column="3"
                MinWidth="120"
                Margin="12,0,0,0"
                Appearance="Primary"
                Click="ApplyButton_Click"
                Content="{x:Static resources:Resource.Apply}" />
            <ui:Button
                Grid.Column="4"
                MinWidth="120"
                Margin="12,0,0,0"
                Appearance="Secondary"
                Click="CancelButton_Click"
                Content="{x:Static resources:Resource.Cancel}" />
        </Grid>

    </Grid>
</local:BaseWindow>
