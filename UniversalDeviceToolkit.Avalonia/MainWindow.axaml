<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:UniversalDeviceToolkit.Avalonia.Localization"
        xmlns:controls="using:UniversalDeviceToolkit.Avalonia.Controls"
        xmlns:automation="using:Avalonia.Automation"
        x:Class="UniversalDeviceToolkit.Avalonia.MainWindow"
        Title="{local:Loc Key=Window_Title, Fallback=Universal Device Toolkit}"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600">
    <Window.Styles>
        <Style Selector="Button.navButton">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusCompact}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="ContentTemplate">
                <DataTemplate>
                    <controls:LocalizedTextBlock Text="{Binding}"
                                                 OverflowMode="Ellipsis"
                                                 MaxLines="1"
                                                 HorizontalAlignment="Stretch"
                                                 MinWidth="0" />
                </DataTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.navButton.active">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </Window.Styles>
    <DockPanel>
        <Border DockPanel.Dock="Left" Width="280" Background="{DynamicResource NavigationPaneBackgroundBrush}">
            <StackPanel Spacing="8" Margin="16">
                <TextBlock Text="{local:Loc Key=Navigation, Fallback=Navigation}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="14"
                           Margin="0,8,0,16"/>
                <Button x:Name="DashboardButton"
                        automation:AutomationProperties.AutomationId="AvaloniaDashboardButton"
                        automation:AutomationProperties.Name="{local:Loc Key=Nav_Dashboard, Fallback=Dashboard}"
                        Classes="navButton"
                        Content="{local:Loc Key=Nav_Dashboard, Fallback=Dashboard}"
                        Click="DashboardButton_Click"/>
                <Button x:Name="AboutButton"
                        automation:AutomationProperties.AutomationId="AvaloniaAboutButton"
                        automation:AutomationProperties.Name="{local:Loc Key=Nav_About, Fallback=About}"
                        Classes="navButton"
                        Content="{local:Loc Key=Nav_About, Fallback=About}"
                        Click="AboutButton_Click"
                        Margin="0,4,0,0"/>
                <Button x:Name="SettingsButton"
                        automation:AutomationProperties.AutomationId="AvaloniaSettingsButton"
                        automation:AutomationProperties.Name="{local:Loc Key=Nav_Settings, Fallback=Settings}"
                        Classes="navButton"
                        Content="{local:Loc Key=Nav_Settings, Fallback=Settings}"
                        Click="SettingsButton_Click"
                        Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <Border Background="{DynamicResource AppSurfaceCardBrush}">
            <ContentControl x:Name="MainContent"
                            automation:AutomationProperties.AutomationId="AvaloniaMainContent" />
        </Border>
    </DockPanel>
</Window>
