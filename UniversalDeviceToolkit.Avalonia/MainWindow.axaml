<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:UniversalDeviceToolkit.Avalonia.Localization"
        xmlns:controls="using:UniversalDeviceToolkit.Avalonia.Controls"
        xmlns:automation="using:Avalonia.Automation"
        x:Class="UniversalDeviceToolkit.Avalonia.MainWindow"
        Title="{local:Loc Key=Window_Title, Fallback=Universal Device Toolkit}"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600">
    <Window.Styles>
        <Style Selector="Button.navButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusCompact}" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="Button.navButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Button.navButton.active">
            <Setter Property="Background" Value="{DynamicResource AccentBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <!-- TextBlock does not reliably inherit a Button's foreground through
             Avalonia's content presenter. Keep the navigation rail readable in
             both theme variants, including dynamically-created plugin entries. -->
        <Style Selector="Button.navButton controls|LocalizedTextBlock">
            <Setter Property="Foreground" Value="{DynamicResource UdtTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.navButton controls|NavigationIcon">
            <Setter Property="Foreground" Value="{DynamicResource UdtTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.navToggleButton">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <!-- Update indicator pill shown only when a newer release is available. -->
        <Style Selector="Button.updatePill">
            <Setter Property="Background" Value="{DynamicResource StatusInfoBrush}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusCompact}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.updatePill controls|LocalizedTextBlock">
            <Setter Property="Foreground" Value="{DynamicResource UdtTextPrimaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Button.updatePill:pointerover">
            <Setter Property="Opacity" Value="0.88" />
        </Style>
    </Window.Styles>
    <DockPanel Background="{DynamicResource AppBackgroundBrush}">
        <Border x:Name="NavigationPane"
                DockPanel.Dock="Left"
                automation:AutomationProperties.AutomationId="AvaloniaNavigationPane"
                Width="280"
                Margin="12,12,0,12"
                Background="{DynamicResource NavigationPaneBackgroundBrush}"
                CornerRadius="{DynamicResource CornerRadiusSurface}">
            <StackPanel x:Name="NavigationStack" Spacing="6" Margin="16,18">
                <Button x:Name="NavigationToggleButton"
                        automation:AutomationProperties.AutomationId="AvaloniaNavigationPaneToggle"
                        Classes="navButton navToggleButton"
                        Click="NavigationToggleButton_Click"
                        ToolTip.Tip="{local:Loc Key=SettingsPage_NavigationItems_Title, Fallback=Toggle navigation pane}">
                    <controls:NavigationIcon x:Name="NavigationToggleIcon"
                                             IconIdentifier="ArrowLeft24"
                                             FontSize="{StaticResource IconSizeMD}" />
                </Button>
                <TextBlock x:Name="NavigationHeader"
                           Text="{local:Loc Key=Navigation, Fallback=Navigation}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Margin="12,4,0,14"/>
                <Button x:Name="DeviceInfoButton"
                        automation:AutomationProperties.AutomationId="AvaloniaDeviceInfoButton"
                        automation:AutomationProperties.Name="{local:Loc Key=DeviceInformationWindow_Device_Title, Fallback=Device information}"
                        Classes="navButton"
                        Tag="Laptop24"
                        Click="DeviceInfoButton_Click"
                        Margin="0,0,0,4">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <controls:NavigationIcon IconIdentifier="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 FontSize="{StaticResource IconSizeMD}" />
                        <controls:LocalizedTextBlock x:Name="DeviceInfoLabel"
                                                     Grid.Column="1"
                                                     Text="{local:Loc Key=DeviceInformationWindow_Device_Title, Fallback=Device information}"
                                                     OverflowMode="Ellipsis"
                                                     MaxLines="1"
                                                     MinWidth="0" />
                    </Grid>
                </Button>
                <Button x:Name="DashboardButton"
                        automation:AutomationProperties.AutomationId="AvaloniaDashboardButton"
                        automation:AutomationProperties.Name="{local:Loc Key=Nav_Dashboard, Fallback=Dashboard}"
                        Classes="navButton"
                        Tag="Home24"
                        Click="DashboardButton_Click">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <controls:NavigationIcon IconIdentifier="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 FontSize="{StaticResource IconSizeMD}"
                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <controls:LocalizedTextBlock x:Name="DashboardLabel" Grid.Column="1"
                                                     Text="{local:Loc Key=Nav_Dashboard, Fallback=Dashboard}"
                                                     OverflowMode="Ellipsis"
                                                     MaxLines="1"
                                                     HorizontalAlignment="Stretch"
                                                     MinWidth="0" />
                    </Grid>
                </Button>
                <Button x:Name="KeyboardButton"
                        automation:AutomationProperties.AutomationId="AvaloniaKeyboardButton"
                        automation:AutomationProperties.Name="{local:Loc Key=MainWindow_NavigationItem_Keyboard, Fallback=Keyboard}"
                        Classes="navButton"
                        Tag="Keyboard24"
                        Click="KeyboardButton_Click"
                        Margin="0,4,0,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <controls:NavigationIcon IconIdentifier="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 FontSize="{StaticResource IconSizeMD}" />
                        <controls:LocalizedTextBlock x:Name="KeyboardLabel" Grid.Column="1"
                                                     Text="{local:Loc Key=MainWindow_NavigationItem_Keyboard, Fallback=Keyboard}"
                                                     OverflowMode="Ellipsis" MaxLines="1" MinWidth="0" />
                    </Grid>
                </Button>
                <Button x:Name="ActionsButton"
                        automation:AutomationProperties.AutomationId="AvaloniaActionsButton"
                        automation:AutomationProperties.Name="{local:Loc Key=MainWindow_NavigationItem_Actions, Fallback=Actions}"
                        Classes="navButton"
                        Tag="Rocket24"
                        Click="ActionsButton_Click"
                        Margin="0,4,0,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <controls:NavigationIcon IconIdentifier="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 FontSize="{StaticResource IconSizeMD}" />
                        <controls:LocalizedTextBlock x:Name="ActionsLabel" Grid.Column="1"
                                                     Text="{local:Loc Key=MainWindow_NavigationItem_Actions, Fallback=Actions}"
                                                     OverflowMode="Ellipsis" MaxLines="1" MinWidth="0" />
                    </Grid>
                </Button>
                <Button x:Name="MacroButton"
                        automation:AutomationProperties.AutomationId="AvaloniaMacroButton"
                        automation:AutomationProperties.Name="{local:Loc Key=MainWindow_NavigationItem_Macro, Fallback=Macro}"
                        Classes="navButton"
                        Tag="ReceiptPlay24"
                        Click="MacroButton_Click"
                        Margin="0,4,0,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <controls:NavigationIcon IconIdentifier="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 FontSize="{StaticResource IconSizeMD}" />
                        <controls:LocalizedTextBlock x:Name="MacroLabel" Grid.Column="1"
                                                     Text="{local:Loc Key=MainWindow_NavigationItem_Macro, Fallback=Macro}"
                                                     OverflowMode="Ellipsis" MaxLines="1" MinWidth="0" />
                    </Grid>
                </Button>
                <Button x:Name="WindowsOptimizationButton"
                        automation:AutomationProperties.AutomationId="AvaloniaWindowsOptimizationButton"
                        automation:AutomationProperties.Name="{local:Loc Key=MainWindow_NavigationItem_WindowsOptimization, Fallback=System optimization}"
                        Classes="navButton"
                        Tag="Gauge24"
                        Click="WindowsOptimizationButton_Click"
                        Margin="0,4,0,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <controls:NavigationIcon IconIdentifier="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 FontSize="{StaticResource IconSizeMD}" />
                        <controls:LocalizedTextBlock x:Name="WindowsOptimizationLabel" Grid.Column="1"
                                                     Text="{local:Loc Key=MainWindow_NavigationItem_WindowsOptimization, Fallback=System optimization}"
                                                     OverflowMode="Ellipsis" MaxLines="1" MinWidth="0" />
                    </Grid>
                </Button>
                <Button x:Name="PluginExtensionsButton"
                        automation:AutomationProperties.AutomationId="AvaloniaPluginExtensionsButton"
                        automation:AutomationProperties.Name="{local:Loc Key=MainWindow_NavigationItem_PluginExtensions, Fallback=Plugin Extensions}"
                        Classes="navButton"
                        Tag="Apps24"
                        Click="PluginExtensionsButton_Click"
                        Margin="0,4,0,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <controls:NavigationIcon IconIdentifier="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 FontSize="{StaticResource IconSizeMD}" />
                        <controls:LocalizedTextBlock x:Name="PluginExtensionsLabel" Grid.Column="1"
                                                     Text="{local:Loc Key=MainWindow_NavigationItem_PluginExtensions, Fallback=Plugin Extensions}"
                                                     OverflowMode="Ellipsis" MaxLines="1" MinWidth="0" />
                    </Grid>
                </Button>
                <StackPanel x:Name="PluginNavigationItems"
                            Spacing="6"
                            Margin="0,2,0,0" />
                <Button x:Name="AboutButton"
                        automation:AutomationProperties.AutomationId="AvaloniaAboutButton"
                        automation:AutomationProperties.Name="{local:Loc Key=Nav_About, Fallback=About}"
                        Classes="navButton"
                        Tag="Info24"
                        Click="AboutButton_Click"
                        Margin="0,4,0,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <controls:NavigationIcon IconIdentifier="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 FontSize="{StaticResource IconSizeMD}"
                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <controls:LocalizedTextBlock x:Name="AboutLabel" Grid.Column="1"
                                                     Text="{local:Loc Key=Nav_About, Fallback=About}"
                                                     OverflowMode="Ellipsis"
                                                     MaxLines="1"
                                                     HorizontalAlignment="Stretch"
                                                     MinWidth="0" />
                    </Grid>
                </Button>
                <Button x:Name="SettingsButton"
                        automation:AutomationProperties.AutomationId="AvaloniaSettingsButton"
                        automation:AutomationProperties.Name="{local:Loc Key=Nav_Settings, Fallback=Settings}"
                        Classes="navButton"
                        Tag="Settings24"
                        Click="SettingsButton_Click"
                        Margin="0,4,0,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <controls:NavigationIcon IconIdentifier="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 FontSize="{StaticResource IconSizeMD}"
                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <controls:LocalizedTextBlock x:Name="SettingsLabel" Grid.Column="1"
                                                     Text="{local:Loc Key=Nav_Settings, Fallback=Settings}"
                                                     OverflowMode="Ellipsis"
                                                     MaxLines="1"
                                                     HorizontalAlignment="Stretch"
                                                     MinWidth="0" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
        <Border Margin="12"
                Background="{DynamicResource AppSurfaceCardBrush}"
                CornerRadius="{DynamicResource CornerRadiusSurface}"
                ClipToBounds="True">
            <Grid>
                <!-- Scale host managed by AvaloniaThemeManager for the persisted UI scale. -->
                <LayoutTransformControl x:Name="ContentScaleTransform"
                                        automation:AutomationProperties.AutomationId="AvaloniaContentScaleHost">
                    <ContentControl x:Name="MainContent"
                                    automation:AutomationProperties.AutomationId="AvaloniaMainContent" />
                </LayoutTransformControl>
                <Button x:Name="UpdateAvailableButton"
                        automation:AutomationProperties.AutomationId="AvaloniaUpdateAvailableButton"
                        automation:AutomationProperties.Name="{local:Loc Key=MainWindow_UpdateAvailable, Fallback=Update available}"
                        Classes="updatePill"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,20,20,0"
                        IsVisible="False"
                        Click="UpdateAvailableButton_Click">
                    <controls:LocalizedTextBlock x:Name="UpdateAvailableLabel"
                                                 Text="{local:Loc Key=MainWindow_UpdateAvailable, Fallback=Update available}" />
                </Button>
            </Grid>
        </Border>
    </DockPanel>
</Window>
