<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(UDTTargetFramework)</TargetFramework>
    <!-- ABI retention: RootNamespace/AssemblyName stay UniversalDeviceToolkit.Lib.Plugins (plugin host surface).
         Do NOT rename to UniversalDeviceToolkit.Lib.Plugins without Docs/NamespaceMigration.md Phase 2–3. -->
    <RootNamespace>UniversalDeviceToolkit.Lib.Plugins</RootNamespace>
    <AssemblyName>UniversalDeviceToolkit.Lib.Plugins</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Match Lib/WPF win-x64 graph (avoids MSB3270 MSIL vs AMD64). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Autofac" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="IAppStartupPlugin.cs" />
    <Compile Remove="IOptimizationCategoryProvider.cs" />
    <Compile Remove="IPlugin.cs" />
    <Compile Remove="IPluginConfiguration.cs" />
    <Compile Remove="IPluginHostContext.cs" />
    <Compile Remove="IPluginPage.cs" />
    <Compile Remove="PluginBase.cs" />
    <Compile Remove="PluginConfiguration.cs" />
    <Compile Remove="PluginHostContext.cs" />
    <Compile Remove="PluginHostMode.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UniversalDeviceToolkit.Lib\UniversalDeviceToolkit.Lib.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Resources\Resource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resource.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\Resource.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
