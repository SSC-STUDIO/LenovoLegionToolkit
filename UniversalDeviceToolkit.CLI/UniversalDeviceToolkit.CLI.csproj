<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>$(UDTTargetFramework)</TargetFramework>
        <RootNamespace>UniversalDeviceToolkit.CLI</RootNamespace>
        <Copyright>$(ProjectCopyright)</Copyright>
        <IsUdtShippingApp>true</IsUdtShippingApp>
        <AssemblyName>udt-cli</AssemblyName>
        <NeutralLanguage>en</NeutralLanguage>
        <SatelliteResourceLanguages>$(UdtSatelliteResourceLanguages)</SatelliteResourceLanguages>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)'=='Debug'">
        <DebugType>portable</DebugType>
    </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UniversalDeviceToolkit.Lib.Abstractions\UniversalDeviceToolkit.Lib.Abstractions.csproj" />
      <PackageReference Include="System.CommandLine" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\UniversalDeviceToolkit.CLI.Lib\UniversalDeviceToolkit.CLI.Lib.csproj" />
    </ItemGroup>
</Project>
