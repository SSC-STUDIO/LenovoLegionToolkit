<Project>
  <Target Name="RejectShippingAppPublishWithTestHooks" BeforeTargets="PrepareForPublish">
    <Error
      Condition="'$(IsUdtShippingApp)' == 'true' and '$(EnableUdtTestHooks)' == 'true' and '$(AllowUdtTestHookPublish)' != 'true'"
      Text="Shipping app publish cannot use EnableUdtTestHooks=true. Build the standalone test tools instead, or set AllowUdtTestHookPublish=true only for isolated non-shipping artifacts." />
  </Target>
</Project>
