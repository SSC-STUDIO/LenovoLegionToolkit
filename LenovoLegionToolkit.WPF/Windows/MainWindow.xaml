<local:BaseWindow
    x:Class="LenovoLegionToolkit.WPF.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="clr-namespace:LenovoLegionToolkit.WPF.Controls.Custom"
    xmlns:local="clr-namespace:LenovoLegionToolkit.WPF.Windows"
    xmlns:pages="clr-namespace:LenovoLegionToolkit.WPF.Pages"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.AppName}"
    Width="1300"
    Height="850"
    MinWidth="500"
    MinHeight="400"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <wpfui:TitleBar Grid.Row="0" Height="48" />

        <Grid
            Grid.Row="0"
            Height="30"
            Margin="12,0,150,0"
            VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="_title"
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FlowDirection="LeftToRight"
                Focusable="False"
                FontSize="12"
                IsHitTestVisible="False"
                Text="{x:Static resources:Resource.AppName}" />

            <custom:Badge
                x:Name="_openLogIndicator"
                Grid.Column="1"
                Height="26"
                Margin="0,0,8,0"
                Padding="8,2,8,2"
                Appearance="Caution"
                Content="Log"
                Cursor="Hand"
                Focusable="True"
                VerticalAlignment="Center"
                KeyDown="OpenLogIndicator_KeyDown"
                MouseLeftButtonDown="OpenLogIndicator_Click"
                MouseRightButtonDown="OpenLogIndicator_Click"
                Visibility="Collapsed" />

            <custom:Badge
                x:Name="_deviceInfoIndicator"
                Grid.Column="2"
                Height="26"
                Padding="8,2,8,2"
                Appearance="Transparent"
                Cursor="Hand"
                Focusable="True"
                VerticalAlignment="Center"
                KeyDown="DeviceInfoIndicator_KeyDown"
                MouseLeftButtonDown="DeviceInfoIndicator_Click"
                MouseRightButtonDown="DeviceInfoIndicator_Click"
                Visibility="Collapsed" />

        </Grid>

        <Grid
            x:Name="_contentGrid"
            Grid.Row="1"
            Margin="0">
            <Grid>
                <wpfui:NavigationView
                    x:Name="_navigationView"
                    AutomationProperties.AutomationId="MainNavigationView"
                    Margin="0,0,0,12"
                    CompactPaneLength="96"
                    FrameMargin="10,0,0,0"
                    IsBackButtonVisible="Collapsed"
                    IsPaneOpen="False"
                    IsPaneToggleVisible="False"
                    OpenPaneLength="96"
                    PaneDisplayMode="LeftFluent">
                    <wpfui:NavigationView.MenuItems>
                    <custom:NavigationItem
                        x:Name="_dashboardItem"
                        AutomationProperties.AccessKey="D"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_Dashboard}"
                        Symbol="Home24"
                        TargetPageTag="dashboard"
                        TargetPageType="{x:Type pages:DashboardPage}"
                        ToolTip="{x:Static resources:Resource.MainWindow_NavigationItem_Dashboard}" />
                    <custom:NavigationItem
                        x:Name="_keyboardItem"
                        AutomationProperties.AccessKey="K"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_Keyboard}"
                        Symbol="Keyboard24"
                        TargetPageTag="keyboardBacklight"
                        TargetPageType="{x:Type pages:KeyboardBacklightPage}"
                        ToolTip="{x:Static resources:Resource.MainWindow_NavigationItem_Keyboard}" />
                    <custom:NavigationItem
                        x:Name="_automationItem"
                        AutomationProperties.AccessKey="A"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_Actions}"
                        Symbol="Rocket24"
                        TargetPageTag="automation"
                        TargetPageType="{x:Type pages:AutomationPage}"
                        ToolTip="{x:Static resources:Resource.MainWindow_NavigationItem_Actions}" />
                    <custom:NavigationItem
                        x:Name="_macroItem"
                        AutomationProperties.AccessKey="M"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_Macro}"
                        Symbol="ReceiptPlay24"
                        TargetPageTag="macro"
                        TargetPageType="{x:Type pages:MacroPage}"
                        ToolTip="{x:Static resources:Resource.MainWindow_NavigationItem_Macro}" />
                    <custom:NavigationItem
                        x:Name="_windowsOptimizationItem"
                        AutomationProperties.AccessKey="W"
                        AutomationProperties.AutomationId="WindowsOptimizationNavItem"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_WindowsOptimization}"
                        Symbol="Gauge24"
                        TargetPageTag="windowsOptimization"
                        TargetPageType="{x:Type pages:WindowsOptimizationPage}"
                        ToolTip="{x:Static resources:Resource.MainWindow_NavigationItem_WindowsOptimization}" />
                    </wpfui:NavigationView.MenuItems>

                    <wpfui:NavigationView.FooterMenuItems>
                    <custom:NavigationItem
                        x:Name="_pluginExtensionsItem"
                        AutomationProperties.AccessKey="P"
                        AutomationProperties.AutomationId="PluginExtensionsNavItem"
                        Content="Plugin Extensions"
                        Symbol="Apps24"
                        TargetPageTag="pluginExtensions"
                        TargetPageType="{x:Type pages:PluginExtensionsPage}"
                        ToolTip="Plugin Extensions" />

                    <custom:NavigationItem
                        AutomationProperties.AccessKey="S"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_Settings}"
                        Symbol="Settings24"
                        TargetPageTag="settings"
                        TargetPageType="{x:Type pages:SettingsPage}"
                        ToolTip="{x:Static resources:Resource.MainWindow_NavigationItem_Settings}" />
                    <custom:NavigationItem
                        x:Name="_aboutItem"
                        AutomationProperties.AccessKey="B"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_About}"
                        Symbol="Info24"
                        TargetPageTag="about"
                        TargetPageType="{x:Type pages:AboutPage}"
                        ToolTip="{x:Static resources:Resource.MainWindow_NavigationItem_About}" />
                    </wpfui:NavigationView.FooterMenuItems>

                </wpfui:NavigationView>

            <Grid
                x:Name="_snackbarHost"
                Margin="0,0,0,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Panel.ZIndex="100">
                <wpfui:SnackbarPresenter x:Name="_snackbarPresenter" />
            </Grid>

            </Grid>

        </Grid>

        <Border
            x:Name="_vantageIndicator"
            Grid.Row="2"
            Padding="8,4,8,6"
            Background="Orange"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <wpfui:SymbolIcon
                    Margin="0,0,4,0"
                    Foreground="Black"
                    Symbol="Warning24" />
                <TextBlock
                    Focusable="True"
                    Foreground="Black"
                    Text="{x:Static resources:Resource.MainWindows_VantageRunning}" />
            </StackPanel>
        </Border>

        <Border
            x:Name="_legionZoneIndicator"
            Grid.Row="3"
            Padding="8,4,8,6"
            Background="Orange"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <wpfui:SymbolIcon
                    Margin="0,0,4,0"
                    Foreground="Black"
                    Symbol="Warning24" />
                <TextBlock
                    Focusable="True"
                    Foreground="Black"
                    Text="{x:Static resources:Resource.MainWindow_LegionZoneRunning}" />
            </StackPanel>
        </Border>

        <Border
            x:Name="_fnKeysIndicator"
            Grid.Row="4"
            Padding="8,4,8,6"
            Background="Orange"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <wpfui:SymbolIcon
                    Margin="0,0,4,0"
                    Foreground="Black"
                    Symbol="Warning24" />
                <TextBlock
                    Focusable="True"
                    Foreground="Black"
                    Text="{x:Static resources:Resource.MainWindows_FnKeysRunning}" />
            </StackPanel>
        </Border>

        <Border
            x:Name="_updateIndicator"
            Grid.Row="5"
            Padding="8,4,8,6"
            Background="{DynamicResource SystemFillColorSuccessBrush}"
            Cursor="Hand"
            ToolTip="{x:Static resources:Resource.MainWindow_UpdateAvailable}"
            MouseLeftButtonDown="UpdateIndicator_Click"
            MouseRightButtonDown="UpdateIndicator_Click"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <wpfui:SymbolIcon Margin="0,0,4,0" Symbol="ArrowSync24" />
                <TextBlock
                    x:Name="_updateIndicatorText"
                    Focusable="True"
                    KeyDown="UpdateIndicator_KeyDown"
                    Text="{x:Static resources:Resource.MainWindow_UpdateAvailable}" />
            </StackPanel>
        </Border>

    </Grid>
</local:BaseWindow>
