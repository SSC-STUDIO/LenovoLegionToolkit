<local:BaseWindow
    x:Class="LenovoLegionToolkit.WPF.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="clr-namespace:LenovoLegionToolkit.WPF.Controls.Custom"
    xmlns:local="clr-namespace:LenovoLegionToolkit.WPF.Windows"
    xmlns:pages="clr-namespace:LenovoLegionToolkit.WPF.Pages"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.AppName}"
    Width="1300"
    Height="850"
    MinWidth="1000"
    MinHeight="650"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}">

    <local:BaseWindow.Resources>
        <Style
            x:Key="TitleBarDeviceInfoButtonStyle"
            BasedOn="{StaticResource {x:Type wpfui:Button}}"
            TargetType="{x:Type wpfui:Button}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </local:BaseWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <wpfui:TitleBar Grid.Row="0" Height="38">
            <wpfui:TitleBar.Header>
                <TextBlock
                    x:Name="_title"
                    MaxWidth="760"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FlowDirection="LeftToRight"
                    Focusable="False"
                    FontSize="12"
                    IsHitTestVisible="False"
                    Text="{x:Static resources:Resource.AppName}"
                    TextTrimming="CharacterEllipsis" />
            </wpfui:TitleBar.Header>

            <wpfui:TitleBar.TrailingContent>
                <StackPanel
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <wpfui:Button
                        x:Name="_openLogIndicator"
                        Height="26"
                        Margin="0,0,8,0"
                        Padding="8,2,8,2"
                        Appearance="Caution"
                        AutomationProperties.AutomationId="OpenLogIndicator"
                        Content="Log"
                        Cursor="Hand"
                        Focusable="True"
                        VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OpenLogIndicator_Click"
                        KeyDown="OpenLogIndicator_KeyDown"
                        PreviewMouseLeftButtonUp="OpenLogIndicator_PreviewMouseLeftButtonUp"
                        Visibility="Collapsed" />

                    <wpfui:Button
                        x:Name="_deviceInfoIndicator"
                        Height="26"
                        MaxWidth="260"
                        Padding="8,2,8,2"
                        AutomationProperties.AutomationId="DeviceInfoIndicator"
                        Cursor="Hand"
                        Focusable="True"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Style="{StaticResource TitleBarDeviceInfoButtonStyle}"
                        VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="DeviceInfoIndicator_Click"
                        KeyDown="DeviceInfoIndicator_KeyDown"
                        PreviewMouseLeftButtonUp="DeviceInfoIndicator_PreviewMouseLeftButtonUp"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="_deviceInfoIndicatorText"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </wpfui:Button>
                </StackPanel>
            </wpfui:TitleBar.TrailingContent>
        </wpfui:TitleBar>

        <Grid
            x:Name="_contentGrid"
            Grid.Row="1"
            Margin="12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <custom:NavigationStore
                x:Name="_navigationStore"
                AutomationProperties.AutomationId="MainNavigationStore"
                Grid.Column="0"
                Margin="0,0,12,12"
                Frame="{Binding ElementName=_rootFrame}"
                SelectedPageIndex="0">

                <custom:NavigationStore.Items>
                    <custom:NavigationItem
                        x:Name="_dashboardItem"
                        AutomationProperties.AccessKey="D"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_Dashboard}"
                        Icon="Home24"
                        PageTag="dashboard"
                        PageType="{x:Type pages:DashboardPage}"
                        ToolTip="{x:Static resources:Resource.MainWindow_NavigationItem_Dashboard}" />
                    <custom:NavigationItem
                        x:Name="_keyboardItem"
                        AutomationProperties.AccessKey="K"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_Keyboard}"
                        Icon="Keyboard24"
                        PageTag="keyboardBacklight"
                        PageType="{x:Type pages:KeyboardBacklightPage}"
                        ToolTip="{x:Static resources:Resource.MainWindow_NavigationItem_Keyboard}" />
                    <custom:NavigationItem
                        x:Name="_automationItem"
                        AutomationProperties.AccessKey="A"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_Actions}"
                        Icon="Rocket24"
                        PageTag="automation"
                        PageType="{x:Type pages:AutomationPage}"
                        ToolTip="{x:Static resources:Resource.MainWindow_NavigationItem_Actions}" />
                    <custom:NavigationItem
                        x:Name="_macroItem"
                        AutomationProperties.AccessKey="M"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_Macro}"
                        Icon="ReceiptPlay24"
                        PageTag="macro"
                        PageType="{x:Type pages:MacroPage}"
                        ToolTip="{x:Static resources:Resource.MainWindow_NavigationItem_Macro}" />
                    <custom:NavigationItem
                        x:Name="_windowsOptimizationItem"
                        AutomationProperties.AccessKey="W"
                        AutomationProperties.AutomationId="WindowsOptimizationNavItem"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_WindowsOptimization}"
                        Icon="Gauge24"
                        PageTag="windowsOptimization"
                        PageType="{x:Type pages:WindowsOptimizationPage}"
                        ToolTip="{x:Static resources:Resource.MainWindow_NavigationItem_WindowsOptimization}" />
                </custom:NavigationStore.Items>

                <custom:NavigationStore.Footer>
                    <custom:NavigationItem
                        x:Name="_pluginExtensionsItem"
                        AutomationProperties.AccessKey="P"
                        AutomationProperties.AutomationId="PluginExtensionsNavItem"
                        Content="Plugin Extensions"
                        Icon="Apps24"
                        PageTag="pluginExtensions"
                        PageType="{x:Type pages:PluginExtensionsPage}"
                        ToolTip="Plugin Extensions" />

                    <custom:NavigationItem
                        AutomationProperties.AccessKey="S"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_Settings}"
                        Icon="Settings24"
                        PageTag="settings"
                        PageType="{x:Type pages:SettingsPage}"
                        ToolTip="{x:Static resources:Resource.MainWindow_NavigationItem_Settings}" />
                    <custom:NavigationItem
                        x:Name="_aboutItem"
                        AutomationProperties.AccessKey="B"
                        Content="{x:Static resources:Resource.MainWindow_NavigationItem_About}"
                        Icon="Info24"
                        PageTag="about"
                        PageType="{x:Type pages:AboutPage}"
                        ToolTip="{x:Static resources:Resource.MainWindow_NavigationItem_About}" />
                </custom:NavigationStore.Footer>

            </custom:NavigationStore>

            <Border
                Grid.Column="1"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="8,0,0,0">
                <Frame Name="_rootFrame"
                       AutomationProperties.AutomationId="MainRootFrame"
                       Margin="24,0,0,0" />
            </Border>

            <wpfui:SnackbarPresenter
                x:Name="_snackbarPresenter"
                Grid.Column="1"
                HorizontalAlignment="Center" />

        </Grid>

        <Border
            x:Name="_vantageIndicator"
            Grid.Row="2"
            Padding="8,4,8,6"
            Background="Orange"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <wpfui:SymbolIcon
                    Margin="0,0,4,0"
                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                    Symbol="Warning24" />
                <TextBlock
                    Focusable="True"
                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                    Text="{x:Static resources:Resource.MainWindows_VantageRunning}" />
            </StackPanel>
        </Border>

        <Border
            x:Name="_legionZoneIndicator"
            Grid.Row="3"
            Padding="8,4,8,6"
            Background="Orange"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <wpfui:SymbolIcon
                    Margin="0,0,4,0"
                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                    Symbol="Warning24" />
                <TextBlock
                    Focusable="True"
                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                    Text="{x:Static resources:Resource.MainWindow_LegionZoneRunning}" />
            </StackPanel>
        </Border>

        <Border
            x:Name="_fnKeysIndicator"
            Grid.Row="4"
            Padding="8,4,8,6"
            Background="Orange"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <wpfui:SymbolIcon
                    Margin="0,0,4,0"
                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                    Symbol="Warning24" />
                <TextBlock
                    Focusable="True"
                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                    Text="{x:Static resources:Resource.MainWindows_FnKeysRunning}" />
            </StackPanel>
        </Border>

        <Border
            x:Name="_updateIndicator"
            Grid.Row="5"
            Padding="8,4,8,6"
            Background="{DynamicResource SystemFillColorSuccessBrush}"
            Cursor="Hand"
            ToolTip="{x:Static resources:Resource.MainWindow_UpdateAvailable}"
            MouseLeftButtonDown="UpdateIndicator_Click"
            MouseRightButtonDown="UpdateIndicator_Click"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <wpfui:SymbolIcon Margin="0,0,4,0" Symbol="ArrowSync24" />
                <TextBlock
                    x:Name="_updateIndicatorText"
                    Focusable="True"
                    KeyDown="UpdateIndicator_KeyDown"
                    Text="{x:Static resources:Resource.MainWindow_UpdateAvailable}" />
            </StackPanel>
        </Border>

    </Grid>
</local:BaseWindow>
