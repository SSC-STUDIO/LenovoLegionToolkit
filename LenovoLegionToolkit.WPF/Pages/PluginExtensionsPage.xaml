                    Text="{x:Static resources:Resource.PluginExtensionsPage_EmptyStoreMessage}"
                    FontSize="14"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Margin="0,8,0,0" />
