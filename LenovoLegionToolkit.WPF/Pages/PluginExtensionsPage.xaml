                Grid.ColumnSpan="3"
                Visibility="Collapsed"
                ClipToBounds="True"
                Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" MinWidth="300" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" MinWidth="420" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Width="138"
                            Height="12"
                            Margin="2,0,0,10"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SkeletonShimmerBlockStyle}" />

                    <Border Height="72" Margin="0,0,0,4" Padding="10" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="8" Style="{StaticResource SkeletonShimmerBlockStyle}" />
                            <StackPanel Grid.Column="1" Margin="12,4,0,0">
                                <Border Width="160" Height="14" HorizontalAlignment="Left" Style="{StaticResource SkeletonShimmerBlockStyle}" />
                                <Border Width="96" Height="10" Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource SkeletonShimmerBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Height="72" Margin="0,0,0,4" Padding="10" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="8" Style="{StaticResource SkeletonShimmerBlockStyle}" />
                            <StackPanel Grid.Column="1" Margin="12,4,0,0">
                                <Border Width="190" Height="14" HorizontalAlignment="Left" Style="{StaticResource SkeletonShimmerBlockStyle}" />
                                <Border Width="118" Height="10" Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource SkeletonShimmerBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Height="72" Margin="0,0,0,4" Padding="10" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="8" Style="{StaticResource SkeletonShimmerBlockStyle}" />
                            <StackPanel Grid.Column="1" Margin="12,4,0,0">
                                <Border Width="142" Height="14" HorizontalAlignment="Left" Style="{StaticResource SkeletonShimmerBlockStyle}" />
                                <Border Width="104" Height="10" Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource SkeletonShimmerBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Height="72" Margin="0,0,0,4" Padding="10" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="8" Style="{StaticResource SkeletonShimmerBlockStyle}" />
                            <StackPanel Grid.Column="1" Margin="12,4,0,0">
                                <Border Width="174" Height="14" HorizontalAlignment="Left" Style="{StaticResource SkeletonShimmerBlockStyle}" />
                                <Border Width="86" Height="10" Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource SkeletonShimmerBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Grid.Column="2"
                        Padding="18"
                        CornerRadius="8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="56" Height="56" CornerRadius="8" Style="{StaticResource SkeletonShimmerBlockStyle}" />
                            <StackPanel Grid.Column="1" Margin="14,2,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="220" Height="20" HorizontalAlignment="Left" Style="{StaticResource SkeletonShimmerBlockStyle}" />
                                    <Border Grid.Column="1" Width="92" Height="24" HorizontalAlignment="Right" Style="{StaticResource SkeletonShimmerBlockStyle}" />
                                </Grid>
                                <WrapPanel Margin="0,14,0,0">
                                    <Border Width="64" Height="22" Margin="0,0,8,8" Style="{StaticResource SkeletonShimmerBlockStyle}" />
                                    <Border Width="126" Height="22" Margin="0,0,8,8" Style="{StaticResource SkeletonShimmerBlockStyle}" />
                                    <Border Width="104" Height="22" Margin="0,0,8,8" Style="{StaticResource SkeletonShimmerBlockStyle}" />
