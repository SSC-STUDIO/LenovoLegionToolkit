<Page
    x:Class="LenovoLegionToolkit.WPF.Pages.PluginExtensionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="PluginExtensionsPageRoot"
    AutomationProperties.AutomationId="PluginExtensionsPageRoot"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <utils:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <utils:BooleanAndConverter x:Key="BooleanAndConverter" />
        <utils:TextToVisibilityConverter x:Key="TextToVisibilityConverter" />

        <Style x:Key="PluginListItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding PluginId, StringFormat=PluginCard_{0}}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PluginListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="PluginIconStyle" TargetType="Border">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="InlineMetricStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,22,0" />
        </Style>

        <Style x:Key="MetadataBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="SkeletonShimmerBlockStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="DetailActionButtonStyle" TargetType="wpfui:Button" BasedOn="{StaticResource AppButtonCompact}">
            <Setter Property="MinWidth" Value="108" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="DetailPrimaryActionButtonStyle" TargetType="wpfui:Button" BasedOn="{StaticResource DetailActionButtonStyle}">
            <Setter Property="Appearance" Value="Primary" />
            <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="DetailSecondaryActionButtonStyle" TargetType="wpfui:Button" BasedOn="{StaticResource DetailActionButtonStyle}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
        </Style>

        <Style x:Key="DetailDangerActionButtonStyle" TargetType="wpfui:Button" BasedOn="{StaticResource DetailActionButtonStyle}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
    </Page.Resources>

    <wpfui:DynamicScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,16,12" Style="{StaticResource AppPageEntranceAnimationStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,16,0,14">
            <TextBlock
                x:Name="_titleTextBlock"
                Focusable="True"
                Style="{StaticResource AppPageTitleTextBlockStyle}"
                Text="{x:Static resources:Resource.PluginExtensionsPage_Title}" />
            <TextBlock
                x:Name="_descriptionTextBlock"
                Margin="0,8,0,0"
                Focusable="True"
                Style="{StaticResource AppPageDescriptionTextBlockStyle}"
                Text="{x:Static resources:Resource.PluginExtensionsPage_Description}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="12,8"
                CornerRadius="8"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <DockPanel LastChildFill="True">
                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <StackPanel Style="{StaticResource InlineMetricStyle}">
                        <wpfui:SymbolIcon Symbol="Apps24" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{x:Static resources:Resource.PluginExtensionsPage_SummaryTotal}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="_summaryTotalTextBlock" Margin="6,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="0" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource InlineMetricStyle}">
                        <wpfui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{x:Static resources:Resource.PluginExtensionsPage_SummaryInstalled}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="_summaryInstalledTextBlock" Margin="6,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="0" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource InlineMetricStyle}">
                        <wpfui:SymbolIcon Symbol="ArrowCircleUp24" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{x:Static resources:Resource.PluginExtensionsPage_SummaryUpdatesReady}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="_summaryUpdatesTextBlock" Margin="6,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="0" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource InlineMetricStyle}">
                        <wpfui:SymbolIcon Symbol="Pulse24" FontSize="15" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{x:Static resources:Resource.PluginExtensionsPage_SummaryStorePulse}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="_summaryStorePulseValueTextBlock" Margin="6,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="0" />
                    </StackPanel>
                </WrapPanel>

                <TextBlock x:Name="_summaryHintTextBlock"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{x:Static resources:Resource.PluginExtensionsPage_SummaryCheckingAvailability}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <wpfui:TextBox
                x:Name="_searchTextBox"
                AutomationProperties.AutomationId="PluginSearchTextBox"
                Grid.Column="0"
                Height="36"
                PlaceholderText="{x:Static resources:Resource.PluginExtensionsPage_SearchPlaceholder}"
                TextChanged="SearchTextBox_TextChanged"
                ClearButtonEnabled="True"
                Margin="0,0,12,0">
                <wpfui:TextBox.Icon>
                    <wpfui:SymbolIcon Symbol="Search24" />
                </wpfui:TextBox.Icon>
            </wpfui:TextBox>

            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                <ComboBox
                    x:Name="_filterComboBox"
                    AutomationProperties.AutomationId="PluginFilterComboBox"
                    MinWidth="142"
                    Height="36"
                    SelectionChanged="FilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="{x:Static resources:Resource.PluginExtensionsPage_FilterAll}" Tag="All" IsSelected="True" />
                    <ComboBoxItem Content="{x:Static resources:Resource.PluginExtensionsPage_FilterInstalled}" Tag="Installed" />
                    <ComboBoxItem Content="{x:Static resources:Resource.PluginExtensionsPage_FilterNotInstalled}" Tag="NotInstalled" />
                </ComboBox>

                <wpfui:Button
                    x:Name="_bulkImportButton"
                    AutomationProperties.AutomationId="PluginBulkImportButton"
                    Appearance="Secondary"
                    Margin="8,0,0,0"
                    Height="36"
                    Click="BulkImportButton_Click"
                    ToolTip="{x:Static resources:Resource.PluginExtensionsPage_BulkImportTooltip}">
                    <wpfui:Button.Icon>
                        <wpfui:SymbolIcon Symbol="Open24" />
                    </wpfui:Button.Icon>
                </wpfui:Button>

                <wpfui:Button
                    x:Name="_refreshButton"
                    AutomationProperties.AutomationId="PluginRefreshButton"
                    Appearance="Secondary"
                    Margin="8,0,0,0"
                    Height="36"
                    Click="RefreshButton_Click"
                    ToolTip="{x:Static resources:Resource.PluginExtensionsPage_RefreshTooltip}">
                    <wpfui:Button.Icon>
                        <wpfui:SymbolIcon Symbol="ArrowClockwise24" />
                    </wpfui:Button.Icon>
                </wpfui:Button>

                <wpfui:Button
                    x:Name="_bulkUpdateButton"
                    AutomationProperties.AutomationId="PluginBulkUpdateButton"
                    Appearance="Primary"
                    Margin="8,0,0,0"
                    Height="36"
                    Click="BulkUpdateButton_Click"
                    Visibility="Collapsed"
                    ToolTip="{x:Static resources:Resource.PluginExtensionsPage_UpdateAllTooltip}"
                    Content="{x:Static resources:Resource.PluginExtensionsPage_UpdateAll}">
                    <wpfui:Button.Icon>
                        <wpfui:SymbolIcon Symbol="ArrowCircleUp24" />
                    </wpfui:Button.Icon>
                </wpfui:Button>

                <wpfui:Button
                    x:Name="_bulkInstallButton"
                    AutomationProperties.AutomationId="PluginBulkInstallButton"
                    Appearance="Primary"
                    Margin="8,0,0,0"
                    Height="36"
                    Click="BulkInstallButton_Click"
                    Visibility="Collapsed"
                    ToolTip=""
                    Content="">
                    <wpfui:Button.Icon>
                        <wpfui:SymbolIcon Symbol="Open24" />
                    </wpfui:Button.Icon>
                </wpfui:Button>
            </WrapPanel>
        </Grid>

        <wpfui:InfoBar
            x:Name="_deprecationNotice"
            Grid.Row="3"
            Margin="0,0,0,12"
            Severity="Warning"
            IsOpen="False"
            IsClosable="True"
            Title=""
            Message=""
            Visibility="Collapsed" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="300" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="_pluginListPanel"
                  Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="_resultsCountTextBlock"
                    AutomationProperties.AutomationId="PluginResultsCountText"
                    Grid.Row="0"
                    Margin="2,0,0,8"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Visibility="Collapsed" />

                <ListBox x:Name="_pluginsListBox"
                         Grid.Row="1"
                         AutomationProperties.AutomationId="PluginListBox"
                         Style="{StaticResource PluginListBoxStyle}"
                         Padding="0,0,0,24"
                         ClipToBounds="False"
                         SelectionMode="Single"
                         SelectionChanged="PluginsListBox_SelectionChanged"
                         MouseDoubleClick="PluginListBox_MouseDoubleClick"
                         ItemContainerStyle="{StaticResource PluginListItemContainerStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border MinHeight="72"
                                    Padding="10"
                                    Background="Transparent"
                                    AutomationProperties.AutomationId="{Binding PluginId, StringFormat=PluginCard_{0}}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{x:Static resources:Resource.PluginExtensionsPage_OpenFolder}" Click="ContextMenu_OpenFolder_Click" Tag="{Binding PluginId}">
                                            <MenuItem.Icon>
                                                <wpfui:SymbolIcon Symbol="FolderOpen24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{x:Static resources:Resource.PluginExtensionsPage_CopyId}" Click="ContextMenu_CopyId_Click" Tag="{Binding PluginId}">
                                            <MenuItem.Icon>
                                                <wpfui:SymbolIcon Symbol="Copy24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{x:Static resources:Resource.PluginExtensionsPage_Uninstall}" Click="PluginUninstallButton_Click" Tag="{Binding PluginId}" Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <MenuItem.Icon>
                                                <wpfui:SymbolIcon Symbol="Delete24" Foreground="Red" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource PluginIconStyle}"
                                            Background="{Binding IconBackground}">
                                        <Grid>
                                            <TextBlock Text="{Binding IconLetter}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource SystemAccentColorBrush}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Width="16"
                                                    Height="16"
                                                    CornerRadius="8"
                                                    Margin="0,0,-3,-3"
                                                    BorderBrush="{DynamicResource ControlFillColorDefaultBrush}"
                                                    BorderThickness="2"
                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <wpfui:SymbolIcon Symbol="Checkmark12"
                                                                  FontSize="9"
                                                                  Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Version}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="  "
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource SystemAccentColorBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Padding="8,3"
                                            CornerRadius="8"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            Visibility="{Binding IsLocal, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{x:Static resources:Resource.PluginExtensionsPage_LocalBadge}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border x:Name="_pluginDetailsPanel"
                    Grid.Column="2"
                    Padding="18"
                    CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    DataContext="{Binding ElementName=_pluginsListBox, Path=SelectedItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Visibility="{Binding PluginId, Converter={StaticResource TextToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="56"
                                    Height="56"
                                    Margin="0,0,14,0"
                                    CornerRadius="8"
                                    Background="{Binding IconBackground}">
                                <TextBlock Text="{Binding IconLetter}"
                                           FontSize="21"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource AppSectionTitleTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />

                                    <Border Grid.Column="1"
                                            Padding="9,4"
                                            CornerRadius="8"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemAccentColorBrush}" />
                                    </Border>
                                </Grid>

                                <WrapPanel Margin="0,10,0,0">
                                    <Border Style="{StaticResource MetadataBadgeStyle}">
                                        <TextBlock Text="{Binding Version}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource MetadataBadgeStyle}" Visibility="{Binding Author, Converter={StaticResource TextToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Author, StringFormat={x:Static resources:Resource.PluginExtensionsPage_AuthorFormat}}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource MetadataBadgeStyle}">
                                        <TextBlock Text="{Binding PluginId}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource MetadataBadgeStyle}" Visibility="{Binding Location, Converter={StaticResource TextToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Location}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource MetadataBadgeStyle}" Visibility="{Binding IsLocal, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{x:Static resources:Resource.PluginExtensionsPage_LocalBadge}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,16,0,8">
                            <wpfui:Button Content="{Binding InstallButtonText}"
                                          AutomationProperties.AutomationId="{Binding PluginId, StringFormat=PluginInstallButton_{0}}"
                                          Style="{StaticResource DetailPrimaryActionButtonStyle}"
                                          Click="PluginInstallButton_Click"
                                          Tag="{Binding PluginId}"
                                          ToolTip="{Binding InstallButtonText}"
                                          Visibility="{Binding ShouldShowInstallButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <wpfui:Button.Icon>
                                    <wpfui:SymbolIcon Symbol="ArrowDownload24" />
                                </wpfui:Button.Icon>
                            </wpfui:Button>

                            <wpfui:Button Content="{Binding ConfigureButtonText}"
                                          AutomationProperties.AutomationId="{Binding PluginId, StringFormat=PluginConfigureButton_{0}}"
                                          Style="{StaticResource DetailSecondaryActionButtonStyle}"
                                          ToolTip="{Binding ConfigureButtonText}">
                                <wpfui:Button.Icon>
                                    <wpfui:SymbolIcon Symbol="Settings24" />
                                </wpfui:Button.Icon>
                                <wpfui:Button.Visibility>
                                    <MultiBinding Converter="{StaticResource BooleanAndConverter}">
                                        <Binding Path="IsInstalled" />
                                        <Binding Path="SupportsConfiguration" />
                                    </MultiBinding>
                                </wpfui:Button.Visibility>
                                <wpfui:Button.Click>PluginConfigureButton_Click</wpfui:Button.Click>
                                <wpfui:Button.Tag>
                                    <Binding Path="PluginId" />
                                </wpfui:Button.Tag>
                            </wpfui:Button>

                            <wpfui:Button Content="{Binding OpenButtonText}"
                                          AutomationProperties.AutomationId="{Binding PluginId, StringFormat=PluginOpenButton_{0}}"
                                          Style="{StaticResource DetailSecondaryActionButtonStyle}"
                                          Click="PluginOpenButton_Click"
                                          Tag="{Binding PluginId}"
                                          ToolTip="{Binding OpenButtonText}">
                                <wpfui:Button.Icon>
                                    <wpfui:SymbolIcon Symbol="Open24" />
                                </wpfui:Button.Icon>
                                <wpfui:Button.Visibility>
                                    <MultiBinding Converter="{StaticResource BooleanAndConverter}">
                                        <Binding Path="IsInstalled" />
                                        <Binding Path="SupportsOpenAction" />
                                    </MultiBinding>
                                </wpfui:Button.Visibility>
                            </wpfui:Button>

                            <wpfui:Button Content="{Binding UninstallButtonText}"
                                          AutomationProperties.AutomationId="{Binding PluginId, StringFormat=PluginUninstallButton_{0}}"
                                          Style="{StaticResource DetailDangerActionButtonStyle}"
                                          Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          Click="PluginUninstallButton_Click"
                                          Tag="{Binding PluginId}"
                                          ToolTip="{Binding UninstallButtonText}">
                                <wpfui:Button.Icon>
                                    <wpfui:SymbolIcon Symbol="Delete24" />
                                </wpfui:Button.Icon>
                            </wpfui:Button>
                        </WrapPanel>

                        <TextBlock Text="{Binding Description}"
                                   Margin="0,18,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource AppBodyTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <Border Height="1"
                                Margin="0,18,0,16"
                                Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{x:Static resources:Resource.PluginExtensionsPage_CapabilitySettings}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding CapabilitySummary}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,12,0,0"
                                       Text="{x:Static resources:Resource.PluginExtensionsPage_VersionLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding HasUpdateDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Margin="0,12,0,0"
                                       Text="{Binding NewVersion}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Visibility="{Binding HasUpdateDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Margin="0,12,0,0"
                                       Text="{x:Static resources:Resource.PluginExtensionsPage_ChangelogLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding HasChangelog, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Margin="0,12,0,0"
                                       Text="{Binding Changelog}"
                                       TextWrapping="Wrap"
                                       MaxHeight="96"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Visibility="{Binding HasChangelog, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsInstalling, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding InstallStatusText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemAccentColorBrush}"
                                       Margin="0,0,0,6" />
                            <ProgressBar Value="{Binding InstallProgress}"
                                         Height="5"
                                         Maximum="100"
                                         Minimum="0" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid
