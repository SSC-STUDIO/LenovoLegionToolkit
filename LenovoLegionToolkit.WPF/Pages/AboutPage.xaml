<Page
    x:Class="LenovoLegionToolkit.WPF.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:root="clr-namespace:LenovoLegionToolkit.WPF"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.AboutPage_Title}"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel
        Margin="32,0,16,12"
        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <TextBlock
            Margin="0,16,0,24"
            Focusable="True"
            Style="{StaticResource AppPageTitleTextBlockStyle}"
            Text="{x:Static resources:Resource.AboutPage_Title}" />

        <TextBlock
            Padding="0,0,0,8"
            Focusable="True"
            Style="{StaticResource AppSubsectionTitleTextBlockStyle}"
            Text="{x:Static resources:Resource.AboutPage_AppName}" />
        <TextBlock
            x:Name="_version"
            Padding="0,0,0,8"
            Focusable="True"
            Text="{x:Static resources:Resource.AboutPage_Version}" />
        <TextBlock
            x:Name="_build"
            Padding="0,0,0,16"
            Focusable="True"
            Text="{x:Static resources:Resource.AboutPage_Build}" />

        <TextBlock x:Name="_copyright" Focusable="True" />
        <TextBlock
            x:Name="_translationCredit"
            Padding="0,8,0,0"
            Text="{x:Static resources:Resource.AboutPage_TranslationCredit}" />

        <TextBlock
            Padding="0,24,0,8"
            Focusable="True"
            Style="{StaticResource AppSubsectionTitleTextBlockStyle}"
            Text="{x:Static resources:Resource.AboutPage_Links}" />
        <wpfui:HyperlinkButton
            Content="{x:Static resources:Resource.AboutPage_ProjectWebsiteOnGitHub}"
            Icon="Link24"
            NavigateUri="{x:Static root:Constants.ProjectWebsiteUrl}" />
        <wpfui:HyperlinkButton
            Content="{x:Static resources:Resource.AboutPage_LatestReleaseOnGitHub}"
            Icon="Link24"
            NavigateUri="{x:Static root:Constants.LatestReleaseUrl}" />

        <TextBlock
            Padding="0,24,0,8"
            Focusable="True"
            Style="{StaticResource AppSubsectionTitleTextBlockStyle}"
            Text="{x:Static resources:Resource.AboutPage_ThirdPartyLibraries}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,32,0">
                <wpfui:HyperlinkButton Content="AsyncLock" NavigateUri="https://github.com/neosmart/AsyncLock" />
                <wpfui:HyperlinkButton Content="Autofac" NavigateUri="https://github.com/autofac/Autofac" />
                <wpfui:HyperlinkButton Content="Ben.Demystifier" NavigateUri="https://github.com/benaadams/Ben.Demystifier" />
                <wpfui:HyperlinkButton Content="ColorPicker" NavigateUri="https://github.com/PixiEditor/ColorPicker" />
                <wpfui:HyperlinkButton Content="CoordinateSharp" NavigateUri="https://github.com/Tronald/CoordinateSharp" />
                <wpfui:HyperlinkButton Content="CsWin32" NavigateUri="https://github.com/microsoft/CsWin32" />
                <wpfui:HyperlinkButton Content="Humanizer" NavigateUri="https://github.com/Humanizr/Humanizer" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,32,0">
                <wpfui:HyperlinkButton Content="ManagedNativeWifi" NavigateUri="https://github.com/emoacht/ManagedNativeWifi" />
                <wpfui:HyperlinkButton Content="Markdig" NavigateUri="https://github.com/xoofx/markdig" />
                <wpfui:HyperlinkButton Content="Markdig.Wpf" NavigateUri="https://github.com/Kryptos-FR/markdig.wpf" />
                <wpfui:HyperlinkButton Content="Microsoft.CSharp" NavigateUri="https://github.com/dotnet/runtime" />
                <wpfui:HyperlinkButton Content="NAudio.Wasapi" NavigateUri="https://github.com/naudio/NAudio" />
                <wpfui:HyperlinkButton Content="System.Text.Json" NavigateUri="https://learn.microsoft.com/dotnet/api/system.text.json" />
                <wpfui:HyperlinkButton Content="NvAPIWrapper.Net" NavigateUri="https://github.com/falahati/NvAPIWrapper" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <wpfui:HyperlinkButton Content="Octokit" NavigateUri="https://github.com/octokit/octokit.net" />
                <wpfui:HyperlinkButton Content="PubSub" NavigateUri="https://github.com/upta/pubsub" />
                <wpfui:HyperlinkButton Content="System.Management" NavigateUri="https://github.com/dotnet/runtime" />
                <wpfui:HyperlinkButton Content="TaskScheduler" NavigateUri="https://github.com/dahall/TaskScheduler" />
                <wpfui:HyperlinkButton Content="WindowsDisplayAPI" NavigateUri="https://github.com/falahati/WindowsDisplayAPI" />
                <wpfui:HyperlinkButton Content="WPF-UI" NavigateUri="https://github.com/lepoco/wpfui" />
            </StackPanel>

        </Grid>

        <TextBlock
            Padding="0,24,0,8"
            AutomationProperties.Name="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Text}"
            Focusable="True"
            Style="{StaticResource AppSubsectionTitleTextBlockStyle}"
            Text="{x:Static resources:Resource.AboutPage_ApplicationFolders}" />

        <wpfui:HyperlinkButton
            Click="OpenApplicationDataFolder_Click"
            Content="{x:Static resources:Resource.AboutPage_Data}"
            Icon="Folder24" />
        <wpfui:HyperlinkButton
            Click="OpenApplicationTempFolder_Click"
            Content="{x:Static resources:Resource.AboutPage_Temp}"
            Icon="Folder24" />

    </StackPanel>
    </ScrollViewer>
</Page>
