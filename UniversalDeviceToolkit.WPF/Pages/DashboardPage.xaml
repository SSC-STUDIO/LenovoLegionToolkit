<Page
    x:Class="UniversalDeviceToolkit.WPF.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:UniversalDeviceToolkit.WPF.Behaviors"
    xmlns:controls="clr-namespace:UniversalDeviceToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:UniversalDeviceToolkit.WPF.Controls.Custom"
    xmlns:dashboard="clr-namespace:UniversalDeviceToolkit.WPF.Controls.Dashboard"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:UniversalDeviceToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.DashboardPage_Title}"
    AutomationProperties.AutomationId="DashboardPageRoot"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    Initialized="DashboardPage_Initialized"
    SizeChanged="DashboardPage_SizeChanged">

    <Page.Resources>
        <Style x:Key="DashboardSkeletonShimmerBlockStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}" />

        <Style x:Key="DashboardListSkeletonCardStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonListItemCardStyle}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinHeight" Value="72" />
        </Style>

        <!--
          Sensors skeleton mirrors SensorsControl overlay layout:
          title + model subtitle, GaugeSizeMD + 3 metric rows, trend well, 3-item legend.
        -->
        <Style x:Key="DashboardSensorsSkeletonCardStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonCardStyle}">
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Padding" Value="8,10" />
            <Setter Property="MinHeight" Value="280" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceCardBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="DashboardSensorsSkeletonSectionStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="DashboardSensorsSkeletonTitleStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
            <Setter Property="Height" Value="20" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Width" Value="72" />
            <Setter Property="MaxWidth" Value="120" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="DashboardSensorsSkeletonSubtitleStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
            <Setter Property="Height" Value="14" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Width" Value="140" />
            <Setter Property="MaxWidth" Value="220" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,1,0,0" />
        </Style>

        <Style x:Key="DashboardSensorsSkeletonGaugeStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
            <Setter Property="Width" Value="{StaticResource GaugeSizeMD}" />
            <Setter Property="Height" Value="{StaticResource GaugeSizeMD}" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusRound}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DashboardSensorsSkeletonLabelStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
            <Setter Property="Height" Value="14" />
            <Setter Property="Width" Value="56" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DashboardSensorsSkeletonBarStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
            <Setter Property="Height" Value="6" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MaxWidth" Value="260" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusProgressBar}" />
        </Style>

        <Style x:Key="DashboardSensorsSkeletonValueStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
            <Setter Property="Height" Value="14" />
            <Setter Property="Width" Value="64" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DashboardSensorsSkeletonTrendPanelStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,14,0,0" />
            <Setter Property="Height" Value="76" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMD}" />
            <Setter Property="Background" Value="{DynamicResource ChartSurfaceBrush}" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="DashboardSensorsSkeletonTrendFillStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
        </Style>

        <Style x:Key="DashboardSensorsSkeletonLegendPanelStyle" TargetType="WrapPanel">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Orientation" Value="Horizontal" />
        </Style>

        <Style x:Key="DashboardSensorsSkeletonLegendItemStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,4" />
        </Style>

        <Style x:Key="DashboardSensorsSkeletonLegendDotStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="DashboardSensorsSkeletonLegendTextStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
            <Setter Property="Height" Value="12" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <wpfui:DynamicScrollViewer
        x:Name="_scrollViewer"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <controls:LoadableControl
            x:Name="_loader"
            Margin="0,0,0,12"
            ContentVisibilityWhileLoading="Visible">
            <controls:LoadableControl.LoadingContent>
                <StackPanel
                    Margin="0,16,0,0"
                    AutomationProperties.AutomationId="DashboardLoadingSkeleton"
                    AutomationProperties.Name="{x:Static resources:Resource.DashboardPage_Title}">

                    <!--
                      Single page-owned skeleton: sensors card + feature groups.
                      NavigationStore skips its generic shell because DashboardPage owns loading chrome.
                      Content stays Opacity 0 while loading, so SensorsControl overlay cannot paint —
                      the page skeleton must include the sensor-card silhouette.
                    -->
                    <Border
                        x:Name="_skeletonSensorsCard"
                        AutomationProperties.AutomationId="DashboardSensorsLoadingSkeleton"
                        Style="{StaticResource DashboardSensorsSkeletonCardStyle}">
                        <UniformGrid Columns="3">
                            <!-- CPU: title+model, gauge+3 metrics, trend, legend -->
                            <StackPanel Style="{StaticResource DashboardSensorsSkeletonSectionStyle}">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource DashboardSensorsSkeletonTitleStyle}" Width="72" />
                                    <Border Grid.Column="1" Style="{StaticResource DashboardSensorsSkeletonSubtitleStyle}" Width="168" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource DashboardSensorsSkeletonGaugeStyle}" />
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" MinWidth="72" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DashboardSensorsSkeletonLabelStyle}" Width="52" />
                                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DashboardSensorsSkeletonBarStyle}" />
                                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource DashboardSensorsSkeletonValueStyle}" Width="58" />
                                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DashboardSensorsSkeletonLabelStyle}" Width="44" />
                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DashboardSensorsSkeletonBarStyle}" />
                                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource DashboardSensorsSkeletonValueStyle}" Width="48" />
                                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource DashboardSensorsSkeletonLabelStyle}" Width="40" />
                                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource DashboardSensorsSkeletonBarStyle}" />
                                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource DashboardSensorsSkeletonValueStyle}" Width="36" />
                                    </Grid>
                                </Grid>
                                <Border Style="{StaticResource DashboardSensorsSkeletonTrendPanelStyle}">
                                    <Border Style="{StaticResource DashboardSensorsSkeletonTrendFillStyle}" />
                                </Border>
                                <WrapPanel Style="{StaticResource DashboardSensorsSkeletonLegendPanelStyle}">
                                    <StackPanel Style="{StaticResource DashboardSensorsSkeletonLegendItemStyle}">
                                        <Border Style="{StaticResource DashboardSensorsSkeletonLegendDotStyle}" />
                                        <Border Style="{StaticResource DashboardSensorsSkeletonLegendTextStyle}" Width="42" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DashboardSensorsSkeletonLegendItemStyle}">
                                        <Border Style="{StaticResource DashboardSensorsSkeletonLegendDotStyle}" />
                                        <Border Style="{StaticResource DashboardSensorsSkeletonLegendTextStyle}" Width="52" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DashboardSensorsSkeletonLegendItemStyle}">
                                        <Border Style="{StaticResource DashboardSensorsSkeletonLegendDotStyle}" />
                                        <Border Style="{StaticResource DashboardSensorsSkeletonLegendTextStyle}" Width="36" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Battery -->
                            <StackPanel Style="{StaticResource DashboardSensorsSkeletonSectionStyle}">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource DashboardSensorsSkeletonTitleStyle}" Width="56" />
                                    <Border Grid.Column="1" Style="{StaticResource DashboardSensorsSkeletonSubtitleStyle}" Width="120" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource DashboardSensorsSkeletonGaugeStyle}" />
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" MinWidth="72" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DashboardSensorsSkeletonLabelStyle}" Width="40" />
                                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DashboardSensorsSkeletonBarStyle}" />
                                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource DashboardSensorsSkeletonValueStyle}" Width="52" />
                                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DashboardSensorsSkeletonLabelStyle}" Width="48" />
                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DashboardSensorsSkeletonBarStyle}" />
                                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource DashboardSensorsSkeletonValueStyle}" Width="56" />
                                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource DashboardSensorsSkeletonLabelStyle}" Width="36" />
                                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource DashboardSensorsSkeletonBarStyle}" />
                                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource DashboardSensorsSkeletonValueStyle}" Width="60" />
                                    </Grid>
                                </Grid>
                                <Border Style="{StaticResource DashboardSensorsSkeletonTrendPanelStyle}">
                                    <Border Style="{StaticResource DashboardSensorsSkeletonTrendFillStyle}" />
                                </Border>
                                <WrapPanel Style="{StaticResource DashboardSensorsSkeletonLegendPanelStyle}">
                                    <StackPanel Style="{StaticResource DashboardSensorsSkeletonLegendItemStyle}">
                                        <Border Style="{StaticResource DashboardSensorsSkeletonLegendDotStyle}" />
                                        <Border Style="{StaticResource DashboardSensorsSkeletonLegendTextStyle}" Width="36" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DashboardSensorsSkeletonLegendItemStyle}">
                                        <Border Style="{StaticResource DashboardSensorsSkeletonLegendDotStyle}" />
                                        <Border Style="{StaticResource DashboardSensorsSkeletonLegendTextStyle}" Width="44" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DashboardSensorsSkeletonLegendItemStyle}">
                                        <Border Style="{StaticResource DashboardSensorsSkeletonLegendDotStyle}" />
                                        <Border Style="{StaticResource DashboardSensorsSkeletonLegendTextStyle}" Width="36" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>

                            <!-- GPU -->
                            <StackPanel Style="{StaticResource DashboardSensorsSkeletonSectionStyle}">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource DashboardSensorsSkeletonTitleStyle}" Width="48" />
                                    <Border Grid.Column="1" Style="{StaticResource DashboardSensorsSkeletonSubtitleStyle}" Width="152" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource DashboardSensorsSkeletonGaugeStyle}" />
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" MinWidth="72" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DashboardSensorsSkeletonLabelStyle}" Width="52" />
                                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DashboardSensorsSkeletonBarStyle}" />
                                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource DashboardSensorsSkeletonValueStyle}" Width="58" />
                                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DashboardSensorsSkeletonLabelStyle}" Width="44" />
                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DashboardSensorsSkeletonBarStyle}" />
                                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource DashboardSensorsSkeletonValueStyle}" Width="48" />
                                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource DashboardSensorsSkeletonLabelStyle}" Width="40" />
                                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource DashboardSensorsSkeletonBarStyle}" />
                                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource DashboardSensorsSkeletonValueStyle}" Width="36" />
                                    </Grid>
                                </Grid>
                                <Border Style="{StaticResource DashboardSensorsSkeletonTrendPanelStyle}">
                                    <Border Style="{StaticResource DashboardSensorsSkeletonTrendFillStyle}" />
                                </Border>
                                <WrapPanel Style="{StaticResource DashboardSensorsSkeletonLegendPanelStyle}">
                                    <StackPanel Style="{StaticResource DashboardSensorsSkeletonLegendItemStyle}">
                                        <Border Style="{StaticResource DashboardSensorsSkeletonLegendDotStyle}" />
                                        <Border Style="{StaticResource DashboardSensorsSkeletonLegendTextStyle}" Width="42" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DashboardSensorsSkeletonLegendItemStyle}">
                                        <Border Style="{StaticResource DashboardSensorsSkeletonLegendDotStyle}" />
                                        <Border Style="{StaticResource DashboardSensorsSkeletonLegendTextStyle}" Width="52" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DashboardSensorsSkeletonLegendItemStyle}">
                                        <Border Style="{StaticResource DashboardSensorsSkeletonLegendDotStyle}" />
                                        <Border Style="{StaticResource DashboardSensorsSkeletonLegendTextStyle}" Width="36" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <Grid x:Name="_skeletonGroupsGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="_skeletonGroup0" Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
                            <Border Width="132" Height="29" Margin="0,0,0,24" HorizontalAlignment="Left" Style="{StaticResource DashboardSkeletonShimmerBlockStyle}" />
                            <Border Style="{StaticResource DashboardListSkeletonCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="0"
                                        Margin="0,0,12,0"
                                        Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="180"
                                        Style="{StaticResource AppSkeletonListItemPrimaryLineStyle}" />
                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="220"
                                        Margin="0,8,0,0"
                                        Style="{StaticResource AppSkeletonListItemSecondaryLineStyle}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource DashboardListSkeletonCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="0"
                                        Margin="0,0,12,0"
                                        Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="160"
                                        Style="{StaticResource AppSkeletonListItemPrimaryLineStyle}" />
                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="200"
                                        Margin="0,8,0,0"
                                        Style="{StaticResource AppSkeletonListItemSecondaryLineStyle}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="_skeletonGroup1" Grid.Row="0" Grid.Column="1" Margin="0,0,16,0">
                            <Border Width="112" Height="29" Margin="0,0,0,24" HorizontalAlignment="Left" Style="{StaticResource DashboardSkeletonShimmerBlockStyle}" />
                            <Border Style="{StaticResource DashboardListSkeletonCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Margin="0,1,12,0" Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                    <Border Grid.Column="1" Width="196" Style="{StaticResource AppSkeletonListItemSingleLineStyle}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource DashboardListSkeletonCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Margin="0,1,12,0" Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                    <Border Grid.Column="1" Width="172" Style="{StaticResource AppSkeletonListItemSingleLineStyle}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="_skeletonGroup2" Grid.Row="0" Grid.Column="2" Margin="0,0,16,0">
                            <Border Width="144" Height="29" Margin="0,0,0,24" HorizontalAlignment="Left" Style="{StaticResource DashboardSkeletonShimmerBlockStyle}" />
                            <Border Style="{StaticResource DashboardListSkeletonCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                    <Border Grid.Row="0" Grid.Column="1" Width="176" Style="{StaticResource AppSkeletonListItemPrimaryLineStyle}" />
                                    <Border Grid.Row="1" Grid.Column="1" Width="216" Margin="0,8,0,0" Style="{StaticResource AppSkeletonListItemSecondaryLineStyle}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource DashboardListSkeletonCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Margin="0,1,12,0" Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                    <Border Grid.Column="1" Width="188" Style="{StaticResource AppSkeletonListItemSingleLineStyle}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </controls:LoadableControl.LoadingContent>

            <Grid
                x:Name="_dashboardContentRoot"
                IsHitTestVisible="False"
                Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <dashboard:SensorsControl x:Name="_sensors" Grid.Row="0" Margin="0,16,16,0" />
                <Grid x:Name="_content" Grid.Row="1" VerticalAlignment="Stretch" />
            </Grid>
        </controls:LoadableControl>
    </wpfui:DynamicScrollViewer>
</Page>
