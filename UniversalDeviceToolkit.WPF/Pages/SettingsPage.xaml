<Page
    x:Class="UniversalDeviceToolkit.WPF.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:UniversalDeviceToolkit.WPF.Controls"
    xmlns:overflow="clr-namespace:UniversalDeviceToolkit.WPF.Behaviors"
    xmlns:settings="clr-namespace:UniversalDeviceToolkit.WPF.Controls.Settings"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:UniversalDeviceToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.SettingsPage_Title}"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}">

    <Page.Resources>
        <Storyboard x:Key="ContentTransitionAnimation">
            <DoubleAnimation
                Storyboard.TargetName="_contentControl"
                Storyboard.TargetProperty="Opacity"
                From="{StaticResource AnimationOpacityStart}"
                To="{StaticResource AnimationOpacityEnd}"
                Duration="{StaticResource AnimationDurationMedium}"
                EasingFunction="{StaticResource AnimationEasingCubicOut}" />
            <DoubleAnimation
                Storyboard.TargetName="_contentControl"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="{StaticResource AnimationTranslationOffset}"
                To="0"
                Duration="{StaticResource AnimationDurationMedium}"
                EasingFunction="{StaticResource AnimationEasingCubicOut}" />
        </Storyboard>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" MinWidth="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,0,16,24">
            <controls:AdaptiveTextBlock
                Margin="0,16,0,8"
                Style="{StaticResource AppPageTitleTextBlockStyle}"
                OverflowMode="Wrap"
                MaxLines="2"
                MinFontSize="11"
                Text="{x:Static resources:Resource.SettingsPage_Title}" />
            <controls:AdaptiveTextBlock
                Margin="0,0,0,0"
                Style="{StaticResource AppPageDescriptionTextBlockStyle}"
                OverflowMode="Wrap"
                MaxLines="3"
                MinFontSize="11"
                Text="{x:Static resources:Resource.SettingsPage_Description}"
                />
        </StackPanel>

        <controls:LoadableControl
            x:Name="_loader"
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            ContentVisibilityWhileLoading="Collapsed">
            <controls:LoadableControl.LoadingContent>
                <!-- Mirrors: left nav rows (icon + label) + right settings cards while nav items and first control load. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" MinWidth="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Background="{DynamicResource PageBackgroundFillColorDefaultBrush}"
                        BorderBrush="Transparent"
                        BorderThickness="0">
                        <StackPanel Margin="16,12,12,0">
                            <Grid Margin="0,0,0,2" Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                <Border Grid.Column="1" Width="118" Style="{StaticResource AppSkeletonListItemSingleLineStyle}" />
                            </Grid>
                            <Grid Margin="0,0,0,2" Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                <Border Grid.Column="1" Width="96" Style="{StaticResource AppSkeletonListItemSingleLineStyle}" />
                            </Grid>
                            <Grid Margin="0,0,0,2" Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                <Border Grid.Column="1" Width="132" Style="{StaticResource AppSkeletonListItemSingleLineStyle}" />
                            </Grid>
                            <Grid Margin="0,0,0,2" Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                <Border Grid.Column="1" Width="84" Style="{StaticResource AppSkeletonListItemSingleLineStyle}" />
                            </Grid>
                            <Grid Margin="0,0,0,2" Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                <Border Grid.Column="1" Width="108" Style="{StaticResource AppSkeletonListItemSingleLineStyle}" />
                            </Grid>
                            <Grid Margin="0,0,0,2" Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                <Border Grid.Column="1" Width="124" Style="{StaticResource AppSkeletonListItemSingleLineStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="24,0,0,0">
                        <Border Margin="0,0,0,16" Style="{StaticResource AppSkeletonCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <Border Width="180" Style="{StaticResource AppSkeletonListItemPrimaryLineStyle}" />
                                    <Border Width="260" Style="{StaticResource AppSkeletonListItemSecondaryLineStyle}" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource AppSkeletonToggleSwitchStyle}" />
                            </Grid>
                        </Border>
                        <Border MinHeight="120" Style="{StaticResource AppSkeletonCardStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <Border Width="200" Style="{StaticResource AppSkeletonListItemPrimaryLineStyle}" />
                                <Border Width="320" Style="{StaticResource AppSkeletonListItemSecondaryLineStyle}" />
                                <Border Height="28" Margin="0,14,0,0" Style="{StaticResource AppSkeletonShimmerBlockStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </controls:LoadableControl.LoadingContent>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" MinWidth="150" MaxWidth="480" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

        <!-- Draggable splitter: makes the left nav width user-adjustable instead of fixed 240. -->
        <GridSplitter
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            Cursor="SizeWE"
            Focusable="False"
            ShowsPreview="False" />

        <!-- Left Navigation Bar -->
        <Border
            Grid.Column="0"
            Background="{DynamicResource PageBackgroundFillColorDefaultBrush}"
            BorderBrush="Transparent"
            BorderThickness="0">
       
            <ListBox
                x:Name="_navigationListBox"
                AutomationProperties.AutomationId="SettingsNavigationList"
                BorderThickness="0"
                Background="Transparent"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                SelectionChanged="NavigationListBox_SelectionChanged"
                SelectedIndex="0"
                VirtualizingStackPanel.IsVirtualizing="True"
                VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="0" />
                            </Grid.ColumnDefinitions>
                            <wpfui:SymbolIcon
                                Grid.Column="0"
                                FontSize="{StaticResource IconSizeMD}"
                                Symbol="{Binding Icon}"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource FontSizeCaption}"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                MinWidth="0"
                                AutomationProperties.Name="{Binding Title}"
                                overflow:LocalizedOverflowBehavior.IsEnabled="True"
                                overflow:LocalizedOverflowBehavior.Mode="Ellipsis"
                                overflow:LocalizedOverflowBehavior.MaxLines="1" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        <Setter Property="AutomationProperties.AutomationId" Value="{Binding Key, StringFormat=SettingsNav_{0}}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border
                                        x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        Padding="16,12,12,12"
                                        CornerRadius="{StaticResource CornerRadiusControl}">
                                        <Grid>
                                            <!-- Accent indicator — matches main NavigationStore selection chrome -->
                                            <Rectangle
                                                x:Name="ActiveRectangle"
                                                Width="4"
                                                Height="24"
                                                Margin="-16,0,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Opacity="0.0"
                                                RadiusX="2"
                                                RadiusY="2">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <ContentPresenter
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- Theme-aware fills (no hardcoded #26000000 — broken in light/presets). -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ActiveRectangle" Property="Opacity" Value="1.0" />
                                            <Setter TargetName="Bd" Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{DynamicResource ControlFillColorSecondary}" />
                                                </Setter.Value>
                                            </Setter>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- Right Content Area -->
        <ContentControl
            x:Name="_contentControl"
            AutomationProperties.AutomationId="SettingsContentControl"
            Grid.Column="2"
            Margin="16,0,0,0">
            <ContentControl.RenderTransform>
                <TranslateTransform />
            </ContentControl.RenderTransform>
        </ContentControl>
            </Grid>
        </controls:LoadableControl>
    </Grid>
</Page>
