<Page
    x:Class="UniversalDeviceToolkit.WPF.Pages.KeyboardBacklightPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:UniversalDeviceToolkit.WPF.Controls"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:UniversalDeviceToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.KeyboardBacklightPage_Title}"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}">

    <wpfui:DynamicScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,0">
        <TextBlock
                x:Name="_titleTextBlock"
                Margin="0,16,0,24"
                Focusable="True"
                Style="{StaticResource AppPageTitleTextBlockStyle}"
                Text="{x:Static resources:Resource.KeyboardBacklightPage_Title}" />

            <controls:LoadableControl x:Name="_loader" ContentVisibilityWhileLoading="Collapsed">
                <controls:LoadableControl.LoadingContent>
                    <StackPanel
                        Margin="0,0,8,0"
                        AutomationProperties.AutomationId="KeyboardBacklightLoadingSkeleton">
                        <Border Style="{StaticResource AppSkeletonCardStyle}" MinHeight="200" Margin="0,0,0,12">
                            <StackPanel>
                                <Border Width="220" Height="18" HorizontalAlignment="Left" Style="{StaticResource AppSkeletonShimmerBlockStyle}" />
                                <Border Height="8" Margin="0,28,140,0" Style="{StaticResource AppSkeletonShimmerBlockStyle}" />
                                <Border Height="8" Margin="0,16,96,0" Style="{StaticResource AppSkeletonShimmerBlockStyle}" />
                                <Border Height="32" Margin="0,24,180,0" CornerRadius="{StaticResource CornerRadiusLG}" Style="{StaticResource AppSkeletonShimmerBlockStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppSkeletonListItemCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                <Border Grid.Column="1" Width="220" Style="{StaticResource AppSkeletonListItemPrimaryLineStyle}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </controls:LoadableControl.LoadingContent>
                <StackPanel x:Name="_content" Margin="0,0,8,0">
                <TextBlock
                    x:Name="_noKeyboardsText"
                    FontSize="{StaticResource FontSizeCaption}"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{x:Static resources:Resource.KeyboardBacklightPage_NoCompatibleKeyboardsFound}"
                    Visibility="Collapsed" />
            </StackPanel>
        </controls:LoadableControl>

        </StackPanel>
    </wpfui:DynamicScrollViewer>

</Page>

