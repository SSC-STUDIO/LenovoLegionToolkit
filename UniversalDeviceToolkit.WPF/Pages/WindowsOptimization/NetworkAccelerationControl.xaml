<UserControl
    x:Class="UniversalDeviceToolkit.WPF.Pages.WindowsOptimization.NetworkAccelerationControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="clr-namespace:UniversalDeviceToolkit.WPF.Controls.Custom"
    xmlns:controls="clr-namespace:UniversalDeviceToolkit.WPF.Controls"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:UniversalDeviceToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}">

    <!--
      Compact settings-style layout (matches SettingsAppearanceControl):
      flat CardControl sections, no nested hero banners / metric grids.
      Behavior inspired by Watt Toolkit; no GPL code copied.
    -->
    <wpfui:DynamicScrollViewer
        AutomationProperties.AutomationId="NetworkAccelerationPageScrollViewer"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,24">
            <TextBlock
                Margin="0,16,0,4"
                Focusable="True"
                Style="{StaticResource AppPageTitleTextBlockStyle}"
                Text="{x:Static resources:Resource.NetworkAccelerationPage_Title}" />
            <TextBlock
                Margin="0,0,0,16"
                Focusable="True"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{x:Static resources:Resource.NetworkAccelerationPage_Subtitle}"
                TextWrapping="Wrap" />

            <!-- Status + master switch -->
            <custom:CardControl
                Margin="0,0,0,8"
                Icon="Rocket24"
                AutomationProperties.AutomationId="NetworkAccelerationStatusCard">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl
                        Title="{x:Static resources:Resource.NetworkAccelerationPage_StatusHeading}"
                        Subtitle="{x:Static resources:Resource.NetworkAccelerationPage_EnableLabel}" />
                </custom:CardControl.Header>
                <StackPanel>
                    <TextBlock
                        x:Name="_statusText"
                        Margin="0,0,0,10"
                        AutomationProperties.AutomationId="NetworkAccelerationStatusText"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{x:Static resources:Resource.NetworkAccelerationPage_StatusOff}"
                        TextWrapping="Wrap" />
                    <CheckBox
                        x:Name="_enableToggle"
                        Margin="0,0,0,12"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="NetworkAccelerationEnableToggle"
                        Click="EnableToggle_Click"
                        Content="{x:Static resources:Resource.NetworkAccelerationPage_EnableLabel}" />
                    <WrapPanel>
                        <wpfui:Button
                            x:Name="_startButton"
                            MinWidth="110"
                            Margin="0,0,8,8"
                            Appearance="Primary"
                            AutomationProperties.AutomationId="NetworkAccelerationStartButton"
                            Click="StartButton_Click"
                            Content="{x:Static resources:Resource.NetworkAccelerationPage_Start}"
                            IsEnabled="False" />
                        <wpfui:Button
                            x:Name="_stopButton"
                            MinWidth="110"
                            Margin="0,0,8,8"
                            AutomationProperties.AutomationId="NetworkAccelerationStopButton"
                            Click="StopButton_Click"
                            Content="{x:Static resources:Resource.NetworkAccelerationPage_Stop}"
                            IsEnabled="False" />
                        <wpfui:Button
                            x:Name="_restoreButton"
                            MinWidth="140"
                            Margin="0,0,8,8"
                            AutomationProperties.AutomationId="NetworkAccelerationRestoreButton"
                            Click="RestoreButton_Click"
                            Content="{x:Static resources:Resource.NetworkAccelerationPage_RestoreNetwork}" />
                    </WrapPanel>
                </StackPanel>
            </custom:CardControl>

            <!-- Mode (System proxy / Hosts / Diagnostics) -->
            <custom:CardControl
                Margin="0,0,0,8"
                Icon="Settings24"
                AutomationProperties.AutomationId="NetworkAccelerationModeCard">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl
                        Title="{x:Static resources:Resource.NetworkAccelerationPage_ModeLabel}"
                        Subtitle="{x:Static resources:Resource.NetworkAccelerationPage_ModeHint}" />
                </custom:CardControl.Header>
                <ComboBox
                    x:Name="_modeComboBox"
                    MinWidth="220"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="NetworkAccelerationModeComboBox"
                    SelectionChanged="ModeComboBox_SelectionChanged" />
            </custom:CardControl>

            <!-- Domain groups (Steam / GitHub / Custom) -->
            <custom:CardControl
                Margin="0,0,0,8"
                Icon="Globe24"
                AutomationProperties.AutomationId="NetworkAccelerationDomainsCard">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl
                        Title="{x:Static resources:Resource.NetworkAccelerationPage_DomainGroupsLabel}"
                        Subtitle="{x:Static resources:Resource.NetworkAccelerationPage_DomainGroupsHint}" />
                </custom:CardControl.Header>
                <StackPanel>
                    <TextBlock
                        x:Name="_domainGroupsText"
                        Margin="0,0,0,10"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <StackPanel x:Name="_domainGroupsPanel" />
                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{x:Static resources:Resource.NetworkAccelerationPage_DomainGroupsFootnote}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </custom:CardControl>

            <!-- Diagnostics -->
            <custom:CardControl
                Margin="0,0,0,8"
                Icon="Pulse24"
                AutomationProperties.AutomationId="NetworkAccelerationDiagnosticsCard">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl
                        Title="{x:Static resources:Resource.NetworkAccelerationPage_DiagnosticsHeading}"
                        Subtitle="{x:Static resources:Resource.NetworkAccelerationPage_DiagnosticsPlaceholder}" />
                </custom:CardControl.Header>
                <StackPanel>
                    <TextBlock
                        x:Name="_diagnosticsText"
                        Margin="0,0,0,10"
                        AutomationProperties.AutomationId="NetworkAccelerationDiagnosticsText"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static resources:Resource.NetworkAccelerationPage_DiagnosticsPlaceholder}"
                        TextWrapping="Wrap" />
                    <wpfui:Button
                        x:Name="_diagnosticsButton"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="NetworkAccelerationDiagnosticsButton"
                        Click="DiagnosticsButton_Click"
                        Content="{x:Static resources:Resource.NetworkAccelerationPage_RunDiagnostics}" />
                </StackPanel>
            </custom:CardControl>

            <custom:CardExpander
                Margin="0,0,0,8"
                AutomationProperties.AutomationId="NetworkAccelerationAdvancedExpander"
                Header="{x:Static resources:Resource.NetworkAccelerationPage_AdvancedHeading}"
                IsExpanded="False">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static resources:Resource.NetworkAccelerationPage_AdvancedBody}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="_modeText"
                        Margin="0,12,0,0"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        x:Name="_portText"
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </custom:CardExpander>
        </StackPanel>
    </wpfui:DynamicScrollViewer>
</UserControl>
