<UserControl
    x:Class="UniversalDeviceToolkit.WPF.Pages.WindowsOptimization.NetworkAccelerationControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="clr-namespace:UniversalDeviceToolkit.WPF.Controls.Custom"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:UniversalDeviceToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}">

    <!--
      Network control center — high density, narrow-column safe, Fluent surface.
      AutomationIds preserved for smoke/UI tests.
    -->
    <UserControl.Resources>
        <Style x:Key="NaMainSurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
        <!-- Segmented selection-bar action cell: tag/chip look (Watt Toolkit reference). -->
        <Style x:Key="NaSelectionActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerRadiusCompact}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NaSelectionGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" />
            <Setter Property="FontSize" Value="{StaticResource IconSizeSM}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NaPrimaryButtonStyle" TargetType="wpfui:Button" BasedOn="{StaticResource {x:Type wpfui:Button}}">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmallCaption}" />
        </Style>
        <Style x:Key="NaSecondaryButtonStyle" TargetType="wpfui:Button" BasedOn="{StaticResource {x:Type wpfui:Button}}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmallCaption}" />
        </Style>
        <!-- Based on app-wide rounded ComboBox so the drop-down popup is not square. -->
        <Style x:Key="NaModeComboStyle" TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}">
            <Setter Property="MinWidth" Value="168" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmallCaption}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
    <wpfui:DynamicScrollViewer
        AutomationProperties.AutomationId="NetworkAccelerationPageScrollViewer"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        Margin="0">
        <Border
            Margin="0,0,8,16"
            HorizontalAlignment="Stretch"
            Style="{StaticResource NaMainSurfaceStyle}"
            AutomationProperties.AutomationId="NetworkAccelerationControlCard">
            <StackPanel>

                <!--
                  1. Compact status chip (dot + short label). Long detail lives in tooltip + mode line.
                  HorizontalAlignment must stay Left — never Stretch with CornerRadius=999.
                -->
                <Border
                    x:Name="_statusPill"
                    Style="{StaticResource AppStatusPillBorderStyle}"
                    HorizontalAlignment="Left"
                    MaxWidth="420"
                    AutomationProperties.AutomationId="NetworkAccelerationStatusPill">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            x:Name="_statusDot"
                            Style="{StaticResource AppStatusDotEllipseStyle}"
                            Fill="{DynamicResource TextFillColorSecondaryBrush}"
                            AutomationProperties.AutomationId="NetworkAccelerationStatusIndicator" />
                        <TextBlock
                            x:Name="_statusText"
                            Style="{StaticResource AppStatusPillTextBlockStyle}"
                            Text="{x:Static resources:Resource.NetworkAccelerationPage_State_Idle}"
                            AutomationProperties.AutomationId="NetworkAccelerationStatusText" />
                    </StackPanel>
                </Border>

                <TextBlock
                    x:Name="_modeSummaryText"
                    Margin="2,5,0,0"
                    Style="{StaticResource AppMutedTextBlockStyle}"
                    Text="{x:Static resources:Resource.NetworkAccelerationPage_ModeLabel}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />

                <!--
                  Grid (not WrapPanel): button + mode selector share one row without overlapping.
                  ComboBox uses plain data items (not ComboBoxItem visuals) so SelectionBoxItem
                  never re-hosts a control template on top of the closed field text.
                -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <wpfui:Button
                            x:Name="_primaryActionButton"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource NaPrimaryButtonStyle}"
                            Appearance="Primary"
                            AutomationProperties.AutomationId="NetworkAccelerationPrimaryActionButton"
                            AutomationProperties.Name="{x:Static resources:Resource.NetworkAccelerationPage_Start}"
                            Click="PrimaryActionButton_Click"
                            Content="{x:Static resources:Resource.NetworkAccelerationPage_Start}" />
                        <wpfui:ProgressRing
                            x:Name="_busyRing"
                            Width="18"
                            Height="18"
                            IsIndeterminate="True"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <ComboBox
                        x:Name="_modeComboBox"
                        Grid.Column="1"
                        MaxWidth="360"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Style="{StaticResource NaModeComboStyle}"
                        AutomationProperties.AutomationId="NetworkAccelerationModeSelector"
                        AutomationProperties.Name="{x:Static resources:Resource.NetworkAccelerationPage_ModeLabel}"
                        SelectionChanged="ModeComboBox_SelectionChanged" />
                </Grid>

                <Border Style="{StaticResource AppDividerBorderStyle}" />

                <!-- 2. Metrics — dense wrap tiles -->
                <TextBlock
                    x:Name="_metricsHeadingText"
                    Style="{StaticResource AppSectionLabelTextBlockStyle}"
                    Text="{x:Static resources:Resource.NetworkAccelerationPage_MetricsHeading}" />
                <WrapPanel Margin="0,4,0,0">
                    <Border Style="{StaticResource AppMetricTileBorderStyle}" AutomationProperties.AutomationId="NetworkAccelerationLatencyMetric">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppMutedTextBlockStyle}" Text="{x:Static resources:Resource.NetworkAccelerationPage_Metric_Latency}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="_metricLatencyValue" Style="{StaticResource AppMetricValueTextBlockStyle}" Text="—" MinWidth="22" />
                                <TextBlock
                                    x:Name="_metricLatencyUnit"
                                    Style="{StaticResource AppMetricUnitTextBlockStyle}"
                                    Text="{x:Static resources:Resource.NetworkAccelerationPage_MetricUnit_Ms}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource AppMetricTileBorderStyle}" AutomationProperties.AutomationId="NetworkAccelerationUploadMetric">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppMutedTextBlockStyle}" Text="{x:Static resources:Resource.NetworkAccelerationPage_Metric_Upload}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="_metricUploadValue" Style="{StaticResource AppMetricValueTextBlockStyle}" Text="—" MinWidth="22" />
                                <TextBlock
                                    Style="{StaticResource AppMetricUnitTextBlockStyle}"
                                    Text="{x:Static resources:Resource.NetworkAccelerationPage_MetricUnit_Rate}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource AppMetricTileBorderStyle}" AutomationProperties.AutomationId="NetworkAccelerationDownloadMetric">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppMutedTextBlockStyle}" Text="{x:Static resources:Resource.NetworkAccelerationPage_Metric_Download}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="_metricDownloadValue" Style="{StaticResource AppMetricValueTextBlockStyle}" Text="—" MinWidth="22" />
                                <TextBlock
                                    Style="{StaticResource AppMetricUnitTextBlockStyle}"
                                    Text="{x:Static resources:Resource.NetworkAccelerationPage_MetricUnit_Rate}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource AppMetricTileBorderStyle}" AutomationProperties.AutomationId="NetworkAccelerationConnectionsMetric">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppMutedTextBlockStyle}" Text="{x:Static resources:Resource.NetworkAccelerationPage_Metric_Connections}" />
                            <TextBlock x:Name="_metricConnectionsValue" Margin="0,4,0,0" Style="{StaticResource AppMetricValueTextBlockStyle}" Text="—" MinWidth="22" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource AppMetricTileBorderStyle}" AutomationProperties.AutomationId="NetworkAccelerationRulesMetric">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppMutedTextBlockStyle}" Text="{x:Static resources:Resource.NetworkAccelerationPage_Metric_Rules}" />
                            <TextBlock x:Name="_metricRulesValue" Margin="0,4,0,0" Style="{StaticResource AppMetricValueTextBlockStyle}" Text="0" MinWidth="22" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Border Style="{StaticResource AppDividerBorderStyle}" />

                <!-- 3. Acceleration targets -->
                <TextBlock
                    Style="{StaticResource AppSectionLabelTextBlockStyle}"
                    Text="{x:Static resources:Resource.NetworkAccelerationPage_TargetsHeading}" />
                <TextBlock
                    Margin="0,0,0,6"
                    Style="{StaticResource AppMutedTextBlockStyle}"
                    Text="{x:Static resources:Resource.NetworkAccelerationPage_DomainGroupsHint}" />
                <ItemsControl
                    x:Name="_domainGroupsPanel"
                    AutomationProperties.AutomationId="NetworkAccelerationDomainsCard">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <!-- Empty state swaps with _domainGroupsPanel (inverse visibility set in RefreshDomainTiles). -->
                <custom:EmptyState
                    x:Name="_domainGroupsEmptyState"
                    Margin="0,8,0,8"
                    Icon="Globe24"
                    Title="{x:Static resources:Resource.NetworkAccelerationPage_DomainGroupsEmptyTitle}"
                    Description="{x:Static resources:Resource.NetworkAccelerationPage_DomainGroupsEmptyDescription}"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="NetworkAccelerationDomainGroupsEmptyState" />
                <TextBlock
                    x:Name="_domainGroupsText"
                    Margin="0,2,0,0"
                    Style="{StaticResource AppMutedTextBlockStyle}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource AppMutedTextBlockStyle}"
                    Text="{x:Static resources:Resource.NetworkAccelerationPage_SelectionHint}" />

                <Border Style="{StaticResource AppDividerBorderStyle}" />

                <!-- 4. Diagnostics -->
                <Grid AutomationProperties.AutomationId="NetworkAccelerationDiagnosticsCard">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="100" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock
                            Style="{StaticResource AppSectionLabelTextBlockStyle}"
                            Text="{x:Static resources:Resource.NetworkAccelerationPage_DiagnosticsHeading}" />
                        <TextBlock
                            Style="{StaticResource AppMutedTextBlockStyle}"
                            Text="{x:Static resources:Resource.NetworkAccelerationPage_DiagnosticsHint}" />
                    </StackPanel>
                    <wpfui:Button
                        x:Name="_diagnosticsButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource NaSecondaryButtonStyle}"
                        Appearance="Secondary"
                        AutomationProperties.AutomationId="NetworkAccelerationDiagnosticsButton"
                        AutomationProperties.Name="{x:Static resources:Resource.NetworkAccelerationPage_RunDiagnostics}"
                        Click="DiagnosticsButton_Click"
                        Content="{x:Static resources:Resource.NetworkAccelerationPage_RunDiagnostics}" />
                </Grid>

                <ItemsControl
                    x:Name="_diagnosticsItemsPanel"
                    Margin="0,8,0,0" />

                <TextBlock
                    x:Name="_diagnosticsText"
                    Margin="0,6,0,0"
                    FontSize="{DynamicResource FontSizeSmallCaption}"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="NetworkAccelerationDiagnosticsText" />

                <Border Style="{StaticResource AppDividerBorderStyle}" />

                <!-- 5. Advanced -->
                <Expander
                    x:Name="_advancedExpander"
                    IsExpanded="False"
                    AutomationProperties.AutomationId="NetworkAccelerationAdvancedExpander">
                    <Expander.Header>
                        <TextBlock
                            FontSize="{DynamicResource FontSizeSmallCaption}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{x:Static resources:Resource.NetworkAccelerationPage_AdvancedHeading}" />
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock
                            Style="{StaticResource AppMutedTextBlockStyle}"
                            Text="{x:Static resources:Resource.NetworkAccelerationPage_AdvancedBody}" />
                        <TextBlock
                            x:Name="_modeText"
                            Margin="0,8,0,0"
                            FontSize="{DynamicResource FontSizeSmallCaption}"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock
                            x:Name="_portText"
                            Margin="0,2,0,8"
                            FontSize="{DynamicResource FontSizeSmallCaption}"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <Border
                            Margin="0,2,0,0"
                            Padding="10,8"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusControl}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="{DynamicResource FontSizeSmallCaption}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{x:Static resources:Resource.NetworkAccelerationPage_DangerZoneHeading}" />
                                <TextBlock
                                    Margin="0,4,0,8"
                                    Style="{StaticResource AppMutedTextBlockStyle}"
                                    Text="{x:Static resources:Resource.NetworkAccelerationPage_RestoreHint}" />
                                <wpfui:Button
                                    x:Name="_restoreButton"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource NaSecondaryButtonStyle}"
                                    Appearance="Secondary"
                                    AutomationProperties.AutomationId="NetworkAccelerationRestoreButton"
                                    AutomationProperties.Name="{x:Static resources:Resource.NetworkAccelerationPage_RestoreNetwork}"
                                    Click="RestoreButton_Click"
                                    Content="{x:Static resources:Resource.NetworkAccelerationPage_RestoreNetwork}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
    </wpfui:DynamicScrollViewer>
    </Grid>
</UserControl>
