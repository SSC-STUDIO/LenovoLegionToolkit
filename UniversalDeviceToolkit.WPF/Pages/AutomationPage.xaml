<Page
    x:Class="UniversalDeviceToolkit.WPF.Pages.AutomationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:UniversalDeviceToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:UniversalDeviceToolkit.WPF.Controls.Custom"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:UniversalDeviceToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.AutomationPage_Title}"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}">

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <wpfui:DynamicScrollViewer x:Name="_scrollViewer" Grid.Row="0">
            <Grid Margin="0,0,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,16,0,24">
                    <TextBlock
                        Focusable="True"
                        Style="{StaticResource AppPageTitleTextBlockStyle}"
                        Text="{x:Static resources:Resource.AutomationPage_Title}" />

                    <TextBlock
                        Margin="0,8,0,0"
                        Focusable="True"
                        Style="{StaticResource AppPageDescriptionTextBlockStyle}"
                        Text="{x:Static resources:Resource.AutomationPage_Actions_Message}" />
                </StackPanel>

                <controls:LoadableControl
                    x:Name="_loaderAutomatic"
                    Grid.Row="1"
                    ContentVisibilityWhileLoading="Collapsed">
                    <controls:LoadableControl.LoadingContent>
                        <!-- Mirrors: enable CardControl + collapsed CardExpander pipeline rows. -->
                        <StackPanel
                            Margin="0,0,0,8"
                            AutomationProperties.AutomationId="AutomationAutomaticLoadingSkeleton"
                            AutomationProperties.Name="{x:Static resources:Resource.AutomationPage_Actions_Title}">
                            <Border Style="{StaticResource AppSkeletonToggleCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <Border
                                            Width="200"
                                            Height="18"
                                            Style="{StaticResource AppSkeletonListItemPrimaryLineStyle}" />
                                        <Border
                                            Width="320"
                                            MaxWidth="999"
                                            Style="{StaticResource AppSkeletonListItemSecondaryLineStyle}" />
                                        <Border
                                            Width="180"
                                            Height="10"
                                            Margin="0,8,0,0"
                                            Style="{StaticResource AppSkeletonListItemSecondaryLineStyle}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource AppSkeletonToggleSwitchStyle}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource AppSkeletonListItemCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        Width="32"
                                        Height="32"
                                        CornerRadius="{StaticResource CornerRadiusSM}"
                                        Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Border Width="240" Style="{StaticResource AppSkeletonListItemPrimaryLineStyle}" />
                                        <Border Width="168" Style="{StaticResource AppSkeletonListItemSecondaryLineStyle}" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="2"
                                        Width="18"
                                        Height="18"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource AppSkeletonListItemCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        Width="32"
                                        Height="32"
                                        CornerRadius="{StaticResource CornerRadiusSM}"
                                        Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Border Width="200" Style="{StaticResource AppSkeletonListItemPrimaryLineStyle}" />
                                        <Border Width="140" Style="{StaticResource AppSkeletonListItemSecondaryLineStyle}" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="2"
                                        Width="18"
                                        Height="18"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource AppSkeletonListItemCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        Width="32"
                                        Height="32"
                                        CornerRadius="{StaticResource CornerRadiusSM}"
                                        Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Border Width="220" Style="{StaticResource AppSkeletonListItemPrimaryLineStyle}" />
                                        <Border Width="152" Style="{StaticResource AppSkeletonListItemSecondaryLineStyle}" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="2"
                                        Width="18"
                                        Height="18"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </controls:LoadableControl.LoadingContent>
                    <StackPanel>

                        <custom:CardControl Margin="0,0,0,24">
                            <custom:CardControl.Header>
                                <controls:CardHeaderControl Title="{x:Static resources:Resource.AutomationPage_ActionsEnabled_Title}" Subtitle="{x:Static resources:Resource.AutomationPage_ActionsEnable_Message}" />
                            </custom:CardControl.Header>
                            <wpfui:ToggleSwitch
                                x:Name="_enableAutomaticPipelinesToggle"
                                Margin="0,0,0,8"
                                AutomationProperties.AutomationId="AutomationEnableAutomaticPipelinesToggle"
                                AutomationProperties.Name="{x:Static resources:Resource.AutomationPage_ActionsEnabled_Title}"
                                Click="EnableAutomaticPipelinesToggle_Click" />
                        </custom:CardControl>

                        <custom:EmptyState
                            x:Name="_noAutomaticActionsText"
                            Margin="0,16,0,16"
                            Focusable="True"
                            Icon="ArrowSync24"
                            Title="{x:Static resources:Resource.AutomationPage_Actions_Empty}" />

                        <StackPanel x:Name="_automaticPipelinesStackPanel" />

                        <StackPanel Margin="0,8,0,0" HorizontalAlignment="Right">
                            <wpfui:Button
                                x:Name="_newAutomaticPipelineButton"
                                MinWidth="120"
                                Appearance="Primary"
                                AutomationProperties.Name="{x:Static resources:Resource.AddNew}"
                                Click="NewAutomaticPipelineButton_Click"
                                Content="{x:Static resources:Resource.AddNew}" />
                        </StackPanel>

                    </StackPanel>
                </controls:LoadableControl>

                <StackPanel Grid.Row="2" Margin="0,24,0,24">

                    <TextBlock
                        Focusable="True"
                        FontWeight="Normal"
                        Style="{StaticResource AppSectionTitleTextBlockStyle}"
                        Text="{x:Static resources:Resource.AutomationPage_QuickActions_Title}" />

                    <TextBlock
                        Margin="0,8,0,0"
                        Focusable="True"
                        Style="{StaticResource AppPageDescriptionTextBlockStyle}"
                        Text="{x:Static resources:Resource.AutomationPage_QuickActions_Message}" />

                </StackPanel>

                <controls:LoadableControl
                    x:Name="_loaderManual"
                    Grid.Row="3"
                    ContentVisibilityWhileLoading="Collapsed">
                    <controls:LoadableControl.LoadingContent>
                        <!-- Mirrors collapsed CardExpander quick-action rows. -->
                        <StackPanel
                            Margin="0,0,0,8"
                            AutomationProperties.AutomationId="AutomationManualLoadingSkeleton"
                            AutomationProperties.Name="{x:Static resources:Resource.AutomationPage_QuickActions_Title}">
                            <Border Style="{StaticResource AppSkeletonListItemCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        Width="32"
                                        Height="32"
                                        CornerRadius="{StaticResource CornerRadiusSM}"
                                        Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Border Width="220" Style="{StaticResource AppSkeletonListItemPrimaryLineStyle}" />
                                        <Border Width="150" Style="{StaticResource AppSkeletonListItemSecondaryLineStyle}" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="2"
                                        Width="18"
                                        Height="18"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource AppSkeletonListItemCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        Width="32"
                                        Height="32"
                                        CornerRadius="{StaticResource CornerRadiusSM}"
                                        Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Border Width="240" Style="{StaticResource AppSkeletonListItemPrimaryLineStyle}" />
                                        <Border Width="170" Style="{StaticResource AppSkeletonListItemSecondaryLineStyle}" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="2"
                                        Width="18"
                                        Height="18"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource AppSkeletonListItemCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        Width="32"
                                        Height="32"
                                        CornerRadius="{StaticResource CornerRadiusSM}"
                                        Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Border Width="190" Style="{StaticResource AppSkeletonListItemPrimaryLineStyle}" />
                                        <Border Width="130" Style="{StaticResource AppSkeletonListItemSecondaryLineStyle}" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="2"
                                        Width="18"
                                        Height="18"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </controls:LoadableControl.LoadingContent>
                    <StackPanel>

                        <custom:EmptyState
                            x:Name="_noManualActionsText"
                            Margin="0,16,0,16"
                            Focusable="True"
                            Icon="Play24"
                            Title="{x:Static resources:Resource.AutomationPage_QuickActions_Empty}" />

                        <StackPanel x:Name="_manualPipelinesStackPanel" />

                        <StackPanel Margin="0,8,0,0" HorizontalAlignment="Right">
                            <wpfui:Button
                                MinWidth="120"
                                Appearance="Primary"
                                AutomationProperties.Name="{x:Static resources:Resource.AddNew}"
                                Click="NewManualPipelineButton_Click"
                                Content="{x:Static resources:Resource.AddNew}" />
                        </StackPanel>

                    </StackPanel>
                </controls:LoadableControl>

            </Grid>
        </wpfui:DynamicScrollViewer>

        <StackPanel
            x:Name="_saveRevertStackPanel"
            Grid.Row="1"
            Margin="12"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Visibility="Collapsed">

            <wpfui:Button
                x:Name="_saveButton"
                MinWidth="120"
                Appearance="Primary"
                AutomationProperties.Name="{x:Static resources:Resource.Save}"
                Click="SaveButton_Click"
                Content="{x:Static resources:Resource.Save}" />
            <wpfui:Button
                MinWidth="120"
                Margin="12,0,0,0"
                AutomationProperties.Name="{x:Static resources:Resource.Revert}"
                Click="RevertButton_Click"
                Content="{x:Static resources:Resource.Revert}" />

        </StackPanel>

    </Grid>

</Page>
