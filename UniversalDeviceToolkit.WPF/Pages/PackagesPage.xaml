<Page
    x:Class="UniversalDeviceToolkit.WPF.Pages.PackagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:UniversalDeviceToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:UniversalDeviceToolkit.WPF.Controls.Custom"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:UniversalDeviceToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:conv="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
    Title="{x:Static resources:Resource.PackagesPage_Title}"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}">

    <Page.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <utils:TextToVisibilityConverter x:Key="TextToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,16,0,24"
                Focusable="True"
                Style="{StaticResource AppPageTitleTextBlockStyle}"
                Text="{x:Static resources:Resource.PackagesPage_Title}" />

            <custom:CardControl
                Grid.Row="1"
                Margin="0,0,16,8"
                FocusVisualStyle="{DynamicResource DefaultControlFocusVisualStyle}">
                <custom:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalContentAlignment="Center"
                            Content="{x:Static resources:Resource.PackagesPage_MachineType}">
                            <Label.Foreground>
                                <SolidColorBrush Color="{DynamicResource TextFillColorPrimary}" />
                            </Label.Foreground>
                        </Label>
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,8,0,0"
                            VerticalContentAlignment="Center"
                            Content="{x:Static resources:Resource.PackagesPage_OperatingSystem}">
                            <Label.Foreground>
                                <SolidColorBrush Color="{DynamicResource TextFillColorPrimary}" />
                            </Label.Foreground>
                        </Label>
                        <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,8,0,0"
                            VerticalContentAlignment="Center"
                            Content="{x:Static resources:Resource.PackagesPage_DownloadTo}">
                            <Label.Foreground>
                                <SolidColorBrush Color="{DynamicResource TextFillColorPrimary}" />
                            </Label.Foreground>
                        </Label>

                        <wpfui:TextBox
                            x:Name="_machineTypeTextBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="{x:Static resources:Resource.PackagesPage_MachineType}"
                            ClearButtonEnabled="False"
                            PlaceholderText="{x:Static resources:Resource.PackagesPage_MachineType_Placeholder}"
                            Text="{Binding MachineType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            x:Name="_osComboBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="8,8,0,0"
                            AutomationProperties.Name="{x:Static resources:Resource.PackagesPage_OperatingSystem}"
                            MaxDropDownHeight="Auto"
                            SelectionChanged="OsComboBox_SelectionChanged" />
                        <Grid
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="8,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <wpfui:TextBox
                                x:Name="_downloadToText"
                                Grid.Column="0"
                                AutomationProperties.Name="{x:Static resources:Resource.PackagesPage_DownloadTo}"
                                ClearButtonEnabled="False"
                                PlaceholderText="{x:Static resources:Resource.PackagesPage_DownloadTo_Placeholder}"
                                TextChanged="DownloadToText_OnTextChanged" />

                            <wpfui:Button
                                Grid.Column="1"
                                Margin="4,0,0,0"
                                VerticalAlignment="Stretch"
                                Click="DownloadToButton_Click"
                                Icon="MoreHorizontal24"
                                ToolTip="{x:Static resources:Resource.PackagesPage_DownloadTo}" />

                            <wpfui:Button
                                Grid.Column="2"
                                Margin="4,0,0,-1"
                                VerticalAlignment="Stretch"
                                Click="OpenDownloadToButton_Click"
                                Icon="Open24"
                                ToolTip="{x:Static resources:Resource.PackagesPage_OpenDownloadTo}" />

                        </Grid>

                        <StackPanel
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Grid.Column="3"
                            HorizontalAlignment="Right">

                            <TextBlock
                                Margin="0,0,0,4"
                                AutomationProperties.Name="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Text}"
                                Focusable="True"
                                Text="{x:Static resources:Resource.PackagesPage_Source}" />
                            <RadioButton
                                x:Name="_sourcePrimaryRadio"
                                AutomationProperties.HelpText="{x:Static resources:Resource.PackagesPage_PrimarySource_Message}"
                                AutomationProperties.Name="{x:Static resources:Resource.PackagesPage_PrimarySource}"
                                Checked="SourceRadio_Checked"
                                Focusable="True"
                                GroupName="source"
                                IsChecked="True">
                                <StackPanel>
                                    <TextBlock Text="{x:Static resources:Resource.PackagesPage_PrimarySource}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{x:Static resources:Resource.PackagesPage_PrimarySource_Message}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                x:Name="_sourceSecondaryRadio"
                                AutomationProperties.HelpText="{x:Static resources:Resource.PackagesPage_SecondarySource_Message}"
                                AutomationProperties.Name="{x:Static resources:Resource.PackagesPage_SecondarySource}"
                                Checked="SourceRadio_Checked"
                                GroupName="source">
                                <StackPanel>
                                    <TextBlock Text="{x:Static resources:Resource.PackagesPage_SecondarySource}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{x:Static resources:Resource.PackagesPage_SecondarySource_Message}" />
                                </StackPanel>
                            </RadioButton>

                        </StackPanel>

                        <wpfui:Button
                            Grid.Row="3"
                            Grid.Column="3"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Appearance="Primary"
                            Command="{Binding LoadPackagesCommand}"
                            Content="{x:Static resources:Resource.Refresh}" />

                        <wpfui:Button
                            Grid.Row="3"
                            Grid.Column="3"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Appearance="Secondary"
                            Command="{Binding CancelLoadCommand}"
                            Content="{x:Static resources:Resource.Cancel}"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

                    </Grid>
                </custom:CardControl.Header>
            </custom:CardControl>

            <controls:LoadableControl
                Grid.Row="2"
                ContentVisibilityWhileLoading="Collapsed"
                IndicatorVerticalAlignment="Center"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:LoadableControl.LoadingContent>
                    <StackPanel
                        Margin="0,0,16,12"
                        AutomationProperties.AutomationId="PackagesLoadingSkeleton">
                        <Border Style="{StaticResource AppSkeletonDenseListItemCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                <Border Grid.Column="1" Width="40" Height="40" Margin="0,0,14,0" CornerRadius="{StaticResource CornerRadiusSM}" Style="{StaticResource AppSkeletonShimmerBlockStyle}" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Border Width="240" Style="{StaticResource AppSkeletonListItemPrimaryLineStyle}" />
                                    <Border Width="180" Style="{StaticResource AppSkeletonListItemSecondaryLineStyle}" />
                                    <Border Height="12" Margin="0,10,96,0" Style="{StaticResource AppSkeletonListItemSecondaryLineStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource AppSkeletonDenseListItemCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                <Border Grid.Column="1" Width="40" Height="40" Margin="0,0,14,0" CornerRadius="{StaticResource CornerRadiusSM}" Style="{StaticResource AppSkeletonShimmerBlockStyle}" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Border Width="210" Style="{StaticResource AppSkeletonListItemPrimaryLineStyle}" />
                                    <Border Width="150" Style="{StaticResource AppSkeletonListItemSecondaryLineStyle}" />
                                    <Border Height="12" Margin="0,10,120,0" Style="{StaticResource AppSkeletonListItemSecondaryLineStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource AppSkeletonDenseListItemCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource AppSkeletonListItemIconStyle}" />
                                <Border Grid.Column="1" Width="40" Height="40" Margin="0,0,14,0" CornerRadius="{StaticResource CornerRadiusSM}" Style="{StaticResource AppSkeletonShimmerBlockStyle}" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Border Width="196" Style="{StaticResource AppSkeletonListItemPrimaryLineStyle}" />
                                    <Border Width="128" Style="{StaticResource AppSkeletonListItemSecondaryLineStyle}" />
                                    <Border Height="12" Margin="0,10,80,0" Style="{StaticResource AppSkeletonListItemSecondaryLineStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </controls:LoadableControl.LoadingContent>
                <wpfui:DynamicScrollViewer>

                    <StackPanel>

                        <custom:InfoBar
                            Title="{x:Static resources:Resource.PackagesPage_Disclaimer_Message}"
                            Margin="0,0,16,8"
                            IsClosable="False"
                            IsOpen="True"
                            Severity="Informational" />

                        <Grid Margin="0,0,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <wpfui:TextBox
                                Grid.Column="0"
                                AutomationProperties.Name="{x:Static resources:Resource.Filter}"
                                Icon="Search24"
                                PlaceholderEnabled="True"
                                PlaceholderText="{x:Static resources:Resource.Filter}"
                                Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                Content="{x:Static resources:Resource.PackagesPage_OnlyShowUpdates}"
                                IsChecked="{Binding OnlyShowUpdates, Mode=TwoWay}" />

                            <ComboBox
                                Grid.Column="3"
                                MaxDropDownHeight="Auto"
                                SelectedIndex="{Binding SortingIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{x:Static resources:Resource.PackagesPage_Sort_Name}" />
                                <ComboBoxItem Content="{x:Static resources:Resource.PackagesPage_Sort_Category}" />
                                <ComboBoxItem Content="{x:Static resources:Resource.PackagesPage_Sort_Date}" />
                            </ComboBox>

                        </Grid>

                        <ItemsControl
                            Margin="0,0,16,12"
                            ItemsSource="{Binding FilteredPackages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <custom:CardControl Margin="0,0,0,8">
                                        <StackPanel Margin="8">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Category}" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Description}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding Description, Converter={StaticResource TextToVisibilityConverter}}" />
                                        </StackPanel>
                                    </custom:CardControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            Margin="0,32,16,32"
                            HorizontalAlignment="Center"
                            Focusable="True"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{x:Static resources:Resource.PackagesPage_NoMatchingDownloads}"
                            Visibility="{Binding HasNoFilteredPackages, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <wpfui:HyperlinkButton
                            Margin="0,8,16,12"
                            HorizontalAlignment="Right"
                            Command="{Binding ClearHiddenPackagesCommand}"
                            Content="{x:Static resources:Resource.PackagesPage_ShowHiddenDownloads}"
                            Icon="Eye24"
                            Visibility="{Binding HasHiddenPackages, Converter={StaticResource BoolToVisibilityConverter}}" />

                    </StackPanel>

                </wpfui:DynamicScrollViewer>
            </controls:LoadableControl>

        </Grid>
    </Grid>
</Page>
