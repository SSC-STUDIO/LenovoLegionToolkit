<Page
    x:Class="UniversalDeviceToolkit.WPF.Pages.WindowsOptimizationPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="Auto"
    TextOptions.TextHintingMode="Fixed"
    RenderOptions.BitmapScalingMode="HighQuality"
    xmlns:controls="clr-namespace:UniversalDeviceToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:UniversalDeviceToolkit.WPF.Controls.Custom"
    xmlns:opt="clr-namespace:UniversalDeviceToolkit.WPF.Pages.WindowsOptimization"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:UniversalDeviceToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:conv="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
    Title="{x:Static resources:Resource.SettingsPage_WindowsOptimization_Title}"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}">

    <Page.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <!-- Unified segmented navigation: one surface, lightweight selected state. -->
        <Style TargetType="RadioButton" x:Key="NavRadioButtonStyle">
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="18,8,18,9" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="RootBorder"
                            MinHeight="{TemplateBinding MinHeight}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerRadiusControl}"
                            Margin="{TemplateBinding Margin}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="3" />
                                </Grid.RowDefinitions>
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Grid.Row="0"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    TextElement.FontWeight="{TemplateBinding FontWeight}"
                                    TextElement.FontSize="{TemplateBinding FontSize}"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Border
                                    x:Name="ActiveIndicator"
                                    Grid.Row="1"
                                    Width="22"
                                    Height="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource CornerRadiusCompact}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="ContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="ContentPresenter" Property="TextElement.FontWeight" Value="SemiBold" />
                                <Setter TargetName="ActiveIndicator" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="RootBorder" Property="Background" Value="Transparent" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="ContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                <Setter TargetName="ContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Background" Value="Transparent" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="ContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Border" x:Key="CardContainerStyle">
            <Setter Property="Padding" Value="{StaticResource SpacingMD}" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusCard}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,16,16" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                    </Trigger>
                </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitleTextStyle" BasedOn="{StaticResource AppSectionTitleTextBlockStyle}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="PrimaryActionButtonStyle" TargetType="wpfui:Button" BasedOn="{StaticResource AppButtonPrimary}">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CleanupActionButtonStyle" TargetType="wpfui:Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="DriverFieldLabelStyle" TargetType="Label">
            <Setter Property="MinWidth" Value="122" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="DriverSourcePanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusControl}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="DriverSourceRadioStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style x:Key="DriverIconButtonStyle" TargetType="wpfui:Button" BasedOn="{StaticResource AppButtonCompact}">
            <Setter Property="Width" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="DriverToolbarPanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusControl}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="DriverSkeletonCardStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonCardStyle}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="DriverSkeletonShimmerBlockStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}" />
    </Page.Resources>

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Margin="0,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,16,0,24">
                <TextBlock
                    Margin="0,0,0,8"
                    AutomationProperties.Name="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Text}"
                    Focusable="True"
                    Style="{StaticResource AppPageTitleTextBlockStyle}"
                    Text="{Binding PageHeaderTitle, FallbackValue={x:Static resources:Resource.SettingsPage_WindowsOptimization_Title}}" />

                <TextBlock
                    MaxWidth="540"
                    HorizontalAlignment="Left"
                    Style="{StaticResource AppPageDescriptionTextBlockStyle}"
                    Text="{Binding PageHeaderDescription, FallbackValue={x:Static resources:Resource.WindowsOptimizationPage_Info}}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="3"
                    Background="{DynamicResource ControlFillColorTertiaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusCard}"
                    Margin="0,0,20,0">
                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <RadioButton
                            x:Name="_optimizationNavButton"
                            AutomationProperties.AutomationId="WindowsOptimizationOptimizationTabButton"
                            Style="{StaticResource NavRadioButtonStyle}"
                            GroupName="WindowsOptimizationNav"
                            Content="{x:Static resources:Resource.WindowsOptimizationPage_Tab_Optimization}"
                            IsChecked="True"
                            Checked="NavButton_Checked" />
                        <RadioButton
                            x:Name="_cleanupNavButton"
                            AutomationProperties.AutomationId="WindowsOptimizationCleanupTabButton"
                            Style="{StaticResource NavRadioButtonStyle}"
                            GroupName="WindowsOptimizationNav"
                            Content="{x:Static resources:Resource.WindowsOptimizationPage_Tab_Cleanup}"
                            Checked="NavButton_Checked" />
                        <RadioButton
                            x:Name="_driverDownloadNavButton"
                            AutomationProperties.AutomationId="WindowsOptimizationDriverTabButton"
                            Style="{StaticResource NavRadioButtonStyle}"
                            GroupName="WindowsOptimizationNav"
                            Content="{x:Static resources:Resource.WindowsOptimizationPage_Tab_DriverDownload}"
                            Checked="NavButton_Checked" />
                        <RadioButton
                            x:Name="_networkAccelerationNavButton"
                            AutomationProperties.AutomationId="WindowsOptimizationNetworkAccelerationTabButton"
                            Style="{StaticResource NavRadioButtonStyle}"
                            GroupName="WindowsOptimizationNav"
                            Content="{x:Static resources:Resource.WindowsOptimizationPage_Tab_NetworkAcceleration}"
                            Checked="NavButton_Checked" />

                    </StackPanel>
                </Border>
                
                <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text=""
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            FontSize="14"
                            Visibility="Collapsed" />

                        <!-- Same tab-row chrome slot for bulk actions (opt/cleanup/drivers) and NA selection.
                             Visual parity with bulk SelectedActions bar: Tertiary fill, Card radius, wpfui Secondary buttons. -->
                        <Border
                            x:Name="_networkAccelerationSelectionBar"
                            Grid.Column="1"
                            Padding="3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ControlFillColorTertiaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusCard}"
                            SnapsToDevicePixels="True"
                            AutomationProperties.AutomationId="NetworkAccelerationSelectionBar"
                            AutomationProperties.Name="{x:Static resources:Resource.NetworkAccelerationPage_SelectionBar}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNetworkAccelerationMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Resources>
                                <Style TargetType="wpfui:Button" BasedOn="{StaticResource {x:Type wpfui:Button}}">
                                    <Setter Property="MinHeight" Value="40" />
                                    <Setter Property="Padding" Value="12,7" />
                                </Style>
                            </Border.Resources>
                            <StackPanel Orientation="Horizontal">
                                <!-- Count summary (display-only; bulk mode opens a list window on click) -->
                                <wpfui:Button
                                    MinWidth="148"
                                    Margin="0,0,4,0"
                                    Appearance="Secondary"
                                    Focusable="False"
                                    IsHitTestVisible="False"
                                    IsTabStop="False"
                                    ToolTip="{x:Static resources:Resource.NetworkAccelerationPage_SelectionBar}"
                                    AutomationProperties.Name="{x:Static resources:Resource.NetworkAccelerationPage_SelectionBar}">
                                    <StackPanel Orientation="Horizontal">
                                        <wpfui:SymbolIcon
                                            Margin="0,0,8,0"
                                            Symbol="DocumentBulletList24" />
                                        <TextBlock
                                            x:Name="_networkAccelerationSelectionCount"
                                            VerticalAlignment="Center"
                                            Text="{x:Static resources:Resource.NetworkAccelerationPage_SelectionCountZero}"
                                            AutomationProperties.AutomationId="NetworkAccelerationSelectionCount" />
                                    </StackPanel>
                                </wpfui:Button>
                                <wpfui:Button
                                    x:Name="_networkAccelerationSelectionFavoriteButton"
                                    MinWidth="40"
                                    Margin="0,0,4,0"
                                    Appearance="Secondary"
                                    IsEnabled="False"
                                    AutomationProperties.AutomationId="NetworkAccelerationSelectionFavoriteButton"
                                    AutomationProperties.Name="{x:Static resources:Resource.NetworkAccelerationPage_SelectionFavorite}"
                                    ToolTip="{x:Static resources:Resource.NetworkAccelerationPage_SelectionFavoriteTooltip}">
                                    <wpfui:SymbolIcon Symbol="Star24" />
                                </wpfui:Button>
                                <wpfui:Button
                                    x:Name="_networkAccelerationSelectionStartButton"
                                    MinWidth="40"
                                    Margin="0"
                                    Appearance="Secondary"
                                    IsEnabled="False"
                                    AutomationProperties.AutomationId="NetworkAccelerationSelectionStartButton"
                                    AutomationProperties.Name="{x:Static resources:Resource.NetworkAccelerationPage_SelectionStart}"
                                    ToolTip="{x:Static resources:Resource.NetworkAccelerationPage_SelectionStartTooltip}">
                                    <wpfui:SymbolIcon Symbol="Play24" />
                                </wpfui:Button>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="3"
                            HorizontalAlignment="Right"
                            Background="{DynamicResource ControlFillColorTertiaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusCard}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNetworkAccelerationMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Resources>
                                <Style TargetType="wpfui:Button" BasedOn="{StaticResource {x:Type wpfui:Button}}">
                                    <Setter Property="MinHeight" Value="40" />
                                    <Setter Property="Padding" Value="12,7" />
                                </Style>
                            </Border.Resources>
                            <StackPanel Orientation="Horizontal">
                            <wpfui:Button
                                AutomationProperties.AutomationId="WindowsOptimizationSelectedActionsButton"
                                MinWidth="148"
                                Margin="0,0,4,0"
                                Appearance="Secondary"
                                ToolTip="{x:Static resources:Resource.WindowsOptimizationPage_SelectedActions_Header}"
                                AutomationProperties.Name="{x:Static resources:Resource.WindowsOptimizationPage_SelectedActions_Header}"
                                Click="SelectedActionsButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <wpfui:SymbolIcon
                                        Margin="0,0,8,0"
                                        Symbol="DocumentBulletList24" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding SelectedActionsSummary, FallbackValue=''}" />
                                </StackPanel>
                            </wpfui:Button>
                            <wpfui:Button
                                x:Name="_selectRecommendedButton"
                                AutomationProperties.AutomationId="WindowsOptimizationSelectRecommendedButton"
                                MinWidth="40"
                                Margin="0,0,4,0"
                                Appearance="Secondary"
                                ToolTip="{x:Static resources:Resource.WindowsOptimizationPage_SelectRecommended_Button}"
                                AutomationProperties.Name="{x:Static resources:Resource.WindowsOptimizationPage_SelectRecommended_Button}"
                                Click="SelectRecommendedButton_Click">
                                <wpfui:SymbolIcon Symbol="Star24" />
                            </wpfui:Button>
                            <wpfui:Button
                                x:Name="_clearButton"
                                AutomationProperties.AutomationId="WindowsOptimizationBulkActionButton"
                                MinWidth="40"
                                Margin="0"
                                Appearance="Secondary"
                                Click="ClearSelectionButton_Click">
                                <wpfui:Button.Style>
                                    <Style TargetType="wpfui:Button" BasedOn="{StaticResource {x:Type wpfui:Button}}">
                                        <Setter Property="MinHeight" Value="40" />
                                        <Setter Property="Padding" Value="12,7" />
                                        <Setter Property="ToolTip" Value="{x:Static resources:Resource.WindowsOptimizationPage_ClearSelection_Button}" />
                                        <Setter Property="AutomationProperties.Name" Value="{x:Static resources:Resource.WindowsOptimizationPage_ClearSelection_Button}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDriverDownloadMode}" Value="True">
                                                <Setter Property="ToolTip" Value="{Binding StartAllButtonText}" />
                                                <Setter Property="AutomationProperties.Name" Value="{Binding StartAllButtonText}" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDriverDownloadMode}" Value="True" />
                                                    <Condition Binding="{Binding IsAnyDriverRunning}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="ToolTip" Value="{Binding PauseAllButtonText}" />
                                                <Setter Property="AutomationProperties.Name" Value="{Binding PauseAllButtonText}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </wpfui:Button.Style>
                                <wpfui:SymbolIcon>
                                    <wpfui:SymbolIcon.Style>
                                        <Style TargetType="wpfui:SymbolIcon">
                                            <Setter Property="Symbol" Value="Delete24" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDriverDownloadMode}" Value="True">
                                                    <Setter Property="Symbol" Value="Play24" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsDriverDownloadMode}" Value="True" />
                                                        <Condition Binding="{Binding IsAnyDriverRunning}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Symbol" Value="Pause24" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </wpfui:SymbolIcon.Style>
                                </wpfui:SymbolIcon>
                            </wpfui:Button>
                            </StackPanel>
                        </Border>
                    </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Category list for optimization, cleanup, and beautification modes -->
                <ScrollViewer
                    x:Name="_categoriesList"
                    AutomationProperties.AutomationId="WindowsOptimizationCategoryList"
                    Grid.Column="0"
                    Margin="0,0,16,0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    CanContentScroll="False"
                    PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDriverDownloadMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNetworkAccelerationMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl
                        ItemsSource="{Binding ActiveCategories}"
                        VirtualizingStackPanel.IsVirtualizing="True"
                        VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <custom:CardExpander
                                    AutomationProperties.AutomationId="{Binding Key, StringFormat=WindowsOptimizationCategory_{0}}"
                                    IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                    Margin="0,0,0,8">
                                    <custom:CardExpander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock
                                                    FontWeight="Medium"
                                                    Text="{Binding Title}" />
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Description}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <!--
                                              Gear only when category HasSettings is true.
                                              WPF-UI needs DataContext=Self so PressedForeground resolves on the Button
                                              (not ContentPresenter). Real data therefore binds via CardExpander.DataContext,
                                              not inherited Grid/Self.
                                            -->
                                            <wpfui:Button
                                                Grid.Column="1"
                                                x:Name="_categorySettingsButton"
                                                DataContext="{Binding RelativeSource={RelativeSource Self}}"
                                                PressedForeground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=custom:CardExpander}}"
                                                AutomationProperties.AutomationId="{Binding DataContext.PluginId, RelativeSource={RelativeSource AncestorType=custom:CardExpander}, StringFormat=WindowsOptimizationCategorySettings_{0}}"
                                                Margin="12,0,8,0"
                                                VerticalAlignment="Center"
                                                Appearance="Transparent"
                                                ToolTip="{x:Static resources:Resource.Settings}"
                                                Click="OpenStyleSettingsButton_Click"
                                                Visibility="{Binding DataContext.HasSettings, RelativeSource={RelativeSource AncestorType=custom:CardExpander}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <wpfui:Button.Icon>
                                                    <wpfui:SymbolIcon Symbol="Settings24" />
                                                </wpfui:Button.Icon>
                                            </wpfui:Button>
                                            <TextBlock
                                                Grid.Column="2"
                                                Margin="0,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding SelectionSummary}" />
                                        </Grid>
                                    </custom:CardExpander.Header>
                                    <ItemsControl
                                        ItemsSource="{Binding Actions}"
                                        Margin="12,8,0,0"
                                        VirtualizingStackPanel.IsVirtualizing="True"
                                        VirtualizingStackPanel.VirtualizationMode="Recycling">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8"
                                                      MouseLeftButtonDown="ActionItem_MouseLeftButtonDown"
                                                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox
                                                        Grid.Column="0"
                                                        AutomationProperties.AutomationId="{Binding Key, StringFormat=WindowsOptimizationAction_{0}}"
                                                        VerticalAlignment="Center"
                                                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding Title}" />
                                                    <wpfui:Badge
                                                        Grid.Column="2"
                                                        x:Name="_recommendedBadge"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding HasRecommendedTag, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding RecommendedTagText}" />
                                                    </wpfui:Badge>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </custom:CardExpander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Content for driver download mode -->
                <Grid Grid.Column="0" Margin="0,0,16,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDriverDownloadMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
