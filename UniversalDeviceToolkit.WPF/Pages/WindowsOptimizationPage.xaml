                                                    <Border
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Width="280"
                                                        Height="16"
                                                        HorizontalAlignment="Left"
                                                        Style="{StaticResource DriverSkeletonShimmerBlockStyle}" />
