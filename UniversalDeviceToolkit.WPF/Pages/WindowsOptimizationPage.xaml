                                                        Grid.Row="0"
                                                        Grid.Column="2"
                                                        Orientation="Horizontal">
                                                        <Border
                                                            Width="34"
                                                            Height="30"
                                                            Margin="0,0,8,0"
                                                            Style="{StaticResource DriverSkeletonShimmerBlockStyle}" />
                                                        <Border
                                                            Width="34"
                                                            Height="30"
                                                            Style="{StaticResource DriverSkeletonShimmerBlockStyle}" />
