                                                        Grid.Row="0"
                                                        Grid.Column="2"
                                                        Orientation="Horizontal">
                                                        <Border
                                                            Width="34"
                                                            Height="30"
                                                            Margin="0,0,8,0"
                                                            Style="{StaticResource DriverSkeletonShimmerBlockStyle}" />
                                                        <Border
                                                            Width="34"
                                                            Height="30"
                                                            Style="{StaticResource DriverSkeletonShimmerBlockStyle}" />
                                                    </StackPanel>
                                                    <Border
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        Width="170"
                                                        Height="12"
                                                        Margin="0,8,0,0"
                                                        HorizontalAlignment="Left"
                                                        Style="{StaticResource DriverSkeletonShimmerBlockStyle}" />
                                                    <Border
                                                        Grid.Row="2"
                                                        Grid.Column="1"
                                                        Height="12"
                                                        Margin="0,10,110,0"
                                                        Style="{StaticResource DriverSkeletonShimmerBlockStyle}" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource DriverSkeletonCardStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border
                                                        Grid.Row="0"
                                                        Grid.RowSpan="3"
                                                        Grid.Column="0"
                                                        Width="18"
                                                        Height="18"
                                                        Margin="0,2,14,0"
                                                        VerticalAlignment="Top"
                                                        Style="{StaticResource DriverSkeletonShimmerBlockStyle}" />
                                                    <Border
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Width="340"
                                                        Height="16"
                                                        HorizontalAlignment="Left"
                                                        Style="{StaticResource DriverSkeletonShimmerBlockStyle}" />
                                                    <StackPanel
                                                        Grid.Row="0"
                                                        Grid.Column="2"
                                                        Orientation="Horizontal">
                                                        <Border
                                                            Width="34"
                                                            Height="30"
                                                            Margin="0,0,8,0"
                                                            Style="{StaticResource DriverSkeletonShimmerBlockStyle}" />
                                                        <Border
                                                            Width="34"
                                                            Height="30"
                                                            Style="{StaticResource DriverSkeletonShimmerBlockStyle}" />
                                                    </StackPanel>
                                                    <Border
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        Width="210"
                                                        Height="12"
                                                        Margin="0,8,0,0"
                                                        HorizontalAlignment="Left"
                                                        Style="{StaticResource DriverSkeletonShimmerBlockStyle}" />
                                                    <Border
                                                        Grid.Row="2"
                                                        Grid.Column="1"
                                                        Height="12"
                                                        Margin="0,10,70,0"
                                                        Style="{StaticResource DriverSkeletonShimmerBlockStyle}" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource DriverSkeletonCardStyle}">
