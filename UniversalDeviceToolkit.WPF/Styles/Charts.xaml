<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="clr-namespace:UniversalDeviceToolkit.WPF.Controls.Charts">

    <Style TargetType="{x:Type charts:TrendChartControl}">
        <Setter Property="GridlineBrush" Value="{DynamicResource ChartGridlineBrush}" />
        <Setter Property="BaselineBrush" Value="{DynamicResource ChartBaselineBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Default template for the self-drawn radial gauge. -->
    <Style TargetType="{x:Type charts:RadialGaugeControl}">
        <Setter Property="RingBrush" Value="{DynamicResource ChartUtilizationBrush}" />
        <Setter Property="RingThickness" Value="5" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="{StaticResource GaugeSizeMD}" />
        <Setter Property="Height" Value="{StaticResource GaugeSizeMD}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type charts:RadialGaugeControl}">
                    <Grid>
                        <Path x:Name="PART_Track" />
                        <!-- Blurred underlay that gives the value arc a soft glow. -->
                        <Path x:Name="PART_Glow" Opacity="0.55">
                            <Path.Effect>
                                <BlurEffect Radius="5" KernelType="Gaussian" />
                            </Path.Effect>
                        </Path>
                        <Path x:Name="PART_Value" />
                        <!-- Bright dot riding the leading edge of the value arc. -->
                        <Ellipse
                            x:Name="PART_Tip"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Visibility="Collapsed" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="PART_ValueText"
                                HorizontalAlignment="Center"
                                FontSize="{DynamicResource FontSizeGaugeValue}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock
                                x:Name="PART_CaptionText"
                                HorizontalAlignment="Center"
                                FontSize="{DynamicResource FontSizeDenseCaption}"
                                Opacity="0.7"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
