<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="clr-namespace:UniversalDeviceToolkit.WPF.Controls.Charts">

    <!-- Default template for the self-drawn radial gauge. -->
    <Style TargetType="{x:Type charts:RadialGaugeControl}">
        <Setter Property="RingBrush" Value="{DynamicResource ChartUtilizationBrush}" />
        <Setter Property="RingThickness" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="{StaticResource GaugeSizeMD}" />
        <Setter Property="Height" Value="{StaticResource GaugeSizeMD}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type charts:RadialGaugeControl}">
                    <Grid>
                        <Path x:Name="PART_Track" />
                        <Path x:Name="PART_Value" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="PART_ValueText"
                                HorizontalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock
                                x:Name="PART_CaptionText"
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
