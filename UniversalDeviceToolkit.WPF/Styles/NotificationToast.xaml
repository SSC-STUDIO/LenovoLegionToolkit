<!--
    UDT notification toast language — glass card matching AppStatusBanner.
    Template structure adapted from WPF-UI Snackbar (MIT) with UDT tokens.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="NotificationToastWidth">360</sys:Double>
    <Thickness x:Key="NotificationToastPadding">10</Thickness>
    <Thickness x:Key="NotificationToastMargin">0,0,0,0</Thickness>

    <Style TargetType="{x:Type controls:Snackbar}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="ContentForeground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource NotificationGlassSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NotificationGlassBorderBrush}" />
        <Setter Property="Margin" Value="{StaticResource NotificationToastMargin}" />
        <Setter Property="Width" Value="{StaticResource NotificationToastWidth}" />
        <Setter Property="MaxWidth" Value="{StaticResource NotificationToastWidth}" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Snackbar}">
                    <Grid
                        x:Name="CardBorderContainer"
                        Margin="0,0,0,-200"
                        Opacity="0"
                        AutomationProperties.Name="{TemplateBinding Title}">
                        <Border
                            x:Name="CardBorder"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{StaticResource NotificationToastPadding}"
                            VerticalAlignment="Bottom"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusCard}"
                            Effect="{DynamicResource NotificationGlassShadowEffect}"
                            RenderTransform="{TemplateBinding SlideTransform}"
                            Visibility="{TemplateBinding Visibility}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                    x:Name="IconChrome"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Content="{TemplateBinding Icon}"
                                    TextElement.FontSize="20"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />

                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ContentPresenter
                                        x:Name="TitleContentPresenter"
                                        Grid.Row="0"
                                        Content="{TemplateBinding Title}"
                                        ContentTemplate="{TemplateBinding TitleTemplate}"
                                        TextElement.FontSize="{DynamicResource FontSizeBody}"
                                        TextElement.FontWeight="SemiBold"
                                        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <ContentPresenter.Resources>
                                            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                                                <Setter Property="TextWrapping" Value="WrapWithOverflow" />
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>

                                    <ContentPresenter
                                        Grid.Row="1"
                                        Content="{TemplateBinding Content}"
                                        ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                        TextElement.FontSize="{DynamicResource FontSizeCaption}"
                                        TextElement.FontWeight="Regular"
                                        TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <ContentPresenter.Resources>
                                            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                                                <Setter Property="TextWrapping" Value="WrapWithOverflow" />
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </Grid>

                                <controls:Button
                                    x:Name="CloseButton"
                                    Grid.Column="2"
                                    Width="28"
                                    Height="28"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Appearance="Transparent"
                                    AutomationProperties.Name="{x:Static resources:Resource.CloseNotification_AutomationName}"
                                    Command="{Binding Path=TemplateButtonCommand, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                    CornerRadius="{StaticResource CornerRadiusCompact}"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    ToolTip="{x:Static resources:Resource.Close_Tooltip}">
                                    <controls:Button.Icon>
                                        <controls:SymbolIcon FontSize="14" Symbol="Dismiss20" />
                                    </controls:Button.Icon>
                                </controls:Button>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconChrome" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconChrome" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsCloseButtonEnabled" Value="False">
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CloseButton" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsShown" Value="True">
                            <Setter Property="Focusable" Value="True" />
                            <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ThicknessAnimationUsingKeyFrames
                                            BeginTime="00:00:00"
                                            Storyboard.TargetName="CardBorderContainer"
                                            Storyboard.TargetProperty="Margin">
                                            <SplineThicknessKeyFrame KeyTime="00:00:00" Value="0,0,0,-200" />
                                            <SplineThicknessKeyFrame KeyTime="00:00:.26" Value="0,0,0,0" />
                                        </ThicknessAnimationUsingKeyFrames>
                                        <DoubleAnimation
                                            Storyboard.TargetName="CardBorderContainer"
                                            Storyboard.TargetProperty="(Grid.Opacity)"
                                            From="0"
                                            To="1"
                                            Duration="0:0:.26" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ThicknessAnimationUsingKeyFrames
                                            BeginTime="00:00:00"
                                            Storyboard.TargetName="CardBorderContainer"
                                            Storyboard.TargetProperty="Margin">
                                            <SplineThicknessKeyFrame KeyTime="00:00:00" Value="0,0,0,0" />
                                            <SplineThicknessKeyFrame KeyTime="00:00:.32" Value="0,0,0,-200" />
                                        </ThicknessAnimationUsingKeyFrames>
                                        <DoubleAnimation
                                            Storyboard.TargetName="CardBorderContainer"
                                            Storyboard.TargetProperty="(Grid.Opacity)"
                                            From="1"
                                            To="0"
                                            Duration="0:0:.32" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Severity via icon accent only — keep glass surface for all appearances. -->
        <Style.Triggers>
            <Trigger Property="Appearance" Value="Secondary">
                <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
                <Setter Property="Background" Value="{DynamicResource NotificationGlassSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NotificationGlassBorderBrush}" />
            </Trigger>
            <Trigger Property="Appearance" Value="Success">
                <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
                <Setter Property="Background" Value="{DynamicResource NotificationGlassSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NotificationGlassBorderBrush}" />
            </Trigger>
            <Trigger Property="Appearance" Value="Info">
                <Setter Property="Foreground" Value="{DynamicResource StatusInfoBrush}" />
                <Setter Property="Background" Value="{DynamicResource NotificationGlassSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NotificationGlassBorderBrush}" />
            </Trigger>
            <Trigger Property="Appearance" Value="Caution">
                <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
                <Setter Property="Background" Value="{DynamicResource NotificationGlassSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NotificationGlassBorderBrush}" />
            </Trigger>
            <Trigger Property="Appearance" Value="Danger">
                <Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
                <Setter Property="Background" Value="{DynamicResource NotificationGlassSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NotificationGlassBorderBrush}" />
            </Trigger>
            <Trigger Property="Appearance" Value="Transparent">
                <Setter Property="Background" Value="{DynamicResource NotificationGlassSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NotificationGlassBorderBrush}" />
            </Trigger>
            <Trigger Property="Appearance" Value="Primary">
                <Setter Property="Foreground" Value="{DynamicResource StatusInfoBrush}" />
                <Setter Property="Background" Value="{DynamicResource NotificationGlassSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NotificationGlassBorderBrush}" />
            </Trigger>
            <Trigger Property="Appearance" Value="Dark">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="{DynamicResource NotificationGlassSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NotificationGlassBorderBrush}" />
            </Trigger>
            <Trigger Property="Appearance" Value="Light">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="{DynamicResource NotificationGlassSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NotificationGlassBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
