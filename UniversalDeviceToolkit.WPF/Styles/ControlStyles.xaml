<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
      Shared control chrome loaded AFTER WPF-UI defaults.
      Only targets interactive controls — never implicit Border styles.
    -->

    <Style BasedOn="{StaticResource {x:Type wpfui:TextBox}}" TargetType="wpfui:TextBox">
        <Setter Property="MinHeight" Value="{StaticResource ButtonHeightStandard}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
    </Style>

    <Style BasedOn="{StaticResource {x:Type wpfui:PasswordBox}}" TargetType="wpfui:PasswordBox">
        <Setter Property="MinHeight" Value="{StaticResource ButtonHeightStandard}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
    </Style>

    <Style BasedOn="{StaticResource {x:Type wpfui:NumberBox}}" TargetType="wpfui:NumberBox">
        <Setter Property="MinHeight" Value="{StaticResource ButtonHeightStandard}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
    </Style>

    <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource ButtonHeightStandard}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
    </Style>

    <!-- Old WPF-UI ComboBox chrome: full rounded field, stable selection text, native popup. -->
    <Style x:Key="AppComboBoxStyle" BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="{StaticResource ButtonHeightStandard}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
    </Style>

    <Style BasedOn="{StaticResource AppComboBoxStyle}" TargetType="ComboBox" />

    <!-- Pill-style status chip for compact badges (not full cards). -->
    <Style x:Key="AppStatusChipBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusRound}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--
      Content-hugging status pill (dot + label, promoted from NetworkAccelerationControl).
      Keep HorizontalAlignment=Left — Stretch + CornerRadius=999 paints a full-width
      capsule streak across the page. Distinct from AppStatusChipBorderStyle (asymmetric
      padding + layout setters); do not merge without re-checking rendered metrics.
    -->
    <Style x:Key="AppStatusPillBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusRound}" />
        <Setter Property="Padding" Value="9,4,11,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="AppStatusDotEllipseStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Margin" Value="0,0,7,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Compact metric tile (WrapPanel-friendly; pairs with AppMetric*TextBlockStyle). -->
    <Style x:Key="AppMetricTileBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusControl}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="MinWidth" Value="108" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Thin horizontal section divider. -->
    <Style x:Key="AppDividerBorderStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,10,0,10" />
        <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- Default tooltip: rounded corners matching the control corner language so every
         tooltip in the app renders with the same radius; background uses the card
         surface and a thin stroke keeps it readable on both light and dark surfaces. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource CornerRadiusControl}"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
