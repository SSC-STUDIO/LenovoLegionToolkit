<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- Skeleton shimmer gradient colors (theme-aware teal accent with transparency) -->
    <Color x:Key="SkeletonShimmerStartColor">#268891A0</Color>
    <Color x:Key="SkeletonShimmerPeakColor">#4A8891A0</Color>

    <Style x:Key="AppLoadingRingStyle" TargetType="wpfui:ProgressRing">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <RotateTransform Angle="-90" />
                    <ScaleTransform ScaleX="-1" />
                </TransformGroup>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppLoadingRingCompactStyle" TargetType="wpfui:ProgressRing" BasedOn="{StaticResource AppLoadingRingStyle}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>

    <Style x:Key="AppSkeletonBlockStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSM}" />
        <Setter Property="Opacity" Value="0.85" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style x:Key="AppSkeletonShimmerBlockStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonBlockStyle}">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" PresentationOptions:Freeze="True">
                    <GradientStop Color="{StaticResource SkeletonShimmerStartColor}" Offset="0" />
                    <GradientStop Color="{StaticResource SkeletonShimmerPeakColor}" Offset="0.48" />
                    <GradientStop Color="{StaticResource SkeletonShimmerStartColor}" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="-1.2" PresentationOptions:Freeze="True" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                            From="-1.2"
                            To="1.2"
                            Duration="{StaticResource AnimationDurationShimmer}"
                            EasingFunction="{StaticResource AnimationEasingCubicOut}"
                            RepeatBehavior="Forever" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppSkeletonCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusCard}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="AppSkeletonListItemCardStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonCardStyle}">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="AppSkeletonListItemIconStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSM}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="AppSkeletonListItemSingleLineStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
        <Setter Property="Height" Value="12" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSM}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppSkeletonListItemPrimaryLineStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
        <Setter Property="Height" Value="14" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSM}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="AppSkeletonListItemSecondaryLineStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
        <Setter Property="Height" Value="10" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSM}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

</ResourceDictionary>
