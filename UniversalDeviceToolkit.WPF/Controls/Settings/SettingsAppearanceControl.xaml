<UserControl
    x:Class="UniversalDeviceToolkit.WPF.Controls.Settings.SettingsAppearanceControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:UniversalDeviceToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:UniversalDeviceToolkit.WPF.Controls.Custom"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:UniversalDeviceToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,12">
            <custom:CardControl
                x:Name="_langCardControl"
                Margin="0,0,0,8"
                Icon="LocalLanguage24">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_Language_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_Language_Message}" />
                </custom:CardControl.Header>
                <StackPanel Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            x:Name="_langComboBox"
                            Grid.Column="0"
                            MinWidth="160"
                            AutomationProperties.AutomationId="LanguageComboBox"
                            AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_Language_Title}"
                            MaxDropDownHeight="Auto"
                            SelectionChanged="LangComboBox_SelectionChanged" />

                    <wpfui:Button
                        x:Name="_installLanguageButton"
                        Grid.Column="2"
                        MinWidth="40"
                        Appearance="Secondary"
                        AutomationProperties.AutomationId="InstallLanguageButton"
                        AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_Language_Install}"
                        Click="InstallLanguageButton_Click"
                        ToolTip="{x:Static resources:Resource.SettingsPage_Language_Install}">
                            <wpfui:Button.Icon>
                                <wpfui:SymbolIcon Symbol="ArrowDownload24" />
                            </wpfui:Button.Icon>
                        </wpfui:Button>

                        <wpfui:Button
                            x:Name="_uninstallLanguageButton"
                            Grid.Column="4"
                            MinWidth="40"
                            Appearance="Secondary"
                            Click="UninstallLanguageButton_Click"
                            ToolTip="{x:Static resources:Resource.SettingsPage_Language_Uninstall}">
                            <wpfui:Button.Icon>
                                <wpfui:SymbolIcon Symbol="Delete24" />
                            </wpfui:Button.Icon>
                        </wpfui:Button>
                    </Grid>

                    <StackPanel
                        x:Name="_languageOperationPanel"
                        Margin="0,12,0,0"
                        AutomationProperties.AutomationId="LanguageOperationPanel"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="_languageOperationStatusText"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar
                                x:Name="_languageOperationProgressBar"
                                Grid.Column="0"
                                Height="6"
                                AutomationProperties.AutomationId="LanguageOperationProgressBar"
                                IsIndeterminate="True"
                                Maximum="1"
                                Minimum="0" />
                            <TextBlock
                                x:Name="_languageOperationPercentText"
                                Grid.Column="1"
                                MinWidth="40"
                                Margin="12,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </custom:CardControl>

            <custom:CardControl Margin="0,0,0,8" Icon="Temperature24">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_Temperature_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_Temperature_Message}" />
                </custom:CardControl.Header>
                <ComboBox
                    x:Name="_temperatureComboBox"
                    MinWidth="160"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_Temperature_Title}"
                    MaxDropDownHeight="Auto"
                    SelectionChanged="TemperatureComboBox_SelectionChanged" />
            </custom:CardControl>

            <custom:CardControl Margin="0,0,0,8" Icon="DarkTheme24">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_Theme_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_Theme_Description}" />
                </custom:CardControl.Header>
                <!-- Watt Toolkit-style theme mode cards: preview thumbnail + label + selected border. -->
                <StackPanel>
                <WrapPanel x:Name="_themeCardsPanel" Margin="0,0,0,8">
                    <!-- Light -->
                    <Button x:Name="_themeLightCard" Margin="0,0,12,0" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ThemeCard_Click" Tag="Light">
                        <StackPanel>
                            <Border Width="96" Height="72" CornerRadius="{StaticResource CornerRadiusSmall}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Background="#F6F6F6">
                                <Grid Margin="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="{StaticResource CornerRadiusSmall}" Margin="0,0,0,4" />
                                    <Border Grid.Row="1" Height="12" Background="#E0E0E0" CornerRadius="{StaticResource CornerRadiusSmall}" />
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static resources:Resource.Theme_Light}" />
                        </StackPanel>
                    </Button>
                    <!-- Dark -->
                    <Button x:Name="_themeDarkCard" Margin="0,0,12,0" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ThemeCard_Click" Tag="Dark">
                        <StackPanel>
                            <Border Width="96" Height="72" CornerRadius="{StaticResource CornerRadiusSmall}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Background="#202020">
                                <Grid Margin="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#2D2D2D" CornerRadius="{StaticResource CornerRadiusSmall}" Margin="0,0,0,4" />
                                    <Border Grid.Row="1" Height="12" Background="#404040" CornerRadius="{StaticResource CornerRadiusSmall}" />
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static resources:Resource.Theme_Dark}" />
                        </StackPanel>
                    </Button>
                    <!-- System -->
                    <Button x:Name="_themeSystemCard" Margin="0" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ThemeCard_Click" Tag="System">
                        <StackPanel>
                            <Border Width="96" Height="72" CornerRadius="{StaticResource CornerRadiusSmall}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Grid Margin="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="{StaticResource CornerRadiusSmall}" Margin="0,0,0,4" />
                                    <Border Grid.Row="1" Height="12" Background="{DynamicResource ControlFillColorTertiaryBrush}" CornerRadius="{StaticResource CornerRadiusSmall}" />
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static resources:Resource.Theme_System}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- Theme style preset (merged from standalone card). -->
                <Border Style="{StaticResource AppDividerBorderStyle}" />
                <TextBlock
                    Margin="0,0,0,4"
                    FontSize="{DynamicResource FontSizeCaption}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{x:Static resources:Resource.SettingsPage_ThemeStyle_SubTitle}" />
                <ComboBox
                    x:Name="_themeStylePresetComboBox"
                    MinWidth="160"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_ThemeStyle_Title}"
                    MaxDropDownHeight="Auto"
                    SelectionChanged="ThemeStylePresetComboBox_SelectionChanged" />
                </StackPanel>
            </custom:CardControl>

            <custom:CardControl Margin="0,0,0,8" Icon="TextFontSize24">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_Font_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_Font_Description}" />
                </custom:CardControl.Header>
                <ComboBox
                    x:Name="_fontComboBox"
                    MinWidth="160"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_Font_Title}"
                    MaxDropDownHeight="Auto"
                    SelectionChanged="FontComboBox_SelectionChanged" />
            </custom:CardControl>

            <custom:CardControl Margin="0,0,0,8" Icon="TextFontSize24">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_UiScale_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_UiScale_Description}" />
                </custom:CardControl.Header>
                <ComboBox
                    x:Name="_uiScaleComboBox"
                    MinWidth="160"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_UiScale_Title}"
                    MaxDropDownHeight="Auto"
                    SelectionChanged="UiScaleComboBox_SelectionChanged" />
            </custom:CardControl>

            <custom:CardControl Margin="0,0,0,8" Icon="Color24">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_AccentColor_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_AccentColor_Description}" />
                </custom:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <controls:ColorPickerControl x:Name="_accentColorPicker" ColorChangedDelayed="AccentColorPicker_Changed" />
                    <ComboBox
                        x:Name="_accentColorSourceComboBox"
                        MinWidth="160"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_AccentColor_Title}"
                        MaxDropDownHeight="Auto"
                        SelectionChanged="AccentColorSourceComboBox_SelectionChanged" />
                </StackPanel>
            </custom:CardControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
