<UserControl
    x:Class="UniversalDeviceToolkit.WPF.Controls.Settings.SettingsAppearanceControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:UniversalDeviceToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:UniversalDeviceToolkit.WPF.Controls.Custom"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:UniversalDeviceToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}">

    <UserControl.Resources>
        <!-- Keep the whole clickable preview clipped to the same radius as its surface. -->
        <Style x:Key="ThemePreviewButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ThemeButtonSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            ClipToBounds="True"
                            CornerRadius="{StaticResource CornerRadiusSmall}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThemeButtonSurface" Property="Opacity" Value="0.94" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ThemeButtonSurface" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ThemeButtonSurface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemePreviewSurfaceStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- WPF does not propagate a Border's radius to its child backgrounds. These
             styles round the title and dock that touch the outer edge of each preview. -->
        <Style x:Key="ThemePreviewTitleBarStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusCompactTop}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="ThemePreviewDockStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusCompactBottom}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,12">
            <custom:CardControl
                x:Name="_langCardControl"
                Margin="0,0,0,8"
                Icon="LocalLanguage24">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_Language_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_Language_Message}" />
                </custom:CardControl.Header>
                <StackPanel Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            x:Name="_langComboBox"
                            Grid.Column="0"
                            MinWidth="160"
                            AutomationProperties.AutomationId="LanguageComboBox"
                            AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_Language_Title}"
                            MaxDropDownHeight="Auto"
                            SelectionChanged="LangComboBox_SelectionChanged" />

                    <wpfui:Button
                        x:Name="_installLanguageButton"
                        Grid.Column="2"
                        MinWidth="40"
                        Appearance="Secondary"
                        AutomationProperties.AutomationId="InstallLanguageButton"
                        AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_Language_Install}"
                        Click="InstallLanguageButton_Click"
                        ToolTip="{x:Static resources:Resource.SettingsPage_Language_Install}">
                            <wpfui:Button.Icon>
                                <wpfui:SymbolIcon Symbol="ArrowDownload24" />
                            </wpfui:Button.Icon>
                        </wpfui:Button>

                        <wpfui:Button
                            x:Name="_uninstallLanguageButton"
                            Grid.Column="4"
                            MinWidth="40"
                            Appearance="Secondary"
                            Click="UninstallLanguageButton_Click"
                            ToolTip="{x:Static resources:Resource.SettingsPage_Language_Uninstall}">
                            <wpfui:Button.Icon>
                                <wpfui:SymbolIcon Symbol="Delete24" />
                            </wpfui:Button.Icon>
                        </wpfui:Button>
                    </Grid>

                    <StackPanel
                        x:Name="_languageOperationPanel"
                        Margin="0,12,0,0"
                        AutomationProperties.AutomationId="LanguageOperationPanel"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="_languageOperationStatusText"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar
                                x:Name="_languageOperationProgressBar"
                                Grid.Column="0"
                                Height="6"
                                AutomationProperties.AutomationId="LanguageOperationProgressBar"
                                IsIndeterminate="True"
                                Maximum="1"
                                Minimum="0" />
                            <TextBlock
                                x:Name="_languageOperationPercentText"
                                Grid.Column="1"
                                MinWidth="40"
                                Margin="12,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </custom:CardControl>

            <custom:CardControl Margin="0,0,0,8" Icon="Temperature24">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_Temperature_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_Temperature_Message}" />
                </custom:CardControl.Header>
                <ComboBox
                    x:Name="_temperatureComboBox"
                    MinWidth="160"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_Temperature_Title}"
                    MaxDropDownHeight="Auto"
                    SelectionChanged="TemperatureComboBox_SelectionChanged" />
            </custom:CardControl>

            <custom:CardControl Margin="0,0,0,8" Icon="DarkTheme24">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_ThemeMode_Title}" />
                </custom:CardControl.Header>
                <!-- Watt Toolkit-style theme mode cards: larger (120x84) macOS window previews
                     with title bar + traffic lights, content area and dock, + selected border. -->
                <StackPanel>
                <WrapPanel x:Name="_themeCardsPanel" Margin="0,0,0,10">
                    <!-- Light -->
                    <Button x:Name="_themeLightCard" Margin="0,0,12,0" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ThemeCard_Click" Style="{StaticResource ThemePreviewButtonStyle}" Tag="Light">
                        <StackPanel>
                            <Border Width="120" Height="84" Style="{StaticResource ThemePreviewSurfaceStyle}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="#F6F6F6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="14" />
                                    </Grid.RowDefinitions>
                                    <!-- Title bar with macOS traffic lights -->
                                    <Border Grid.Row="0" Style="{StaticResource ThemePreviewTitleBarStyle}" Background="#E8E8E8">
                                        <StackPanel Margin="5,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#FF5F57" Margin="0,0,3,0" />
                                            <Ellipse Width="6" Height="6" Fill="#FEBC2E" Margin="0,0,3,0" />
                                            <Ellipse Width="6" Height="6" Fill="#28C840" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Content area: sidebar + search bar + content lines -->
                                    <Grid Grid.Row="1" Background="#FFFFFF" Margin="7,6,7,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,2,0,0" VerticalAlignment="Top">
                    <Border Height="5" Width="10" Background="#ECECEC" CornerRadius="{StaticResource CornerRadiusProgressBar}" HorizontalAlignment="Left" Margin="0,0,0,4" />
                                            <Border Height="5" Width="10" Background="#F1F1F1" CornerRadius="{StaticResource CornerRadiusProgressBar}" HorizontalAlignment="Left" Margin="0,0,0,4" />
                                            <Border Height="5" Width="10" Background="#F1F1F1" CornerRadius="{StaticResource CornerRadiusProgressBar}" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Top">
                                            <Border Height="9" Background="#F0F0F0" CornerRadius="{StaticResource CornerRadiusMicro}" Margin="0,0,0,5" />
                                            <Border Height="4" Background="#EDEDED" CornerRadius="{StaticResource CornerRadiusProgressBar}" Margin="0,0,18,4" />
                                            <Border Height="4" Background="#F2F2F2" CornerRadius="{StaticResource CornerRadiusProgressBar}" Margin="0,0,30,0" />
                                        </StackPanel>
                                    </Grid>
                                    <!-- Dock -->
                                    <Border Grid.Row="2" Style="{StaticResource ThemePreviewDockStyle}" Background="#E0E0E0">
                                        <StackPanel Margin="6,2,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Border Width="10" Height="10" Background="#C9C9C9" CornerRadius="{StaticResource CornerRadiusSwatch}" Margin="0,0,4,0" />
                                            <Border Width="10" Height="10" Background="#C9C9C9" CornerRadius="{StaticResource CornerRadiusSwatch}" Margin="0,0,4,0" />
                                            <Border Width="10" Height="10" Background="#C9C9C9" CornerRadius="{StaticResource CornerRadiusSwatch}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static resources:Resource.Theme_Light}" />
                        </StackPanel>
                    </Button>
                    <!-- Dark -->
                    <Button x:Name="_themeDarkCard" Margin="0,0,12,0" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ThemeCard_Click" Style="{StaticResource ThemePreviewButtonStyle}" Tag="Dark">
                        <StackPanel>
                            <Border Width="120" Height="84" Style="{StaticResource ThemePreviewSurfaceStyle}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="#202020">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="14" />
                                    </Grid.RowDefinitions>
                                    <!-- Title bar with macOS traffic lights -->
                                    <Border Grid.Row="0" Style="{StaticResource ThemePreviewTitleBarStyle}" Background="#2C2C2C">
                                        <StackPanel Margin="5,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#FF5F57" Margin="0,0,3,0" />
                                            <Ellipse Width="6" Height="6" Fill="#FEBC2E" Margin="0,0,3,0" />
                                            <Ellipse Width="6" Height="6" Fill="#28C840" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Content area: sidebar + search bar + content lines -->
                                    <Grid Grid.Row="1" Background="#262626" Margin="7,6,7,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,2,0,0" VerticalAlignment="Top">
                                            <Border Height="5" Width="10" Background="#333333" CornerRadius="{StaticResource CornerRadiusProgressBar}" HorizontalAlignment="Left" Margin="0,0,0,4" />
                                            <Border Height="5" Width="10" Background="#383838" CornerRadius="{StaticResource CornerRadiusProgressBar}" HorizontalAlignment="Left" Margin="0,0,0,4" />
                                            <Border Height="5" Width="10" Background="#383838" CornerRadius="{StaticResource CornerRadiusProgressBar}" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Top">
                                            <Border Height="9" Background="#333333" CornerRadius="{StaticResource CornerRadiusMicro}" Margin="0,0,0,5" />
                                            <Border Height="4" Background="#2F2F2F" CornerRadius="{StaticResource CornerRadiusProgressBar}" Margin="0,0,18,4" />
                                            <Border Height="4" Background="#3A3A3A" CornerRadius="{StaticResource CornerRadiusProgressBar}" Margin="0,0,30,0" />
                                        </StackPanel>
                                    </Grid>
                                    <!-- Dock -->
                                    <Border Grid.Row="2" Style="{StaticResource ThemePreviewDockStyle}" Background="#343434">
                                        <StackPanel Margin="6,2,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Border Width="10" Height="10" Background="#4A4A4A" CornerRadius="{StaticResource CornerRadiusSwatch}" Margin="0,0,4,0" />
                                            <Border Width="10" Height="10" Background="#4A4A4A" CornerRadius="{StaticResource CornerRadiusSwatch}" Margin="0,0,4,0" />
                                            <Border Width="10" Height="10" Background="#4A4A4A" CornerRadius="{StaticResource CornerRadiusSwatch}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static resources:Resource.Theme_Dark}" />
                        </StackPanel>
                    </Button>
                    <!-- System -->
                    <Button x:Name="_themeSystemCard" Margin="0" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ThemeCard_Click" Style="{StaticResource ThemePreviewButtonStyle}" Tag="System">
                        <StackPanel>
                            <Border Width="120" Height="84" Style="{StaticResource ThemePreviewSurfaceStyle}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Border.Background>
                                    <!-- Split light/dark preview: left half light, right half dark. -->
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#F6F6F6" />
                                        <GradientStop Offset="0.5" Color="#F6F6F6" />
                                        <GradientStop Offset="0.5" Color="#202020" />
                                        <GradientStop Offset="1" Color="#202020" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="14" />
                                    </Grid.RowDefinitions>
                                    <!-- Title bar with macOS traffic lights (neutral overlay on the split) -->
                                    <Border Grid.Row="0" Style="{StaticResource ThemePreviewTitleBarStyle}" Background="#40000000">
                                        <StackPanel Margin="5,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#FF5F57" Margin="0,0,3,0" />
                                            <Ellipse Width="6" Height="6" Fill="#FEBC2E" Margin="0,0,3,0" />
                                            <Ellipse Width="6" Height="6" Fill="#28C840" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Content area: sidebar + search bar + content lines (neutral overlay on the split) -->
                                    <Grid Grid.Row="1" Margin="7,6,7,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,2,0,0" VerticalAlignment="Top">
                                            <Border Height="5" Width="10" Background="#2A000000" CornerRadius="{StaticResource CornerRadiusProgressBar}" HorizontalAlignment="Left" Margin="0,0,0,4" />
                                            <Border Height="5" Width="10" Background="#22000000" CornerRadius="{StaticResource CornerRadiusProgressBar}" HorizontalAlignment="Left" Margin="0,0,0,4" />
                                            <Border Height="5" Width="10" Background="#22000000" CornerRadius="{StaticResource CornerRadiusProgressBar}" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Top">
                                            <Border Height="9" Background="#2A000000" CornerRadius="{StaticResource CornerRadiusMicro}" Margin="0,0,0,5" />
                                            <Border Height="4" Background="#22000000" CornerRadius="{StaticResource CornerRadiusProgressBar}" Margin="0,0,18,4" />
                                            <Border Height="4" Background="#1E000000" CornerRadius="{StaticResource CornerRadiusProgressBar}" Margin="0,0,30,0" />
                                        </StackPanel>
                                    </Grid>
                                    <!-- Dock -->
                                    <Border Grid.Row="2" Style="{StaticResource ThemePreviewDockStyle}" Background="#40000000">
                                        <StackPanel Margin="6,2,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Border Width="10" Height="10" Background="#55000000" CornerRadius="{StaticResource CornerRadiusSwatch}" Margin="0,0,4,0" />
                                            <Border Width="10" Height="10" Background="#55000000" CornerRadius="{StaticResource CornerRadiusSwatch}" Margin="0,0,4,0" />
                                            <Border Width="10" Height="10" Background="#55000000" CornerRadius="{StaticResource CornerRadiusSwatch}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static resources:Resource.Theme_System}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- Apply the selected accent to Windows. -->
                <CheckBox
                    x:Name="_applyAccentColorToSystemCheckBox"
                    Margin="0,0,0,6"
                    FontWeight="Medium"
                    Content="{x:Static resources:Resource.SettingsPage_ApplyAccentColorToTheme_Title}"
                    Checked="ApplyAccentColorToSystemCheckBox_Checked"
                    Unchecked="ApplyAccentColorToSystemCheckBox_Unchecked" />

                <!-- Apply the selected app theme style. -->
                <CheckBox
                    x:Name="_applyAccentColorToThemeCheckBox"
                    Margin="0,0,0,6"
                    FontWeight="Medium"
                    Content="{x:Static resources:Resource.SettingsPage_ApplyAccentColorToThemeStyle_Title}"
                    Checked="ApplyAccentColorToThemeCheckBox_Checked"
                    Unchecked="ApplyAccentColorToThemeCheckBox_Unchecked" />

                <!-- Global interface accent color presets and source selection. -->
                <Border Style="{StaticResource AppDividerBorderStyle}" Margin="0,6,0,6" />
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="{DynamicResource FontSizeCaption}"
                    FontWeight="Medium"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{x:Static resources:Resource.SettingsPage_AccentColorPresets_Title}" />
                <WrapPanel x:Name="_accentColorSwatchesPanel" Margin="0,0,0,8" />
                <ComboBox
                    x:Name="_accentColorSourceComboBox"
                    MinWidth="160"
                    AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_AccentColor_Title}"
                    MaxDropDownHeight="Auto"
                    SelectionChanged="AccentColorSourceComboBox_SelectionChanged" />
                </StackPanel>
            </custom:CardControl>

            <custom:CardControl Margin="0,0,0,8" Icon="TextFontSize24">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_Font_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_Font_Description}" />
                </custom:CardControl.Header>
                <ComboBox
                    x:Name="_fontComboBox"
                    MinWidth="160"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_Font_Title}"
                    MaxDropDownHeight="Auto"
                    SelectionChanged="FontComboBox_SelectionChanged" />
            </custom:CardControl>

            <custom:CardControl Margin="0,0,0,8" Icon="TextFontSize24">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_UiScale_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_UiScale_Description}" />
                </custom:CardControl.Header>
                <ComboBox
                    x:Name="_uiScaleComboBox"
                    MinWidth="160"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_UiScale_Title}"
                    MaxDropDownHeight="Auto"
                    SelectionChanged="UiScaleComboBox_SelectionChanged" />
            </custom:CardControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
