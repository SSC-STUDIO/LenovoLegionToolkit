<UserControl
    x:Class="UniversalDeviceToolkit.WPF.Controls.Settings.SettingsApplicationBehaviorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:UniversalDeviceToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:UniversalDeviceToolkit.WPF.Controls.Custom"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:UniversalDeviceToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,12">
            <custom:CardControl Margin="0,0,0,8">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_Autorun_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_Autorun_Message}" />
                </custom:CardControl.Header>
                <ComboBox
                    x:Name="_autorunComboBox"
                    MinWidth="160"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_Autorun_Title}"
                    MaxDropDownHeight="Auto"
                    SelectionChanged="AutorunComboBox_SelectionChanged" />
            </custom:CardControl>

            <custom:CardControl Margin="0,0,0,8">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_MinimizeToTray_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_MinimizeToTray_Message}" />
                </custom:CardControl.Header>
                <wpfui:ToggleSwitch
                    x:Name="_minimizeToTrayToggle"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_MinimizeToTray_Title}"
                    Click="MinimizeToTrayToggle_Click" />
            </custom:CardControl>

            <custom:CardControl Margin="0,0,0,8">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_MinimizeOnClose_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_MinimizeOnClose_Message}" />
                </custom:CardControl.Header>
                <wpfui:ToggleSwitch
                    x:Name="_minimizeOnCloseToggle"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_MinimizeOnClose_Title}"
                    Click="MinimizeOnCloseToggle_Click" />
            </custom:CardControl>

            <custom:CardControl
                x:Name="_disableCompatibilityWarningCard"
                Margin="0,0,0,8"
                Visibility="Collapsed">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_DisableCompatibilityWarning_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_DisableCompatibilityWarning_Message}" />
                </custom:CardControl.Header>
                <wpfui:ToggleSwitch
                    x:Name="_disableCompatibilityWarningToggle"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_DisableCompatibilityWarning_Title}"
                    Click="DisableCompatibilityWarningToggle_Click" />
            </custom:CardControl>

            <custom:CardControl x:Name="_vantageCard" Margin="0,0,0,8">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_DisableVantage_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_DisableVantage_Message}" />
                </custom:CardControl.Header>
                <wpfui:ToggleSwitch
                    x:Name="_vantageToggle"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_DisableVantage_Title}"
                    Click="VantageToggle_Click" />
            </custom:CardControl>

            <custom:CardControl x:Name="_legionZoneCard" Margin="0,0,0,8">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_DisableLegionZone_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_DisableLegionZone_Message}" />
                </custom:CardControl.Header>
                <wpfui:ToggleSwitch
                    x:Name="_legionZoneToggle"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_DisableLegionZone_Title}"
                    Click="LegionZoneToggle_Click" />
            </custom:CardControl>

            <custom:CardControl x:Name="_fnKeysCard" Margin="0,0,0,8">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_DisableLenovoHotkeys_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_DisableLenovoHotkeys_Message}" />
                </custom:CardControl.Header>
                <wpfui:ToggleSwitch
                    x:Name="_fnKeysToggle"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_DisableLenovoHotkeys_Title}"
                    Click="FnKeysToggle_Click" />
            </custom:CardControl>

            <custom:CardAction
                x:Name="_hardwareSensorsCardControl"
                Margin="0,0,0,8"
                Click="HardwareSensorsCard_Click"
                Icon="DataUsage24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:CardHeaderControl
                        x:Name="_hardwareSensorsCardHeader"
                        Grid.Column="0"
                        Title="{x:Static resources:Resource.SettingsPage_HardwareSensors_Title}"
                        Subtitle="{x:Static resources:Resource.SettingsPage_HardwareSensors_Message}" />

                    <wpfui:ToggleSwitch
                        x:Name="_hardwareSensorsToggle"
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_HardwareSensors_Title}"
                        Click="HardwareSensorsToggle_Click" />
                </Grid>
            </custom:CardAction>

            <custom:CardAction
                x:Name="_osdCardControl"
                Margin="24,0,0,8"
                Click="OsdSettingsButton_Click"
                Icon="ProjectionScreen24"
                Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:CardHeaderControl
                        Grid.Column="0"
                        Title="{x:Static resources:Resource.SettingsPage_Osd_Title}"
                        Subtitle="{x:Static resources:Resource.SettingsPage_Osd_Message}" />

                    <wpfui:ToggleSwitch
                        x:Name="_osdToggle"
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_Osd_Title}"
                        Click="OsdToggle_Click" />
                </Grid>
            </custom:CardAction>
        </StackPanel>
    </ScrollViewer>
</UserControl>
