<UserControl
    x:Class="UniversalDeviceToolkit.WPF.Controls.Settings.SettingsDisplayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:UniversalDeviceToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:UniversalDeviceToolkit.WPF.Controls.Custom"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:UniversalDeviceToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,12">
            <custom:CardAction
                x:Name="_navigationItemsSettingsCard"
                AutomationProperties.AutomationId="NavigationItemsSettingsCard"
                Margin="0,0,0,8"
                Click="NavigationItemsSettingsCard_Click">
                <custom:CardAction.Content>
                    <controls:CardHeaderControl 
                        Title="{x:Static resources:Resource.SettingsPage_NavigationItems_Title}" 
                        Subtitle="{x:Static resources:Resource.SettingsPage_NavigationItems_Message}" />
                </custom:CardAction.Content>
            </custom:CardAction>

            <custom:CardAction
                x:Name="_notificationsCard"
                AutomationProperties.AutomationId="NotificationsCard"
                Margin="0,0,0,8"
                Click="NotificationsCard_Click">
                <custom:CardAction.Content>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_Notifications_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_Notifications_Message}" />
                </custom:CardAction.Content>
            </custom:CardAction>

            <custom:CardAction
                x:Name="_excludeRefreshRatesCard"
                AutomationProperties.AutomationId="ExcludeRefreshRatesCard"
                Margin="0,0,0,8"
                Click="ExcludeRefreshRates_Click">
                <custom:CardAction.Content>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_ExcludeRefreshRates_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_ExcludeRefreshRates_Message}" />
                </custom:CardAction.Content>
            </custom:CardAction>

            <custom:CardControl Margin="0,0,0,8">
                <Grid MinHeight="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:CardHeaderControl
                        Grid.Column="0"
                        Margin="0,0,16,0"
                        Title="{x:Static resources:Resource.SettingsPage_SynchronizeBrightnessToAllPowerPlans_Title}"
                        Subtitle="{x:Static resources:Resource.SettingsPage_SynchronizeBrightnessToAllPowerPlans_Message}" />
                    <wpfui:ToggleSwitch
                        x:Name="_synchronizeBrightnessToAllPowerPlansToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="SynchronizeBrightnessToggle"
                        AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_SynchronizeBrightnessToAllPowerPlans_Title}"
                        Click="SynchronizeBrightnessToAllPowerPlansToggle_Click" />
                </Grid>
            </custom:CardControl>

            <custom:CardControl Margin="0,0,0,8">
                <Grid MinHeight="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:CardHeaderControl
                        Grid.Column="0"
                        Margin="0,0,16,0"
                        Title="{x:Static resources:Resource.SettingsPage_ForceSoftwareRendering_Title}"
                        Subtitle="{x:Static resources:Resource.SettingsPage_ForceSoftwareRendering_Message}" />
                    <wpfui:ToggleSwitch
                        x:Name="_forceSoftwareRenderingToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ForceSoftwareRenderingToggle"
                        AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_ForceSoftwareRendering_Title}"
                        Click="ForceSoftwareRenderingToggle_Click" />
                </Grid>
            </custom:CardControl>

            <custom:CardControl Margin="0,0,0,8">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_WindowBackdrop_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_WindowBackdrop_Message}" />
                </custom:CardControl.Header>
                <ComboBox
                    x:Name="_windowBackdropComboBox"
                    MinWidth="160"
                    Margin="0,0,0,8"
                    AutomationProperties.AutomationId="WindowBackdropStyleComboBox"
                    AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_WindowBackdrop_Title}"
                    MaxDropDownHeight="Auto"
                    SelectionChanged="WindowBackdropComboBox_SelectionChanged" />
            </custom:CardControl>

            <custom:CardAction
                x:Name="_bootLogoCard"
                AutomationProperties.AutomationId="BootLogoCard"
                Margin="0,0,0,8"
                Click="BootLogo_Click">
                <custom:CardAction.Content>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_BootLogo_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_BootLogo_Message}" />
                </custom:CardAction.Content>
            </custom:CardAction>
        </StackPanel>
    </ScrollViewer>
</UserControl>
