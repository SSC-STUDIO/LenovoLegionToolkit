<UserControl
    x:Class="UniversalDeviceToolkit.WPF.Controls.Settings.SettingsIntegrationsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:UniversalDeviceToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:UniversalDeviceToolkit.WPF.Controls.Custom"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:UniversalDeviceToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}">

    <wpfui:DynamicScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,12">
            <custom:CardControl Margin="0,0,0,8">
                <Grid MinHeight="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:CardHeaderControl
                        Grid.Column="0"
                        Margin="0,0,16,0"
                        Title="{x:Static resources:Resource.SettingsPage_HWiNFO_Title}"
                        Subtitle="{x:Static resources:Resource.SettingsPage_HWiNFO_Message}" />
                    <wpfui:ToggleSwitch
                        x:Name="_hwinfoIntegrationToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_HWiNFO_Title}"
                        Click="HWiNFOIntegrationToggle_Click" />
                </Grid>
            </custom:CardControl>

            <custom:CardControl Margin="0,0,0,8">
                <Grid MinHeight="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:CardHeaderControl
                        Grid.Column="0"
                        Margin="0,0,16,0"
                        Title="{x:Static resources:Resource.SettingsPage_CLI_Title}"
                        Subtitle="{x:Static resources:Resource.SettingsPage_CLI_Message}" />
                    <wpfui:ToggleSwitch
                        x:Name="_cliInterfaceToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_CLI_Title}"
                        Click="CLIInterfaceToggle_Click" />
                </Grid>
            </custom:CardControl>

            <custom:CardControl Margin="0,0,0,8">
                <Grid MinHeight="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:CardHeaderControl
                        Grid.Column="0"
                        Margin="0,0,16,0"
                        Title="{x:Static resources:Resource.SettingsPage_CLIAddToPath_Title}"
                        Subtitle="{x:Static resources:Resource.SettingsPage_CLIAddToPath_Message}" />
                    <wpfui:ToggleSwitch
                        x:Name="_cliPathToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_CLIAddToPath_Title}"
                        Click="CLIPathToggle_Click" />
                </Grid>
            </custom:CardControl>
        </StackPanel>
    </wpfui:DynamicScrollViewer>
</UserControl>
