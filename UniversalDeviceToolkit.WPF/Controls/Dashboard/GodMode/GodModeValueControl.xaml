<UserControl
    x:Class="UniversalDeviceToolkit.WPF.Controls.Dashboard.GodMode.GodModeValueControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="64"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <Border
        Background="{DynamicResource ControlFillColorDefaultBrush}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource CornerRadiusMD}"
        Padding="12,8"
        SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*"
                    MinWidth="140"
                    MaxWidth="260" />
                <ColumnDefinition
                    Width="2.4*"
                    MinWidth="100" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="0,0,12,0"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="_titleTextBlock"
                    FontWeight="Medium"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock
                    x:Name="_descriptionTextBlock"
                    Margin="0,2,0,0"
                    FontSize="{DynamicResource FontSizeDenseCaption}"
                    LineHeight="14"
                    MaxHeight="28"
                    Opacity="0.78"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Slider
                x:Name="_slider"
                Grid.Column="1"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                IsSnapToTickEnabled="True" />

            <TextBlock
                x:Name="_sliderLabel"
                Grid.Column="2"
                MinWidth="48"
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                FlowDirection="LeftToRight"
                FontWeight="Medium"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <ComboBox
                x:Name="_comboBox"
                Grid.Column="3"
                MinWidth="88"
                MaxWidth="120"
                Margin="0,0,4,0"
                VerticalAlignment="Center" />

            <wpfui:Button
                x:Name="_resetToDefaultButton"
                Grid.Column="4"
                Width="32"
                Height="32"
                Margin="4,0,0,0"
                Padding="0"
                Click="ResetToDefaultButton_OnClick"
                ToolTip="{x:Static resources:Resource.Default}">
                <wpfui:Button.Icon>
                    <wpfui:SymbolIcon FontSize="{StaticResource IconSizeSM}" Symbol="ArrowClockwise24" />
                </wpfui:Button.Icon>
            </wpfui:Button>
        </Grid>
    </Border>
</UserControl>
