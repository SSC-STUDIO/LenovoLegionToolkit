<controls:AbstractRefreshingControl
    x:Class="UniversalDeviceToolkit.WPF.Controls.Dashboard.DiscreteGPUControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:UniversalDeviceToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:UniversalDeviceToolkit.WPF.Controls.Custom"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    >
    <controls:AbstractRefreshingControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </controls:AbstractRefreshingControl.Resources>
    <custom:CardControl Margin="0,0,0,8" Icon="DeveloperBoard24">
        <custom:CardControl.Header>
            <controls:CardHeaderControl Title="{x:Static resources:Resource.DiscreteGPUControl_Title}" Subtitle="{x:Static resources:Resource.DiscreteGPUControl_Message}" />
        </custom:CardControl.Header>
        <StackPanel
            x:Name="_content"
            Orientation="Vertical">
            <Grid HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Ellipse
                    x:Name="_discreteGPUStatusActiveIndicator"
                    Grid.Column="0"
                    Width="12"
                    Height="12"
                    Fill="{DynamicResource StatusSuccessBrush}"
                    Visibility="{Binding IsGpuActive, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=controls:AbstractRefreshingControl}}" />
                <Ellipse
                    x:Name="_discreteGPUStatusInactiveIndicator"
                    Grid.Column="0"
                    Width="12"
                    Height="12"
                    Fill="{DynamicResource StatusWarningBrush}"
                    Visibility="{Binding IsGpuInactive, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=controls:AbstractRefreshingControl}}" />
                <Ellipse
                    x:Name="_discreteGPUStatusPoweredOffIndicator"
                    Grid.Column="0"
                    Width="12"
                    Height="12"
                    Fill="{DynamicResource TextFillColorTertiaryBrush}"
                    Visibility="{Binding IsGpuPoweredOff, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=controls:AbstractRefreshingControl}}" />
                <TextBlock
                    x:Name="_discreteGPUStatusDescription"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Text}"
                    AutomationProperties.Name="{x:Static resources:Resource.DiscreteGPUControl_Title}"
                    Focusable="True"
                    FontWeight="Medium"
                    Text="-" />
                <wpfui:Button
                    x:Name="_gpuInfoButton"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    AutomationProperties.HelpText="{x:Static resources:Resource.Information}"
                    AutomationProperties.Name="{x:Static resources:Resource.DiscreteGPUControl_Title}"
                    ToolTipService.InitialShowDelay="200"
                    ToolTipService.BetweenShowDelay="200"
                    ToolTipService.ShowDuration="15000">
                    <wpfui:Button.Resources>
                        <!-- Crisp, theme-aware tooltip card: ClearType + display formatting + layout
                             rounding — plain ToolTip text renders blurry at 150% DPI. -->
                        <Style TargetType="ToolTip">
                            <Setter Property="Padding" Value="12,9" />
                            <Setter Property="Background" Value="{DynamicResource AppSurfaceCardBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="UseLayoutRounding" Value="True" />
                            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToolTip">
                                        <Border
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{StaticResource CornerRadiusControl}"
                                            Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True"
                                            UseLayoutRounding="True">
                                            <ContentPresenter
                                                Content="{TemplateBinding Content}"
                                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                TextOptions.TextFormattingMode="Display"
                                                TextOptions.TextRenderingMode="ClearType" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </wpfui:Button.Resources>
                    <wpfui:SymbolIcon Symbol="QuestionCircle24" FontSize="{StaticResource IconSizeCardGlyph}" />
                </wpfui:Button>
            </Grid>
            <wpfui:Button
                x:Name="_deactivateGPUButton"
                MinWidth="150"
                Margin="0,8,0,0"
                Appearance="Primary"
                AutomationProperties.Name="{x:Static resources:Resource.DiscreteGPUControl_Deactivate}"
                Click="DeactivateGPUButton_Click"
                IsEnabled="{Binding CanDeactivateGpu, Mode=OneWay, RelativeSource={RelativeSource AncestorType=controls:AbstractRefreshingControl}}"
                ToolTipService.InitialShowDelay="0"
                ToolTipService.ShowOnDisabled="True">
                <wpfui:Button.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="_deactivateGPUButtonText"
                            Grid.Column="1"
                            Margin="8,0,8,2"
                            FontWeight="Medium"
                            Text="{x:Static resources:Resource.DiscreteGPUControl_Deactivate}" />
                        <wpfui:SymbolIcon
                            x:Name="_deactivateGPUButtonIcon"
                            Grid.Column="0"
                            FontWeight="Medium"
                            Symbol="ChevronDown24" />
                    </Grid>
                </wpfui:Button.Content>
                <wpfui:Button.ContextMenu>
                    <ContextMenu MinWidth="150">
                        <ContextMenu.Items>
                            <wpfui:MenuItem
                                x:Name="_killAppsMenuItem"
                                AutomationProperties.Name="{x:Static resources:Resource.DiscreteGPUControl_KillApps}"
                                Click="KillAppsMenuItem_Click"
                                Header="{x:Static resources:Resource.DiscreteGPUControl_KillApps}" />
                            <wpfui:MenuItem
                                x:Name="_restartGPUMenuItem"
                                AutomationProperties.Name="{x:Static resources:Resource.DiscreteGPUControl_RestartGPU}"
                                Click="RestartGPUMenuItem_Click"
                                Header="{x:Static resources:Resource.DiscreteGPUControl_RestartGPU}" />
                        </ContextMenu.Items>
                    </ContextMenu>
                </wpfui:Button.ContextMenu>
            </wpfui:Button>
        </StackPanel>
    </custom:CardControl>
</controls:AbstractRefreshingControl>
