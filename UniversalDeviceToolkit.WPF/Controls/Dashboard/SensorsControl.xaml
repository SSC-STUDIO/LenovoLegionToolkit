<UserControl
    x:Class="UniversalDeviceToolkit.WPF.Controls.Dashboard.SensorsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:UniversalDeviceToolkit.WPF.Behaviors"
    xmlns:charts="clr-namespace:UniversalDeviceToolkit.WPF.Controls.Charts"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="450"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource AppSectionTitleTextBlockStyle}">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="SensorSectionStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style x:Key="SensorHeaderModelStyle" TargetType="TextBlock" BasedOn="{StaticResource AppCaptionTextBlockStyle}">
            <Setter Property="Margin" Value="8,1,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="StatLabelStyle" TargetType="Label">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="StatValueStyle" TargetType="Label">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="MetricProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MaxWidth" Value="260" />
            <Setter Property="Margin" Value="6,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Maximum" Value="100" />
        </Style>
        <Style x:Key="LegendTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AppSmallBodyTextBlockStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,14,0" />
        </Style>
        <Style x:Key="LegendDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TrendPanelStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,14,0,0" />
            <Setter Property="Height" Value="76" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMD}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style x:Key="SkeletonTitleBlockStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
            <Setter Property="Height" Value="20" />
            <Setter Property="Width" Value="96" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,4,0,14" />
        </Style>
        <Style x:Key="SkeletonSubtitleBlockStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
            <Setter Property="Height" Value="12" />
            <Setter Property="Width" Value="120" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,1,0,0" />
        </Style>
        <Style x:Key="SkeletonGaugeStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="80" />
            <Setter Property="CornerRadius" Value="40" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SkeletonLabelBlockStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
            <Setter Property="Height" Value="12" />
            <Setter Property="Width" Value="60" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SkeletonBarBlockStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
            <Setter Property="Height" Value="6" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style x:Key="SkeletonValueBlockStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
            <Setter Property="Height" Value="12" />
            <Setter Property="Width" Value="48" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SkeletonTrendPanelStyle" TargetType="Border" BasedOn="{StaticResource TrendPanelStyle}">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="SkeletonTrendBlockStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
            <Setter Property="Height" Value="60" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="SkeletonLegendDotStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SkeletonLegendTextStyle" TargetType="Border" BasedOn="{StaticResource AppSkeletonShimmerBlockStyle}">
            <Setter Property="Height" Value="10" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Margin" Value="4,0,14,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- PLACEHOLDER_BODY -->
    <Grid>
        <Grid.Resources>
            <Storyboard x:Key="SkeletonFadeOutStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="_skeletonOverlay"
                    Storyboard.TargetProperty="Opacity"
                    From="1"
                    To="0"
                    Duration="0:0:0.45"
                    EasingFunction="{StaticResource AnimationEasingCubicOut}" />
                <ObjectAnimationUsingKeyFrames
                    Storyboard.TargetName="_skeletonOverlay"
                    Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="0:0:0.45" Value="{x:Static Visibility.Collapsed}" />
                </ObjectAnimationUsingKeyFrames>
            </Storyboard>
        </Grid.Resources>
        <wpfui:CardControl
            x:Name="_sensorsCard"
            AutomationProperties.AutomationId="DashboardSensorsCard"
            Background="{DynamicResource AppSurfaceCardBrush}"
            Focusable="False"
            PreviewMouseLeftButtonDown="CardControl_PreviewMouseLeftButtonDown">
        <wpfui:CardControl.Header>
            <UniformGrid x:Name="_sensorsGrid" Margin="8,10" Columns="3">
                <!-- PLACEHOLDER_CPU -->
                <StackPanel x:Name="_cpuSection" Style="{StaticResource SensorSectionStyle}">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static resources:Resource.SensorsControl_CPU_Title}" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                        <TextBlock x:Name="_cpuModelName" Grid.Column="1" Text="" Style="{StaticResource SensorHeaderModelStyle}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <charts:RadialGaugeControl
                            x:Name="_cpuGauge"
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            RingBrush="{DynamicResource ChartUtilizationBrush}"
                            Caption="{x:Static resources:Resource.SensorsControl_Utilization_Title}" />

                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" MinWidth="56" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="{x:Static resources:Resource.SensorsControl_CoreClock_Title}" Style="{StaticResource StatLabelStyle}" />
                            <ProgressBar x:Name="_cpuCoreClockBar" Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricProgressBarStyle}">
                                <i:Interaction.Behaviors><behaviors:ProgressBarAnimateBehavior /></i:Interaction.Behaviors>
                            </ProgressBar>
                            <Label x:Name="_cpuCoreClockLabel" Grid.Row="0" Grid.Column="2" Content="" Style="{StaticResource StatValueStyle}" />

                            <Label Grid.Row="1" Grid.Column="0" Content="{x:Static resources:Resource.SensorsControl_Temperature_Title}" Style="{StaticResource StatLabelStyle}" />
                            <ProgressBar x:Name="_cpuTemperatureBar" Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricProgressBarStyle}">
                                <i:Interaction.Behaviors><behaviors:ProgressBarAnimateBehavior /></i:Interaction.Behaviors>
                            </ProgressBar>
                            <Label x:Name="_cpuTemperatureLabel" Grid.Row="1" Grid.Column="2" Content="" Style="{StaticResource StatValueStyle}" />

                            <Label Grid.Row="2" Grid.Column="0" Content="{x:Static resources:Resource.SensorsControl_Fan_Title}" Style="{StaticResource StatLabelStyle}" />
                            <ProgressBar x:Name="_cpuFanSpeedBar" Grid.Row="2" Grid.Column="1" Style="{StaticResource MetricProgressBarStyle}">
                                <i:Interaction.Behaviors><behaviors:ProgressBarAnimateBehavior /></i:Interaction.Behaviors>
                            </ProgressBar>
                            <Label x:Name="_cpuFanSpeedLabel" Grid.Row="2" Grid.Column="2" Content="" Style="{StaticResource StatValueStyle}" />
                        </Grid>
                    </Grid>

                    <Border x:Name="_cpuTrendPanel" Style="{StaticResource TrendPanelStyle}">
                        <charts:TrendChartControl x:Name="_cpuTrendChart" Margin="2" />
                    </Border>
                    <WrapPanel x:Name="_cpuLegend" Margin="0,8,0,0" HorizontalAlignment="Left">
                        <Ellipse Style="{StaticResource LegendDotStyle}" Fill="{DynamicResource ChartUtilizationBrush}" />
                        <TextBlock Style="{StaticResource LegendTextStyle}" Text="{x:Static resources:Resource.SensorsControl_Utilization_Title}" />
                        <Ellipse Style="{StaticResource LegendDotStyle}" Fill="{DynamicResource ChartCoreClockBrush}" />
                        <TextBlock Style="{StaticResource LegendTextStyle}" Text="{x:Static resources:Resource.SensorsControl_CoreClock_Title}" />
                        <Ellipse Style="{StaticResource LegendDotStyle}" Fill="{DynamicResource ChartTemperatureBrush}" />
                        <TextBlock Style="{StaticResource LegendTextStyle}" Text="{x:Static resources:Resource.SensorsControl_Temperature_Title}" />
                    </WrapPanel>

                    <!-- PLACEHOLDER_CPU_DETAILS -->
                    <StackPanel x:Name="_cpuDetailsPanel" AutomationProperties.AutomationId="DashboardSensorsCpuDetailsPanel" Visibility="Collapsed" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <StackPanel x:Name="_cpuWattageDetail">
                                    <TextBlock Text="{x:Static resources:Resource.SensorsControl_PowerUsage}" Style="{StaticResource AppCaptionTextBlockStyle}" />
                                    <TextBlock x:Name="_cpuWattage" Text="" Margin="0,0,0,8" />
                                </StackPanel>

                                <StackPanel x:Name="_cpuVoltageDetail">
                                    <TextBlock Text="{x:Static resources:Resource.SensorsControl_Voltage}" Style="{StaticResource AppCaptionTextBlockStyle}" />
                                    <TextBlock x:Name="_cpuVoltage" Text="" Margin="0,0,0,8" />
                                </StackPanel>

                                <StackPanel x:Name="_cpuPCoreClockDetail">
                                    <TextBlock x:Name="_cpuPCoreClockTitle" Style="{StaticResource AppCaptionTextBlockStyle}" />
                                    <TextBlock x:Name="_cpuPCoreClock" Text="" Margin="0,0,0,8" />
                                </StackPanel>

                                <StackPanel x:Name="_cpuECoreClockDetail">
                                    <TextBlock x:Name="_cpuECoreClockTitle" Style="{StaticResource AppCaptionTextBlockStyle}" />
                                    <TextBlock x:Name="_cpuECoreClock" Text="" Margin="0,0,0,8" />
                                </StackPanel>

                                <StackPanel x:Name="_cpuMemoryUsageDetail">
                                    <TextBlock x:Name="_cpuMemoryUsageTitle" Style="{StaticResource AppCaptionTextBlockStyle}" />
                                    <TextBlock x:Name="_cpuMemoryUsage" Text="" Margin="0,0,0,8" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <StackPanel x:Name="_cpuTempRangeDetail">
                                    <TextBlock Text="{x:Static resources:Resource.SensorsControl_Temperature_Title}" Style="{StaticResource AppCaptionTextBlockStyle}" />
                                    <TextBlock x:Name="_cpuTempRange" Text="" Margin="0,0,0,8" />
                                </StackPanel>

                                <StackPanel x:Name="_cpuVoltageRangeDetail">
                                    <TextBlock Text="{x:Static resources:Resource.SensorsControl_VoltageRange}" Style="{StaticResource AppCaptionTextBlockStyle}" />
                                    <TextBlock x:Name="_cpuVoltageRange" Text="" Margin="0,0,0,8" />
                                </StackPanel>

                                <StackPanel x:Name="_cpuMemoryTemperatureDetail">
                                    <TextBlock x:Name="_cpuMemoryTemperatureTitle" Style="{StaticResource AppCaptionTextBlockStyle}" />
                                    <TextBlock x:Name="_cpuMemoryTemperature" Text="" Margin="0,0,0,8" />
                                </StackPanel>

                                <StackPanel x:Name="_cpuSsdTemperatureDetail">
                                    <TextBlock x:Name="_cpuSsdTemperatureTitle" Style="{StaticResource AppCaptionTextBlockStyle}" />
                                    <TextBlock x:Name="_cpuSsdTemperature" Text="" Margin="0,0,0,8" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
                <!-- PLACEHOLDER_BATTERY -->
                <StackPanel x:Name="_batterySectionColumn" Style="{StaticResource SensorSectionStyle}">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static resources:Resource.BatteryPage_Title}" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                        <TextBlock x:Name="_batteryModelName" Grid.Column="1" Text="" Style="{StaticResource SensorHeaderModelStyle}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <charts:RadialGaugeControl
                            x:Name="_batteryGauge"
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            RingBrush="{DynamicResource ChartBatteryBrush}"
                            Caption="{x:Static resources:Resource.SensorsControl_Charge}" />

                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" MinWidth="56" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="{x:Static resources:Resource.SensorsControl_Health}" Style="{StaticResource StatLabelStyle}" />
                            <ProgressBar x:Name="_batteryHealthBar" Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricProgressBarStyle}">
                                <i:Interaction.Behaviors><behaviors:ProgressBarAnimateBehavior /></i:Interaction.Behaviors>
                            </ProgressBar>
                            <Label x:Name="_batteryHealthText" Grid.Row="0" Grid.Column="2" Content="" Style="{StaticResource StatValueStyle}" />

                            <Label Grid.Row="1" Grid.Column="0" Content="{x:Static resources:Resource.SensorsControl_Temperature_Title}" Style="{StaticResource StatLabelStyle}" />
                            <ProgressBar x:Name="_batteryTemperatureBar" Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricProgressBarStyle}">
                                <i:Interaction.Behaviors><behaviors:ProgressBarAnimateBehavior /></i:Interaction.Behaviors>
                            </ProgressBar>
                            <Label x:Name="_batteryTempText" Grid.Row="1" Grid.Column="2" Content="" Style="{StaticResource StatValueStyle}" />

                            <Label Grid.Row="2" Grid.Column="0" Content="{x:Static resources:Resource.SensorsControl_Rate}" Style="{StaticResource StatLabelStyle}" />
                            <ProgressBar x:Name="_batteryRateBar" Grid.Row="2" Grid.Column="1" Style="{StaticResource MetricProgressBarStyle}">
                                <i:Interaction.Behaviors><behaviors:ProgressBarAnimateBehavior /></i:Interaction.Behaviors>
                            </ProgressBar>
                            <Label x:Name="_batteryRateText" Grid.Row="2" Grid.Column="2" Content="" Style="{StaticResource StatValueStyle}" />
                        </Grid>
                    </Grid>

                    <Border x:Name="_batteryTrendPanel" Style="{StaticResource TrendPanelStyle}">
                        <charts:TrendChartControl x:Name="_batteryTrendChart" Margin="2" />
                    </Border>
                    <WrapPanel x:Name="_batteryLegend" Margin="0,8,0,0" HorizontalAlignment="Left">
                        <Ellipse Style="{StaticResource LegendDotStyle}" Fill="{DynamicResource ChartBatteryBrush}" />
                        <TextBlock Style="{StaticResource LegendTextStyle}" Text="{x:Static resources:Resource.SensorsControl_Charge}" />
                        <Ellipse Style="{StaticResource LegendDotStyle}" Fill="{DynamicResource ChartCoreClockBrush}" />
                        <TextBlock Style="{StaticResource LegendTextStyle}" Text="{x:Static resources:Resource.SensorsControl_Health}" />
                        <Ellipse Style="{StaticResource LegendDotStyle}" Fill="{DynamicResource ChartTemperatureBrush}" />
                        <TextBlock Style="{StaticResource LegendTextStyle}" Text="{x:Static resources:Resource.SensorsControl_Temperature_Title}" />
                    </WrapPanel>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock x:Name="_batteryStatusLabel" Text="" Style="{StaticResource AppCaptionTextBlockStyle}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="_lowBatteryWarning" Text="{x:Static resources:Resource.BatteryPage_LowLevel}" Foreground="{DynamicResource StatusWarningBrush}" Visibility="Collapsed" HorizontalAlignment="Center" Style="{StaticResource AppCaptionTextBlockStyle}" />
                        <TextBlock x:Name="_lowWattageWarning" Text="{x:Static resources:Resource.BatteryPage_LowWattageChargerConnected}" Foreground="{DynamicResource StatusWarningBrush}" Visibility="Collapsed" HorizontalAlignment="Center" Style="{StaticResource AppCaptionTextBlockStyle}" />
                        <wpfui:SymbolIcon x:Name="_batteryIcon" Symbol="Battery024" FontSize="{DynamicResource FontSizeDisplaySection}" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- PLACEHOLDER_BATTERY_DETAILS -->
                    <StackPanel x:Name="_batteryDetailsPanel" AutomationProperties.AutomationId="DashboardSensorsBatteryDetailsPanel" Visibility="Collapsed" Margin="0,16,0,0">
                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <StackPanel HorizontalAlignment="Center">
                                <charts:RadialGaugeControl
                                    x:Name="_batteryCapGauge"
                                    Width="{StaticResource GaugeSizeSM}"
                                    Height="{StaticResource GaugeSizeSM}"
                                    RingThickness="6"
                                    RingBrush="{DynamicResource ChartBatteryBrush}"
                                    Caption="{x:Static resources:Resource.SensorsControl_Capacity}" />
                                <TextBlock x:Name="_batteryCap" Text="-" HorizontalAlignment="Center" Margin="0,4,0,0" Style="{StaticResource AppSmallBodyTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <charts:RadialGaugeControl
                                    x:Name="_batteryFullCapGauge"
                                    Width="{StaticResource GaugeSizeSM}"
                                    Height="{StaticResource GaugeSizeSM}"
                                    RingThickness="6"
                                    RingBrush="{DynamicResource ChartUtilizationBrush}"
                                    Caption="{x:Static resources:Resource.SensorsControl_FullCapacity}" />
                                <TextBlock x:Name="_batteryFullCap" Text="-" HorizontalAlignment="Center" Margin="0,4,0,0" Style="{StaticResource AppSmallBodyTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <charts:RadialGaugeControl
                                    Width="{StaticResource GaugeSizeSM}"
                                    Height="{StaticResource GaugeSizeSM}"
                                    RingThickness="6"
                                    Value="100"
                                    RingBrush="{DynamicResource ChartTrackBrush}"
                                    ValueText=" "
                                    Caption="{x:Static resources:Resource.SensorsControl_DesignCapacity}" />
                                <TextBlock x:Name="_batteryDesignCap" Text="-" HorizontalAlignment="Center" Margin="0,4,0,0" Style="{StaticResource AppSmallBodyTextBlockStyle}" />
                            </StackPanel>
                        </UniformGrid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <StackPanel x:Name="_batteryRateRangeDetail">
                                    <TextBlock Text="{x:Static resources:Resource.SensorsControl_RateRange}" Style="{StaticResource AppSmallBodyTextBlockStyle}" />
                                    <TextBlock x:Name="_batteryRateRange" Text="-" />
                                </StackPanel>
                                <StackPanel x:Name="_batteryCyclesDetail" Margin="0,4,0,0">
                                    <TextBlock Text="{x:Static resources:Resource.SensorsControl_Cycles}" Style="{StaticResource AppSmallBodyTextBlockStyle}" />
                                    <TextBlock x:Name="_batteryCycles" Text="-" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <StackPanel x:Name="_batteryDateDetail">
                                    <TextBlock Text="{x:Static resources:Resource.SensorsControl_Date}" Style="{StaticResource AppSmallBodyTextBlockStyle}" />
                                    <TextBlock x:Name="_batteryDate" Text="-" />
                                </StackPanel>
                                <StackPanel x:Name="_batteryTemperatureDetail" Margin="0,4,0,0">
                                    <TextBlock Text="{x:Static resources:Resource.SensorsControl_Temperature_Title}" Style="{StaticResource AppSmallBodyTextBlockStyle}" />
                                    <TextBlock x:Name="_batteryTemperature" Text="-" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
                <!-- PLACEHOLDER_GPU -->
                <StackPanel x:Name="_gpuSection" Style="{StaticResource SensorSectionStyle}">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static resources:Resource.SensorsControl_GPU_Title}" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                        <TextBlock x:Name="_gpuModelName" Grid.Column="1" Text="" Style="{StaticResource SensorHeaderModelStyle}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <charts:RadialGaugeControl
                            x:Name="_gpuGauge"
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            RingBrush="{DynamicResource ChartUtilizationBrush}"
                            Caption="{x:Static resources:Resource.SensorsControl_Utilization_Title}" />

                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" MinWidth="56" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="{x:Static resources:Resource.SensorsControl_CoreClock_Title}" Style="{StaticResource StatLabelStyle}" />
                            <ProgressBar x:Name="_gpuCoreClockBar" Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricProgressBarStyle}">
                                <i:Interaction.Behaviors><behaviors:ProgressBarAnimateBehavior /></i:Interaction.Behaviors>
                            </ProgressBar>
                            <Label x:Name="_gpuCoreClockLabel" Grid.Row="0" Grid.Column="2" Content="" Style="{StaticResource StatValueStyle}" />

                            <Label Grid.Row="1" Grid.Column="0" Content="{x:Static resources:Resource.SensorsControl_Temperature_Title}" Style="{StaticResource StatLabelStyle}" />
                            <ProgressBar x:Name="_gpuTemperatureBar" Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricProgressBarStyle}">
                                <i:Interaction.Behaviors><behaviors:ProgressBarAnimateBehavior /></i:Interaction.Behaviors>
                            </ProgressBar>
                            <Label x:Name="_gpuTemperatureLabel" Grid.Row="1" Grid.Column="2" Content="" Style="{StaticResource StatValueStyle}" />

                            <Label Grid.Row="2" Grid.Column="0" Content="{x:Static resources:Resource.SensorsControl_Fan_Title}" Style="{StaticResource StatLabelStyle}" />
                            <ProgressBar x:Name="_gpuFanSpeedBar" Grid.Row="2" Grid.Column="1" Style="{StaticResource MetricProgressBarStyle}">
                                <i:Interaction.Behaviors><behaviors:ProgressBarAnimateBehavior /></i:Interaction.Behaviors>
                            </ProgressBar>
                            <Label x:Name="_gpuFanSpeedLabel" Grid.Row="2" Grid.Column="2" Content="" Style="{StaticResource StatValueStyle}" />
                        </Grid>
                    </Grid>

