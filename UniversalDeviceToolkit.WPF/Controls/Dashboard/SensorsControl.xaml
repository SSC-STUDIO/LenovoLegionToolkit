                    </Grid>
                    <Border x:Name="_skeletonGpuTrendPanel" Style="{StaticResource SkeletonTrendPanelStyle}">
                        <Border Style="{StaticResource SkeletonTrendBlockStyle}" />
                    </Border>
                    <WrapPanel x:Name="_skeletonGpuLegend" Style="{StaticResource LegendPanelStyle}">
                        <StackPanel Style="{StaticResource SkeletonLegendItemStyle}">
