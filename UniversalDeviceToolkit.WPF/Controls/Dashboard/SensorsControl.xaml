                        </StackPanel>
                        <StackPanel Style="{StaticResource LegendItemStyle}">
                            <Ellipse Style="{StaticResource LegendDotStyle}" Fill="{DynamicResource ChartTemperatureBrush}" />
                            <TextBlock Style="{StaticResource LegendTextStyle}" Text="{x:Static resources:Resource.SensorsControl_Temperature_Title}" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- PLACEHOLDER_GPU_DETAILS -->
                    <StackPanel x:Name="_gpuDetailsPanel" AutomationProperties.AutomationId="DashboardSensorsGpuDetailsPanel" Visibility="Collapsed" Margin="0,16,0,0">
                        <TextBlock Text="{x:Static resources:Resource.SensorsControl_MemoryClock_Title}" Style="{StaticResource AppCaptionTextBlockStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" MinWidth="72" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="_gpuMemoryClockBar" Grid.Column="0" Margin="0,0,8,0" Maximum="100" Style="{StaticResource MetricProgressBarStyle}">
                                <i:Interaction.Behaviors><behaviors:ProgressBarAnimateBehavior /></i:Interaction.Behaviors>
                            </ProgressBar>
                            <TextBlock x:Name="_gpuMemoryClockText" Grid.Column="1" Text="-" Style="{StaticResource StatDetailValueStyle}" Margin="0" />
                        </Grid>

                        <Grid Margin="0,8,0,0" ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource SensorDetailColumnStyle}">
                                <StackPanel x:Name="_gpuVramUsageDetail">
                                    <TextBlock x:Name="_gpuVramUsageTitle" Style="{StaticResource AppCaptionTextBlockStyle}" />
                                    <TextBlock x:Name="_gpuVramUsage" Text="" Style="{StaticResource StatDetailValueStyle}" />
                                </StackPanel>

                                <StackPanel x:Name="_gpuWattageDetail">
                                    <TextBlock Text="{x:Static resources:Resource.SensorsControl_PowerUsage}" Style="{StaticResource AppCaptionTextBlockStyle}" />
                                    <TextBlock x:Name="_gpuWattage" Text="" Style="{StaticResource StatDetailValueStyle}" />
                                </StackPanel>

                                <StackPanel x:Name="_gpuVoltageDetail">
                                    <TextBlock Text="{x:Static resources:Resource.SensorsControl_Voltage}" Style="{StaticResource AppCaptionTextBlockStyle}" />
                                    <TextBlock x:Name="_gpuVoltage" Text="" Style="{StaticResource StatDetailValueStyle}" />
                                </StackPanel>

                                <StackPanel x:Name="_gpuPcieThroughputDetail">
                                    <TextBlock x:Name="_gpuPcieThroughputTitle" Style="{StaticResource AppCaptionTextBlockStyle}" />
                                    <TextBlock x:Name="_gpuPcieThroughput" Text="" Style="{StaticResource StatDetailValueStyle}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SensorDetailColumnStyle}">
                                <StackPanel x:Name="_gpuVramTemperatureDetail">
                                    <TextBlock x:Name="_gpuVramTemperatureTitle" Style="{StaticResource AppCaptionTextBlockStyle}" />
                                    <TextBlock x:Name="_gpuVramTemperature" Text="" Style="{StaticResource StatDetailValueStyle}" />
                                </StackPanel>

                                <StackPanel x:Name="_gpuHotSpotTemperatureDetail">
                                    <TextBlock x:Name="_gpuHotSpotTemperatureTitle" Style="{StaticResource AppCaptionTextBlockStyle}" />
                                    <TextBlock x:Name="_gpuHotSpotTemperature" Text="" Style="{StaticResource StatDetailValueStyle}" />
                                </StackPanel>

                                <StackPanel x:Name="_gpuTempRangeDetail">
                                    <TextBlock Text="{x:Static resources:Resource.SensorsControl_Temperature_Title}" Style="{StaticResource AppCaptionTextBlockStyle}" />
                                    <TextBlock x:Name="_gpuTempRange" Text="" Style="{StaticResource StatDetailValueStyle}" />
                                </StackPanel>

                                <StackPanel x:Name="_gpuVoltageRangeDetail">
                                    <TextBlock Text="{x:Static resources:Resource.SensorsControl_VoltageRange}" Style="{StaticResource AppCaptionTextBlockStyle}" />
                                    <TextBlock x:Name="_gpuVoltageRange" Text="" Style="{StaticResource StatDetailValueStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </UniformGrid>
        </wpfui:CardControl.Header>
    </wpfui:CardControl>

        <!-- Overlay sits on top of the live card; corner radius/padding match CardControl.Header. -->
        <Border
            x:Name="_skeletonOverlay"
            AutomationProperties.AutomationId="DashboardSensorsSkeleton"
            Background="{DynamicResource AppSurfaceCardBrush}"
            CornerRadius="{StaticResource CornerRadiusCard}"
            ClipToBounds="True"
            IsHitTestVisible="False">
            <UniformGrid x:Name="_skeletonGrid" Margin="8,10" Columns="3">
                <StackPanel x:Name="_skeletonCpuSection" Style="{StaticResource SensorSectionStyle}">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SkeletonTitleBlockStyle}" />
                        <Border x:Name="_skeletonCpuSubtitle" Grid.Column="1" Style="{StaticResource SkeletonSubtitleBlockStyle}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="_skeletonCpuGauge" Grid.Column="0" Style="{StaticResource SkeletonGaugeStyle}">
                            <!-- Background ring (full circle track) -->
                            <Ellipse Style="{StaticResource SkeletonGaugeBackgroundRingStyle}" />
                            <!-- Progress arc (simulating 75% progress) -->
                            <Path Style="{StaticResource SkeletonGaugeProgressArcStyle}">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="55,10">
                                            <ArcSegment Point="10,55" Size="45,45" SweepDirection="Clockwise" IsLargeArc="True" />
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                            <!-- Center percentage text skeleton -->
                            <Border Style="{StaticResource SkeletonGaugeCenterTextStyle}" />
                        </Grid>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" MinWidth="72" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SkeletonLabelBlockStyle}" />
                            <Border x:Name="_skeletonCpuBar0" Grid.Row="0" Grid.Column="1" Style="{StaticResource SkeletonBarBlockStyle}" />
                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource SkeletonValueBlockStyle}" />
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SkeletonLabelBlockStyle}" />
                            <Border x:Name="_skeletonCpuBar1" Grid.Row="1" Grid.Column="1" Style="{StaticResource SkeletonBarBlockStyle}" />
                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource SkeletonValueBlockStyle}" />
                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource SkeletonLabelBlockStyle}" />
                            <Border x:Name="_skeletonCpuBar2" Grid.Row="2" Grid.Column="1" Style="{StaticResource SkeletonBarBlockStyle}" />
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource SkeletonValueBlockStyle}" />
                        </Grid>
                    </Grid>
                    <Border x:Name="_skeletonCpuTrendPanel" Style="{StaticResource SkeletonTrendPanelStyle}">
                        <Border Style="{StaticResource SkeletonTrendBlockStyle}" />
                    </Border>
                    <WrapPanel x:Name="_skeletonCpuLegend" Style="{StaticResource LegendPanelStyle}">
                        <StackPanel Style="{StaticResource SkeletonLegendItemStyle}">
                            <Border Style="{StaticResource SkeletonLegendDotStyle}" />
                            <Border Style="{StaticResource SkeletonLegendTextStyle}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource SkeletonLegendItemStyle}">
                            <Border Style="{StaticResource SkeletonLegendDotStyle}" />
                            <Border Style="{StaticResource SkeletonLegendTextStyle}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource SkeletonLegendItemStyle}">
                            <Border Style="{StaticResource SkeletonLegendDotStyle}" />
                            <Border Style="{StaticResource SkeletonLegendTextStyle}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
                <StackPanel x:Name="_skeletonBatterySection" Style="{StaticResource SensorSectionStyle}">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SkeletonTitleBlockStyle}" />
                        <Border x:Name="_skeletonBatterySubtitle" Grid.Column="1" Style="{StaticResource SkeletonSubtitleBlockStyle}" />
