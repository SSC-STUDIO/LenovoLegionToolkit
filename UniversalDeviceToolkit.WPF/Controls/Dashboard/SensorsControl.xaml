                                    <TextBlock x:Name="_gpuVoltageRange" Text="" Margin="0,0,0,8" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </UniformGrid>
        </wpfui:CardControl.Header>
    </wpfui:CardControl>

