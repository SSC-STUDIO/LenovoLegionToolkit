<UserControl
    x:Class="UniversalDeviceToolkit.WPF.Controls.Shell.AppNotificationHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    Width="{StaticResource NotificationToastWidth}"
    MinWidth="{StaticResource NotificationToastWidth}"
    MaxWidth="{StaticResource NotificationToastWidth}"
    HorizontalAlignment="Right"
    VerticalAlignment="Bottom"
    Focusable="False"
    Background="Transparent"
    AutomationProperties.AutomationId="AppNotificationHost"
    AutomationProperties.Name="{x:Static resources:Resource.AppNotificationHost_AccessibleName}">
    <!--
      Bottom-right toast stack: up to 3 rows fully visible; overflow scrolls inside a fixed max height.
      Card width matches Snackbar / AppStatusBanner via NotificationToastWidth.
      New items append at the bottom. Close buttons never invoke notification primary actions.
    -->
    <!-- ~3 toast rows (~100px each + margins) stay fully visible; overflow scrolls. -->
    <ScrollViewer
        x:Name="_scrollViewer"
        MaxHeight="320"
        HorizontalAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        CanContentScroll="False"
        Focusable="False"
        Padding="0">
        <ItemsControl
            x:Name="_items"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.AutomationId="AppNotificationList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Vertical spacing only — full NotificationToastWidth for every card. -->
                    <Border
                            x:Name="ToastBorder"
                            Margin="0,5,0,11"
                            Padding="12,10"
                            HorizontalAlignment="Stretch"
                            MinWidth="{StaticResource NotificationToastWidth}"
                            Background="{DynamicResource NotificationGlassSurfaceBrush}"
                            BorderBrush="{DynamicResource NotificationGlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusCard}"
                            Effect="{DynamicResource NotificationGlassShadowEffect}"
                            SnapsToDevicePixels="True"
                            MouseEnter="Toast_MouseEnter"
                            MouseLeave="Toast_MouseLeave"
                            AutomationProperties.AutomationId="{Binding AutomationId}"
                            AutomationProperties.Name="{Binding AccessibilityName}">
                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <wpfui:SymbolIcon
                                Grid.Column="0"
                                Width="28"
                                Height="28"
                                FontSize="{StaticResource IconSizeCardGlyph}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Symbol="{Binding IconSymbol}"
                                Foreground="{Binding IconBrush}" />
                            <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="{DynamicResource FontSizeSmallBody}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding DisplayTitle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="{DynamicResource FontSizeSmallCaption}"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Message}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding MessageVisibility}" />
                            </StackPanel>
                            <wpfui:Button
                                Grid.Column="2"
                                VerticalAlignment="Top"
                                Style="{StaticResource NotificationCloseButtonStyle}"
                                ToolTip="{x:Static resources:Resource.AppNotificationHost_Close}"
                                AutomationProperties.AutomationId="{Binding CloseAutomationId}"
                                AutomationProperties.Name="{x:Static resources:Resource.AppNotificationHost_Close}"
                                Click="CloseButton_Click"
                                Tag="{Binding Id}">
                                <wpfui:SymbolIcon Symbol="Dismiss24" FontSize="{StaticResource IconSizeSM}" />
                            </wpfui:Button>
                            </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
