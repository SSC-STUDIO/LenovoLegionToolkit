<UserControl
    x:Class="UniversalDeviceToolkit.WPF.Windows.Automation.TabItemContent.HardwareSensorAutomationPipelineTriggerTabItemContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Initialized="HardwareSensorAutomationPipelineTriggerTabItemContent_Initialized"
    mc:Ignorable="d">
    <StackPanel Margin="16">
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Text="Metric" />
            <ComboBox
                x:Name="_metricComboBox"
                Grid.Column="1"
                MinWidth="200"
                MaxDropDownHeight="Auto" />
        </Grid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Text="Comparison" />
            <ComboBox
                x:Name="_comparisonComboBox"
                Grid.Column="1"
                MinWidth="200"
                MaxDropDownHeight="Auto" />
        </Grid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Text="Threshold" />
            <ui:NumberBox
                x:Name="_thresholdBox"
                Grid.Column="1"
                ClearButtonEnabled="False"
                MaxDecimalPlaces="1"
                Maximum="9999"
                Minimum="-9999" />
        </Grid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Text="Duration (s)" />
            <ui:NumberBox
                x:Name="_durationSecondsBox"
                Grid.Column="1"
                ClearButtonEnabled="False"
                MaxDecimalPlaces="0"
                Maximum="86400"
                Minimum="0" />
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Text="Cooldown (s)" />
            <ui:NumberBox
                x:Name="_cooldownSecondsBox"
                Grid.Column="1"
                ClearButtonEnabled="False"
                MaxDecimalPlaces="0"
                Maximum="86400"
                Minimum="0" />
        </Grid>
    </StackPanel>
</UserControl>
