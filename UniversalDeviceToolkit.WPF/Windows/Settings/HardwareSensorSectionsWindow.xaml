<wpfui:FluentWindow
    x:Class="UniversalDeviceToolkit.WPF.Windows.Settings.HardwareSensorSectionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:UniversalDeviceToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Sensor sections"
    Width="420"
    Height="420"
    ExtendsContentIntoTitleBar="True"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowBackdropType="None">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <wpfui:TitleBar
            Title="Sensor sections"
            CanMaximize="False"
            ShowMaximize="False"
            ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" Margin="20,8,20,8">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,12"
                    FontWeight="SemiBold"
                    Text="Visible sections" />
                <StackPanel x:Name="_visibilityPanel" />

                <TextBlock
                    Margin="0,16,0,8"
                    FontWeight="SemiBold"
                    Text="Section order" />
                <StackPanel x:Name="_orderHost" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <wpfui:Button
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Click="MoveUp_Click"
                        Content="Move up" />
                    <wpfui:Button
                        MinWidth="88"
                        Click="MoveDown_Click"
                        Content="Move down" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Margin="20,0,20,20"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <wpfui:Button
                MinWidth="100"
                Margin="0,0,8,0"
                Click="Cancel_Click"
                Content="{x:Static resources:Resource.Cancel}" />
            <wpfui:Button
                MinWidth="100"
                Appearance="Primary"
                Click="Save_Click"
                Content="Save" />
        </StackPanel>
    </Grid>
</wpfui:FluentWindow>
