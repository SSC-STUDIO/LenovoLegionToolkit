<wpfui:FluentWindow
    x:Class="UniversalDeviceToolkit.WPF.Windows.Utils.DeviceSetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:UniversalDeviceToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static utils:AppDisplayName.Value}"
    MinWidth="560"
    MinHeight="340"
    MaxWidth="560"
    MaxHeight="340"
    Closed="DeviceSetupWindow_OnClosed"
    ExtendsContentIntoTitleBar="True"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    ResizeMode="NoResize"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    WindowBackdropType="None">

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <wpfui:TitleBar
            Title="{x:Static utils:AppDisplayName.Value}"
            Grid.Row="0"
            CanMaximize="false"
            ShowMaximize="false"
            ShowMinimize="false" />

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,16,0">
                <wpfui:SymbolIcon FontSize="56" Symbol="Laptop24" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1">
                <TextBlock
                    x:Name="_titleText"
                    Margin="0,0,0,8"
                    Focusable="True"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap" />

                <TextBlock
                    x:Name="_summaryText"
                    Margin="0,0,0,14"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />

                <Grid Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Medium" Text="{x:Static resources:Resource.UnsupportedWindow_Vendor}" />
                    <TextBlock x:Name="_vendorText" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="Medium" Text="{x:Static resources:Resource.UnsupportedWindow_Model}" />
                    <TextBlock x:Name="_modelText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Grid.Column="0" FontWeight="Medium" Text="{x:Static resources:Resource.UnsupportedWindow_MachineType}" />
                    <TextBlock x:Name="_machineTypeText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" />
                </Grid>

                <TextBlock
                    x:Name="_packText"
                    Margin="0,0,0,8"
                    Focusable="True"
                    FontWeight="Medium"
                    TextWrapping="Wrap" />

                <TextBlock
                    x:Name="_hintText"
                    Margin="0,0,0,12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />

                <TextBlock
                    x:Name="_statusText"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <Grid
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,16,0,0"
                HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Labels set in code-behind so we never reuse RestartLater (hybrid-mode restart). -->
                <wpfui:Button
                    x:Name="_skipButton"
                    Grid.Column="0"
                    MinWidth="120"
                    Appearance="Secondary"
                    Click="Skip_Click" />
                <wpfui:Button
                    x:Name="_confirmButton"
                    Grid.Column="2"
                    MinWidth="120"
                    Appearance="Primary"
                    Click="Confirm_Click" />
            </Grid>
        </Grid>
    </Grid>
</wpfui:FluentWindow>
