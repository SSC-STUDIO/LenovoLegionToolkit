<local:BaseWindow
    x:Class="UniversalDeviceToolkit.WPF.Windows.Utils.DeviceInformationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:UniversalDeviceToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:UniversalDeviceToolkit.WPF.Controls.Custom"
    xmlns:local="clr-namespace:UniversalDeviceToolkit.WPF.Windows"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:UniversalDeviceToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.DeviceInformationWindow_Title}"
    Width="500"
    ExtendsContentIntoTitleBar="True"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    Loaded="DeviceInformationWindow_Loaded"
    ResizeMode="CanMinimize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <wpfui:TitleBar
            Grid.Row="0"
            CanMaximize="false"
            ShowMaximize="false"
            ShowMinimize="false" />

        <Grid
            Grid.Row="0"
            Height="24"
            Margin="12,8,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Style="{StaticResource AppCaptionTextBlockStyle}"
                IsHitTestVisible="False"
                Text="{x:Static resources:Resource.DeviceInformationWindow_Title}" />

        </Grid>

        <wpfui:DynamicScrollViewer
            x:Name="_contentScrollViewer"
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,0,16,12">

                <TextBlock
                    Margin="0,16,0,24"
                    Focusable="True"
                    Style="{StaticResource AppPageTitleTextBlockStyle}"
                    Text="{x:Static resources:Resource.DeviceInformationWindow_Device_Title}" />

                <custom:CardControl Margin="0,0,0,8" Click="DeviceCardControl_Click">
                    <custom:CardControl.Header>
                        <controls:CardHeaderControl Title="{x:Static resources:Resource.DeviceInformationWindow_Manufacturer_Title}" />
                    </custom:CardControl.Header>
                    <TextBlock x:Name="_manufacturerLabel" Focusable="True" />
                </custom:CardControl>

                <custom:CardControl Margin="0,0,0,8" Click="DeviceCardControl_Click">
                    <custom:CardControl.Header>
                        <controls:CardHeaderControl Title="{x:Static resources:Resource.DeviceInformationWindow_Model_Title}" />
                    </custom:CardControl.Header>
                    <TextBlock x:Name="_modelLabel" Focusable="True" />
                </custom:CardControl>

                <custom:CardControl Margin="0,0,0,8" Click="DeviceCardControl_Click">
                    <custom:CardControl.Header>
                        <controls:CardHeaderControl Title="{x:Static resources:Resource.DeviceInformationWindow_MachineType_Title}" />
                    </custom:CardControl.Header>
                    <TextBlock x:Name="_mtmLabel" Focusable="True" />
                </custom:CardControl>
                <custom:CardControl Margin="0,0,0,8" Click="DeviceCardControl_Click">
                    <custom:CardControl.Header>
                        <controls:CardHeaderControl Title="{x:Static resources:Resource.DeviceInformationWindow_SerialNumber_Title}" />
                    </custom:CardControl.Header>
                    <TextBlock x:Name="_serialNumberLabel" Focusable="True" />
                </custom:CardControl>

                <custom:CardControl Margin="0,0,0,8" Click="DeviceCardControl_Click">
                    <custom:CardControl.Header>
                        <controls:CardHeaderControl Title="{x:Static resources:Resource.DeviceInformationWindow_BiosVersion_Title}" />
                    </custom:CardControl.Header>
                    <TextBlock x:Name="_biosLabel" Focusable="True" />
                </custom:CardControl>

                <StackPanel x:Name="_hardwareInfo" Visibility="Collapsed">
                    <TextBlock
                        Margin="0,16,0,24"
                        Focusable="True"
                        Style="{StaticResource AppDisplaySectionTitleTextBlockStyle}"
                        Text="{x:Static resources:Resource.DeviceInformationWindow_Hardware_Title}" />

                    <custom:CardControl
                        x:Name="_cpuCard"
                        Margin="0,0,0,8"
                        Click="DeviceCardControl_Click">
                        <custom:CardControl.Header>
                            <controls:CardHeaderControl Title="{x:Static resources:Resource.FanCurveControl_CPU}" />
                        </custom:CardControl.Header>
                        <TextBlock
                            x:Name="_cpuLabel"
                            Focusable="True"
                            TextWrapping="Wrap" />
                    </custom:CardControl>

                    <custom:CardControl
                        x:Name="_gpuCard"
                        Margin="0,0,0,8"
                        Click="DeviceCardControl_Click">
                        <custom:CardControl.Header>
                            <controls:CardHeaderControl Title="{x:Static resources:Resource.FanCurveControl_GPU}" />
                        </custom:CardControl.Header>
                        <TextBlock
                            x:Name="_gpuLabel"
                            Focusable="True"
                            TextWrapping="Wrap" />
                    </custom:CardControl>

                    <custom:CardControl
                        x:Name="_memoryCard"
                        Margin="0,0,0,8"
                        Click="DeviceCardControl_Click">
                        <custom:CardControl.Header>
                            <controls:CardHeaderControl Title="{x:Static resources:Resource.DeviceInformationWindow_Memory_Title}" />
                        </custom:CardControl.Header>
                        <TextBlock x:Name="_memoryLabel" Focusable="True" />
                    </custom:CardControl>

                    <custom:CardControl
                        x:Name="_baseBoardCard"
                        Margin="0,0,0,8"
                        Click="DeviceCardControl_Click">
                        <custom:CardControl.Header>
                            <controls:CardHeaderControl Title="{x:Static resources:Resource.DeviceInformationWindow_BaseBoard_Title}" />
                        </custom:CardControl.Header>
                        <TextBlock
                            x:Name="_baseBoardLabel"
                            Focusable="True"
                            TextWrapping="Wrap" />
                    </custom:CardControl>

                    <custom:CardControl
                        x:Name="_chassisCard"
                        Margin="0,0,0,8"
                        Click="DeviceCardControl_Click">
                        <custom:CardControl.Header>
                            <controls:CardHeaderControl Title="{x:Static resources:Resource.DeviceInformationWindow_Chassis_Title}" />
                        </custom:CardControl.Header>
                        <TextBlock
                            x:Name="_chassisLabel"
                            Focusable="True"
                            TextWrapping="Wrap" />
                    </custom:CardControl>
                </StackPanel>

                <StackPanel x:Name="_warrantyInfo" Visibility="Collapsed">
                    <Grid Margin="0,16,0,24">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Focusable="True"
                            Style="{StaticResource AppDisplaySectionTitleTextBlockStyle}"
                            Text="{x:Static resources:Resource.DeviceInformationWindow_Warranty_Title}" />
                        <wpfui:Button
                            x:Name="_refreshWarrantyButton"
                            Grid.Column="1"
                            Click="RefreshWarrantyButton_OnClick"
                            Icon="ArrowClockwise32"
                            ToolTip="{x:Static resources:Resource.DeviceInformationWindow_Refresh}" />
                    </Grid>

                    <custom:CardControl Margin="0,0,0,8">
                        <custom:CardControl.Header>
                            <controls:CardHeaderControl Title="{x:Static resources:Resource.DeviceInformationWindow_WarrantyStartDate_Title}" />
                        </custom:CardControl.Header>
                        <TextBlock
                            x:Name="_warrantyStartLabel"
                            Focusable="True"
                            Text="-" />
                    </custom:CardControl>

                    <custom:CardControl Margin="0,0,0,8">
                        <custom:CardControl.Header>
                            <controls:CardHeaderControl Title="{x:Static resources:Resource.DeviceInformationWindow_WarrantyEndDate_Title}" />
                        </custom:CardControl.Header>
                        <TextBlock
                            x:Name="_warrantyEndLabel"
                            Focusable="True"
                            Text="-" />
                    </custom:CardControl>


                    <custom:CardAction
                        x:Name="_warrantyLinkCardAction"
                        Margin="0,8,0,8"
                        Click="WarrantyLinkCardAction_OnClick"
                        Content="{x:Static resources:Resource.DeviceInformationWindow_LenovoSupport}"
                        Icon="Open24"
                        IsChevronVisible="False"
                        IsEnabled="False" />
                </StackPanel>

            </StackPanel>

        </wpfui:DynamicScrollViewer>

        <wpfui:SnackbarPresenter
            x:Name="_snackBarPresenter"
            Grid.Row="1"
            HorizontalAlignment="Center" />
    </Grid>
</local:BaseWindow>
