<local:BaseWindow
    x:Class="UniversalDeviceToolkit.WPF.Windows.Utils.InputDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:UniversalDeviceToolkit.WPF.Windows"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.GodModeSettingsWindow_EditPreset_Title}"
    Width="420"
    Height="184"
    MinWidth="380"
    MinHeight="184"
    MaxWidth="520"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    AutomationProperties.AutomationId="InputDialogWindow"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            CanMaximize="False"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid
            Grid.Row="1"
            Margin="20,12,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="_titleTextBlock"
                Grid.Row="0"
                Margin="0,0,0,12"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Style="{StaticResource AppSubsectionTitleTextBlockStyle}"
                TextWrapping="Wrap" />

            <ui:TextBox
                x:Name="_textBox"
                Grid.Row="1"
                AutomationProperties.AutomationId="InputDialogTextBox"
                MaxLength="50" />
        </Grid>

        <StackPanel
            Grid.Row="2"
            Margin="20,16,20,20"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                x:Name="_cancelButton"
                AutomationProperties.AutomationId="InputDialogCancelButton"
                MinWidth="100"
                Margin="0,0,12,0"
                IsCancel="True"
                Click="CancelButton_Click" />
            <ui:Button
                x:Name="_confirmButton"
                AutomationProperties.AutomationId="InputDialogConfirmButton"
                MinWidth="100"
                Appearance="Primary"
                IsDefault="True"
                Click="ConfirmButton_Click" />
        </StackPanel>
    </Grid>
</local:BaseWindow>
