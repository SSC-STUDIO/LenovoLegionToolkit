<wpfui:FluentWindow
    x:Class="UniversalDeviceToolkit.WPF.Windows.Utils.LanguageSelectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:UniversalDeviceToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:UniversalDeviceToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static utils:AppDisplayName.Value}"
    Width="450"
    Height="300"
    MinWidth="450"
    MinHeight="300"
    MaxWidth="520"
    MaxHeight="320"
    Closed="LanguageSelectorWindow_OnClosed"
    ExtendsContentIntoTitleBar="True"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    ResizeMode="NoResize"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    WindowBackdropType="None">

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <wpfui:TitleBar
            Title="{x:Static utils:AppDisplayName.Value}"
            Grid.Row="0"
            CanMaximize="false"
            ShowMaximize="false"
            ShowMinimize="false" />

        <Grid Grid.Row="1" Margin="20,18,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,18,0"
                VerticalAlignment="Top">
                <wpfui:SymbolIcon FontSize="48" Symbol="LocalLanguage24" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1">

                <TextBlock
                    Margin="0,0,0,12"
                    Focusable="True"
                    FontWeight="Medium"
                    Text="{x:Static resources:Resource.LanguageSelectorWindow_SelectLanguage}"
                    TextWrapping="Wrap" />

                <ComboBox x:Name="_languageComboBox" MaxDropDownHeight="Auto" />

                <TextBlock
                    x:Name="_statusText"
                    Margin="0,12,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <Grid
                    x:Name="_installProgressPanel"
                    Margin="0,8,0,0"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar
                        x:Name="_installProgressBar"
                        Grid.Column="0"
                        Height="6"
                        IsIndeterminate="True"
                        Maximum="1"
                        Minimum="0" />
                    <TextBlock
                        x:Name="_installPercentText"
                        Grid.Column="1"
                        MinWidth="40"
                        Margin="12,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>

            </StackPanel>

            <Grid
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,20,0,0"
                HorizontalAlignment="Right">

                <wpfui:Button
                    x:Name="_okButton"
                    MinWidth="120"
                    Appearance="Primary"
                    Click="OK_Click"
                    Content="{x:Static resources:Resource.Continue}" />

                <StackPanel
                    x:Name="_failureActionsPanel"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
                    <wpfui:Button
                        x:Name="_retryButton"
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Appearance="Primary"
                        Click="Retry_Click"
                        Content="Retry" />
                    <wpfui:Button
                        x:Name="_continueEnglishButton"
                        MinWidth="140"
                        Margin="0,0,8,0"
                        Click="ContinueEnglish_Click"
                        Content="Continue in English" />
                    <wpfui:Button
                        x:Name="_exitButton"
                        MinWidth="88"
                        Click="Exit_Click"
                        Content="{x:Static resources:Resource.Exit}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>

</wpfui:FluentWindow>
