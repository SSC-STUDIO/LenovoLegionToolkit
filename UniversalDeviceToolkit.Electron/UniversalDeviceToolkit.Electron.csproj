<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Use the repo-wide TFM so Directory.Build.props' platform settings
         apply cleanly. This project exists ONLY so the Electron client shows
         up in the Visual Studio solution and can be set as the STARTUP
         PROJECT: F5 runs the "Electron (npm run dev)" launch profile (see
         Properties/launchSettings.json), which starts `npm run dev` in this
         directory. The built exe is a no-op stub; never run it directly.
         UniversalDeviceToolkit.Host is a headless JSON-RPC backend spawned
         automatically by Electron and must NOT be set as the startup project
         (it never shows a window). -->
    <TargetFramework>$(UDTTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>UniversalDeviceToolkit.Electron.Launcher</RootNamespace>
    <AssemblyName>UniversalDeviceToolkit.Electron.Launcher</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
