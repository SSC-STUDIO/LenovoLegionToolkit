<Window x:Class="UniversalDeviceToolkit.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="660" Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="AppIconImage" Width="34" Height="34" Source="pack://application:,,,/Icon.ico"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Universal Device Toolkit"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="HeaderSubtitle"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Pages -->
        <Grid Grid.Row="1" Margin="28,22">

            <!-- Welcome -->
            <StackPanel x:Name="PageWelcome" Visibility="Collapsed">
                <TextBlock x:Name="WelcomeTitle" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock x:Name="WelcomeText" Style="{StaticResource PageTextStyle}" Margin="0,14,0,0"/>

                <Border x:Name="UpgradeNotice" Visibility="Collapsed"
                        Background="#EFF6FC" BorderBrush="#B4D6FA" BorderThickness="1"
                        CornerRadius="4" Padding="12,8" Margin="0,14,0,0">
                    <TextBlock x:Name="UpgradeNoticeText" FontSize="12.5" Foreground="#1B4B7A" TextWrapping="Wrap"/>
                </Border>

                <Border x:Name="RuntimePanel" Visibility="Collapsed"
                        Background="#FFF4CE" BorderBrush="#F2C94C" BorderThickness="1"
                        CornerRadius="4" Padding="12" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock x:Name="RuntimeWarningText" FontSize="12.5" Foreground="#5D4A00" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="InstallRuntimeButton" Style="{StaticResource AccentButtonStyle}"
                                    MinWidth="0" Padding="14,6" FontSize="12.5" Click="InstallRuntimeButton_Click"/>
                            <TextBlock x:Name="RuntimeStatusText" FontSize="12" Foreground="#5D4A00"
                                       VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Location -->
            <StackPanel x:Name="PageLocation" Visibility="Collapsed">
                <TextBlock x:Name="LocationTitle" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock x:Name="LocationText" Style="{StaticResource PageTextStyle}" Margin="0,14,0,0"/>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InstallDirBox" Grid.Column="0"
                             FontSize="13" Padding="8,6" VerticalContentAlignment="Center"
                             BorderBrush="{StaticResource BorderBrush}"/>
                    <Button x:Name="BrowseButton" Grid.Column="1" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}" MinWidth="0"
                            Padding="14,6" Click="BrowseButton_Click"/>
                </Grid>
                <CheckBox x:Name="DesktopShortcutCheck" Margin="0,16,0,0" FontSize="13"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>

            <!-- Progress -->
            <StackPanel x:Name="PageProgress" Visibility="Collapsed">
                <TextBlock x:Name="ProgressTitle" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock x:Name="ProgressStatus" Style="{StaticResource PageTextStyle}" Margin="0,18,0,0"/>
                <ProgressBar x:Name="ProgressBar" Height="6" Margin="0,14,0,0"
                             Minimum="0" Maximum="100" Value="0"
                             Foreground="{StaticResource AccentBrush}"/>
                <TextBlock x:Name="ProgressDetail" FontSize="11.5" Margin="0,10,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Done / Error -->
            <StackPanel x:Name="PageDone" Visibility="Collapsed">
                <TextBlock x:Name="DoneTitle" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock x:Name="DoneText" Style="{StaticResource PageTextStyle}" Margin="0,14,0,0"/>
                <CheckBox x:Name="LaunchCheck" Margin="0,16,0,0" FontSize="13" IsChecked="True"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>

            <!-- Uninstall confirm -->
            <StackPanel x:Name="PageUninstallConfirm" Visibility="Collapsed">
                <TextBlock x:Name="UninstallConfirmTitle" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock x:Name="UninstallConfirmText" Style="{StaticResource PageTextStyle}" Margin="0,14,0,0"/>
                <CheckBox x:Name="DeleteDataCheck" Margin="0,16,0,0" FontSize="13"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0" Click="BackButton_Click"/>
                <Button x:Name="NextButton" Style="{StaticResource AccentButtonStyle}"
                        Margin="0,0,8,0" Click="NextButton_Click"/>
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButtonStyle}"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
