<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Plain net10.0-windows: the 10.0.26100.0 suffix would drag in the 26 MB
         CsWinRT projections (Microsoft.Windows.SDK.NET.dll) which we never call.
         Pin both platform versions to 7.0 so the repo-wide SupportedOSPlatformVersion
         (10.0.19041.0) cannot reintroduce the Windows SDK ref pack. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <TargetPlatformVersion>7.0</TargetPlatformVersion>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UniversalDeviceToolkit.Installer</RootNamespace>
    <AssemblyName>UniversalDeviceToolkit.Installer</AssemblyName>
    <UseWPF>true</UseWPF>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <ApplicationIcon>..\..\Assets\Icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>5.0.1</Version>
    <!-- No NuGet dependencies; opting out of the repo-wide lock file keeps
         locked-mode restore immune to SDK-band ILLink pack drift. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <!-- The wizard seeds the app's first-run state (language + device model) in
         the app's own formats, so the app skips its first-run selectors after
         setup. UI strings follow the OS display language. -->
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\Assets\Icon.ico">
      <Link>Icon.ico</Link>
    </Resource>
    <EmbeddedResource Include="..\..\LICENSE">
      <LogicalName>UniversalDeviceToolkit.Installer.LICENSE</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\NOTICE">
      <LogicalName>UniversalDeviceToolkit.Installer.NOTICE</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Full (offline) flavor: the Release workflow passes -p:PayloadZipPath=<zip>
       to embed the payload; without it the Online flavor downloads the payload. -->
  <ItemGroup Condition="'$(PayloadZipPath)' != ''">
    <EmbeddedResource Include="$(PayloadZipPath)">
      <LogicalName>UniversalDeviceToolkit.Installer.payload.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
