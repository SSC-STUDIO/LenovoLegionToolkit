<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>UniversalDeviceToolkit.CrossPlatform</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Copyright>$(ProjectCopyright)</Copyright>
    <AssemblyName>udt</AssemblyName>
    <!--
      Align solution configs (Debug|x64 / Release|x64) without forcing win-x64 RID.
      DisableUdtForceX64 keeps this portable net10.0 (macOS/Linux-capable).
    -->
    <DisableUdtForceX64>true</DisableUdtForceX64>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
</Project>
