<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(UDTTargetFramework)</TargetFramework>
    <RootNamespace>UniversalDeviceToolkit.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <EnableUdtTestHooks>true</EnableUdtTestHooks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="FlaUI.UIA3" />
    <PackageReference Include="FlaUI.Core" />
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UniversalDeviceToolkit.Lib\UniversalDeviceToolkit.Lib.csproj" AdditionalProperties="EnableUdtTestHooks=true" />
    <ProjectReference Include="..\UniversalDeviceToolkit.Lib.Plugins\UniversalDeviceToolkit.Lib.Plugins.csproj" AdditionalProperties="EnableUdtTestHooks=true" />
    <ProjectReference Include="..\UniversalDeviceToolkit.Lib.Automation\UniversalDeviceToolkit.Lib.Automation.csproj" AdditionalProperties="EnableUdtTestHooks=true" />
    <ProjectReference Include="..\UniversalDeviceToolkit.CLI.Lib\UniversalDeviceToolkit.CLI.Lib.csproj" AdditionalProperties="EnableUdtTestHooks=true" />
    <ProjectReference Include="..\UniversalDeviceToolkit.CLI\UniversalDeviceToolkit.CLI.csproj" AdditionalProperties="EnableUdtTestHooks=true" />
    <ProjectReference Include="..\UniversalDeviceToolkit.WPF\UniversalDeviceToolkit.WPF.csproj" AdditionalProperties="EnableUdtTestHooks=true" />
    <ProjectReference Include="..\UniversalDeviceToolkit.Avalonia\UniversalDeviceToolkit.Avalonia.csproj" />
    <ProjectReference Include="..\UniversalDeviceToolkit.Lib.Macro\UniversalDeviceToolkit.Lib.Macro.csproj" AdditionalProperties="EnableUdtTestHooks=true" />
    <ProjectReference Include="..\UniversalDeviceToolkit.SpectrumTester\UniversalDeviceToolkit.SpectrumTester.csproj" AdditionalProperties="EnableUdtTestHooks=true" />
    <ProjectReference Include="..\Tools\MainAppPluginUi.Smoke\MainAppPluginUi.Smoke.csproj" AdditionalProperties="EnableUdtTestHooks=true" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="coverlet.runsettings">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
